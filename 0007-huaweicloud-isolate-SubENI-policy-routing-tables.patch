@@ -32,6 +32,13 @@ const (
 	// table which is between 253-255. See ip-route(8).
 	RouteTableInterfacesOffset = 10
 
+	// RouteTableHuaweiCloudInterfacesOffset is the offset for per-SubENI
+	// routing tables in HuaweiCloud VLAN mode. VLAN IDs are unique on a parent
+	// interface and range from 1 to 4094, so this reserves tables 10001-14094.
+	// The dedicated range avoids the reserved tables 253-255 and the table
+	// ranges already used by Cilium.
+	RouteTableHuaweiCloudInterfacesOffset = 10000
+
 	// RouteMarkDecrypt is the default route mark to use to indicate datapath
 	// needs to decrypt a packet.
