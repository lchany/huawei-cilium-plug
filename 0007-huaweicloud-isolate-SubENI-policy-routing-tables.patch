+func (e *LinuxRoutingSuite) TestConfigureHuaweiCloudIsolatesSubENIRouteTables(c *C) {
+	_, first := getFakes(c)
+	first.IpamMode = ipamOption.IPAMHuaweiCloud
+	first.Masquerade = false
+	first.InterfaceNumber = 101
+	first.IPv4Gateway = net.ParseIP("192.168.1.1")
+
+	second := first
+	second.InterfaceNumber = 202
+	second.IPv4Gateway = net.ParseIP("192.168.2.1")
+
+	firstIP := net.ParseIP("192.168.1.10")
+	secondIP := net.ParseIP("192.168.2.10")
+	masterMAC := first.MasterIfMAC
+
+	runFuncInNetNS(c, func() {
+		ifaceCleanup := createDummyDevice(c, masterMAC)
+		defer ifaceCleanup()
+		trunkIfindex, err := retrieveIfIndexFromMAC(masterMAC, 1500)
+		c.Assert(err, IsNil)
+		legacyRule := route.Rule{
+			Priority: linux_defaults.RulePriorityEgress,
+			From:     &net.IPNet{IP: firstIP, Mask: net.CIDRMask(32, 32)},
+			Table:    trunkIfindex,
+		}
+		c.Assert(route.ReplaceRule(legacyRule), IsNil)
+
+		c.Assert(first.Configure(firstIP, 1500, false, false), IsNil)
+		c.Assert(second.Configure(secondIP, 1500, false, false), IsNil)
+
+		firstTable := linux_defaults.RouteTableHuaweiCloudInterfacesOffset + first.InterfaceNumber
+		secondTable := linux_defaults.RouteTableHuaweiCloudInterfacesOffset + second.InterfaceNumber
+		c.Assert(firstTable, Not(Equals), secondTable)
+
+		assertHuaweiCloudEgressRuleAndDefaultRoute(c, firstIP, first.IPv4Gateway, firstTable)
+		assertHuaweiCloudEgressRuleAndDefaultRoute(c, secondIP, second.IPv4Gateway, secondTable)
+		legacyRules, err := route.ListRules(netlink.FAMILY_V4, &legacyRule)
+		c.Assert(err, IsNil)
+		c.Assert(legacyRules, HasLen, 0)
+
+		c.Assert(Delete(firstIP, false), IsNil)
+		c.Assert(Delete(secondIP, false), IsNil)
+	})
+}
+
+func assertHuaweiCloudEgressRuleAndDefaultRoute(c *C, ip, gateway net.IP, table int) {
+	ipWithMask := &net.IPNet{IP: ip, Mask: net.CIDRMask(32, 32)}
+	rules, err := route.ListRules(netlink.FAMILY_V4, &route.Rule{
+		Priority: linux_defaults.RulePriorityEgressv2,
+		From:     ipWithMask,
+		Table:    table,
+	})
+	c.Assert(err, IsNil)
+	c.Assert(rules, HasLen, 1)
+
+	routes, err := netlink.RouteListFiltered(netlink.FAMILY_V4, &netlink.Route{
+		Table: table,
+	}, netlink.RT_FILTER_TABLE)
+	c.Assert(err, IsNil)
+
+	foundDefault := false
+	for _, configuredRoute := range routes {
+		if configuredRoute.Dst == nil || configuredRoute.Dst.String() == "0.0.0.0/0" {
+			c.Assert(configuredRoute.Gw.Equal(gateway), Equals, true)
+			foundDefault = true
+		}
+	}
+	c.Assert(foundDefault, Equals, true)
+}
