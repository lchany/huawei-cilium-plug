+	return nil
+}
+
+// cleanupStaleHuaweiCloudEgressRules removes rules left by the former shared
+// trunk-ifindex scheme or by a compatibility-priority change. It runs only
+// after the new rule and both routes are installed, so removing a stale rule
+// switches the endpoint to a complete per-VLAN routing table.
+func cleanupStaleHuaweiCloudEgressRules(ip *net.IPNet, priority, tableID int) error {
+	for _, candidatePriority := range []int{
+		linux_defaults.RulePriorityEgress,
+		linux_defaults.RulePriorityEgressv2,
+	} {
+		rules, err := route.ListRules(netlink.FAMILY_V4, &route.Rule{
+			Priority: candidatePriority,
+			From:     ip,
+		})
+		if err != nil {
+			return err
+		}
+
+		for _, ruleToDelete := range rules {
+			if ruleToDelete.Priority == priority && ruleToDelete.Table == tableID {
+				continue
+			}
+			if err := route.DeleteRule(route.Rule{
+				Priority: ruleToDelete.Priority,
+				Mark:     ruleToDelete.Mark,
+				Mask:     ruleToDelete.Mask,
+				From:     ruleToDelete.Src,
+				To:       ruleToDelete.Dst,
+				Table:    ruleToDelete.Table,
+			}); err != nil {
+				return err
+			}
+		}
+	}
 	return nil
 }
 
@@ -308,3 +345,27 @@ func retrieveIfIndexFromMAC(mac mac.MAC, mtu int) (int, error) {
 func computeTableIDFromIfaceNumber(num int) int {
 	return linux_defaults.RouteTableInterfacesOffset + num
 }
+
+// egressRulePriorityAndTableID selects the policy-rule priority and route
+// table used for an endpoint. HuaweiCloud SubENIs share one trunk device, so
+// using the trunk ifindex as the table ID would make SubENIs with different
+// gateways replace each other's default route. Use the VLAN ID, which is
+// unique per trunk interface, to give every SubENI an isolated route table.
+func (info *RoutingInfo) egressRulePriorityAndTableID(ifindex int, compat bool) (int, int, error) {
+	priority := linux_defaults.RulePriorityEgressv2
+	if compat {
+		priority = linux_defaults.RulePriorityEgress
+	}
+
+	if info.IpamMode == ipamOption.IPAMHuaweiCloud {
+		if info.InterfaceNumber < minHuaweiCloudVLANID || info.InterfaceNumber > maxHuaweiCloudVLANID {
+			return 0, 0, fmt.Errorf("invalid HuaweiCloud VLAN ID: %d", info.InterfaceNumber)
+		}
+		return priority, linux_defaults.RouteTableHuaweiCloudInterfacesOffset + info.InterfaceNumber, nil
+	}
+
+	if compat {
+		return priority, ifindex, nil
+	}
+	return priority, computeTableIDFromIfaceNumber(info.InterfaceNumber), nil
+}
