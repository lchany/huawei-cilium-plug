diff --git a/pkg/huaweicloud/subenimap/manager.go b/pkg/huaweicloud/subenimap/manager.go
new file mode 100644
index 000000000..f925d1cca
--- /dev/null
+++ b/pkg/huaweicloud/subenimap/manager.go
@@ -0,0 +1,558 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package subenimap
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"reflect"
+	"strings"
+	"unsafe"
+
+	"github.com/sirupsen/logrus"
+	"golang.org/x/sys/unix"
+
+	"github.com/cilium/cilium/pkg/bpf"
+	"github.com/cilium/cilium/pkg/lock"
+)
+
+const (
+	srcIPMapName   = "cilium_hwc_srcip4"
+	vlanMACMapName = "cilium_hwc_vlan_mac"
+	maxEntries     = 65536
+)
+
+// EndpointInfo provides the data needed to populate the SubENI BPF maps.
+type EndpointInfo interface {
+	// GetIPv4Address returns the Pod IPv4 address (e.g. "10.0.0.5").
+	GetIPv4Address() string
+	// GetID returns the endpoint's LXC ID.
+	GetID() uint32
+	// GetIfIndex returns the interface ifindex of the endpoint's veth.
+	GetIfIndex() uint32
+	// GetMACAddress returns the MAC address of the SubENI bound to this endpoint.
+	GetMACAddress() [6]byte
+	// GetVLANID returns the VLAN ID from the SubENI binding.
+	GetVLANID() int32
+}
+
+// mapBackend abstracts bpf.Map operations to allow test injection.
+type mapBackend interface {
+	Lookup(key bpf.MapKey) (bpf.MapValue, error)
+	Update(key bpf.MapKey, value bpf.MapValue) error
+	Delete(key bpf.MapKey) (bool, error)
+	Dump(callback func(bpf.MapKey, bpf.MapValue)) error
+}
+
+// bpfMapAdapter wraps *bpf.Map so it satisfies mapBackend.
+// bpf.Map.Delete returns (error), but mapBackend.Delete returns (bool, error),
+// so we delegate to SilentDelete which already returns (bool, error).
+type bpfMapAdapter struct {
+	m *bpf.Map
+}
+
+func (a *bpfMapAdapter) Update(key bpf.MapKey, value bpf.MapValue) error {
+	return a.m.Update(key, value)
+}
+
+func (a *bpfMapAdapter) Lookup(key bpf.MapKey) (bpf.MapValue, error) {
+	return a.m.Lookup(key)
+}
+
+func (a *bpfMapAdapter) Delete(key bpf.MapKey) (bool, error) {
+	return a.m.SilentDelete(key)
+}
+
+func (a *bpfMapAdapter) Dump(callback func(bpf.MapKey, bpf.MapValue)) error {
+	return a.m.DumpWithCallback(func(key bpf.MapKey, value bpf.MapValue) {
+		callback(key.DeepCopyMapKey(), value.DeepCopyMapValue())
+	})
+}
+
+// SubENIMapManager maintains two BPF maps used by the HuaweiCloud SubENI
+// datapath:
+//
+//   - cilium_hwc_srcip4   (egress):  Pod IPv4 → SubENI VLAN/MAC/LXC-ID
+//   - cilium_hwc_vlan_mac (ingress): (VLAN ID, dst MAC) → endpoint ifindex/LXC-ID
+type SubENIMapManager struct {
+	logger     *logrus.Entry
+	srcIPMap   mapBackend
+	vlanMACMap mapBackend
+	mutex      lock.RWMutex
+	closed     bool
+}
+
+func newSrcIPMap() *bpf.Map {
+	return bpf.NewMap(
+		srcIPMapName,
+		bpf.MapTypeHash,
+		&SrcIPKey4{}, int(unsafe.Sizeof(SrcIPKey4{})),
+		&SubENIInfo{}, int(unsafe.Sizeof(SubENIInfo{})),
+		maxEntries,
+		0, 0,
+		bpf.ConvertKeyValue,
+	)
+}
+
+func newVLANMACMap() *bpf.Map {
+	return bpf.NewMap(
+		vlanMACMapName,
+		bpf.MapTypeHash,
+		&VLANMACKey{}, int(unsafe.Sizeof(VLANMACKey{})),
+		&EPInfo{}, int(unsafe.Sizeof(EPInfo{})),
+		maxEntries,
+		0, 0,
+		bpf.ConvertKeyValue,
+	)
+}
+
+func openOrCreateDatapathMap(name string, spec *bpf.Map) (*bpf.Map, error) {
+	// The BTF map declarations in bpf/lib/huaweicloud.h have flags=0. Do not
+	// use Map.OpenOrCreate here: with preallocate-bpf-maps=false it adds
+	// BPF_F_NO_PREALLOC, so libbpf later replaces the map during endpoint
+	// compilation and discards entries inserted during startup.
+	fd, _, err := bpf.OpenOrCreateMap(
+		bpf.MapPath(name),
+		bpf.GetMapType(spec.MapType),
+		spec.KeySize,
+		spec.ValueSize,
+		spec.MaxEntries,
+		0,
+		0,
+		true,
+	)
+	if err != nil {
+		return nil, err
+	}
+	if err := unix.Close(fd); err != nil {
+		return nil, fmt.Errorf("close newly opened %s fd: %w", name, err)
+	}
+	if err := spec.Open(); err != nil {
+		return nil, err
+	}
+	return spec, nil
+}
+
+// NewSubENIMapManager opens or creates the pinned HuaweiCloud datapath maps
+// before endpoint events are subscribed. Waiting for the first endpoint BPF
+// program to create these maps leaves a startup race: restored Pods can become
+// Ready while both maps are still absent, and no later event repairs them.
+func NewSubENIMapManager(logger *logrus.Entry) (*SubENIMapManager, error) {
+	srcIP, err := openOrCreateDatapathMap(srcIPMapName, newSrcIPMap())
+	if err != nil {
+		return nil, fmt.Errorf("open or create pinned %s: %w", srcIPMapName, err)
+	}
+
+	vlanMAC, err := openOrCreateDatapathMap(vlanMACMapName, newVLANMACMap())
+	if err != nil {
+		_ = srcIP.Close()
+		return nil, fmt.Errorf("open or create pinned %s: %w", vlanMACMapName, err)
+	}
+
+	return &SubENIMapManager{
+		logger:     logger,
+		srcIPMap:   &bpfMapAdapter{m: srcIP},
+		vlanMACMap: &bpfMapAdapter{m: vlanMAC},
+	}, nil
+}
+
+func (m *SubENIMapManager) ensureMapsOpenLocked() error {
+	if m.closed {
+		return errors.New("SubENI map manager is closed")
+	}
+	if m.srcIPMap != nil && m.vlanMACMap != nil {
+		return nil
+	}
+
+	srcIP, err := bpf.OpenMap(bpf.MapPath(srcIPMapName))
+	if err != nil {
+		return fmt.Errorf("failed to open pinned %s: %w", srcIPMapName, err)
+	}
+
+	vlanMAC, err := bpf.OpenMap(bpf.MapPath(vlanMACMapName))
+	if err != nil {
+		_ = srcIP.Close()
+		return fmt.Errorf("failed to open pinned %s: %w", vlanMACMapName, err)
+	}
+
+	m.srcIPMap = &bpfMapAdapter{m: srcIP}
+	m.vlanMACMap = &bpfMapAdapter{m: vlanMAC}
+
+	return nil
+}
+
+// newWithBackends is used in tests to inject fake map backends without opening
+// real BPF file descriptors.
+func newWithBackends(logger *logrus.Entry, srcIP mapBackend, vlanMAC mapBackend) *SubENIMapManager {
+	return &SubENIMapManager{
+		logger:     logger,
+		srcIPMap:   srcIP,
+		vlanMACMap: vlanMAC,
+	}
+}
+
+func parseIPv4(addr string) ([4]byte, error) {
+	ip := net.ParseIP(addr)
+	if ip == nil {
+		return [4]byte{}, fmt.Errorf("invalid IPv4 address: %q", addr)
+	}
+	ip4 := ip.To4()
+	if ip4 == nil {
+		return [4]byte{}, fmt.Errorf("address is not IPv4: %q", addr)
+	}
+	var out [4]byte
+	copy(out[:], ip4)
+	return out, nil
+}
+
+type endpointMapEntries struct {
+	srcKey    *SrcIPKey4
+	srcValue  *SubENIInfo
+	vlanKey   *VLANMACKey
+	vlanValue *EPInfo
+}
+
+func mapEntriesForEndpoint(ep EndpointInfo) (*endpointMapEntries, error) {
+	if ep == nil {
+		return nil, errors.New("endpoint is nil")
+	}
+	v := reflect.ValueOf(ep)
+	if (v.Kind() == reflect.Ptr || v.Kind() == reflect.Interface) && v.IsNil() {
+		return nil, errors.New("endpoint is nil")
+	}
+	if ep.GetID() == 0 || ep.GetID() > uint32(^uint16(0)) {
+		return nil, fmt.Errorf("endpoint ID %d is outside 1-65535", ep.GetID())
+	}
+	if ep.GetIfIndex() == 0 {
+		return nil, errors.New("endpoint ifindex must be positive")
+	}
+	if ep.GetVLANID() < 1 || ep.GetVLANID() > 4094 {
+		return nil, fmt.Errorf("VLAN ID %d is outside 1-4094", ep.GetVLANID())
+	}
+	mac := ep.GetMACAddress()
+	if mac == [6]byte{} {
+		return nil, errors.New("SubENI MAC address is empty")
+	}
+	if mac[0]&1 != 0 {
+		return nil, fmt.Errorf("SubENI MAC address %02x:%02x:%02x:%02x:%02x:%02x is multicast", mac[0], mac[1], mac[2], mac[3], mac[4], mac[5])
+	}
+	addr, err := parseIPv4(ep.GetIPv4Address())
+	if err != nil {
+		return nil, err
+	}
+	vlanID := uint16(ep.GetVLANID()) //nolint:gosec // validated above
+	return &endpointMapEntries{
+		srcKey:   &SrcIPKey4{Addr: addr},
+		srcValue: &SubENIInfo{VlanID: vlanID, MAC: mac, LxcID: ep.GetID()},
+		vlanKey:  &VLANMACKey{VlanID: vlanID, MAC: mac},
+		vlanValue: &EPInfo{
+			IfIndex: ep.GetIfIndex(),
+			LxcID:   uint16(ep.GetID()), //nolint:gosec // validated above
+		},
+	}, nil
+}
+
+type mapEntry struct {
+	key   bpf.MapKey
+	value bpf.MapValue
+}
+
+func dumpMapEntries(backend mapBackend) (map[string]mapEntry, error) {
+	entries := map[string]mapEntry{}
+	err := backend.Dump(func(key bpf.MapKey, value bpf.MapValue) {
+		entries[key.String()] = mapEntry{key: key, value: value}
+	})
+	return entries, err
+}
+
+func restoreMapEntries(backend mapBackend, snapshot map[string]mapEntry) error {
+	current, err := dumpMapEntries(backend)
+	if err != nil {
+		return err
+	}
+	var restoreErrors []string
+	for keyString, entry := range current {
+		if _, keep := snapshot[keyString]; keep {
+			continue
+		}
+		if _, err := backend.Delete(entry.key); err != nil {
+			restoreErrors = append(restoreErrors, err.Error())
+		}
+	}
+	for _, entry := range snapshot {
+		if err := backend.Update(entry.key, entry.value); err != nil {
+			restoreErrors = append(restoreErrors, err.Error())
+		}
+	}
+	if len(restoreErrors) != 0 {
+		return fmt.Errorf("restore map snapshot: %s", strings.Join(restoreErrors, "; "))
+	}
+	return nil
+}
+
+func updateDesiredEntries(backend mapBackend, desired map[string]mapEntry) error {
+	for _, entry := range desired {
+		if err := backend.Update(entry.key, entry.value); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func deleteStaleEntries(backend mapBackend, current, desired map[string]mapEntry) error {
+	for keyString, entry := range current {
+		if _, keep := desired[keyString]; keep {
+			continue
+		}
+		if _, err := backend.Delete(entry.key); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Reconcile replaces stale pinned-map ownership with the endpoint manager's
+// complete current state. Pinned maps survive an Agent restart, while health
+// and Pod endpoints may be recreated with a different LXC ID. Treating the
+// old ID as a live owner permanently rejects the replacement and leaves an
+// unreachable ingress entry. Reconciliation validates the full desired set
+// before mutation and restores both original map snapshots on any failure.
+func (m *SubENIMapManager) Reconcile(endpoints []EndpointInfo) error {
+	desiredSrc := map[string]mapEntry{}
+	desiredVLAN := map[string]mapEntry{}
+	for _, ep := range endpoints {
+		entries, err := mapEntriesForEndpoint(ep)
+		if err != nil {
+			return fmt.Errorf("Reconcile: %w", err)
+		}
+		if old, ok := desiredSrc[entries.srcKey.String()]; ok && !reflect.DeepEqual(old.value, entries.srcValue) {
+			return fmt.Errorf("Reconcile: duplicate source IP %s has conflicting endpoint owners", ep.GetIPv4Address())
+		}
+		desiredSrc[entries.srcKey.String()] = mapEntry{key: entries.srcKey, value: entries.srcValue}
+
+		if old, ok := desiredVLAN[entries.vlanKey.String()]; ok && !reflect.DeepEqual(old.value, entries.vlanValue) {
+			return fmt.Errorf("Reconcile: duplicate VLAN/MAC %s has conflicting endpoint owners", entries.vlanKey)
+		}
+		desiredVLAN[entries.vlanKey.String()] = mapEntry{key: entries.vlanKey, value: entries.vlanValue}
+	}
+
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+	if err := m.ensureMapsOpenLocked(); err != nil {
+		return fmt.Errorf("Reconcile: %w", err)
+	}
+	srcSnapshot, err := dumpMapEntries(m.srcIPMap)
+	if err != nil {
+		return fmt.Errorf("Reconcile: dump %s: %w", srcIPMapName, err)
+	}
+	vlanSnapshot, err := dumpMapEntries(m.vlanMACMap)
+	if err != nil {
+		return fmt.Errorf("Reconcile: dump %s: %w", vlanMACMapName, err)
+	}
+	rollback := func(cause error) error {
+		var rollbackErrors []string
+		if err := restoreMapEntries(m.srcIPMap, srcSnapshot); err != nil {
+			rollbackErrors = append(rollbackErrors, fmt.Sprintf("%s: %v", srcIPMapName, err))
+		}
+		if err := restoreMapEntries(m.vlanMACMap, vlanSnapshot); err != nil {
+			rollbackErrors = append(rollbackErrors, fmt.Sprintf("%s: %v", vlanMACMapName, err))
+		}
+		if len(rollbackErrors) != 0 {
+			return fmt.Errorf("%w; rollback failed: %s", cause, strings.Join(rollbackErrors, "; "))
+		}
+		return cause
+	}
+	// Install ingress ownership before making the corresponding source-IP
+	// entry usable. On removal, stop egress first and remove ingress ownership
+	// last. This ordering keeps the datapath fail-closed while the two distinct
+	// BPF maps are being reconciled.
+	if err := updateDesiredEntries(m.vlanMACMap, desiredVLAN); err != nil {
+		return rollback(fmt.Errorf("Reconcile: update %s: %w", vlanMACMapName, err))
+	}
+	if err := updateDesiredEntries(m.srcIPMap, desiredSrc); err != nil {
+		return rollback(fmt.Errorf("Reconcile: update %s: %w", srcIPMapName, err))
+	}
+	if err := deleteStaleEntries(m.srcIPMap, srcSnapshot, desiredSrc); err != nil {
+		return rollback(fmt.Errorf("Reconcile: delete stale %s entry: %w", srcIPMapName, err))
+	}
+	if err := deleteStaleEntries(m.vlanMACMap, vlanSnapshot, desiredVLAN); err != nil {
+		return rollback(fmt.Errorf("Reconcile: delete stale %s entry: %w", vlanMACMapName, err))
+	}
+	return nil
+}
+
+// OnEndpointReady upserts one entry in each BPF map for the given endpoint.
+// It is safe to call concurrently.
+func (m *SubENIMapManager) OnEndpointReady(ep EndpointInfo) error {
+	entries, err := mapEntriesForEndpoint(ep)
+	if err != nil {
+		return fmt.Errorf("OnEndpointReady: %w", err)
+	}
+	srcKey, srcVal := entries.srcKey, entries.srcValue
+	vlanKey, epVal := entries.vlanKey, entries.vlanValue
+
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+
+	if err := m.ensureMapsOpenLocked(); err != nil {
+		return fmt.Errorf("OnEndpointReady: %w", err)
+	}
+
+	// --- Map 1: srcip → subeni info (egress) ---
+	oldSrcVal, err := m.srcIPMap.Lookup(srcKey)
+	if err != nil && !errors.Is(err, unix.ENOENT) {
+		return fmt.Errorf("OnEndpointReady: lookup %s key=%s: %w", srcIPMapName, srcKey, err)
+	}
+	var oldSrc *SubENIInfo
+	if oldSrcVal != nil {
+		var ok bool
+		oldSrc, ok = oldSrcVal.(*SubENIInfo)
+		if !ok {
+			return fmt.Errorf("OnEndpointReady: %s key=%s contains an unexpected value type", srcIPMapName, srcKey)
+		}
+		if oldSrc.LxcID != ep.GetID() {
+			return fmt.Errorf("OnEndpointReady: %s key=%s is already owned by endpoint %d", srcIPMapName, srcKey, oldSrc.LxcID)
+		}
+	}
+	if err := m.srcIPMap.Update(srcKey, srcVal); err != nil {
+		return fmt.Errorf("OnEndpointReady: update %s key=%s: %w", srcIPMapName, srcKey, err)
+	}
+	rollbackSrc := func() error {
+		if oldSrcVal != nil {
+			return m.srcIPMap.Update(srcKey, oldSrcVal)
+		}
+		_, rollbackErr := m.srcIPMap.Delete(srcKey)
+		return rollbackErr
+	}
+
+	// --- Map 2: (vlan-id, dst-mac) → endpoint (ingress) ---
+	oldEPVal, err := m.vlanMACMap.Lookup(vlanKey)
+	if err != nil && !errors.Is(err, unix.ENOENT) {
+		if rollbackErr := rollbackSrc(); rollbackErr != nil {
+			return fmt.Errorf("OnEndpointReady: lookup %s key=%s: %w; rollback %s: %v", vlanMACMapName, vlanKey, err, srcIPMapName, rollbackErr)
+		}
+		return fmt.Errorf("OnEndpointReady: lookup %s key=%s: %w", vlanMACMapName, vlanKey, err)
+	}
+	if oldEPVal != nil {
+		oldEP, ok := oldEPVal.(*EPInfo)
+		if !ok || oldEP.IfIndex != epVal.IfIndex || oldEP.LxcID != epVal.LxcID {
+			if rollbackErr := rollbackSrc(); rollbackErr != nil {
+				return fmt.Errorf("OnEndpointReady: %s key=%s is already owned by another endpoint; rollback %s: %v", vlanMACMapName, vlanKey, srcIPMapName, rollbackErr)
+			}
+			return fmt.Errorf("OnEndpointReady: %s key=%s is already owned by another endpoint", vlanMACMapName, vlanKey)
+		}
+	}
+	if err := m.vlanMACMap.Update(vlanKey, epVal); err != nil {
+		rollbackErr := rollbackSrc()
+		if rollbackErr != nil {
+			return fmt.Errorf("OnEndpointReady: update %s key=%s: %w; rollback %s: %v", vlanMACMapName, vlanKey, err, srcIPMapName, rollbackErr)
+		}
+		return fmt.Errorf("OnEndpointReady: update %s key=%s: %w", vlanMACMapName, vlanKey, err)
+	}
+
+	// When the same endpoint is rebound to another SubENI, remove its old
+	// ingress key only after both replacement entries are installed.
+	if oldSrc != nil && (oldSrc.VlanID != srcVal.VlanID || oldSrc.MAC != srcVal.MAC) {
+		oldVLANKey := &VLANMACKey{VlanID: oldSrc.VlanID, MAC: oldSrc.MAC}
+		if _, err := m.vlanMACMap.Delete(oldVLANKey); err != nil {
+			var newKeyRollbackErr error
+			if oldEPVal != nil {
+				newKeyRollbackErr = m.vlanMACMap.Update(vlanKey, oldEPVal)
+			} else {
+				_, newKeyRollbackErr = m.vlanMACMap.Delete(vlanKey)
+			}
+			srcRollbackErr := rollbackSrc()
+			return fmt.Errorf("OnEndpointReady: delete stale %s key=%s: %w; rollback replacement key: %v; rollback %s: %v",
+				vlanMACMapName, oldVLANKey, err, newKeyRollbackErr, srcIPMapName, srcRollbackErr)
+		}
+	}
+
+	return nil
+}
+
+// OnEndpointDelete removes the entries for the given endpoint from both BPF
+// maps on a best-effort basis (individual delete errors are logged but not
+// returned).
+func (m *SubENIMapManager) OnEndpointDelete(ep EndpointInfo) error {
+	entries, err := mapEntriesForEndpoint(ep)
+	if err != nil {
+		return fmt.Errorf("OnEndpointDelete: %w", err)
+	}
+
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+
+	if err := m.ensureMapsOpenLocked(); err != nil {
+		return fmt.Errorf("OnEndpointDelete: %w", err)
+	}
+
+	// A delete notification can arrive after a newer Ready/Restore notification
+	// for the same Pod IP. Remove an entry only when it still describes the
+	// endpoint being deleted; otherwise a stale delete would tear down the new
+	// endpoint's datapath state.
+	srcKey := entries.srcKey
+	srcValue, srcLookupErr := m.srcIPMap.Lookup(srcKey)
+	deleteSrc := false
+	if srcLookupErr == nil {
+		if current, ok := srcValue.(*SubENIInfo); ok {
+			deleteSrc = *current == *entries.srcValue
+		}
+	} else if !errors.Is(srcLookupErr, unix.ENOENT) {
+		m.logger.WithError(srcLookupErr).WithFields(logrus.Fields{
+			"map":  srcIPMapName,
+			"addr": ep.GetIPv4Address(),
+		}).Warn("failed to verify srcip entry ownership before delete")
+	}
+	if deleteSrc {
+		if _, err := m.srcIPMap.Delete(srcKey); err != nil {
+			m.logger.WithError(err).WithFields(logrus.Fields{
+				"map":  srcIPMapName,
+				"addr": ep.GetIPv4Address(),
+			}).Warn("failed to delete srcip entry")
+		}
+	}
+
+	vlanKey := entries.vlanKey
+	vlanValue, vlanLookupErr := m.vlanMACMap.Lookup(vlanKey)
+	deleteVLAN := false
+	if vlanLookupErr == nil {
+		if current, ok := vlanValue.(*EPInfo); ok {
+			deleteVLAN = *current == *entries.vlanValue
+		}
+	} else if !errors.Is(vlanLookupErr, unix.ENOENT) {
+		m.logger.WithError(vlanLookupErr).WithFields(logrus.Fields{
+			"map":  vlanMACMapName,
+			"addr": ep.GetIPv4Address(),
+		}).Warn("failed to verify vlan-mac entry ownership before delete")
+	}
+	if deleteVLAN {
+		if _, err := m.vlanMACMap.Delete(vlanKey); err != nil {
+			m.logger.WithError(err).WithFields(logrus.Fields{
+				"map":  vlanMACMapName,
+				"addr": ep.GetIPv4Address(),
+			}).Warn("failed to delete vlan-mac entry")
+		}
+	}
+
+	return nil
+}
+
+// Close releases any resources held by the manager.
+// After Close the manager must not be used.
+func (m *SubENIMapManager) Close() {
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+	if m.closed {
+		return
+	}
+	m.closed = true
+	// If the underlying backends are real bpf.Map adapters, close the maps.
+	if a, ok := m.srcIPMap.(*bpfMapAdapter); ok {
+		_ = a.m.Close()
+	}
+	if a, ok := m.vlanMACMap.(*bpfMapAdapter); ok {
+		_ = a.m.Close()
+	}
+}
