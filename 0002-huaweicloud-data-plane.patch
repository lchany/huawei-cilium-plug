+	"github.com/cilium/cilium/pkg/endpoint"
+	"github.com/cilium/cilium/pkg/huaweicloud/subenimap"
+	ipamOption "github.com/cilium/cilium/pkg/ipam/option"
+	"github.com/cilium/cilium/pkg/k8s"
+	ciliumv2 "github.com/cilium/cilium/pkg/k8s/apis/cilium.io/v2"
+	"github.com/cilium/cilium/pkg/logging"
+	"github.com/cilium/cilium/pkg/logging/logfields"
+	"github.com/cilium/cilium/pkg/node"
+	nodeTypes "github.com/cilium/cilium/pkg/node/types"
+	"github.com/cilium/cilium/pkg/option"
+)
+
+var huaweiCloudSubENILog = logging.DefaultLogger.WithField(logfields.LogSubsys, "endpointmanager-huaweicloud-subeni")
+
+type subENIMapUpdater interface {
+	Reconcile([]subenimap.EndpointInfo) error
+	OnEndpointReady(subenimap.EndpointInfo) error
+	OnEndpointDelete(subenimap.EndpointInfo) error
+	Close()
+}
+
+type huaweiCloudSubENISubscriber struct {
+	logger        *logrus.Entry
+	mapMgr        subENIMapUpdater
+	endpointMutex sync.Mutex
+	neighborMutex sync.Mutex
+	mutex         sync.Mutex
+	initialized   bool
+	pending       []pendingSubENIEvent
+	cacheMutex    sync.RWMutex
+	cache         map[string]subenimap.EndpointInfo
+	routerRouting func() (*linuxrouting.RoutingInfo, net.IP)
+	getCiliumNode func(context.Context) (*ciliumv2.CiliumNode, error)
+	reconcileStop chan struct{}
+	reconcileDone chan struct{}
+	stopOnce      sync.Once
+}
+
+const (
+	huaweiCloudRouteReconcileInterval = 5 * time.Second
+	huaweiCloudCiliumNodeGetTimeout   = 10 * time.Second
+)
+
+type pendingSubENIEvent struct {
+	kind uint8
+	ep   *endpoint.Endpoint
+}
+
+const (
+	subENIEventCreated uint8 = iota
+	subENIEventRestored
+	subENIEventDeleted
+)
+
+type subENIEndpoint interface {
+	GetIPv4Address() string
+	GetID() uint64
+	GetIfIndex() int
+}
+
+type huaweiCloudEndpointInfo struct {
+	ipv4           string
+	id             uint32
+	ifIndex        uint32
+	mac            [6]byte
+	vlanID         int32
+	gatewayIP      net.IP
+	gatewayMAC     net.HardwareAddr
+	trunkInterface string
+}
+
+func (e *huaweiCloudEndpointInfo) GetIPv4Address() string { return e.ipv4 }
+func (e *huaweiCloudEndpointInfo) GetID() uint32          { return e.id }
+func (e *huaweiCloudEndpointInfo) GetIfIndex() uint32     { return e.ifIndex }
+func (e *huaweiCloudEndpointInfo) GetMACAddress() [6]byte { return e.mac }
+func (e *huaweiCloudEndpointInfo) GetVLANID() int32       { return e.vlanID }
+
+func RegisterHuaweiCloudSubENIManager(mgr *EndpointManager) (func(), error) {
+	if option.Config.IPAM != ipamOption.IPAMHuaweiCloud || !k8s.IsEnabled() {
+		return nil, nil
+	}
+
+	mapMgr, err := subenimap.NewSubENIMapManager(huaweiCloudSubENILog)
+	if err != nil {
+		return nil, fmt.Errorf("create HuaweiCloud SubENI map manager: %w", err)
+	}
+
+	subscriber := &huaweiCloudSubENISubscriber{
+		logger: huaweiCloudSubENILog,
+		mapMgr: mapMgr,
+		cache:  map[string]subenimap.EndpointInfo{},
+		routerRouting: func() (*linuxrouting.RoutingInfo, net.IP) {
+			routingInfo, _ := node.GetRouterInfo().(*linuxrouting.RoutingInfo)
+			return routingInfo, node.GetInternalIPv4Router()
+		},
+		getCiliumNode: func(ctx context.Context) (*ciliumv2.CiliumNode, error) {
+			return k8s.CiliumClient().CiliumV2().CiliumNodes().Get(ctx, nodeTypes.GetName(), metav1.GetOptions{})
+		},
+	}
+	mgr.Subscribe(subscriber)
+	cleanupOnError := func(err error) (func(), error) {
+		mgr.Unsubscribe(subscriber)
+		mapMgr.Close()
+		return nil, err
+	}
+	endpoints := mgr.GetEndpoints()
+	initialEndpoints := make([]subENIEndpoint, 0, len(endpoints))
+	for _, ep := range endpoints {
+		initialEndpoints = append(initialEndpoints, ep)
+	}
+	initialInfos, err := subscriber.resolveInitialEndpointInfos(initialEndpoints)
+	if err != nil {
+		return cleanupOnError(err)
+	}
+	var desired []subenimap.EndpointInfo
+	for _, info := range initialInfos {
+		if err := subscriber.ensureGatewayNeighbor(info); err != nil {
+			return cleanupOnError(fmt.Errorf("install initial HuaweiCloud gateway neighbor for endpoint %d: %w", info.id, err))
+		}
+		if err := subscriber.ensureEndpointRouting(info); err != nil {
+			return cleanupOnError(fmt.Errorf("install initial HuaweiCloud endpoint routing for endpoint %d: %w", info.id, err))
+		}
+		desired = append(desired, info)
+	}
+	if err := mapMgr.Reconcile(desired); err != nil {
+		return cleanupOnError(fmt.Errorf("reconcile initial HuaweiCloud SubENI maps: %w", err))
+	}
+	for _, info := range desired {
+		subscriber.cacheEndpointInfo(info)
+	}
+	subscriber.finishInitialization()
+	subscriber.startRouteReconciler(huaweiCloudRouteReconcileInterval)
+
+	return func() {
+		subscriber.stopRouteReconciler()
+		mgr.Unsubscribe(subscriber)
+		mapMgr.Close()
+	}, nil
+}
+
+func (s *huaweiCloudSubENISubscriber) EndpointCreated(ep *endpoint.Endpoint) {
+	if s.queueBeforeInitialization(pendingSubENIEvent{kind: subENIEventCreated, ep: ep}) {
+		return
+	}
+	s.upsertEndpoint(ep, "created")
+}
+
+func (s *huaweiCloudSubENISubscriber) EndpointRestored(ep *endpoint.Endpoint) {
+	if s.queueBeforeInitialization(pendingSubENIEvent{kind: subENIEventRestored, ep: ep}) {
+		return
+	}
+	s.upsertEndpoint(ep, "restored")
+}
+
+func (s *huaweiCloudSubENISubscriber) EndpointDeleted(ep *endpoint.Endpoint, _ endpoint.DeleteConfig) {
+	if s.queueBeforeInitialization(pendingSubENIEvent{kind: subENIEventDeleted, ep: ep}) {
+		return
+	}
+	s.deleteEndpoint(ep)
+}
+
+func (s *huaweiCloudSubENISubscriber) queueBeforeInitialization(event pendingSubENIEvent) bool {
+	s.mutex.Lock()
+	defer s.mutex.Unlock()
+	if s.initialized {
+		return false
+	}
+	s.pending = append(s.pending, event)
+	return true
+}
+
+func (s *huaweiCloudSubENISubscriber) finishInitialization() {
+	s.mutex.Lock()
+	defer s.mutex.Unlock()
+	for _, event := range s.pending {
+		switch event.kind {
+		case subENIEventCreated:
+			s.upsertEndpoint(event.ep, "created-during-initial-reconcile")
+		case subENIEventRestored:
+			s.upsertEndpoint(event.ep, "restored-during-initial-reconcile")
+		case subENIEventDeleted:
+			s.deleteEndpoint(event.ep)
+		}
+	}
+	s.pending = nil
+	s.initialized = true
+}
+
+func (s *huaweiCloudSubENISubscriber) deleteEndpoint(ep *endpoint.Endpoint) {
+	s.endpointMutex.Lock()
+	defer s.endpointMutex.Unlock()
+
+	info := s.cachedEndpointInfo(ep)
+	if info == nil {
+		var err error
+		info, err = s.resolveEndpointInfo(ep)
+		if err != nil {
+			s.logger.WithError(err).WithFields(logrus.Fields{
+				logfields.EndpointID: ep.GetID(),
+				logfields.IPv4:       ep.GetIPv4Address(),
+			}).Warn("Failed to resolve HuaweiCloud SubENI endpoint info on delete")
+			return
+		}
+	}
+	if info == nil {
+		return
+	}
+	if err := s.mapMgr.OnEndpointDelete(info); err != nil {
+		s.logger.WithError(err).WithFields(logrus.Fields{
+			logfields.EndpointID: ep.GetID(),
+			logfields.IPv4:       ep.GetIPv4Address(),
+		}).Warn("Failed to delete HuaweiCloud SubENI BPF map entries")
+		return
+	}
+	s.forgetEndpointInfo(ep)
+}
+
+func (s *huaweiCloudSubENISubscriber) upsertEndpoint(ep *endpoint.Endpoint, reason string) {
+	info, err := s.resolveEndpointInfo(ep)
+	if err != nil {
+		s.logger.WithError(err).WithFields(logrus.Fields{
+			logfields.EndpointID: ep.GetID(),
+			logfields.IPv4:       ep.GetIPv4Address(),
+			"reason":             reason,
+		}).Warn("Failed to resolve HuaweiCloud SubENI endpoint info")
+		return
+	}
+	if info == nil {
+		return
+	}
+	s.upsertEndpointInfo(info, ep.GetID(), ep.GetIPv4Address(), reason)
+}
+
+func (s *huaweiCloudSubENISubscriber) upsertEndpointInfo(info *huaweiCloudEndpointInfo, endpointID uint64, ipv4, reason string) {
+	s.endpointMutex.Lock()
+	defer s.endpointMutex.Unlock()
+	s.upsertEndpointInfoLocked(info, endpointID, ipv4, reason)
+}
+
+func (s *huaweiCloudSubENISubscriber) upsertEndpointInfoLocked(info *huaweiCloudEndpointInfo, endpointID uint64, ipv4, reason string) {
+	if err := s.ensureGatewayNeighbor(info); err != nil {
+		s.logger.WithError(err).WithFields(logrus.Fields{
+			logfields.EndpointID: endpointID,
+			logfields.IPv4:       ipv4,
+			"reason":             reason,
+		}).Warn("Failed to install HuaweiCloud gateway neighbor entry")
+		return
+	}
+	if err := s.ensureEndpointRouting(info); err != nil {
+		s.logger.WithError(err).WithFields(logrus.Fields{
+			logfields.EndpointID: endpointID,
+			logfields.IPv4:       ipv4,
+			"reason":             reason,
+		}).Warn("Failed to install HuaweiCloud endpoint routing")
+		return
+	}
+	if err := s.mapMgr.OnEndpointReady(info); err != nil {
+		s.logger.WithError(err).WithFields(logrus.Fields{
+			logfields.EndpointID: endpointID,
+			logfields.IPv4:       ipv4,
+			"reason":             reason,
+		}).Warn("Failed to upsert HuaweiCloud SubENI BPF map entries")
+		return
+	}
+	s.cacheEndpointInfo(info)
+}
+
+func (s *huaweiCloudSubENISubscriber) ensureEndpointRouting(info *huaweiCloudEndpointInfo) error {
+	return s.configureEndpointRouting(info, false)
+}
+
+func (s *huaweiCloudSubENISubscriber) reconcileEndpointRouting(info *huaweiCloudEndpointInfo) error {
+	return s.configureEndpointRouting(info, true)
+}
+
+func (s *huaweiCloudSubENISubscriber) configureEndpointRouting(info *huaweiCloudEndpointInfo, reconcile bool) error {
+	if info == nil || info.gatewayIP == nil || info.trunkInterface == "" {
+		return nil
+	}
+	link, err := netlink.LinkByName(info.trunkInterface)
+	if err != nil {
+		return fmt.Errorf("resolve trunk interface %s: %w", info.trunkInterface, err)
+	}
+	routingInfo, err := linuxrouting.NewRoutingInfo(
+		info.gatewayIP.String(), nil, link.Attrs().HardwareAddr.String(),
+		strconv.Itoa(int(info.vlanID)), ipamOption.IPAMHuaweiCloud, false,
+	)
+	if err != nil {
+		return fmt.Errorf("construct routing info: %w", err)
+	}
+	configure := func() error {
+		if reconcile {
+			return routingInfo.Reconcile(net.ParseIP(info.ipv4), option.Config.EgressMultiHomeIPRuleCompat, false)
+		}
+		return routingInfo.Configure(net.ParseIP(info.ipv4), link.Attrs().MTU,
+			option.Config.EgressMultiHomeIPRuleCompat, false)
+	}
+	if err := configure(); err != nil {
+		return fmt.Errorf("configure endpoint %s: %w", info.ipv4, err)
+	}
+	return nil
+}
+
+func (s *huaweiCloudSubENISubscriber) reconcileCachedEndpointInfos(reason string) {
+	s.endpointMutex.Lock()
+	defer s.endpointMutex.Unlock()
+
+	s.cacheMutex.RLock()
+	infos := make([]*huaweiCloudEndpointInfo, 0, len(s.cache))
+	for _, cached := range s.cache {
+		if info, ok := cached.(*huaweiCloudEndpointInfo); ok {
+			infos = append(infos, info)
+		}
+	}
+	s.cacheMutex.RUnlock()
+	for _, info := range infos {
+		fields := logrus.Fields{
+			logfields.EndpointID: info.id,
+			logfields.IPv4:       info.ipv4,
+			"reason":             reason,
+		}
+		if err := s.ensureGatewayNeighbor(info); err != nil {
+			s.logger.WithError(err).WithFields(fields).Warn("Failed to reconcile HuaweiCloud gateway neighbor entry")
+			continue
+		}
+		if err := s.reconcileEndpointRouting(info); err != nil {
+			s.logger.WithError(err).WithFields(fields).Warn("Failed to reconcile HuaweiCloud endpoint routing")
+		}
+	}
+	if s.routerRouting != nil {
+		routingInfo, routerIP := s.routerRouting()
+		if routingInfo != nil && routerIP != nil {
+			if err := routingInfo.Reconcile(routerIP, option.Config.EgressMultiHomeIPRuleCompat, true); err != nil {
+				s.logger.WithError(err).WithFields(logrus.Fields{
+					logfields.IPv4: routerIP,
+					"reason":       reason,
+				}).Warn("Failed to reconcile HuaweiCloud router routing")
+			}
+		}
+	}
+}
+
+func (s *huaweiCloudSubENISubscriber) startRouteReconciler(interval time.Duration) {
+	if interval <= 0 || s.reconcileStop != nil {
+		return
+	}
+	s.reconcileStop = make(chan struct{})
+	s.reconcileDone = make(chan struct{})
+	go func() {
+		ticker := time.NewTicker(interval)
+		defer ticker.Stop()
+		defer close(s.reconcileDone)
+		for {
+			select {
+			case <-ticker.C:
+				s.reconcileCachedEndpointInfos("periodic-route-reconcile")
+			case <-s.reconcileStop:
+				return
+			}
+		}
+	}()
+}
+
+func (s *huaweiCloudSubENISubscriber) stopRouteReconciler() {
+	if s.reconcileStop == nil {
+		return
+	}
+	s.stopOnce.Do(func() { close(s.reconcileStop) })
+	<-s.reconcileDone
+}
+
+func endpointInfoCacheKey(id uint32, ipv4 string) string {
+	return fmt.Sprintf("%d/%s", id, ipv4)
+}
+
+func (s *huaweiCloudSubENISubscriber) cacheEndpointInfo(info subenimap.EndpointInfo) {
+	if info == nil {
+		return
+	}
+	s.cacheMutex.Lock()
+	if s.cache == nil {
+		s.cache = map[string]subenimap.EndpointInfo{}
+	}
+	s.cache[endpointInfoCacheKey(info.GetID(), info.GetIPv4Address())] = info
+	s.cacheMutex.Unlock()
+}
+
+func (s *huaweiCloudSubENISubscriber) cachedEndpointInfo(ep *endpoint.Endpoint) subenimap.EndpointInfo {
+	if ep == nil {
+		return nil
+	}
+	s.cacheMutex.RLock()
+	info := s.cache[endpointInfoCacheKey(uint32(ep.GetID()), ep.GetIPv4Address())] //nolint:gosec // endpoint IDs are validated before caching
+	s.cacheMutex.RUnlock()
+	return info
+}
+
+func (s *huaweiCloudSubENISubscriber) forgetEndpointInfo(ep *endpoint.Endpoint) {
+	if ep == nil {
+		return
+	}
+	s.cacheMutex.Lock()
+	delete(s.cache, endpointInfoCacheKey(uint32(ep.GetID()), ep.GetIPv4Address())) //nolint:gosec // endpoint IDs are validated before caching
+	s.cacheMutex.Unlock()
+}
+
+func endpointCanResolveSubENI(ep subENIEndpoint) bool {
+	if ep == nil {
+		return false
+	}
+	v := reflect.ValueOf(ep)
+	if v.Kind() == reflect.Ptr && v.IsNil() {
+		return false
+	}
+	return ep.GetIfIndex() != 0 && ep.GetID() != 0 && ep.GetIPv4Address() != ""
+}
+
+func (s *huaweiCloudSubENISubscriber) getLocalCiliumNode() (*ciliumv2.CiliumNode, error) {
+	if s.getCiliumNode == nil {
+		return nil, errors.New("CiliumNode getter is not configured")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), huaweiCloudCiliumNodeGetTimeout)
+	defer cancel()
+	cn, err := s.getCiliumNode(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("get CiliumNode %s: %w", nodeTypes.GetName(), err)
+	}
+	if cn == nil {
+		return nil, fmt.Errorf("get CiliumNode %s: returned nil without an error", nodeTypes.GetName())
+	}
+	return cn, nil
+}
+
+func (s *huaweiCloudSubENISubscriber) resolveInitialEndpointInfos(endpoints []subENIEndpoint) ([]*huaweiCloudEndpointInfo, error) {
+	var (
+		cn     *ciliumv2.CiliumNode
+		result []*huaweiCloudEndpointInfo
+	)
+	for _, ep := range endpoints {
+		if !endpointCanResolveSubENI(ep) {
+			continue
+		}
+		if cn == nil {
+			var err error
+			cn, err = s.getLocalCiliumNode()
+			if err != nil {
+				return nil, fmt.Errorf("resolve initial HuaweiCloud endpoints: %w", err)
+			}
+		}
+		info, err := subENIInfoForEndpoint(cn, ep)
+		if err != nil {
+			return nil, fmt.Errorf("resolve initial HuaweiCloud endpoint %d: %w", ep.GetID(), err)
+		}
+		if info != nil {
+			result = append(result, info)
+		}
+	}
+	return result, nil
+}
+
+func (s *huaweiCloudSubENISubscriber) resolveEndpointInfo(ep *endpoint.Endpoint) (*huaweiCloudEndpointInfo, error) {
+	if !endpointCanResolveSubENI(ep) {
+		return nil, nil
+	}
+
+	cn, err := s.getLocalCiliumNode()
+	if err != nil {
+		return nil, err
+	}
+
+	return subENIInfoForEndpoint(cn, ep)
+}
+
+func subENIInfoForEndpoint(cn *ciliumv2.CiliumNode, ep subENIEndpoint) (*huaweiCloudEndpointInfo, error) {
+	if cn == nil || cn.Status.HuaweiCloud == nil || ep == nil {
+		return nil, nil
+	}
+	if ep.GetID() == 0 || ep.GetID() > uint64(^uint16(0)) {
+		return nil, fmt.Errorf("HuaweiCloud endpoint ID %d is outside 1-65535", ep.GetID())
+	}
+	if ep.GetIfIndex() <= 0 {
+		return nil, fmt.Errorf("HuaweiCloud endpoint ifindex %d must be positive", ep.GetIfIndex())
+	}
+
+	ipv4 := ep.GetIPv4Address()
+	var matched *huaweiCloudEndpointInfo
+	for _, subENI := range cn.Status.HuaweiCloud.SubENIs {
+		if subENI.PrivateIPAddress != ipv4 {
+			continue
+		}
+
+		parsedMAC, err := net.ParseMAC(subENI.MACAddress)
+		if err != nil {
+			return nil, fmt.Errorf("parse HuaweiCloud SubENI MAC %q for %s: %w", subENI.MACAddress, ipv4, err)
+		}
+		if len(parsedMAC) != 6 || parsedMAC[0]&1 != 0 {
+			return nil, fmt.Errorf("HuaweiCloud SubENI MAC %q for %s must be a 6-byte unicast address", subENI.MACAddress, ipv4)
+		}
+		var macArr [6]byte
+		copy(macArr[:], parsedMAC)
+
+		gatewayMAC, err := parseOptionalMAC(subENI.GatewayMAC)
+		if err != nil {
+			return nil, fmt.Errorf("parse HuaweiCloud gateway MAC %q for %s: %w", subENI.GatewayMAC, ipv4, err)
+		}
+		gatewayIP, err := parseOptionalIPv4(subENI.GatewayIP)
+		if err != nil {
+			return nil, fmt.Errorf("parse HuaweiCloud gateway IP %q for %s: %w", subENI.GatewayIP, ipv4, err)
+		}
+		if (gatewayIP == nil) != (len(gatewayMAC) == 0) {
+			return nil, fmt.Errorf("HuaweiCloud gateway IP and MAC must be configured together for %s", ipv4)
+		}
+		if gatewayIP != nil && subENI.TrunkInterface == "" {
+			return nil, fmt.Errorf("HuaweiCloud trunk interface is required with gateway metadata for %s", ipv4)
+		}
+
+		if matched != nil {
+			return nil, fmt.Errorf("multiple HuaweiCloud SubENIs match endpoint IPv4 %s", ipv4)
+		}
+		matched = &huaweiCloudEndpointInfo{
+			ipv4:           ipv4,
+			id:             uint32(ep.GetID()),
+			ifIndex:        uint32(ep.GetIfIndex()),
+			mac:            macArr,
+			vlanID:         subENI.VlanID,
+			gatewayIP:      gatewayIP,
+			gatewayMAC:     gatewayMAC,
+			trunkInterface: subENI.TrunkInterface,
+		}
+	}
+
+	return matched, nil
+}
+
+func parseOptionalMAC(raw string) (net.HardwareAddr, error) {
+	if raw == "" {
+		return nil, nil
+	}
+	return net.ParseMAC(raw)
+}
+
+func parseOptionalIPv4(raw string) (net.IP, error) {
+	if raw == "" {
+		return nil, nil
+	}
+	ip := net.ParseIP(raw).To4()
+	if ip == nil {
+		return nil, fmt.Errorf("invalid IPv4 address")
+	}
+	return ip, nil
+}
+
+func (s *huaweiCloudSubENISubscriber) ensureGatewayNeighbor(info *huaweiCloudEndpointInfo) error {
+	if info == nil || info.gatewayIP == nil || len(info.gatewayMAC) == 0 || info.trunkInterface == "" {
+		return nil
+	}
+
+	link, err := netlink.LinkByName(info.trunkInterface)
+	if err != nil {
+		return fmt.Errorf("resolve trunk interface %s: %w", info.trunkInterface, err)
+	}
+
+	s.neighborMutex.Lock()
+	defer s.neighborMutex.Unlock()
+
+	neighbors, err := netlink.NeighList(link.Attrs().Index, netlink.FAMILY_V4)
+	if err != nil {
+		return fmt.Errorf("list neighbors on trunk interface %s: %w", info.trunkInterface, err)
+	}
+	for _, neighbor := range neighbors {
+		if neighbor.State&netlink.NUD_PERMANENT == 0 || !neighbor.IP.Equal(info.gatewayIP) {
+			continue
+		}
+		if !bytes.Equal(neighbor.HardwareAddr, info.gatewayMAC) {
+			return fmt.Errorf("permanent neighbor %s on trunk interface %s already uses MAC %s, conflicts with %s",
+				info.gatewayIP, info.trunkInterface, neighbor.HardwareAddr, info.gatewayMAC)
+		}
+		return nil
+	}
+
+	return netlink.NeighSet(&netlink.Neigh{
+		LinkIndex:    link.Attrs().Index,
+		Family:       netlink.FAMILY_V4,
+		State:        netlink.NUD_PERMANENT,
+		IP:           info.gatewayIP,
+		HardwareAddr: info.gatewayMAC,
+	})
+}
