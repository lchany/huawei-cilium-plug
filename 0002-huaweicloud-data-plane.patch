diff --git a/bpf/lib/huaweicloud.h b/bpf/lib/huaweicloud.h
new file mode 100644
index 000000000..b060344de
--- /dev/null
+++ b/bpf/lib/huaweicloud.h
@@ -0,0 +1,222 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/* Copyright Authors of Cilium */
+
+#pragma once
+
+#ifdef ENABLE_HUAWEICLOUD_VLAN
+
+#include <linux/ip.h>
+
+#include "common.h"
+#include "eth.h"
+#include "drop.h"
+
+struct hwc_srcip_key4 {
+	__u32 addr;
+};
+
+struct hwc_srcip_key6 {
+	__u8 addr[16];
+};
+
+struct hwc_subeni_info {
+	__u16 vlan_id;
+	__u8 mac[6];
+	__u16 pad;
+	__u16 reserved;
+	__u32 lxc_id;
+};
+
+struct {
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__type(key, struct hwc_srcip_key4);
+	__type(value, struct hwc_subeni_info);
+	__uint(max_entries, 65536);
+	__uint(pinning, LIBBPF_PIN_BY_NAME);
+} cilium_hwc_srcip4 __section_maps_btf;
+
+struct {
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__type(key, struct hwc_srcip_key6);
+	__type(value, struct hwc_subeni_info);
+	__uint(max_entries, 65536);
+	__uint(pinning, LIBBPF_PIN_BY_NAME);
+} cilium_hwc_srcip6 __section_maps_btf;
+
+struct hwc_vlan_mac_key {
+	__u16 vlan_id;
+	__u8 mac[6];
+};
+
+struct hwc_ep_info {
+	__u32 ifindex;
+	__u16 lxc_id;
+	__u16 flags;
+};
+
+struct hwc_vlan_hdr {
+	__be16 tci;
+	__be16 encapsulated_proto;
+};
+
+struct {
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__type(key, struct hwc_vlan_mac_key);
+	__type(value, struct hwc_ep_info);
+	__uint(max_entries, 65536);
+	__uint(pinning, LIBBPF_PIN_BY_NAME);
+} cilium_hwc_vlan_mac __section_maps_btf;
+
+static __always_inline __u16 hwc_vlan_id(__u16 tci)
+{
+	return tci & 0x0fff;
+}
+
+static __always_inline bool hwc_ethernet_header_complete(__u32 packet_len)
+{
+	return packet_len >= sizeof(struct ethhdr);
+}
+
+static __always_inline bool hwc_vlan_header_complete(__u32 packet_len)
+{
+	return packet_len >= sizeof(struct ethhdr) + sizeof(struct hwc_vlan_hdr);
+}
+
+static __always_inline bool hwc_vlan_id_valid(__u16 vlan_id)
+{
+	return vlan_id >= 1 && vlan_id <= 4094;
+}
+
+static __always_inline bool
+hwc_vlan_representations_match(__u16 inline_tci, __u16 metadata_tci)
+{
+	return hwc_vlan_id(inline_tci) == hwc_vlan_id(metadata_tci);
+}
+
+static __always_inline int
+hwc_vlan_pop_count(bool inline_vlan, bool metadata_vlan)
+{
+	return inline_vlan && metadata_vlan ? 2 : 1;
+}
+
+static __always_inline int hwc_vlan_map_miss_action(bool inline_vlan)
+{
+	/* An inline VLAN has already bypassed the kernel's metadata VLAN path.
+	 * It must not continue as apparently untagged traffic after an HWC map
+	 * miss. A metadata-only miss is intentionally left for the generic VLAN
+	 * allow/drop logic in bpf_host.c.
+	 */
+	return inline_vlan ? DROP_INVALID : CTX_ACT_OK;
+}
+
+static __always_inline int
+hwc_to_netdev(struct __ctx_buff *ctx, __be16 proto)
+{
+	struct hwc_subeni_info *info;
+	__u32 src_ip4 = 0;
+	struct hwc_srcip_key4 key = {};
+
+	if (ctx->ifindex != HWC_TRUNK_IFINDEX)
+		return CTX_ACT_OK;
+	if (proto != bpf_htons(ETH_P_IP))
+		return CTX_ACT_OK;
+
+	if (ctx_load_bytes(ctx, ETH_HLEN + offsetof(struct iphdr, saddr),
+			   &src_ip4, sizeof(src_ip4)) < 0)
+		return CTX_ACT_OK;
+
+	key.addr = src_ip4;
+	info = map_lookup_elem(&cilium_hwc_srcip4, &key);
+	if (!info)
+		return CTX_ACT_OK;
+
+	if (eth_store_saddr(ctx, info->mac, 0) < 0)
+		return DROP_HWC_MAC_REWRITE_FAIL;
+
+	if (skb_vlan_push(ctx, bpf_htons(ETH_P_8021Q), info->vlan_id) < 0)
+		return DROP_HWC_VLAN_PUSH_FAIL;
+
+	return CTX_ACT_OK;
+}
+
+static __always_inline int
+hwc_from_netdev(struct __ctx_buff *ctx, bool *handled)
+{
+	struct hwc_vlan_mac_key key __align_stack_8 = {};
+	struct hwc_ep_info *ep;
+	void *data, *data_end;
+	struct ethhdr *eth;
+	__u16 vlan_id;
+	__u16 inline_tci = 0;
+	__be16 inner_proto;
+	bool inline_vlan = false;
+	bool metadata_vlan;
+
+	*handled = false;
+	if (ctx->ifindex != HWC_TRUNK_IFINDEX)
+		return CTX_ACT_OK;
+
+	data = (void *)(long)ctx->data;
+	data_end = (void *)(long)ctx->data_end;
+	eth = data;
+	if (!hwc_ethernet_header_complete((__u32)((long)data_end - (long)data)))
+		return DROP_INVALID;
+	if ((void *)(eth + 1) > data_end)
+		return DROP_INVALID;
+
+	/* Prefer an inline VLAN header when both inline and skb metadata
+	 * representations are visible. HuaweiCloud virtio devices may deliver
+	 * either representation, or both at the same time.
+	 */
+	if (eth->h_proto == bpf_htons(ETH_P_8021Q) ||
+	    eth->h_proto == bpf_htons(ETH_P_8021AD)) {
+		struct hwc_vlan_hdr *vlan = (void *)(eth + 1);
+
+		if (!hwc_vlan_header_complete((__u32)((long)data_end - (long)data)))
+			return DROP_INVALID;
+		if ((void *)(vlan + 1) > data_end)
+			return DROP_INVALID;
+		inline_tci = bpf_ntohs(vlan->tci);
+		vlan_id = hwc_vlan_id(inline_tci);
+		inner_proto = vlan->encapsulated_proto;
+		inline_vlan = true;
+	} else if (ctx->vlan_present) {
+		vlan_id = hwc_vlan_id((__u16)ctx->vlan_tci);
+		inner_proto = eth->h_proto;
+	} else {
+		return CTX_ACT_OK;
+	}
+	metadata_vlan = ctx->vlan_present;
+	if (!hwc_vlan_id_valid(vlan_id))
+		return DROP_INVALID;
+	if (inline_vlan && metadata_vlan &&
+	    !hwc_vlan_representations_match(inline_tci, (__u16)ctx->vlan_tci))
+		return DROP_INVALID;
+	if (inner_proto != bpf_htons(ETH_P_IP))
+		return inline_vlan ? DROP_INVALID : CTX_ACT_OK;
+
+	key.vlan_id = vlan_id;
+	key.mac[0] = eth->h_dest[0];
+	key.mac[1] = eth->h_dest[1];
+	key.mac[2] = eth->h_dest[2];
+	key.mac[3] = eth->h_dest[3];
+	key.mac[4] = eth->h_dest[4];
+	key.mac[5] = eth->h_dest[5];
+
+	ep = map_lookup_elem(&cilium_hwc_vlan_mac, &key);
+	if (!ep)
+		return hwc_vlan_map_miss_action(inline_vlan);
+	*handled = true;
+
+	if (hwc_vlan_pop_count(inline_vlan, metadata_vlan) == 2 &&
+	    skb_vlan_pop(ctx) < 0)
+		return DROP_HWC_VLAN_POP_FAIL;
+
+	if (skb_vlan_pop(ctx) < 0)
+		return DROP_HWC_VLAN_POP_FAIL;
+
+	ctx_change_type(ctx, PACKET_HOST);
+	return CTX_ACT_OK;
+}
+
+#endif
