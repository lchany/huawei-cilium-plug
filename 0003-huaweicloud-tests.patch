+func TestEgressRulePriorityAndTableID(t *testing.T) {
+	tests := []struct {
+		name      string
+		ifaceNum  int
+		ifindex   int
+		ipamMode  string
+		compat    bool
+		wantPrio  int
+		wantTable int
+		wantErr   bool
+	}{
+		{
+			name:      "minimum VLAN",
+			ifaceNum:  1,
+			ipamMode:  ipamOption.IPAMHuaweiCloud,
+			wantPrio:  linux_defaults.RulePriorityEgressv2,
+			wantTable: linux_defaults.RouteTableHuaweiCloudInterfacesOffset + 1,
+		},
+		{
+			name:      "VLAN that would collide with main using legacy offset",
+			ifaceNum:  244,
+			ipamMode:  ipamOption.IPAMHuaweiCloud,
+			wantPrio:  linux_defaults.RulePriorityEgressv2,
+			wantTable: linux_defaults.RouteTableHuaweiCloudInterfacesOffset + 244,
+		},
+		{
+			name:      "maximum VLAN in compatibility priority",
+			ifaceNum:  4094,
+			ipamMode:  ipamOption.IPAMHuaweiCloud,
+			compat:    true,
+			wantPrio:  linux_defaults.RulePriorityEgress,
+			wantTable: linux_defaults.RouteTableHuaweiCloudInterfacesOffset + 4094,
+		},
+		{name: "zero VLAN", ifaceNum: 0, ipamMode: ipamOption.IPAMHuaweiCloud, wantErr: true},
+		{name: "VLAN above maximum", ifaceNum: 4095, ipamMode: ipamOption.IPAMHuaweiCloud, wantErr: true},
+		{
+			name:      "ENI compatibility mode remains ifindex based",
+			ifaceNum:  7,
+			ifindex:   42,
+			ipamMode:  ipamOption.IPAMENI,
+			compat:    true,
+			wantPrio:  linux_defaults.RulePriorityEgress,
+			wantTable: 42,
+		},
+		{
+			name:      "ENI v2 mode remains interface number based",
+			ifaceNum:  7,
+			ifindex:   42,
+			ipamMode:  ipamOption.IPAMENI,
+			wantPrio:  linux_defaults.RulePriorityEgressv2,
+			wantTable: linux_defaults.RouteTableInterfacesOffset + 7,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			info := RoutingInfo{InterfaceNumber: tt.ifaceNum, IpamMode: tt.ipamMode}
+			priority, tableID, err := info.egressRulePriorityAndTableID(tt.ifindex, tt.compat)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("egressRulePriorityAndTableID() error = %v, wantErr %t", err, tt.wantErr)
+			}
+			if tt.wantErr {
+				return
+			}
+			if priority != tt.wantPrio || tableID != tt.wantTable {
+				t.Fatalf("got priority/table %d/%d, want %d/%d", priority, tableID, tt.wantPrio, tt.wantTable)
+			}
+		})
+	}
