+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package metadata
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func withMetadataServer(t *testing.T, handler http.HandlerFunc) string {
+	t.Helper()
+	server := httptest.NewServer(handler)
+	t.Cleanup(server.Close)
+	return server.URL
+}
+
+func testInterface(t *testing.T) *net.Interface {
+	t.Helper()
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range interfaces {
+		if len(interfaces[i].HardwareAddr) != 0 {
+			return &interfaces[i]
+		}
+	}
+	t.Fatal("test host has no interface with a hardware address")
+	return nil
+}
+
+func TestOpenStackMetadataRequiredFields(t *testing.T) {
+	tests := []struct {
+		name string
+		body string
+		call func(context.Context) (string, error)
+	}{
+		{name: "empty uuid", body: `{}`, call: GetInstanceID},
+		{name: "empty vpc", body: `{}`, call: GetVPCID},
+		{name: "empty availability zone", body: `{}`, call: GetRegionID},
+		{name: "one character availability zone", body: `{"availability_zone":"a"}`, call: GetRegionID},
+		{name: "invalid availability zone suffix", body: `{"availability_zone":"cn-south-1"}`, call: GetRegionID},
+		{name: "null metadata", body: `null`, call: GetInstanceID},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			oldURL := metadataOpenStackURL
+			metadataOpenStackURL = withMetadataServer(t, func(w http.ResponseWriter, _ *http.Request) {
+				_, _ = w.Write([]byte(tt.body))
+			})
+			t.Cleanup(func() { metadataOpenStackURL = oldURL })
+
+			if _, err := tt.call(context.Background()); err == nil {
+				t.Fatal("expected metadata validation error")
+			}
+		})
+	}
+}
+
+func TestGetRegionID(t *testing.T) {
+	oldURL := metadataOpenStackURL
+	metadataOpenStackURL = withMetadataServer(t, func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(`{"availability_zone":"cn-south-1f","unknown":"ignored"}`))
+	})
+	t.Cleanup(func() { metadataOpenStackURL = oldURL })
+
+	region, err := GetRegionID(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if region != "cn-south-1" {
+		t.Fatalf("got region %q, want cn-south-1", region)
+	}
+}
+
+func TestGetTrunkInterfaceIDValidation(t *testing.T) {
+	iface := testInterface(t)
+	tests := []struct {
+		name    string
+		body    string
+		want    string
+		wantErr bool
+	}{
+		{name: "empty links", body: `{"links":[]}`, wantErr: true},
+		{name: "later matching link", body: fmt.Sprintf(`{"links":[{"vif_id":"other","ethernet_mac_address":"02:00:00:00:00:01"},{"vif_id":"port-2","ethernet_mac_address":%q}]}`, iface.HardwareAddr), want: "port-2"},
+		{name: "matching link empty", body: fmt.Sprintf(`{"links":[{"vif_id":"","ethernet_mac_address":%q}]}`, iface.HardwareAddr), wantErr: true},
+		{name: "malformed", body: `{`, wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			oldURL := metadataNetworkDataURL
+			metadataNetworkDataURL = withMetadataServer(t, func(w http.ResponseWriter, _ *http.Request) {
+				_, _ = w.Write([]byte(tt.body))
+			})
+			t.Cleanup(func() { metadataNetworkDataURL = oldURL })
+
+			got, err := GetTrunkInterfaceID(context.Background(), iface.Name)
+			if tt.wantErr && err == nil {
+				t.Fatal("expected error")
+			}
+			if !tt.wantErr && err != nil {
+				t.Fatal(err)
+			}
+			if got != tt.want {
+				t.Fatalf("got %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestMetadataHTTPStatuses(t *testing.T) {
+	iface := testInterface(t)
+	for _, status := range []int{http.StatusNoContent, http.StatusMovedPermanently, http.StatusNotFound, http.StatusInternalServerError} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			oldURL := metadataNetworkDataURL
+			metadataNetworkDataURL = withMetadataServer(t, func(w http.ResponseWriter, _ *http.Request) {
+				w.WriteHeader(status)
+			})
+			t.Cleanup(func() { metadataNetworkDataURL = oldURL })
+			if _, err := GetTrunkInterfaceID(context.Background(), iface.Name); err == nil {
+				t.Fatalf("expected status %d to fail", status)
+			}
+		})
+	}
+}
+
+func TestReadMetadataBodyLimit(t *testing.T) {
+	oldLimit := metadataMaxRead
+	metadataMaxRead = 16
+	t.Cleanup(func() { metadataMaxRead = oldLimit })
+
+	if got, err := readMetadataBody(strings.NewReader(strings.Repeat("x", 16))); err != nil || len(got) != 16 {
+		t.Fatalf("exact limit: len=%d err=%v", len(got), err)
+	}
+	if _, err := readMetadataBody(strings.NewReader(strings.Repeat("x", 17))); err == nil {
+		t.Fatal("expected oversized response to fail")
+	}
+}
+
+func TestMetadataCancelledContext(t *testing.T) {
+	iface := testInterface(t)
+	oldURL := metadataNetworkDataURL
+	metadataNetworkDataURL = withMetadataServer(t, func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(`{"links":[{"vif_id":"port-1"}]}`))
+	})
+	t.Cleanup(func() { metadataNetworkDataURL = oldURL })
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := GetTrunkInterfaceID(ctx, iface.Name); err == nil {
+		t.Fatal("expected cancelled context to fail")
+	}
+}
+
+func TestMetadataHTTPTimeout(t *testing.T) {
+	iface := testInterface(t)
+	oldURL := metadataNetworkDataURL
+	oldTimeout := metadataHTTPTimeout
+	metadataHTTPTimeout = 10 * time.Millisecond
+	metadataNetworkDataURL = withMetadataServer(t, func(w http.ResponseWriter, _ *http.Request) {
+		time.Sleep(50 * time.Millisecond)
+		_, _ = w.Write([]byte(`{"links":[]}`))
+	})
+	t.Cleanup(func() {
+		metadataNetworkDataURL = oldURL
+		metadataHTTPTimeout = oldTimeout
+	})
+
+	if _, err := GetTrunkInterfaceID(context.Background(), iface.Name); err == nil {
+		t.Fatal("expected metadata HTTP timeout")
+	}
+}
+
+func TestSelectTrunkInterfaceIDOrderIndependent(t *testing.T) {
+	trunkMAC, err := net.ParseMAC("fa:16:3e:00:00:02")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	makeData := func(reverse bool) networkData {
+		var data networkData
+		data.Links = append(data.Links,
+			struct {
+				VifID              string `json:"vif_id"`
+				EthernetMACAddress string `json:"ethernet_mac_address"`
+			}{VifID: "other-port", EthernetMACAddress: "fa:16:3e:00:00:01"},
+			struct {
+				VifID              string `json:"vif_id"`
+				EthernetMACAddress string `json:"ethernet_mac_address"`
+			}{VifID: "trunk-port", EthernetMACAddress: "FA-16-3E-00-00-02"},
+		)
+		if reverse {
+			data.Links[0], data.Links[1] = data.Links[1], data.Links[0]
+		}
+		return data
+	}
+
+	for _, reverse := range []bool{false, true} {
+		got, err := selectTrunkInterfaceID(makeData(reverse), trunkMAC)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got != "trunk-port" {
+			t.Fatalf("got %q, want trunk-port", got)
+		}
+	}
+}
