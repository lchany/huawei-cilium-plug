+func TestNewClientRejectsEmptyCredentialFields(t *testing.T) {
+	tests := []struct {
+		name      string
+		accessKey string
+		secretKey string
+		projectID string
+		want      string
+	}{
+		{name: "empty access key", secretKey: "sk", projectID: "project", want: "access key"},
+		{name: "blank access key", accessKey: " \t", secretKey: "sk", projectID: "project", want: "access key"},
+		{name: "empty secret key", accessKey: "ak", projectID: "project", want: "secret key"},
+		{name: "blank secret key", accessKey: "ak", secretKey: "\n", projectID: "project", want: "secret key"},
+		{name: "empty project", accessKey: "ak", secretKey: "sk", want: "project ID"},
+		{name: "blank project", accessKey: "ak", secretKey: "sk", projectID: "  ", want: "project ID"},
