+	manager := NewInstancesManager(api, "vpc-1", nil)
+	if manager.Resync(context.Background()).IsZero() {
+		t.Fatal("resync failed")
+	}
+	node := &Node{
+		node:    testNodeID("instance-1"),
+		manager: manager,
+		k8sObj:  &v2.CiliumNode{},
+		subENIs: map[string]eniTypes.SubENI{
+			"eni-a": {ID: "eni-a", PrivateIPAddress: "172.31.1.2"},
+			"eni-b": {ID: "eni-b", PrivateIPAddress: "172.31.1.10"},
+		},
+	}
+
+	for _, excess := range []int{-1, 0, 10} {
+		action := node.PrepareIPRelease(excess, nil)
+		if len(action.IPsToRelease) != 0 {
+			t.Fatalf("unknown used state or excess %d unexpectedly released %v", excess, action.IPsToRelease)
+		}
+	}
+	node.k8sObj.Status.IPAM.Used = ipamTypes.AllocationMap{}
+	for _, excess := range []int{-1, 0} {
+		if got := node.PrepareIPRelease(excess, nil).IPsToRelease; len(got) != 0 {
+			t.Fatalf("excess %d unexpectedly released %v", excess, got)
+		}
+	}
+	if got := node.PrepareIPRelease(10, nil).IPsToRelease; len(got) != 2 || got[0] != "172.31.1.10" || got[1] != "172.31.1.2" {
+		t.Fatalf("unexpected stable all-free candidates: %v", got)
+	}
+
+	// A candidate that becomes used after Prepare must not be deleted. Unknown
+	// and duplicate release entries must not affect the valid remaining item.
+	node.k8sObj.Status.IPAM.Used["172.31.1.2"] = ipamTypes.AllocationIP{}
+	err := node.ReleaseIPs(context.Background(), &ipam.ReleaseAction{IPsToRelease: []string{
+		"unknown", "172.31.1.2", "172.31.1.10", "172.31.1.10",
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := api.GetSubNetworkInterface(context.Background(), "eni-a"); err != nil {
+		t.Fatalf("newly used SubENI was deleted: %v", err)
+	}
+	if _, err := api.GetSubNetworkInterface(context.Background(), "eni-b"); err == nil {
+		t.Fatal("free SubENI was not deleted")
+	}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := node.ReleaseIPs(ctx, &ipam.ReleaseAction{IPsToRelease: []string{"172.31.1.2"}}); err == nil {
+		t.Fatal("cancelled release context was ignored")
+	}
+}
