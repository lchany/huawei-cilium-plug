+func TestCloseConcurrentWithReadyAndDelete(t *testing.T) {
+	manager := newWithBackends(logging.DefaultLogger.WithField("test", t.Name()),
+		&testMap{entries: map[string]bpf.MapValue{}}, &testMap{entries: map[string]bpf.MapValue{}})
+	var wg sync.WaitGroup
+	for i := 0; i < 20; i++ {
+		wg.Add(2)
+		go func() { defer wg.Done(); _ = manager.OnEndpointReady(validEndpoint()) }()
+		go func() { defer wg.Done(); _ = manager.OnEndpointDelete(validEndpoint()) }()
+	}
+	manager.Close()
+	wg.Wait()
+	if err := manager.OnEndpointReady(validEndpoint()); err == nil {
