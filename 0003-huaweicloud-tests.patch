+func TestApplyHuaweiCloudIPAMNetConf(t *testing.T) {
+	dst := &ipamTypes.IPAMSpec{MinAllocate: 2, PreAllocate: 1}
+	applyHuaweiCloudIPAMNetConf(dst, ipamTypes.IPAMSpec{MinAllocate: 10, PreAllocate: 4})
+	if dst.MinAllocate != 10 || dst.PreAllocate != 4 {
+		t.Fatalf("CNI IPAM watermarks were not applied: %+v", dst)
+	}
+
+	applyHuaweiCloudIPAMNetConf(dst, ipamTypes.IPAMSpec{})
+	if dst.MinAllocate != 10 || dst.PreAllocate != 4 {
+		t.Fatalf("empty CNI IPAM watermarks overwrote existing values: %+v", dst)
+	}
+
+	applyHuaweiCloudIPAMNetConf(nil, ipamTypes.IPAMSpec{MinAllocate: 20, PreAllocate: 8})
+}
+
+func TestApplyHuaweiCloudNetConf(t *testing.T) {
+	dst := &huaweiCloudTypes.Spec{
+		Subnets:        []string{"subnet-from-agent"},
+		SecurityGroups: []string{"sg-from-agent"},
+	}
+	src := huaweiCloudTypes.Spec{
+		Subnets:           []string{"subnet-from-cni"},
+		SubnetTags:        map[string]string{"network-role": "pod"},
+		SecurityGroups:    []string{"sg-from-cni"},
+		SecurityGroupTags: map[string]string{"security-role": "pod"},
+	}
+
+	applyHuaweiCloudNetConf(dst, src)
+
+	if !reflect.DeepEqual(dst.Subnets, src.Subnets) {
+		t.Fatalf("CNI subnet IDs were not applied: %v", dst.Subnets)
+	}
+	if !reflect.DeepEqual(dst.SubnetTags, src.SubnetTags) {
+		t.Fatalf("CNI subnet tags were not applied: %v", dst.SubnetTags)
+	}
+	if !reflect.DeepEqual(dst.SecurityGroups, src.SecurityGroups) {
+		t.Fatalf("CNI security groups were not applied: %v", dst.SecurityGroups)
+	}
+	if !reflect.DeepEqual(dst.SecurityGroupTags, src.SecurityGroupTags) {
+		t.Fatalf("CNI security group tags were not applied: %v", dst.SecurityGroupTags)
+	}
+
+	src.Subnets[0] = "mutated"
+	src.SecurityGroups[0] = "mutated"
+	src.SubnetTags["network-role"] = "mutated"
+	src.SecurityGroupTags["security-role"] = "mutated"
+	if reflect.DeepEqual(dst.Subnets, src.Subnets) || reflect.DeepEqual(dst.SecurityGroups, src.SecurityGroups) ||
+		reflect.DeepEqual(dst.SubnetTags, src.SubnetTags) || reflect.DeepEqual(dst.SecurityGroupTags, src.SecurityGroupTags) {
+		t.Fatalf("applied HuaweiCloud configuration retained caller-owned references: %+v", dst)
+	}
+	before := *dst.DeepCopy()
+	applyHuaweiCloudNetConf(dst, huaweiCloudTypes.Spec{})
+	if !reflect.DeepEqual(*dst, before) {
+		t.Fatalf("empty CNI HuaweiCloud configuration overwrote existing values: before=%+v after=%+v", before, *dst)
+	}
+}
