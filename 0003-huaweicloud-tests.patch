+			if tt.mutate != nil {
+				tt.mutate(&subENI)
+			}
+			_, err := subENIInfoForEndpoint(testCiliumNode(map[string]eniTypes.SubENI{"eni": subENI}), tt.ep)
+			if err == nil || !strings.Contains(err.Error(), tt.want) {
