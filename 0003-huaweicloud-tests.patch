+
+func TestRouteReconcilerDoesNotResurrectDeletedEndpoint(t *testing.T) {
+	mapMgr := &fakeSubENIMapUpdater{}
+	subscriber := &huaweiCloudSubENISubscriber{
+		logger:      logging.DefaultLogger.WithField("test", t.Name()),
+		mapMgr:      mapMgr,
+		initialized: true,
+		cache:       map[string]subenimap.EndpointInfo{},
+	}
+	ep := &endpoint.Endpoint{
+		ID:   9,
+		IPv4: addressing.DeriveCiliumIPv4(net.ParseIP("10.0.0.9")),
+	}
+	info := &huaweiCloudEndpointInfo{id: 9, ipv4: "10.0.0.9"}
+	subscriber.upsertEndpointInfo(info, 9, info.ipv4, "initial")
+	subscriber.startRouteReconciler(time.Millisecond)
+	time.Sleep(10 * time.Millisecond)
+	subscriber.EndpointDeleted(ep, endpoint.DeleteConfig{})
+
+	subscriber.endpointMutex.Lock()
+	readyAfterDelete := len(mapMgr.ready)
+	subscriber.endpointMutex.Unlock()
+	time.Sleep(10 * time.Millisecond)
+	subscriber.stopRouteReconciler()
