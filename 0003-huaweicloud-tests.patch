+++ b/test/hwc-real-e2e/netprobe.go
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+// netprobe is a small, static workload used for Huawei Cilium datapath tests.
+package main
+
+import (
+	"context"
+	"fmt"
+	"log"
+	"net"
+	"net/http"
+	"os"
+	"time"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		log.Fatal("usage: netprobe <server|probe|tcp|dns|dns-server|wait> [host:port]")
+	}
+
+	switch os.Args[1] {
+	case "server":
+		http.HandleFunc("/health", func(w http.ResponseWriter, _ *http.Request) {
+			_, _ = w.Write([]byte("ok\n"))
+		})
+		log.Fatal(http.ListenAndServe(":8080", nil))
+	case "probe":
+		if len(os.Args) != 3 {
+			log.Fatal("usage: netprobe probe <host:port>")
+		}
+		client := http.Client{Timeout: 5 * time.Second}
+		response, err := client.Get("http://" + os.Args[2] + "/health")
+		if err != nil {
+			log.Fatal(err)
+		}
+		defer response.Body.Close()
+		if response.StatusCode != http.StatusOK {
+			log.Fatalf("unexpected HTTP status: %s", response.Status)
+		}
+		fmt.Println("ok")
+	case "tcp":
+		if len(os.Args) != 3 {
+			log.Fatal("usage: netprobe tcp <host:port>")
+		}
+		connection, err := net.DialTimeout("tcp", os.Args[2], 5*time.Second)
+		if err != nil {
+			log.Fatal(err)
+		}
+		defer connection.Close()
+		fmt.Println("ok")
+	case "dns":
+		if len(os.Args) != 3 {
+			log.Fatal("usage: netprobe dns <name>")
+		}
+		addresses, err := net.LookupHost(os.Args[2])
+		if err != nil {
+			log.Fatal(err)
+		}
+		if len(addresses) == 0 {
+			log.Fatal("DNS response contained no addresses")
+		}
+		fmt.Println(addresses[0])
+	case "dns-server":
+		if len(os.Args) != 4 {
+			log.Fatal("usage: netprobe dns-server <name> <server:port>")
+		}
+		resolver := &net.Resolver{
+			PreferGo: true,
+			Dial: func(ctx context.Context, network, _ string) (net.Conn, error) {
+				dialer := net.Dialer{Timeout: 5 * time.Second}
+				return dialer.DialContext(ctx, network, os.Args[3])
+			},
+		}
+		addresses, err := resolver.LookupHost(context.Background(), os.Args[2])
+		if err != nil {
+			log.Fatal(err)
+		}
+		if len(addresses) == 0 {
+			log.Fatal("DNS response contained no addresses")
+		}
+		fmt.Println(addresses[0])
+	case "wait":
+		for {
+			time.Sleep(time.Hour)
+		}
+	default:
+		log.Fatalf("unknown mode %q", os.Args[1])
+	}
+}
