+	if err := manager.OnEndpointReady(first); err != nil {
+		t.Fatal(err)
+	}
+	conflicting := first
+	conflicting.id = 2
+	conflicting.ifindex = 22
+	conflicting.vlan = 202
+	conflicting.mac = [6]byte{2, 20, 21, 22, 23, 24}
+	if err := manager.Reconcile([]EndpointInfo{first, conflicting}); err == nil {
+		t.Fatal("conflicting desired source owners were accepted")
+	}
+	if got := src.entries[(&SrcIPKey4{Addr: [4]byte{10, 0, 0, 2}}).String()]; !reflect.DeepEqual(got, &SubENIInfo{VlanID: 1, MAC: first.mac, LxcID: first.id}) {
+		t.Fatalf("validation failure mutated source map: %#v", got)
+	}
+}
