+type batchResultAPI struct {
+	*mock.API
+	result []*eniTypes.SubENI
+}
+
+type blockingBatchAPI struct {
+	*mock.API
+	started chan hwAPI.CreateSubENIRequest
+	proceed chan struct{}
+}
+
+type recordingBatchAPI struct {
+	*mock.API
+	mutex    sync.Mutex
+	requests []hwAPI.CreateSubENIRequest
+}
+
+type releaseControlAPI struct {
+	*mock.API
+	deleteCount int
+	failAt      int
+	notFoundAt  int
+	cancelAt    int
+	cancel      context.CancelFunc
+}
+
+type limitResultAPI struct {
+	*mock.API
+	limits ipamTypes.Limits
+	err    error
+}
+
+func (a *limitResultAPI) GetInstanceLimits(context.Context, string) (ipamTypes.Limits, error) {
+	return a.limits, a.err
+}
+
+var errInjectedDelete = errors.New("injected delete failure")
+
+func (a *releaseControlAPI) DeleteSubNetworkInterface(ctx context.Context, subENIID string) error {
+	a.deleteCount++
+	if a.cancelAt == a.deleteCount {
+		a.cancel()
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if a.failAt == a.deleteCount {
+		return errInjectedDelete
+	}
+	if a.notFoundAt == a.deleteCount {
+		_ = a.API.DeleteSubNetworkInterface(ctx, subENIID)
+		return fmt.Errorf("%w: injected already absent SubENI", hwAPI.ErrNotFound)
+	}
+	return a.API.DeleteSubNetworkInterface(ctx, subENIID)
+}
+
+func (a *batchResultAPI) BatchCreateSubNetworkInterfaces(_ context.Context, _ int, _ hwAPI.CreateSubENIRequest) ([]*eniTypes.SubENI, error) {
+	return a.result, nil
+}
+
+func (a *blockingBatchAPI) BatchCreateSubNetworkInterfaces(_ context.Context, _ int, req hwAPI.CreateSubENIRequest) ([]*eniTypes.SubENI, error) {
+	a.started <- req
+	<-a.proceed
+	return []*eniTypes.SubENI{{ID: "eni-created", PrivateIPAddress: "172.31.1.2"}}, nil
+}
+
+func (a *recordingBatchAPI) BatchCreateSubNetworkInterfaces(_ context.Context, _ int, req hwAPI.CreateSubENIRequest) ([]*eniTypes.SubENI, error) {
+	a.mutex.Lock()
+	defer a.mutex.Unlock()
+	a.requests = append(a.requests, req)
+	n := len(a.requests)
+	return []*eniTypes.SubENI{{ID: fmt.Sprintf("eni-%d", n), PrivateIPAddress: fmt.Sprintf("172.31.1.%d", n+1)}}, nil
+}
