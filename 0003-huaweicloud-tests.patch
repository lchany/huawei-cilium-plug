+func TestReconcileCachedEndpointInfosRestoresRoutingAndNeighbor(t *testing.T) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	originalNS, err := netns.Get()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer originalNS.Close()
+	testNS, err := netns.New()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := netns.Set(originalNS); err != nil {
+			t.Error(err)
+		}
+		testNS.Close()
+	}()
+
+	attrs := netlink.NewLinkAttrs()
+	attrs.Name = "hwc-rt63"
+	attrs.HardwareAddr, _ = net.ParseMAC("02:00:00:00:63:01")
+	link := &netlink.Dummy{LinkAttrs: attrs}
+	if err := netlink.LinkAdd(link); err != nil {
+		t.Fatal(err)
+	}
+	if err := netlink.LinkSetUp(link); err != nil {
+		t.Fatal(err)
+	}
+
+	gateway := net.ParseIP("10.63.0.1").To4()
+	gatewayMAC, _ := net.ParseMAC("02:00:00:00:63:fe")
+	info := &huaweiCloudEndpointInfo{
+		ipv4: "10.63.0.2", id: 63, ifIndex: 7,
+		mac: [6]byte{0x02, 0, 0, 0, 0x63, 0x02}, vlanID: 3063,
+		gatewayIP: gateway, gatewayMAC: gatewayMAC, trunkInterface: attrs.Name,
+	}
+	mapMgr := &fakeSubENIMapUpdater{}
+	routerIP := net.ParseIP("10.63.0.3").To4()
+	routerVLAN := 3064
+	routerInfo, err := linuxrouting.NewRoutingInfo(
+		gateway.String(), []string{"10.63.0.0/24"}, attrs.HardwareAddr.String(),
+		fmt.Sprint(routerVLAN), ipamOption.IPAMHuaweiCloud, false,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	subscriber := &huaweiCloudSubENISubscriber{
+		logger: logging.DefaultLogger.WithField("test", t.Name()),
+		mapMgr: mapMgr,
+		cache:  map[string]subenimap.EndpointInfo{},
+		routerRouting: func() (*linuxrouting.RoutingInfo, net.IP) {
+			return routerInfo, routerIP
+		},
+	}
+	subscriber.upsertEndpointInfo(info, uint64(info.id), info.ipv4, "initial")
+	if err := routerInfo.Configure(routerIP, 1500, false, true); err != nil {
+		t.Fatal(err)
+	}
+
+	table := linux_defaults.RouteTableHuaweiCloudInterfacesOffset + int(info.vlanID)
+	routerTable := linux_defaults.RouteTableHuaweiCloudInterfacesOffset + routerVLAN
+	assertState := func(want bool) {
+		t.Helper()
+		routes, err := netlink.RouteListFiltered(netlink.FAMILY_V4,
+			&netlink.Route{Table: table}, netlink.RT_FILTER_TABLE)
+		if err != nil {
+			t.Fatal(err)
+		}
+		neighbors, err := netlink.NeighList(link.Attrs().Index, netlink.FAMILY_V4)
+		if err != nil {
+			t.Fatal(err)
+		}
+		hasNeighbor := false
+		for i := range neighbors {
+			if neighbors[i].IP.Equal(gateway) && bytes.Equal(neighbors[i].HardwareAddr, gatewayMAC) &&
+				neighbors[i].State&netlink.NUD_PERMANENT != 0 {
+				hasNeighbor = true
+			}
+		}
+		rules, err := netlink.RuleList(netlink.FAMILY_V4)
+		if err != nil {
+			t.Fatal(err)
+		}
+		hasRule := false
+		for i := range rules {
+			if rules[i].Priority == linux_defaults.RulePriorityEgressv2 && rules[i].Table == table &&
+				rules[i].Src != nil && rules[i].Src.IP.Equal(net.ParseIP(info.ipv4)) {
+				hasRule = true
+			}
+		}
+		if want && (len(routes) != 2 || !hasNeighbor || !hasRule) {
+			t.Fatalf("routing state not restored: routes=%v neighbor=%v rule=%v", routes, hasNeighbor, hasRule)
+		}
+		if !want && (len(routes) != 0 || hasNeighbor || hasRule) {
+			t.Fatalf("routing state not removed: routes=%v neighbor=%v rule=%v", routes, hasNeighbor, hasRule)
+		}
+		routerRoutes, err := netlink.RouteListFiltered(netlink.FAMILY_V4,
+			&netlink.Route{Table: routerTable}, netlink.RT_FILTER_TABLE)
+		if err != nil {
+			t.Fatal(err)
+		}
+		hasRouterRule := false
+		for i := range rules {
+			if rules[i].Priority == linux_defaults.RulePriorityEgressv2 && rules[i].Table == routerTable &&
+				rules[i].Src != nil && rules[i].Src.IP.Equal(routerIP) {
+				hasRouterRule = true
+			}
+		}
+		if want && (len(routerRoutes) != 2 || !hasRouterRule) {
+			t.Fatalf("router routing state not restored: routes=%v rule=%v", routerRoutes, hasRouterRule)
+		}
+		if !want && (len(routerRoutes) != 0 || hasRouterRule) {
+			t.Fatalf("router routing state not removed: routes=%v rule=%v", routerRoutes, hasRouterRule)
+		}
+	}
+	assertState(true)
+
+	routes, err := netlink.RouteListFiltered(netlink.FAMILY_V4,
+		&netlink.Route{Table: table}, netlink.RT_FILTER_TABLE)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range routes {
+		if err := netlink.RouteDel(&routes[i]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	routerRoutes, err := netlink.RouteListFiltered(netlink.FAMILY_V4,
+		&netlink.Route{Table: routerTable}, netlink.RT_FILTER_TABLE)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range routerRoutes {
+		if err := netlink.RouteDel(&routerRoutes[i]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	rules, err := netlink.RuleList(netlink.FAMILY_V4)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range rules {
+		if rules[i].Priority == linux_defaults.RulePriorityEgressv2 &&
+			((rules[i].Table == table && rules[i].Src != nil && rules[i].Src.IP.Equal(net.ParseIP(info.ipv4))) ||
+				(rules[i].Table == routerTable && rules[i].Src != nil && rules[i].Src.IP.Equal(routerIP))) {
+			if err := netlink.RuleDel(&rules[i]); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	if err := netlink.NeighDel(&netlink.Neigh{
+		LinkIndex: link.Attrs().Index, Family: netlink.FAMILY_V4,
+		IP: gateway, HardwareAddr: gatewayMAC,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	assertState(false)
+
+	if err := netlink.LinkSetDown(link); err != nil {
+		t.Fatal(err)
+	}
+	subscriber.reconcileCachedEndpointInfos("test-route-drift-while-down")
+	if refreshed, err := netlink.LinkByName(attrs.Name); err != nil || refreshed.Attrs().Flags&net.FlagUp != 0 {
+		t.Fatalf("reconciliation changed down link state: link=%v err=%v", refreshed, err)
+	}
+	_ = netlink.NeighDel(&netlink.Neigh{
+		LinkIndex: link.Attrs().Index, Family: netlink.FAMILY_V4,
+		IP: gateway, HardwareAddr: gatewayMAC,
+	})
+	assertState(false)
+	if err := netlink.LinkSetUp(link); err != nil {
+		t.Fatal(err)
+	}
+	subscriber.reconcileCachedEndpointInfos("test-route-drift")
+	assertState(true)
+	if len(mapMgr.ready) != 1 {
+		t.Fatalf("route reconciliation unexpectedly rewrote maps: calls=%d, want 1", len(mapMgr.ready))
+	}
+}
