+func TestHuaweiCloudMapDefinitionsMatchDatapathABI(t *testing.T) {
+	tests := []struct {
+		name       string
+		m          *bpf.Map
+		keySize    uint32
+		valueSize  uint32
+		maxEntries uint32
+	}{
+		{srcIPMapName, newSrcIPMap(), 4, 16, maxEntries},
+		{vlanMACMapName, newVLANMACMap(), 8, 8, maxEntries},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.m.MapType != bpf.MapTypeHash || tt.m.KeySize != tt.keySize ||
+				tt.m.ValueSize != tt.valueSize || tt.m.MaxEntries != tt.maxEntries {
+				t.Fatalf("unexpected map ABI: type=%v key=%d value=%d max=%d",
+					tt.m.MapType, tt.m.KeySize, tt.m.ValueSize, tt.m.MaxEntries)
+			}
+		})
+	}
+}
+
+type testMap struct {
+	entries      map[string]bpf.MapValue
+	keys         map[string]bpf.MapKey
+	lookupErr    error
+	updateErr    error
+	deleteErr    error
+	dumpErr      error
+	updateCalls  int
+	failUpdateAt int
+	mutex        sync.Mutex
+}
+
+func (m *testMap) Lookup(key bpf.MapKey) (bpf.MapValue, error) {
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+	if m.lookupErr != nil {
+		return nil, m.lookupErr
+	}
+	value, ok := m.entries[key.String()]
+	if !ok {
+		return nil, unix.ENOENT
+	}
+	return value, nil
+}
+
+func (m *testMap) Update(key bpf.MapKey, value bpf.MapValue) error {
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+	m.updateCalls++
+	if m.failUpdateAt != 0 && m.updateCalls == m.failUpdateAt {
+		return errors.New("injected update failure")
+	}
+	if m.updateErr != nil {
+		return m.updateErr
+	}
+	if m.keys == nil {
+		m.keys = map[string]bpf.MapKey{}
+	}
+	m.entries[key.String()] = value
+	m.keys[key.String()] = key.DeepCopyMapKey()
+	return nil
+}
+
+func TestReconcileReplacesStalePinnedMapOwners(t *testing.T) {
+	src := &testMap{entries: map[string]bpf.MapValue{}}
+	vlan := &testMap{entries: map[string]bpf.MapValue{}}
+	manager := newWithBackends(logging.DefaultLogger.WithField("test", t.Name()), src, vlan)
+
+	stale := validEndpoint()
+	if err := manager.OnEndpointReady(stale); err != nil {
+		t.Fatal(err)
+	}
+	orphan := stale
+	orphan.ip = "10.0.0.99"
+	orphan.id = 99
+	orphan.ifindex = 99
+	orphan.vlan = 99
+	orphan.mac = [6]byte{2, 99, 98, 97, 96, 95}
+	if err := manager.OnEndpointReady(orphan); err != nil {
+		t.Fatal(err)
+	}
+
+	desired := stale
+	desired.id = 22
+	desired.ifindex = 33
+	desired.vlan = 202
+	desired.mac = [6]byte{2, 20, 21, 22, 23, 24}
+	if err := manager.Reconcile([]EndpointInfo{desired}); err != nil {
+		t.Fatal(err)
+	}
+	if len(src.entries) != 1 || len(vlan.entries) != 1 {
+		t.Fatalf("stale entries survived reconciliation: src=%d vlan=%d", len(src.entries), len(vlan.entries))
+	}
+	srcKey := (&SrcIPKey4{Addr: [4]byte{10, 0, 0, 2}}).String()
+	wantSrc := &SubENIInfo{VlanID: 202, MAC: desired.mac, LxcID: desired.id}
+	if got := src.entries[srcKey]; !reflect.DeepEqual(got, wantSrc) {
+		t.Fatalf("source owner was not replaced: got=%#v want=%#v", got, wantSrc)
+	}
+	vlanKey := (&VLANMACKey{VlanID: 202, MAC: desired.mac}).String()
+	wantVLAN := &EPInfo{IfIndex: desired.ifindex, LxcID: uint16(desired.id)}
+	if got := vlan.entries[vlanKey]; !reflect.DeepEqual(got, wantVLAN) {
+		t.Fatalf("VLAN owner was not replaced: got=%#v want=%#v", got, wantVLAN)
+	}
+}
