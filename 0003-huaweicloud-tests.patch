+func TestEndpointValidationBoundaries(t *testing.T) {
+	manager := newWithBackends(logging.DefaultLogger.WithField("test", t.Name()),
+		&testMap{entries: map[string]bpf.MapValue{}}, &testMap{entries: map[string]bpf.MapValue{}})
+	if err := manager.OnEndpointReady(nil); err == nil {
+		t.Fatal("nil endpoint was accepted")
+	}
+	var typedNil *configurableEndpoint
+	if err := manager.OnEndpointReady(typedNil); err == nil {
+		t.Fatal("typed nil endpoint was accepted")
+	}
+
+	tests := map[string]func(*configurableEndpoint){
+		"empty-ip":      func(e *configurableEndpoint) { e.ip = "" },
+		"invalid-ip":    func(e *configurableEndpoint) { e.ip = "not-an-ip" },
+		"ipv6":          func(e *configurableEndpoint) { e.ip = "2001:db8::1" },
+		"zero-id":       func(e *configurableEndpoint) { e.id = 0 },
+		"overflow-id":   func(e *configurableEndpoint) { e.id = 65536 },
+		"zero-ifindex":  func(e *configurableEndpoint) { e.ifindex = 0 },
+		"negative-vlan": func(e *configurableEndpoint) { e.vlan = -1 },
+		"zero-vlan":     func(e *configurableEndpoint) { e.vlan = 0 },
+		"vlan-4095":     func(e *configurableEndpoint) { e.vlan = 4095 },
+		"vlan-65536":    func(e *configurableEndpoint) { e.vlan = 65536 },
+		"empty-mac":     func(e *configurableEndpoint) { e.mac = [6]byte{} },
+		"multicast-mac": func(e *configurableEndpoint) { e.mac = [6]byte{1, 1, 2, 3, 4, 5} },
+	}
+	for name, mutate := range tests {
+		t.Run(name, func(t *testing.T) {
+			ep := validEndpoint()
+			mutate(&ep)
+			if err := manager.OnEndpointReady(ep); err == nil {
+				t.Fatal("invalid endpoint was accepted")
+			}
+			if err := manager.OnEndpointDelete(ep); err == nil {
+				t.Fatal("invalid endpoint delete was accepted")
+			}
+		})
+	}
+
+	for _, id := range []uint32{1, 65535} {
+		ep := validEndpoint()
+		ep.id = id
+		fresh := newWithBackends(logging.DefaultLogger.WithField("test", t.Name()),
+			&testMap{entries: map[string]bpf.MapValue{}}, &testMap{entries: map[string]bpf.MapValue{}})
+		if err := fresh.OnEndpointReady(ep); err != nil {
+			t.Fatalf("valid endpoint ID %d rejected: %v", id, err)
+		}
+	}
+	for _, vlan := range []int32{1, 4094} {
+		ep := validEndpoint()
+		ep.vlan = vlan
+		fresh := newWithBackends(logging.DefaultLogger.WithField("test", t.Name()),
+			&testMap{entries: map[string]bpf.MapValue{}}, &testMap{entries: map[string]bpf.MapValue{}})
+		if err := fresh.OnEndpointReady(ep); err != nil {
+			t.Fatalf("valid VLAN %d rejected: %v", vlan, err)
+		}
+	}
+}
