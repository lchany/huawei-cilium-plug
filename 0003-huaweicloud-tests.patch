+func TestRepeatedReadyAndDeleteAreIdempotent(t *testing.T) {
+	src := &testMap{entries: map[string]bpf.MapValue{}}
+	vlan := &testMap{entries: map[string]bpf.MapValue{}}
+	manager := newWithBackends(logging.DefaultLogger.WithField("test", t.Name()), src, vlan)
+	ep := validEndpoint()
+	for i := 0; i < 10; i++ {
+		if err := manager.OnEndpointReady(ep); err != nil {
+			t.Fatalf("ready iteration %d: %v", i, err)
+		}
+	}
+	if len(src.entries) != 1 || len(vlan.entries) != 1 {
+		t.Fatalf("repeated Ready duplicated entries: src=%d vlan=%d", len(src.entries), len(vlan.entries))
+	}
+	for i := 0; i < 10; i++ {
+		if err := manager.OnEndpointDelete(ep); err != nil {
+			t.Fatalf("delete iteration %d: %v", i, err)
+		}
+	}
+	if len(src.entries) != 0 || len(vlan.entries) != 0 {
+		t.Fatalf("repeated Delete retained entries: src=%d vlan=%d", len(src.entries), len(vlan.entries))
+	}
