+	srcKey := (&SrcIPKey4{Addr: [4]byte{10, 0, 0, 2}}).String()
+	if got := src.entries[srcKey]; !reflect.DeepEqual(got, &SubENIInfo{VlanID: 1, MAC: restored.mac, LxcID: restored.id}) {
