+func TestHuaweiCloudAPIRateLimitBoundaries(t *testing.T) {
+	metrics := &rateLimitRecorder{delays: make(chan time.Duration, 64)}
+	limiter := helpers.NewApiLimiter(metrics, 20, 40)
+	ctx := context.Background()
+	for i := 0; i < 40; i++ {
+		limiter.Limit(ctx, "boundary")
+	}
+	select {
+	case delay := <-metrics.delays:
+		t.Fatalf("first 40 burst requests should not wait, observed %v", delay)
+	default:
+	}
+	started := time.Now()
+	limiter.Limit(ctx, "boundary")
+	if elapsed := time.Since(started); elapsed < 20*time.Millisecond {
+		t.Fatalf("41st request was not rate limited at 20 QPS: elapsed=%v", elapsed)
+	}
+	select {
+	case delay := <-metrics.delays:
+		if delay < 20*time.Millisecond {
+			t.Fatalf("unexpected limiter delay %v", delay)
+		}
+	default:
+		t.Fatal("41st request did not report rate-limit delay")
+	}
+}
+
+func TestAPICancellationDuringRateLimitPreventsCloudCall(t *testing.T) {
+	var requests int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		atomic.AddInt32(&requests, 1)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = fmt.Fprint(w, `{"sub_network_interface":{"id":"unexpected"}}`)
+	}))
+	defer server.Close()
+	client := newTestClient(t, server.URL)
+	client.limiter = helpers.NewApiLimiter(noOpRateLimitMetrics{}, 0.1, 1)
+	if err := client.limiter.Limit(context.Background(), "consume-burst"); err != nil {
+		t.Fatal(err)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	started := time.Now()
+	_, err := client.GetSubNetworkInterface(ctx, "eni-1")
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("got %v, want deadline exceeded", err)
+	}
+	if elapsed := time.Since(started); elapsed > 500*time.Millisecond {
+		t.Fatalf("rate-limit cancellation returned too slowly: %v", elapsed)
+	}
+	if got := atomic.LoadInt32(&requests); got != 0 {
+		t.Fatalf("cloud API was called %d times after limiter cancellation", got)
+	}
+}
