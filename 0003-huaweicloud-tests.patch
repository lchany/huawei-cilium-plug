+		t.Fatalf("deleted endpoint was reinserted: ready before=%d after=%d", readyAfterDelete, len(mapMgr.ready))
+	}
+	if len(mapMgr.deleted) != 1 {
+		t.Fatalf("delete calls=%d, want 1", len(mapMgr.deleted))
+	}
