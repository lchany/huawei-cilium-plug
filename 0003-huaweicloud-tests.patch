+}
+
+func validSubENI() eniTypes.SubENI {
+	return eniTypes.SubENI{
+		ID: "eni-1", PrivateIPAddress: "10.0.0.2", MACAddress: "fa:16:3e:00:00:01",
+		VlanID: 100, GatewayIP: "10.0.0.1", GatewayMAC: "fa:16:3e:00:00:fe", TrunkInterface: "eth0",
+	}
+}
+
+func TestSubENIInfoRequiresExactlyOneIPMatch(t *testing.T) {
+	ep := testSubENIEndpoint{ip: "10.0.0.2", id: 1, ifindex: 2}
+	info, err := subENIInfoForEndpoint(testCiliumNode(nil), ep)
+	if err != nil || info != nil {
+		t.Fatalf("zero matches: info=%#v err=%v", info, err)
+	}
+	first := validSubENI()
+	second := first
+	second.ID = "eni-2"
+	second.VlanID = 200
+	if _, err := subENIInfoForEndpoint(testCiliumNode(map[string]eniTypes.SubENI{"a": first, "b": second}), ep); err == nil {
+		t.Fatal("duplicate private-IP matches were accepted")
+	}
+}
+
+func TestResolveInitialEndpointInfosFetchesCiliumNodeOnce(t *testing.T) {
+	first := validSubENI()
+	second := first
+	second.ID = "eni-2"
+	second.PrivateIPAddress = "10.0.0.3"
+	second.VlanID = 101
+	cn := testCiliumNode(map[string]eniTypes.SubENI{"eni-1": first, "eni-2": second})
+	getCalls := 0
+	subscriber := &huaweiCloudSubENISubscriber{
+		getCiliumNode: func(ctx context.Context) (*ciliumv2.CiliumNode, error) {
+			getCalls++
+			deadline, ok := ctx.Deadline()
+			if !ok || time.Until(deadline) <= 0 || time.Until(deadline) > huaweiCloudCiliumNodeGetTimeout {
+				t.Fatalf("CiliumNode GET context has invalid deadline: %v, %v", deadline, ok)
+			}
+			return cn, nil
+		},
+	}
+	infos, err := subscriber.resolveInitialEndpointInfos([]subENIEndpoint{
+		testSubENIEndpoint{ip: first.PrivateIPAddress, id: 1, ifindex: 2},
+		testSubENIEndpoint{ip: second.PrivateIPAddress, id: 2, ifindex: 3},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(infos) != 2 {
+		t.Fatalf("resolved infos=%d, want 2", len(infos))
+	}
+	if getCalls != 1 {
+		t.Fatalf("CiliumNode GET calls=%d, want 1", getCalls)
+	}
+}
