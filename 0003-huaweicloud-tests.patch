+func TestUpdateCiliumNodeResourceStopsDuringConflictBackoff(t *testing.T) {
+	oldAutoCreate, oldIPAM := option.Config.AutoCreateCiliumNodeResource, option.Config.IPAM
+	option.Config.AutoCreateCiliumNodeResource = true
+	option.Config.IPAM = "test"
+	t.Cleanup(func() {
+		option.Config.AutoCreateCiliumNodeResource = oldAutoCreate
+		option.Config.IPAM = oldIPAM
+	})
+
+	ctx, cancel := context.WithCancel(context.Background())
+	client := &cancelingCiliumNodeClient{cancel: cancel}
+	n := &NodeDiscovery{
+		k8sGetters: fakeNodeGetters{
+			getK8sNode: func(context.Context, string) (*corev1.Node, error) {
+				return &corev1.Node{ObjectMeta: metav1.ObjectMeta{UID: types.UID("node-uid")}}, nil
+			},
+			getCiliumNode: func(context.Context, string) (*ciliumv2.CiliumNode, error) {
+				return nil, k8serrors.NewNotFound(schema.GroupResource{Group: "cilium.io", Resource: "ciliumnodes"}, "local")
+			},
+		},
+		ciliumNodes: func() ciliumNodeResourceClient { return client },
+	}
+
+	started := time.Now()
+	err := n.updateCiliumNodeResource(ctx)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("update returned %v, want context cancellation", err)
+	}
+	if time.Since(started) >= 400*time.Millisecond {
+		t.Fatalf("canceled update waited for the full retry backoff")
+	}
+	if client.createCalls != 1 {
+		t.Fatalf("create calls=%d, want 1", client.createCalls)
+	}
+}
