+	manager := NewInstancesManager(api, "vpc-1", nil)
+	manager.instances.Update("instance-1", ipamTypes.InterfaceRevision{Resource: &eniTypes.SubENI{ID: "eni-old"}})
+
+	manager.resyncLock.Lock()
+	var wg sync.WaitGroup
+	updateDone := make(chan struct{})
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		manager.UpdateSubENI("instance-1", &eniTypes.SubENI{ID: "eni-new"})
+		close(updateDone)
+	}()
+	select {
+	case <-updateDone:
+		manager.resyncLock.Unlock()
+		t.Fatal("SubENI update bypassed an in-progress full resync")
+	case <-time.After(20 * time.Millisecond):
+	}
+	manager.resyncLock.Unlock()
+	wg.Wait()
+
+	manager.resyncLock.Lock()
+	deleteDone := make(chan struct{})
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		manager.DeleteSubENI("instance-1", "eni-old")
+		close(deleteDone)
+	}()
+	select {
+	case <-deleteDone:
+		manager.resyncLock.Unlock()
+		t.Fatal("SubENI delete bypassed an in-progress full resync")
+	case <-time.After(20 * time.Millisecond):
+	}
+	manager.resyncLock.Unlock()
+	wg.Wait()
+
+	seen := map[string]bool{}
+	manager.ForeachInstance("instance-1", func(_, interfaceID string, _ ipamTypes.InterfaceRevision) error {
+		seen[interfaceID] = true
+		return nil
+	})
+	if !seen["eni-new"] || seen["eni-old"] {
+		t.Fatalf("unexpected post-resync mutation state: %#v", seen)
+	}
+}
+
+func TestCreateInterfaceUsesOneNodeRevisionDuringConcurrentUpdate(t *testing.T) {
+	base := mock.NewAPI(nil, nil, nil)
+	base.SetInstanceLimit("instance-old", ipamTypes.Limits{IPv4: 8})
+	base.SetInstanceLimit("instance-new", ipamTypes.Limits{IPv4: 2})
+	api := &blockingBatchAPI{API: base, started: make(chan hwAPI.CreateSubENIRequest, 1), proceed: make(chan struct{})}
+	manager := NewInstancesManager(api, "vpc-1", nil)
+	oldObj := &v2.CiliumNode{Spec: v2.NodeSpec{InstanceID: "instance-old", HuaweiCloud: &eniTypes.Spec{
+		InstanceType:     "flavor-old",
+		VPCID:            "vpc-1",
+		AvailabilityZone: "az-1",
+		TrunkInterfaceID: "trunk-old",
+		SecurityGroups:   []string{"sg-old"},
+		Subnets:          []string{"subnet-old"},
+	}}}
+	node := &Node{node: testNodeID("instance-old"), manager: manager, k8sObj: oldObj, instanceID: "instance-old", subENIs: map[string]eniTypes.SubENI{}}
+
+	result := make(chan error, 1)
+	go func() {
+		count, _, err := node.CreateInterface(context.Background(), &ipam.AllocationAction{AvailableInterfaces: 1, MaxIPsToAllocate: 1}, log)
+		if err == nil && count != 1 {
+			err = fmt.Errorf("created count %d, want 1", count)
+		}
+		result <- err
+	}()
+	req := <-api.started
+	newObj := oldObj.DeepCopy()
+	newObj.Spec.InstanceID = "instance-new"
+	newObj.Spec.HuaweiCloud.InstanceType = "flavor-new"
+	newObj.Spec.HuaweiCloud.TrunkInterfaceID = "trunk-new"
+	newObj.Spec.HuaweiCloud.SecurityGroups = []string{"sg-new"}
+	newObj.Spec.HuaweiCloud.Subnets = []string{"subnet-new"}
+	node.UpdatedNode(newObj)
+	close(api.proceed)
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+	if req.TrunkInterfaceID != "trunk-old" || req.SubnetID != "subnet-old" || !reflect.DeepEqual(req.SecurityGroupIDs, []string{"sg-old"}) {
+		t.Fatalf("create request mixed node revisions: %#v", req)
+	}
+	seenOld, seenNew := false, false
+	manager.ForeachInstance("instance-old", func(_, interfaceID string, _ ipamTypes.InterfaceRevision) error {
+		seenOld = seenOld || interfaceID == "eni-created"
+		return nil
+	})
+	manager.ForeachInstance("instance-new", func(_, interfaceID string, _ ipamTypes.InterfaceRevision) error {
+		seenNew = seenNew || interfaceID == "eni-created"
+		return nil
+	})
+	if !seenOld || seenNew {
+		t.Fatalf("created SubENI attributed to wrong revision: old=%v new=%v", seenOld, seenNew)
+	}
+}
+
+func TestConcurrentCreateInterfaceHonorsInstanceLimit(t *testing.T) {
+	api := mock.NewAPI([]*ipamTypes.Subnet{{
+		ID: "subnet-1", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 10,
+	}}, nil, nil)
+	api.SetInstanceLimit("instance-1", ipamTypes.Limits{IPv4: 1})
+	manager := NewInstancesManager(api, "vpc-1", nil)
+	node := &Node{
+		node:       testNodeID("instance-1"),
+		manager:    manager,
+		instanceID: "instance-1",
+		subENIs:    map[string]eniTypes.SubENI{},
+		k8sObj: &v2.CiliumNode{Spec: v2.NodeSpec{InstanceID: "instance-1", HuaweiCloud: &eniTypes.Spec{
+			InstanceType:     "flavor-1",
+			VPCID:            "vpc-1",
+			AvailabilityZone: "az-1",
+			TrunkInterfaceID: "trunk-1",
+			SecurityGroups:   []string{"sg-1"},
+			Subnets:          []string{"subnet-1"},
+		}}},
+	}
+
+	start := make(chan struct{})
+	results := make(chan int, 2)
+	errs := make(chan error, 2)
+	for i := 0; i < 2; i++ {
+		go func() {
+			<-start
+			count, _, err := node.CreateInterface(context.Background(), &ipam.AllocationAction{AvailableInterfaces: 1, MaxIPsToAllocate: 1}, log)
+			results <- count
+			errs <- err
+		}()
+	}
+	close(start)
+	total := 0
+	for i := 0; i < 2; i++ {
+		total += <-results
+		if err := <-errs; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if total != 1 || len(node.subENIs) != 1 {
+		t.Fatalf("concurrent expansion exceeded limit: created=%d cached=%d", total, len(node.subENIs))
+	}
+}
+
+func TestCreateInterfaceFollowsSubnetAndSecurityGroupConfigTransition(t *testing.T) {
+	base := mock.NewAPI([]*ipamTypes.Subnet{
+		{ID: "subnet-old", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 10, Tags: ipamTypes.Tags{"role": "old"}},
+		{ID: "subnet-new", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 10, Tags: ipamTypes.Tags{"role": "new"}},
+	}, []*ipamTypes.VirtualNetwork{{ID: "vpc-1"}}, nil)
+	base.SetInstanceLimit("instance-1", ipamTypes.Limits{IPv4: 2})
+	api := &recordingBatchAPI{API: base}
+	manager := NewInstancesManager(api, "vpc-1", nil)
+	if manager.Resync(context.Background()).IsZero() {
+		t.Fatal("initial manager resync failed")
+	}
+	oldObj := &v2.CiliumNode{Spec: v2.NodeSpec{InstanceID: "instance-1", HuaweiCloud: &eniTypes.Spec{
+		InstanceType:     "flavor-1",
+		VPCID:            "vpc-1",
+		AvailabilityZone: "az-1",
+		TrunkInterfaceID: "trunk-1",
+		SecurityGroups:   []string{"sg-a"},
+		Subnets:          []string{"subnet-old"},
+	}}}
+	node := &Node{node: testNodeID("instance-1"), manager: manager, k8sObj: oldObj, instanceID: "instance-1", subENIs: map[string]eniTypes.SubENI{}}
+	if count, _, err := node.CreateInterface(context.Background(), &ipam.AllocationAction{AvailableInterfaces: 1, MaxIPsToAllocate: 1}, log); err != nil || count != 1 {
+		t.Fatalf("old configuration create failed: count=%d err=%v", count, err)
+	}
+
+	newObj := oldObj.DeepCopy()
+	newObj.Spec.HuaweiCloud.Subnets = nil
+	newObj.Spec.HuaweiCloud.SubnetTags = map[string]string{"role": "new"}
+	newObj.Spec.HuaweiCloud.SecurityGroups = []string{"sg-b"}
+	node.UpdatedNode(newObj)
+	if count, _, err := node.CreateInterface(context.Background(), &ipam.AllocationAction{AvailableInterfaces: 1, MaxIPsToAllocate: 1}, log); err != nil || count != 1 {
+		t.Fatalf("new configuration create failed: count=%d err=%v", count, err)
+	}
+
+	api.mutex.Lock()
+	requests := append([]hwAPI.CreateSubENIRequest(nil), api.requests...)
+	api.mutex.Unlock()
+	if len(requests) != 2 {
+		t.Fatalf("request count=%d, want 2", len(requests))
+	}
+	if requests[0].SubnetID != "subnet-old" || !reflect.DeepEqual(requests[0].SecurityGroupIDs, []string{"sg-a"}) {
+		t.Fatalf("old request mismatch: %#v", requests[0])
+	}
+	if requests[1].SubnetID != "subnet-new" || !reflect.DeepEqual(requests[1].SecurityGroupIDs, []string{"sg-b"}) {
+		t.Fatalf("new request retained stale configuration: %#v", requests[1])
+	}
+}
