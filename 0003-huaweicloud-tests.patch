+	if err != nil || client == nil {
+		t.Fatalf("opaque credential characters were rejected: client=%v err=%v", client, err)
+	}
+}
+
+func TestNewClientRejectsInvalidEndpointAndRegion(t *testing.T) {
+	tests := []struct {
+		name     string
+		region   string
+		endpoint string
+		want     string
+	}{
+		{name: "empty endpoint and region", want: "region is required"},
+		{name: "endpoint without scheme", endpoint: "vpc.example.com", want: "endpoint"},
+		{name: "endpoint with unsupported scheme", endpoint: "ftp://vpc.example.com", want: "endpoint"},
+		{name: "endpoint without host", endpoint: "https://", want: "endpoint"},
+		{name: "endpoint with credentials", endpoint: "https://user@example.com", want: "credentials"},
+		{name: "endpoint with query", endpoint: "https://example.com?project=other", want: "query"},
+		{name: "region with whitespace", region: "cn south 1", want: "region"},
+		{name: "region with path separator", region: "cn-south-1/other", want: "region"},
+	}
