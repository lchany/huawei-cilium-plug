+	first := RoutingInfo{InterfaceNumber: 101, IpamMode: ipamOption.IPAMHuaweiCloud}
+	second := RoutingInfo{InterfaceNumber: 202, IpamMode: ipamOption.IPAMHuaweiCloud}
+	_, firstTable, err := first.egressRulePriorityAndTableID(42, false)
+	if err != nil {
