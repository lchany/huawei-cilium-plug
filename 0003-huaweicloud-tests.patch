+func TestGetTrunkInterfaceIDAfterExplicitLinkRename(t *testing.T) {
+	mac, err := net.ParseMAC("02:00:00:00:14:01")
+	if err != nil {
+		t.Fatal(err)
+	}
+	attrs := netlink.NewLinkAttrs()
+	attrs.Name = "hwc-meta-old"
+	attrs.HardwareAddr = mac
+	link := &netlink.Dummy{LinkAttrs: attrs}
+	if err := netlink.LinkAdd(link); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = netlink.LinkDel(link) })
+	if err := netlink.LinkSetUp(link); err != nil {
+		t.Fatal(err)
+	}
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = fmt.Fprintf(w, `{"links":[{"vif_id":"stable-port-id","ethernet_mac_address":%q}]}`, mac)
+	}))
+	t.Cleanup(server.Close)
+	oldURL := metadataNetworkDataURL
+	metadataNetworkDataURL = server.URL
+	t.Cleanup(func() { metadataNetworkDataURL = oldURL })
+
+	got, err := GetTrunkInterfaceID(context.Background(), attrs.Name)
+	if err != nil || got != "stable-port-id" {
+		t.Fatalf("initial trunk lookup: port=%q err=%v", got, err)
+	}
+	if err := netlink.LinkSetDown(link); err != nil {
+		t.Fatal(err)
+	}
+	if err := netlink.LinkSetName(link, "hwc-meta-new"); err != nil {
+		t.Fatal(err)
+	}
+	if err := netlink.LinkSetUp(link); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := GetTrunkInterfaceID(context.Background(), attrs.Name); err == nil {
+		t.Fatal("stale trunk interface name was accepted after rename")
+	}
+	got, err = GetTrunkInterfaceID(context.Background(), "hwc-meta-new")
+	if err != nil || got != "stable-port-id" {
+		t.Fatalf("renamed trunk lookup: port=%q err=%v", got, err)
+	}
+}
