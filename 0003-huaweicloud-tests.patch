+func TestAPIHTTPErrorNormalization(t *testing.T) {
+	tests := []struct {
+		status int
+		want   error
+	}{
+		{status: http.StatusUnauthorized, want: ErrUnauthorized},
+		{status: http.StatusForbidden, want: ErrUnauthorized},
+		{status: http.StatusNotFound, want: ErrNotFound},
+		{status: http.StatusTooManyRequests, want: ErrRateLimited},
+		{status: http.StatusBadRequest, want: ErrInvalidArgument},
+		{status: http.StatusInternalServerError},
+	}
+
+	for _, tt := range tests {
+		t.Run(http.StatusText(tt.status), func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(tt.status)
+				_, _ = fmt.Fprint(w, `{"error_code":"VPC.TEST","error_msg":"fixture failure"}`)
+			}))
+			defer server.Close()
+
+			client := newTestClient(t, server.URL)
+			_, err := client.GetPortSecurityGroups(context.Background(), "port-1")
+			if err == nil {
+				t.Fatal("expected API error")
+			}
+			if tt.want != nil && !errors.Is(err, tt.want) {
+				t.Fatalf("got %v, want errors.Is(%v)", err, tt.want)
+			}
+		})
+	}
+}
+
+func TestAPINetworkDisconnectIsReturned(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	endpoint := server.URL
+	server.Close()
+
+	client := newTestClient(t, endpoint)
+	if _, err := client.GetPortSecurityGroups(context.Background(), "port-1"); err == nil {
+		t.Fatal("expected network disconnect error")
+	}
+}
+
+func TestAPIErrorIncludesRequestIDWithoutCredentials(t *testing.T) {
+	for _, status := range []int{
+		http.StatusBadRequest,
+		http.StatusUnauthorized,
+		http.StatusForbidden,
+		http.StatusNotFound,
+		http.StatusTooManyRequests,
+		http.StatusInternalServerError,
+	} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			requestID := fmt.Sprintf("audit92-request-%d", status)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				w.Header().Set("X-Request-Id", requestID)
+				w.WriteHeader(status)
+				_, _ = fmt.Fprint(w, `{"error_code":"VPC.TEST","error_msg":"fixture failure"}`)
+			}))
+			defer server.Close()
+
+			client := newTestClient(t, server.URL)
+			_, err := client.GetPortSecurityGroups(context.Background(), "port-1")
+			if err == nil {
+				t.Fatal("expected API error")
+			}
+			message := err.Error()
+			if !strings.Contains(message, requestID) {
+				t.Fatalf("request ID is missing from error: %v", err)
+			}
+			for _, sensitive := range []string{"test-ak", "test-sk", "Authorization"} {
+				if strings.Contains(message, sensitive) {
+					t.Fatalf("error leaked sensitive request data %q: %v", sensitive, err)
+				}
+			}
+		})
+	}
+}
diff --git a/pkg/huaweicloud/api/mock/mock.go b/pkg/huaweicloud/api/mock/mock.go
new file mode 100644
index 000000000..c517ef12a
--- /dev/null
+++ b/pkg/huaweicloud/api/mock/mock.go
@@ -0,0 +1,459 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package mock
+
+import (
+	"context"
+	"fmt"
+	"net"
+
+	"github.com/google/uuid"
+
+	hwAPI "github.com/cilium/cilium/pkg/huaweicloud/api"
+	eniTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+	hwTypes "github.com/cilium/cilium/pkg/huaweicloud/types"
+	ipamTypes "github.com/cilium/cilium/pkg/ipam/types"
+	"github.com/cilium/cilium/pkg/lock"
+)
+
+type SubENIMap map[string]*eniTypes.SubENI
+
+// Compile-time check that API implements hwAPI.HuaweiCloudAPI.
+var _ hwAPI.HuaweiCloudAPI = &API{}
+
+type API struct {
+	mutex              lock.RWMutex
+	subENIs            map[string]*eniTypes.SubENI
+	instanceSubENIs    map[string]SubENIMap
+	subnets            map[string]*ipamTypes.Subnet
+	vpcs               map[string]*ipamTypes.VirtualNetwork
+	securityGroups     map[string]*hwTypes.SecurityGroup
+	instanceLimits     map[string]ipamTypes.Limits
+	portSecurityGroups map[string][]string
+	nextIP             net.IP
+	// subnetErrors maps subnet IDs to errors returned on creation.
+	// Tests use SetSubnetError to inject errors like api.ErrSubnetInsufficientIP.
+	subnetErrors map[string]error
+}
+
+func NewAPI(subnets []*ipamTypes.Subnet, vpcs []*ipamTypes.VirtualNetwork, securityGroups []*hwTypes.SecurityGroup) *API {
+	_, cidr, _ := net.ParseCIDR("10.0.0.0/8")
+
+	api := &API{
+		subENIs:            map[string]*eniTypes.SubENI{},
+		instanceSubENIs:    map[string]SubENIMap{},
+		subnets:            map[string]*ipamTypes.Subnet{},
+		vpcs:               map[string]*ipamTypes.VirtualNetwork{},
+		securityGroups:     map[string]*hwTypes.SecurityGroup{},
+		instanceLimits:     map[string]ipamTypes.Limits{},
+		portSecurityGroups: map[string][]string{},
+		nextIP:             nextIPv4(cidr.IP),
+		subnetErrors:       map[string]error{},
+	}
+
+	for _, subnet := range subnets {
+		api.AddSubnet(subnet)
+	}
+	for _, vpc := range vpcs {
+		api.AddVPC(vpc)
+	}
+	for _, securityGroup := range securityGroups {
+		api.AddSecurityGroup(securityGroup)
+	}
+
+	return api
+}
+
+func (a *API) AddSubENI(instanceID string, subENI *eniTypes.SubENI) {
+	if subENI == nil {
+		return
+	}
+
+	a.mutex.Lock()
+	defer a.mutex.Unlock()
+
+	cloned := subENI.DeepCopy()
+	if cloned.ID == "" {
+		cloned.ID = uuid.NewString()
+	}
+	if cloned.State == "" {
+		cloned.State = "ACTIVE"
+	}
+
+	a.subENIs[cloned.ID] = cloned
+
+	if instanceID != "" {
+		if _, ok := a.instanceSubENIs[instanceID]; !ok {
+			a.instanceSubENIs[instanceID] = SubENIMap{}
+		}
+		a.instanceSubENIs[instanceID][cloned.ID] = cloned.DeepCopy()
+	}
+}
+
+func (a *API) GetSubENIs(instanceID string) map[string]*eniTypes.SubENI {
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+
+	result := map[string]*eniTypes.SubENI{}
+
+	if instanceID == "" {
+		for id, subENI := range a.subENIs {
+			result[id] = subENI.DeepCopy()
+		}
+		return result
+	}
+
+	for id, subENI := range a.instanceSubENIs[instanceID] {
+		result[id] = subENI.DeepCopy()
+	}
+
+	return result
+}
+
+func (a *API) AddVPC(vpc *ipamTypes.VirtualNetwork) {
+	if vpc == nil {
+		return
+	}
+
+	a.mutex.Lock()
+	a.vpcs[vpc.ID] = vpc.DeepCopy()
+	a.mutex.Unlock()
+}
+
+func (a *API) AddSubnet(subnet *ipamTypes.Subnet) {
+	if subnet == nil {
+		return
+	}
+
+	a.mutex.Lock()
+	a.subnets[subnet.ID] = subnet.DeepCopy()
+	a.mutex.Unlock()
+}
+
+// SetSubnetError configures the mock to return the given error when creating
+// a Sub-ENI in the specified subnet. Pass api.ErrSubnetInsufficientIP to
+// simulate IP exhaustion for fallback testing.
+func (a *API) SetSubnetError(subnetID string, err error) {
+	a.mutex.Lock()
+	a.subnetErrors[subnetID] = err
+	a.mutex.Unlock()
+}
+
+// ClearSubnetError removes any configured error for the specified subnet.
+func (a *API) ClearSubnetError(subnetID string) {
+	a.mutex.Lock()
+	delete(a.subnetErrors, subnetID)
+	a.mutex.Unlock()
+}
+
+func (a *API) AddSecurityGroup(securityGroup *hwTypes.SecurityGroup) {
+	if securityGroup == nil {
+		return
+	}
+
+	a.mutex.Lock()
+	a.securityGroups[securityGroup.ID] = copySecurityGroup(securityGroup)
+	a.mutex.Unlock()
+}
+
+func (a *API) SetInstanceLimit(instanceID string, l ipamTypes.Limits) {
+	a.mutex.Lock()
+	a.instanceLimits[instanceID] = l
+	a.mutex.Unlock()
+}
+
+func (a *API) SetPortSecurityGroups(portID string, groups []string) {
+	a.mutex.Lock()
+	a.portSecurityGroups[portID] = append([]string(nil), groups...)
+	a.mutex.Unlock()
+}
+
+func (a *API) CreateSubNetworkInterface(ctx context.Context, req hwAPI.CreateSubENIRequest) (string, *eniTypes.SubENI, error) {
+	_ = ctx
+
+	a.mutex.Lock()
+	defer a.mutex.Unlock()
+
+	// Return any configured error for this subnet (e.g. ErrSubnetInsufficientIP)
+	if err, ok := a.subnetErrors[req.SubnetID]; ok {
+		return "", nil, err
+	}
+
+	subnet, ok := a.subnets[req.SubnetID]
+	if !ok {
+		return "", nil, fmt.Errorf("subnet %s not found", req.SubnetID)
+	}
+
+	ip := a.allocateNextIP()
+
+	id := uuid.NewString()
+	generated := &eniTypes.SubENI{
+		ID:               id,
+		PrivateIPAddress: ip.String(),
+		MACAddress:       randomMAC(),
+		GatewayIP:        subnetGateway(subnet),
+		SubnetID:         req.SubnetID,
+		SecurityGroups:   append([]string(nil), req.SecurityGroupIDs...),
+		State:            "ACTIVE",
+		ParentID:         req.TrunkInterfaceID,
+		VPCID:            subnet.VirtualNetworkID,
+	}
+	if subnet.CIDR != nil {
+		generated.SubnetCIDR = subnet.CIDR.String()
+	}
+
+	a.subENIs[id] = generated
+
+	return id, generated.DeepCopy(), nil
+}
+
+func (a *API) BatchCreateSubNetworkInterfaces(ctx context.Context, count int, req hwAPI.CreateSubENIRequest) ([]*eniTypes.SubENI, error) {
+	if count <= 0 {
+		return nil, fmt.Errorf("count must be positive")
+	}
+	if count > 10 {
+		return nil, fmt.Errorf("batch create count exceeds max 10")
+	}
+
+	result := make([]*eniTypes.SubENI, 0, count)
+	for i := 0; i < count; i++ {
+		_, subENI, err := a.CreateSubNetworkInterface(ctx, req)
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, subENI)
+	}
+
+	return result, nil
+}
+
+func (a *API) TagSubNetworkInterface(ctx context.Context, subENIID string, tags map[string]string) error {
+	_ = ctx
+	_ = tags
+
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+	if _, ok := a.subENIs[subENIID]; !ok {
+		return fmt.Errorf("sub-eni %s not found", subENIID)
+	}
+	return nil
+}
+
+func (a *API) DeleteSubNetworkInterface(ctx context.Context, subENIID string) error {
+	_ = ctx
+
+	a.mutex.Lock()
+	defer a.mutex.Unlock()
+
+	if _, ok := a.subENIs[subENIID]; !ok {
+		return fmt.Errorf("sub-eni %s not found", subENIID)
+	}
+
+	delete(a.subENIs, subENIID)
+	for instanceID, subENIs := range a.instanceSubENIs {
+		if _, ok := subENIs[subENIID]; ok {
+			delete(subENIs, subENIID)
+			if len(subENIs) == 0 {
+				delete(a.instanceSubENIs, instanceID)
+			}
+		}
+	}
+
+	return nil
+}
+
+func (a *API) GetSubNetworkInterface(ctx context.Context, subENIID string) (*eniTypes.SubENI, error) {
+	_ = ctx
+
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+
+	subENI, ok := a.subENIs[subENIID]
+	if !ok {
+		return nil, fmt.Errorf("sub-eni %s not found", subENIID)
+	}
+
+	return subENI.DeepCopy(), nil
+}
+
+func (a *API) ListSubNetworkInterfaces(ctx context.Context, parentID string) ([]*eniTypes.SubENI, error) {
+	_ = ctx
+
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+
+	result := make([]*eniTypes.SubENI, 0)
+	for _, subENI := range a.subENIs {
+		if parentID == "" || subENI.ParentID == parentID {
+			result = append(result, subENI.DeepCopy())
+		}
+	}
+
+	return result, nil
+}
+
+func (a *API) GetPortSecurityGroups(ctx context.Context, portID string) ([]string, error) {
+	_ = ctx
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+	return append([]string(nil), a.portSecurityGroups[portID]...), nil
+}
+
+func (a *API) GetInstance(ctx context.Context, instanceID string) (*ipamTypes.Instance, error) {
+	_ = ctx
+
+	instance := &ipamTypes.Instance{Interfaces: map[string]ipamTypes.InterfaceRevision{}}
+
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+
+	for subENIID, subENI := range a.instanceSubENIs[instanceID] {
+		instance.Interfaces[subENIID] = ipamTypes.InterfaceRevision{Resource: subENI.DeepCopy()}
+	}
+
+	return instance, nil
+}
+
+func (a *API) GetInstanceLimits(ctx context.Context, instanceID string) (ipamTypes.Limits, error) {
+	_ = ctx
+
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+
+	if l, ok := a.instanceLimits[instanceID]; ok {
+		return l, nil
+	}
+
+	return ipamTypes.Limits{}, fmt.Errorf("instance limits not found for %s", instanceID)
+}
+
+func (a *API) GetInstances(ctx context.Context, vpcs ipamTypes.VirtualNetworkMap, subnets ipamTypes.SubnetMap) (*ipamTypes.InstanceMap, error) {
+	_ = ctx
+	_ = vpcs
+	_ = subnets
+
+	instances := ipamTypes.NewInstanceMap()
+
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+
+	for instanceID, subENIs := range a.instanceSubENIs {
+		for _, subENI := range subENIs {
+			instances.Update(instanceID, ipamTypes.InterfaceRevision{Resource: subENI.DeepCopy()})
+		}
+	}
+
+	return instances, nil
+}
+
+func (a *API) GetSubnets(ctx context.Context, vpcID string) (ipamTypes.SubnetMap, error) {
+	_ = ctx
+
+	result := ipamTypes.SubnetMap{}
+
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+
+	for _, subnet := range a.subnets {
+		if vpcID != "" && subnet.VirtualNetworkID != vpcID {
+			continue
+		}
+		result[subnet.ID] = subnet.DeepCopy()
+	}
+
+	return result, nil
+}
+
+func (a *API) GetVPCs(ctx context.Context) (ipamTypes.VirtualNetworkMap, error) {
+	_ = ctx
+
+	result := ipamTypes.VirtualNetworkMap{}
+
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+
+	for _, vpc := range a.vpcs {
+		result[vpc.ID] = vpc.DeepCopy()
+	}
+
+	return result, nil
+}
+
+func (a *API) GetSecurityGroups(ctx context.Context, vpcID string) (hwTypes.SecurityGroupMap, error) {
+	_ = ctx
+
+	result := hwTypes.SecurityGroupMap{}
+
+	a.mutex.RLock()
+	defer a.mutex.RUnlock()
+
+	for _, securityGroup := range a.securityGroups {
+		if vpcID != "" && securityGroup.VPCID != vpcID {
+			continue
+		}
+		result[securityGroup.ID] = copySecurityGroup(securityGroup)
+	}
+
+	return result, nil
+}
+
+func randomMAC() string {
+	id := uuid.New()
+	return fmt.Sprintf("fa:16:3e:%02x:%02x:%02x", id[0], id[1], id[2])
+}
+
+func (a *API) allocateNextIP() net.IP {
+	if a.nextIP == nil {
+		a.nextIP = net.IPv4(10, 0, 0, 1)
+	}
+	ip := append(net.IP(nil), a.nextIP...)
+	incrementIPv4(a.nextIP)
+	return ip
+}
+
+func nextIPv4(ip net.IP) net.IP {
+	v4 := ip.To4()
+	if v4 == nil {
+		return net.IPv4(10, 0, 0, 1)
+	}
+	out := append(net.IP(nil), v4...)
+	incrementIPv4(out)
+	return out
+}
+
+func incrementIPv4(ip net.IP) {
+	for i := len(ip) - 1; i >= 0; i-- {
+		ip[i]++
+		if ip[i] != 0 {
+			return
+		}
+	}
+}
+
+func subnetGateway(subnet *ipamTypes.Subnet) string {
+	if subnet == nil || subnet.CIDR == nil || subnet.CIDR.IPNet == nil {
+		return ""
+	}
+	return nextIPv4(subnet.CIDR.IP).String()
+}
+
+func copySecurityGroup(in *hwTypes.SecurityGroup) *hwTypes.SecurityGroup {
+	if in == nil {
+		return nil
+	}
+
+	out := &hwTypes.SecurityGroup{
+		ID:    in.ID,
+		VPCID: in.VPCID,
+	}
+
+	if in.Tags != nil {
+		out.Tags = make(map[string]string, len(in.Tags))
+		for key, value := range in.Tags {
+			out.Tags[key] = value
+		}
+	}
+
+	return out
+}
