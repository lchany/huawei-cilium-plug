+func TestReconcileRollsBackBothMapsOnFailure(t *testing.T) {
+	src := &testMap{entries: map[string]bpf.MapValue{}}
+	vlan := &testMap{entries: map[string]bpf.MapValue{}}
+	manager := newWithBackends(logging.DefaultLogger.WithField("test", t.Name()), src, vlan)
+	old := validEndpoint()
+	if err := manager.OnEndpointReady(old); err != nil {
+		t.Fatal(err)
+	}
+	desired := old
+	desired.id = 2
+	desired.ifindex = 22
+	desired.vlan = 202
+	desired.mac = [6]byte{2, 20, 21, 22, 23, 24}
+	// VLAN ownership is installed first. Failing the subsequent source-IP
+	// update verifies that reconciliation restores the already-mutated VLAN
+	// map as well as the source map.
+	src.failUpdateAt = src.updateCalls + 1
+	if err := manager.Reconcile([]EndpointInfo{desired}); err == nil {
+		t.Fatal("injected source-IP update failure was ignored")
+	}
+	srcKey := (&SrcIPKey4{Addr: [4]byte{10, 0, 0, 2}}).String()
+	if got := src.entries[srcKey]; !reflect.DeepEqual(got, &SubENIInfo{VlanID: 1, MAC: old.mac, LxcID: old.id}) {
+		t.Fatalf("source snapshot was not restored: %#v", got)
+	}
+	oldVLANKey := (&VLANMACKey{VlanID: 1, MAC: old.mac}).String()
+	if len(vlan.entries) != 1 || !reflect.DeepEqual(vlan.entries[oldVLANKey], &EPInfo{IfIndex: old.ifindex, LxcID: uint16(old.id)}) {
+		t.Fatalf("VLAN snapshot was not restored: %#v", vlan.entries)
+	}
+}
