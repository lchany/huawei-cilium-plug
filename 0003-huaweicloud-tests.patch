+func TestEnsureGatewayNeighborScopesSameGatewayByLink(t *testing.T) {
+	firstLink := testHuaweiCloudDummyLink(t, "hwc-bmap16a")
+	secondLink := testHuaweiCloudDummyLink(t, "hwc-bmap16b")
+	gateway := net.ParseIP("10.42.16.1").To4()
+	firstMAC, _ := net.ParseMAC("02:00:00:00:16:01")
+	secondMAC, _ := net.ParseMAC("02:00:00:00:16:02")
+	subscriber := &huaweiCloudSubENISubscriber{}
+
+	first := &huaweiCloudEndpointInfo{
+		gatewayIP: gateway, gatewayMAC: firstMAC, trunkInterface: firstLink.Attrs().Name,
+	}
+	if err := subscriber.ensureGatewayNeighbor(first); err != nil {
+		t.Fatal(err)
+	}
+	if err := subscriber.ensureGatewayNeighbor(&huaweiCloudEndpointInfo{
+		gatewayIP: gateway, gatewayMAC: secondMAC, trunkInterface: firstLink.Attrs().Name,
+	}); err == nil || !strings.Contains(err.Error(), "conflicts") {
+		t.Fatalf("same-link gateway conflict was not rejected: %v", err)
+	}
+	if got := testHuaweiCloudNeighbor(t, firstLink, gateway); !bytes.Equal(got.HardwareAddr, firstMAC) {
+		t.Fatalf("first link neighbor changed: got %s want %s", got.HardwareAddr, firstMAC)
+	}
+
+	if err := subscriber.ensureGatewayNeighbor(&huaweiCloudEndpointInfo{
+		gatewayIP: gateway, gatewayMAC: secondMAC, trunkInterface: secondLink.Attrs().Name,
+	}); err != nil {
+		t.Fatalf("same gateway on a different trunk was rejected: %v", err)
+	}
+	if got := testHuaweiCloudNeighbor(t, secondLink, gateway); !bytes.Equal(got.HardwareAddr, secondMAC) {
+		t.Fatalf("second link neighbor MAC: got %s want %s", got.HardwareAddr, secondMAC)
+	}
