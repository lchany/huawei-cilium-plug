+
+func TestListSubnetsV2ResponseDecodesAvailableAddresses(t *testing.T) {
+	var response listSubnetsV2Response
+	err := json.Unmarshal([]byte(`{
+		"subnets": [
+			{"id": "subnet-empty", "available_ip_address_count": 0},
+			{"id": "subnet-ready", "available_ip_address_count": 37}
+		]
+	}`), &response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.Subnets == nil || len(*response.Subnets) != 2 {
+		t.Fatalf("unexpected subnets response: %#v", response.Subnets)
+	}
+	if got := (*response.Subnets)[0].AvailableIPAddressCount; got != 0 {
+		t.Fatalf("unexpected empty subnet capacity: %d", got)
+	}
+	if got := (*response.Subnets)[1].AvailableIPAddressCount; got != 37 {
+		t.Fatalf("available address count was not decoded: %d", got)
+	}
+}
+
+func TestGetSubnetAvailableAddressesUsesV2SubnetAPI(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/v1/project-1/subnets" {
+			t.Errorf("unexpected request path: %s", r.URL.Path)
+			http.NotFound(w, r)
+			return
+		}
+		if got := r.URL.Query().Get("vpc_id"); got != "vpc-1" {
+			t.Errorf("unexpected vpc_id: %q", got)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = fmt.Fprint(w, `{
+			"subnets": [
+				{"id": "subnet-empty", "available_ip_address_count": 0},
+				{"id": "subnet-ready", "available_ip_address_count": 37}
+			]
+		}`)
+	}))
+	defer server.Close()
+
+	client := newTestClient(t, server.URL)
+
+	got, err := client.getSubnetAvailableAddresses(context.Background(), "vpc-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got["subnet-empty"] != 0 || got["subnet-ready"] != 37 || len(got) != 2 {
+		t.Fatalf("unexpected available address map: %#v", got)
+	}
+}
+
+func TestGetSubnetAvailableAddressesRejectsNilAndDuplicateItems(t *testing.T) {
+	tests := []struct {
+		name string
+		body string
+	}{
+		{name: "nil subnets", body: `{}`},
+		{name: "empty subnet ID", body: `{"subnets":[{"id":"","available_ip_address_count":1}]}`},
+		{name: "duplicate subnet ID", body: `{"subnets":[{"id":"subnet-1","available_ip_address_count":1},{"id":"subnet-1","available_ip_address_count":2}]}`},
+		{name: "negative capacity", body: `{"subnets":[{"id":"subnet-1","available_ip_address_count":-1}]}`},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = fmt.Fprint(w, tt.body)
+			}))
+			defer server.Close()
+
+			client := newTestClient(t, server.URL)
+			if _, err := client.getSubnetAvailableAddresses(context.Background(), "vpc-1"); err == nil {
+				t.Fatal("expected malformed capacity response to fail")
+			}
+		})
+	}
+}
+
+func TestGetSubnetAvailableAddressesPageBoundaries(t *testing.T) {
+	for _, total := range []int{0, 1, 1999, 2000, 2001} {
+		t.Run(strconv.Itoa(total), func(t *testing.T) {
+			all := make([]subnetCapacity, total)
+			for i := range all {
+				all[i] = subnetCapacity{ID: fmt.Sprintf("subnet-%04d", i), AvailableIPAddressCount: int32(i)}
+			}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				start := 0
+				if marker := r.URL.Query().Get("marker"); marker != "" {
+					if _, err := fmt.Sscanf(marker, "subnet-%04d", &start); err != nil {
+						t.Errorf("invalid marker %q", marker)
+					}
+					start++
+				}
+				end := start + 2000
+				if end > len(all) {
+					end = len(all)
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(listSubnetsV2Response{Subnets: func() *[]subnetCapacity { page := all[start:end]; return &page }()})
+			}))
+			defer server.Close()
+
+			client := newTestClient(t, server.URL)
+			got, err := client.getSubnetAvailableAddresses(context.Background(), "vpc-1")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(got) != total {
+				t.Fatalf("got %d subnets, want %d", len(got), total)
+			}
+		})
+	}
+}
+
+func TestGetSubnetAvailableAddressesRejectsNonAdvancingFullPage(t *testing.T) {
+	page := make([]subnetCapacity, 2000)
+	for i := range page {
+		page[i] = subnetCapacity{ID: fmt.Sprintf("subnet-%04d", i), AvailableIPAddressCount: 1}
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(listSubnetsV2Response{Subnets: &page})
+	}))
+	defer server.Close()
+
+	client := newTestClient(t, server.URL)
+	if _, err := client.getSubnetAvailableAddresses(context.Background(), "vpc-1"); err == nil {
+		t.Fatal("expected a repeated full page to fail")
+	}
+}
+
+func TestGetSubnetAvailableAddressesHonorsCancelledContextBetweenPages(t *testing.T) {
+	page := make([]subnetCapacity, 2000)
+	for i := range page {
+		page[i] = subnetCapacity{ID: fmt.Sprintf("subnet-%04d", i), AvailableIPAddressCount: 1}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(listSubnetsV2Response{Subnets: &page})
+		cancel()
+	}))
+	defer server.Close()
+
+	client := newTestClient(t, server.URL)
+	if _, err := client.getSubnetAvailableAddresses(ctx, "vpc-1"); err == nil {
+		t.Fatal("expected cancelled context to stop pagination")
+	}
+}
+
+func TestGetSubnetAvailableAddressesHTTPFailures(t *testing.T) {
+	for _, status := range []int{http.StatusForbidden, http.StatusNotFound, http.StatusTooManyRequests, http.StatusInternalServerError} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(status)
+				_, _ = fmt.Fprint(w, `{"error_code":"VPC.TEST","error_msg":"fixture failure"}`)
+			}))
+			defer server.Close()
+
+			client := newTestClient(t, server.URL)
+			if _, err := client.getSubnetAvailableAddresses(context.Background(), "vpc-1"); err == nil {
+				t.Fatalf("expected status %d to fail", status)
+			}
+		})
+	}
+}
+
+func TestGetSubnetAvailableAddressesRecoversAfterTimeout(t *testing.T) {
+	var requests int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if atomic.AddInt32(&requests, 1) == 1 {
+			time.Sleep(30 * time.Millisecond)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = fmt.Fprint(w, `{"subnets":[]}`)
+	}))
+	defer server.Close()
+
+	client := newTestClient(t, server.URL)
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Millisecond)
+	defer cancel()
+	if _, err := client.getSubnetAvailableAddresses(ctx, "vpc-1"); err == nil {
+		t.Fatal("expected first request to time out")
+	}
+	result, err := client.getSubnetAvailableAddresses(context.Background(), "vpc-1")
+	if err != nil || len(result) != 0 {
+		t.Fatalf("recovery result=%v err=%v", result, err)
+	}
+}
+
+func TestGetSubnetsPopulatesAvailableAddresses(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/v1/project-1/subnets":
+			_, _ = fmt.Fprint(w, `{
+				"subnets": [
+					{"id": "subnet-empty", "available_ip_address_count": 0},
+					{"id": "subnet-ready", "available_ip_address_count": 37}
+				]
+			}`)
+		case "/v3/project-1/vpc/virsubnets":
+			_, _ = fmt.Fprint(w, `{
+				"virsubnets": [
+					{"id": "subnet-empty", "name": "empty", "vpc_id": "vpc-1", "zone_id": "az-1", "subnet_cidrs": [{"ip_version": "4", "cidr": "10.0.2.0/24", "gateway_ip": "10.0.2.1"}]},
+					{"id": "subnet-ready", "name": "ready", "vpc_id": "vpc-1", "zone_id": "az-1", "subnet_cidrs": [{"ip_version": "4", "cidr": "10.0.0.0/24", "gateway_ip": "10.0.0.1"}]}
+				]
+			}`)
+		default:
+			t.Errorf("unexpected request path: %s", r.URL.Path)
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+
+	client := newTestClient(t, server.URL)
+	subnets, err := client.GetSubnets(context.Background(), "vpc-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if subnets["subnet-empty"].AvailableAddresses != 0 {
+		t.Fatalf("unexpected empty subnet capacity: %#v", subnets["subnet-empty"])
+	}
+	if subnets["subnet-ready"].AvailableAddresses != 37 {
+		t.Fatalf("available addresses were not populated: %#v", subnets["subnet-ready"])
+	}
+}
+
+func TestGetSubnetsCapacityAndVirsubnetSetMismatch(t *testing.T) {
+	for _, tc := range []struct {
+		name            string
+		capacityPayload string
+		wantError       bool
+	}{
+		{
+			name:            "missing capacity for virsubnet",
+			capacityPayload: `{"subnets":[{"id":"orphan","available_ip_address_count":9}]}`,
+			wantError:       true,
+		},
+		{
+			name:            "orphan capacity ignored",
+			capacityPayload: `{"subnets":[{"id":"subnet-ready","available_ip_address_count":7},{"id":"orphan","available_ip_address_count":9}]}`,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				switch r.URL.Path {
+				case "/v1/project-1/subnets":
+					_, _ = fmt.Fprint(w, tc.capacityPayload)
+				case "/v3/project-1/vpc/virsubnets":
+					_, _ = fmt.Fprint(w, `{"virsubnets":[{"id":"subnet-ready","name":"ready","vpc_id":"vpc-1","zone_id":"az-1","subnet_cidrs":[{"ip_version":"4","cidr":"10.0.0.0/24","gateway_ip":"10.0.0.1"}]}]}`)
+				default:
+					http.NotFound(w, r)
+				}
+			}))
+			defer server.Close()
+
+			client := newTestClient(t, server.URL)
+			subnets, err := client.GetSubnets(context.Background(), "vpc-1")
+			if tc.wantError {
+				if err == nil {
+					t.Fatalf("expected missing capacity to fail, got %#v", subnets)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(subnets) != 1 || subnets["subnet-ready"] == nil || subnets["subnet-ready"].AvailableAddresses != 7 {
+				t.Fatalf("unexpected merged subnets: %#v", subnets)
+			}
+		})
+	}
+}
+
+func newTestClient(t *testing.T, endpoint string) *Client {
+	return newTestClientWithTimeout(t, endpoint, 0)
+}
+
+func newTestClientWithTimeout(t *testing.T, endpoint string, timeout time.Duration) *Client {
+	t.Helper()
+	credentials, err := auth.NewBasicCredentialsBuilder().
+		WithAk("test-ak").
+		WithSk("test-sk").
+		WithProjectId("project-1").
+		SafeBuild()
+	if err != nil {
+		t.Fatal(err)
+	}
+	builder := hwVPC.VpcClientBuilder().
+		WithEndpoint(endpoint).
+		WithCredential(credentials)
+	if timeout > 0 {
+		builder = builder.WithHttpConfig(config.DefaultHttpConfig().WithTimeout(timeout))
+	}
+	hcClient, err := builder.SafeBuild()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &Client{
+		vpcClient: hwVPC.NewVpcClient(hcClient),
+		limiter:   helpers.NewApiLimiter(noOpRateLimitMetrics{}, 20, 40),
+	}
+}
+
+func TestNewIPAMSubnetSetsAvailableAddresses(t *testing.T) {
+	item := vpcmodel.Virsubnet{
+		Id:     "subnet-1",
+		Name:   "pod-subnet",
+		VpcId:  "vpc-1",
+		ZoneId: "az-1",
+		SubnetCidrs: []vpcmodel.SubnetCidr{{
+			IpVersion: "4",
+			Cidr:      "10.0.0.0/24",
+			GatewayIp: "10.0.0.1",
+		}},
+	}
+
+	subnet, err := newIPAMSubnet(item, 23)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if subnet.AvailableAddresses != 23 {
+		t.Fatalf("unexpected available addresses: %d", subnet.AvailableAddresses)
+	}
+	if subnet.ID != item.Id || subnet.VirtualNetworkID != item.VpcId || subnet.AvailabilityZone != item.ZoneId {
+		t.Fatalf("unexpected subnet conversion: %#v", subnet)
+	}
+	if subnet.CIDR == nil || subnet.CIDR.String() != "10.0.0.0/24" || subnet.GatewayIP != "10.0.0.1" {
+		t.Fatalf("unexpected IPv4 metadata: %#v", subnet)
+	}
+}
+
+func TestNewIPAMSubnetRejectsNegativeAvailableAddresses(t *testing.T) {
+	if _, err := newIPAMSubnet(vpcmodel.Virsubnet{Id: "subnet-1"}, -1); err == nil {
+		t.Fatal("expected negative available address count to be rejected")
+	}
+}
+
+func TestNewIPAMSubnetCapacityBoundaries(t *testing.T) {
+	item := vpcmodel.Virsubnet{Id: "subnet-1", SubnetCidrs: []vpcmodel.SubnetCidr{{IpVersion: "4", Cidr: "10.0.0.0/24", GatewayIp: "10.0.0.1"}}}
+	for _, available := range []int{0, 1, int(^uint32(0) >> 1)} {
+		subnet, err := newIPAMSubnet(item, available)
+		if err != nil || subnet.AvailableAddresses != available {
+			t.Fatalf("available=%d subnet=%#v err=%v", available, subnet, err)
+		}
+	}
+}
