+func TestHuaweiCloudRoutingInfoBoundaries(t *testing.T) {
+	valid := func() (string, []string, string, string, string, bool) {
+		return "192.168.1.1", []string{"192.168.0.0/24", "192.168.2.0/24"},
+			"fa:16:3e:00:00:01", "100", ipamOption.IPAMHuaweiCloud, false
+	}
+	if _, err := NewRoutingInfo(valid()); err != nil {
+		t.Fatalf("valid HuaweiCloud routing info rejected: %v", err)
+	}
+
+	tests := map[string]func() (string, []string, string, string, string, bool){
+		"empty-gateway": func() (string, []string, string, string, string, bool) {
+			_, c, m, i, mode, masq := valid()
+			return "", c, m, i, mode, masq
+		},
+		"ipv6-gateway": func() (string, []string, string, string, string, bool) {
+			_, c, m, i, mode, masq := valid()
+			return "2001:db8::1", c, m, i, mode, masq
+		},
+		"ipv6-cidr": func() (string, []string, string, string, string, bool) {
+			g, _, m, i, mode, masq := valid()
+			return g, []string{"2001:db8::/64"}, m, i, mode, masq
+		},
+		"duplicate-cidr": func() (string, []string, string, string, string, bool) {
+			g, _, m, i, mode, masq := valid()
+			return g, []string{"192.168.0.0/24", "192.168.0.0/24"}, m, i, mode, masq
+		},
+		"empty-mac": func() (string, []string, string, string, string, bool) {
+			g, c, _, i, mode, masq := valid()
+			return g, c, "", i, mode, masq
+		},
+		"zero-mac": func() (string, []string, string, string, string, bool) {
+			g, c, _, i, mode, masq := valid()
+			return g, c, "00:00:00:00:00:00", i, mode, masq
+		},
+		"multicast-mac": func() (string, []string, string, string, string, bool) {
+			g, c, _, i, mode, masq := valid()
+			return g, c, "01:00:5e:00:00:01", i, mode, masq
+		},
+	}
+	for name, input := range tests {
+		t.Run(name, func(t *testing.T) {
+			if _, err := NewRoutingInfo(input()); err == nil {
+				t.Fatal("invalid HuaweiCloud routing info was accepted")
+			}
+		})
+	}
+	if _, err := NewRoutingInfo("192.168.1.1", []string{"192.168.0.0/16", "192.168.1.0/24"},
+		"fa:16:3e:00:00:01", "100", ipamOption.IPAMHuaweiCloud, false); err != nil {
+		t.Fatalf("valid nested VPC and SubENI subnet CIDRs rejected: %v", err)
+	}
+
+	for _, masq := range []bool{false, true} {
+		_, err := NewRoutingInfo("192.168.1.1", nil, "fa:16:3e:00:00:01", "100", ipamOption.IPAMHuaweiCloud, masq)
+		if masq && err == nil {
+			t.Fatal("masquerade=true accepted nil CIDRs")
+		}
+		if !masq && err != nil {
+			t.Fatalf("masquerade=false rejected nil CIDRs: %v", err)
+		}
+	}
+}
