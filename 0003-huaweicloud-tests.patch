+	"testing"
+
+	"github.com/cilium/ebpf"
+	"github.com/cilium/ebpf/rlimit"
+)
+
+func capacityKey(size uint32, value uint64) []byte {
+	key := make([]byte, size)
+	if size >= 8 {
+		binary.LittleEndian.PutUint64(key, value)
+	} else {
+		binary.LittleEndian.PutUint32(key, uint32(value))
+	}
+	return key
+}
+
+func exerciseMapCapacity(t *testing.T, spec *ebpf.MapSpec) {
+	t.Helper()
+	if spec.MaxEntries != 65536 {
+		t.Fatalf("unexpected max entries: got %d, want 65536", spec.MaxEntries)
+	}
+	if spec.KeySize != 4 && spec.KeySize != 8 {
+		t.Fatalf("unsupported key size: %d", spec.KeySize)
+	}
+
+	isolatedSpec := *spec
+	isolatedSpec.Pinning = ebpf.PinNone
+	m, err := ebpf.NewMap(&isolatedSpec)
+	if err != nil {
+		t.Fatal("create map:", err)
+	}
+	defer m.Close()
+
+	value := make([]byte, spec.ValueSize)
+	for i := uint64(0); i < uint64(spec.MaxEntries); i++ {
+		if err := m.Put(capacityKey(spec.KeySize, i), value); err != nil {
+			t.Fatalf("insert entry %d: %v", i, err)
+		}
+	}
+
+	overflowKey := capacityKey(spec.KeySize, uint64(spec.MaxEntries))
+	if err := m.Put(overflowKey, value); err == nil {
+		t.Fatal("insert beyond map capacity unexpectedly succeeded")
+	}
+	if err := m.Delete(capacityKey(spec.KeySize, 0)); err != nil {
+		t.Fatal("delete entry from full map:", err)
+	}
+	if err := m.Put(overflowKey, value); err != nil {
+		t.Fatal("insert after freeing one map slot:", err)
+	}
+}
+
+func TestHuaweiCloudMapCapacity(t *testing.T) {
+	if testPath == nil || *testPath == "" {
+		t.Fatal("-bpf-test-path is a required flag")
+	}
+	if err := rlimit.RemoveMemlock(); err != nil {
+		t.Log(err)
+	}
+
+	spec, err := ebpf.LoadCollectionSpec(filepath.Join(*testPath, "huaweicloud_test.o"))
+	if err != nil {
+		t.Fatal("load collection spec:", err)
+	}
+	for _, name := range []string{"cilium_hwc_srcip4", "cilium_hwc_vlan_mac"} {
+		mapSpec, ok := spec.Maps[name]
+		if !ok {
+			t.Fatalf("map %q not found", name)
+		}
+		t.Run(name, func(t *testing.T) {
+			exerciseMapCapacity(t, mapSpec)
+		})
+	}
+}
