+func TestFindOneSubnetFiltersByTagsAndPrefersExplicitIDs(t *testing.T) {
+	api := mock.NewAPI(
+		[]*ipamTypes.Subnet{
+			{ID: "subnet-pod", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 10, Tags: ipamTypes.Tags{"network-role": "pod"}},
+			{ID: "subnet-node", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 20, Tags: ipamTypes.Tags{"network-role": "node"}},
+		},
+		[]*ipamTypes.VirtualNetwork{{ID: "vpc-1"}}, nil,
+	)
+	manager := NewInstancesManager(api, "vpc-1", nil)
+	if manager.Resync(context.Background()).IsZero() {
+		t.Fatal("resync failed")
+	}
+
+	byTags := manager.FindOneSubnet(eniTypes.Spec{
+		VPCID:            "vpc-1",
+		AvailabilityZone: "az-1",
+		SubnetTags:       map[string]string{"network-role": "pod"},
+	}, 1)
+	if byTags == nil || byTags.ID != "subnet-pod" {
+		t.Fatalf("unexpected tag-selected subnet: %#v", byTags)
+	}
+
+	byID := manager.FindOneSubnet(eniTypes.Spec{
+		VPCID:            "vpc-1",
+		AvailabilityZone: "az-1",
+		Subnets:          []string{"subnet-node"},
+		SubnetTags:       map[string]string{"network-role": "pod"},
+	}, 1)
+	if byID == nil || byID.ID != "subnet-node" {
+		t.Fatalf("explicit subnet ID did not take precedence: %#v", byID)
+	}
+}
