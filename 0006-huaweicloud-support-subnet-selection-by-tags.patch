index 00000000..7112a064
--- /dev/null
+++ b/pkg/nodediscovery/huaweicloud_test.go
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package nodediscovery
+
+import (
+	"reflect"
+	"testing"
+
+	huaweiCloudTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+)
+
+func TestApplyHuaweiCloudNetConf(t *testing.T) {
+	dst := &huaweiCloudTypes.Spec{
+		Subnets:        []string{"subnet-from-agent"},
+		SecurityGroups: []string{"sg-from-agent"},
+	}
+	src := huaweiCloudTypes.Spec{
+		SubnetTags:        map[string]string{"network-role": "pod"},
+		SecurityGroupTags: map[string]string{"security-role": "pod"},
+	}
+
+	applyHuaweiCloudNetConf(dst, src)
+
+	if !reflect.DeepEqual(dst.Subnets, []string{"subnet-from-agent"}) {
+		t.Fatalf("empty CNI subnet IDs overwrote agent configuration: %v", dst.Subnets)
+	}
+	if !reflect.DeepEqual(dst.SubnetTags, src.SubnetTags) {
+		t.Fatalf("CNI subnet tags were not applied: %v", dst.SubnetTags)
+	}
+	if !reflect.DeepEqual(dst.SecurityGroups, []string{"sg-from-agent"}) {
+		t.Fatalf("empty CNI security groups overwrote agent configuration: %v", dst.SecurityGroups)
+	}
+	if !reflect.DeepEqual(dst.SecurityGroupTags, src.SecurityGroupTags) {
+		t.Fatalf("CNI security group tags were not applied: %v", dst.SecurityGroupTags)
+	}
+}
