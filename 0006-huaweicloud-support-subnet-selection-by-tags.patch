+func (t *CNITypesSuite) TestReadCNIConfHuaweiCloudSubnetTags(c *check.C) {
+	standalone := `
+{
+  "cniVersion": "0.3.1",
+  "name": "cilium",
+  "type": "cilium-cni",
+  "huawei-cloud": {
+    "subnet-tags": {
+      "network-role": "pod"
+    }
+  }
+}
+`
+	wantStandalone := NetConf{
+		NetConf: cnitypes.NetConf{
+			CNIVersion: "0.3.1",
+			Name:       "cilium",
+			Type:       "cilium-cni",
+		},
+		HuaweiCloud: huaweiCloudTypes.Spec{
+			SubnetTags: map[string]string{"network-role": "pod"},
+		},
+	}
+	testConfRead(c, standalone, &wantStandalone)
+
+	conflist := `
+{
+  "cniVersion": "0.3.1",
+  "name": "cilium",
+  "plugins": [
+    {
+      "cniVersion": "0.3.1",
+      "type": "cilium-cni",
+      "huawei-cloud": {
+        "subnet-tags": {
+          "network-role": "pod"
+        }
+      }
+    }
+  ]
+}
+`
+	wantConflist := NetConf{
+		NetConf: cnitypes.NetConf{
+			CNIVersion: "0.3.1",
+			Type:       "cilium-cni",
+		},
+		HuaweiCloud: huaweiCloudTypes.Spec{
+			SubnetTags: map[string]string{"network-role": "pod"},
+		},
+	}
+	testConfRead(c, conflist, &wantConflist)
+}
