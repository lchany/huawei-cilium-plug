+	for _, key := range stale {
+		link, err := safenetlink.LinkByName(key.LinkName)
+		if err != nil {
+			if _, ok := err.(netlink.LinkNotFoundError); ok {
+				removed = append(removed, key)
+				continue
+			}
+			return fmt.Errorf("resolve trunk interface %s: %w", key.LinkName, err)
+		}
+		neighbors, err := safenetlink.NeighList(link.Attrs().Index, netlink.FAMILY_V4)
+		if err != nil {
+			return fmt.Errorf("list gateway neighbors on trunk interface %s: %w", key.LinkName, err)
+		}
+		found := false
+		for _, neighbor := range neighbors {
+			if neighbor.IP.String() != key.IPv4 || !strings.EqualFold(neighbor.HardwareAddr.String(), key.MAC) {
+				continue
+			}
+			found = true
+			if !huaweiCloudNeighbor.Default.Contains(key.LinkName, neighbor.IP, neighbor.HardwareAddr) &&
+				neighbor.State&netlink.NUD_PERMANENT != 0 && neighbor.Flags&netlink.NTF_EXT_LEARNED != 0 {
+				if err := netlink.NeighDel(&neighbor); err != nil {
+					return fmt.Errorf("remove stale HuaweiCloud gateway neighbor %s on %s: %w", neighbor.IP, key.LinkName, err)
+				}
+			}
+			removed = append(removed, key)
+			break
+		}
+		if !found {
+			removed = append(removed, key)
+		}
+	}
+	huaweiCloudNeighbor.Default.ForgetStale(removed)
+	return nil
