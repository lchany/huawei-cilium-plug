+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+// Package neighbor tracks HuaweiCloud gateway neighbors owned by the Sub-ENI
+// endpoint manager.
+package neighbor
+
+import (
+	"net"
+	"strings"
+	"sync"
+)
+
+type Key struct {
+	LinkName string
+	IPv4     string
+	MAC      string
+}
+
+func NewKey(linkName string, ip net.IP, mac net.HardwareAddr) (Key, bool) {
+	ipv4 := ip.To4()
+	if linkName == "" || ipv4 == nil || len(mac) == 0 {
+		return Key{}, false
+	}
+	return Key{LinkName: linkName, IPv4: ipv4.String(), MAC: strings.ToLower(mac.String())}, true
+}
+
+type Registry struct {
+	mu    sync.RWMutex
+	keys  map[Key]struct{}
+	stale map[Key]struct{}
+	ready bool
+}
+
+func NewRegistry() *Registry {
+	return &Registry{keys: make(map[Key]struct{}), stale: make(map[Key]struct{})}
+}
+
+func (r *Registry) Replace(keys []Key) {
+	next := make(map[Key]struct{}, len(keys))
+	for _, key := range keys {
+		if key.LinkName != "" && key.IPv4 != "" && key.MAC != "" {
+			next[key] = struct{}{}
+		}
+	}
+	r.mu.Lock()
+	for key := range r.keys {
+		if _, found := next[key]; !found {
+			r.stale[key] = struct{}{}
+		}
+	}
+	r.keys = next
+	for key := range next {
+		delete(r.stale, key)
+	}
+	r.ready = true
+	r.mu.Unlock()
+}
+
+func (r *Registry) Contains(linkName string, ip net.IP, mac net.HardwareAddr) bool {
+	key, ok := NewKey(linkName, ip, mac)
+	if !ok {
+		return false
+	}
+	r.mu.RLock()
+	_, found := r.keys[key]
+	r.mu.RUnlock()
+	return found
+}
+
+func (r *Registry) Snapshot() []Key {
+	r.mu.RLock()
+	keys := make([]Key, 0, len(r.keys))
+	for key := range r.keys {
+		keys = append(keys, key)
+	}
+	r.mu.RUnlock()
+	return keys
+}
+
+func (r *Registry) StaleSnapshot() []Key {
+	r.mu.RLock()
+	keys := make([]Key, 0, len(r.stale))
+	for key := range r.stale {
+		keys = append(keys, key)
+	}
+	r.mu.RUnlock()
+	return keys
+}
+
+func (r *Registry) ForgetStale(keys []Key) {
+	r.mu.Lock()
+	for _, key := range keys {
+		delete(r.stale, key)
+	}
+	r.mu.Unlock()
+}
+
+func (r *Registry) Clear() {
+	r.mu.Lock()
+	r.keys = make(map[Key]struct{})
+	r.stale = make(map[Key]struct{})
+	r.ready = false
+	r.mu.Unlock()
+}
+
+func (r *Registry) Ready() bool {
+	r.mu.RLock()
+	ready := r.ready
+	r.mu.RUnlock()
+	return ready
+}
+
+var Default = NewRegistry()
