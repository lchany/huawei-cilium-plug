+++ b/pkg/datapath/linux/routing/huaweicloud.go
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package linuxrouting
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"sync"
+
+	"github.com/vishvananda/netlink"
+	"golang.org/x/sys/unix"
+
+	"github.com/cilium/cilium/pkg/datapath/linux/linux_defaults"
+	"github.com/cilium/cilium/pkg/datapath/linux/route"
+	"github.com/cilium/cilium/pkg/datapath/linux/safenetlink"
+	ipamOption "github.com/cilium/cilium/pkg/ipam/option"
+)
+
+var routingHuaweiCloudConfigureMu sync.Mutex
+
+func (info *RoutingInfo) routeTableID(ifindex int) int {
+	if info.IpamMode == ipamOption.IPAMHuaweiCloud {
+		return linux_defaults.RouteTableHuaweiCloudInterfacesOffset + info.InterfaceNumber
+	}
+	ifaceNum := info.InterfaceNumber
+	if info.useCompatEgressPriority() {
+		ifaceNum = ifindex
+	}
+	return computeTableIDFromIfaceNumber(info.useCompatEgressPriority(), ifaceNum)
+}
+
+type routeChange struct {
+	installed netlink.Route
+	previous  *netlink.Route
+}
+
+type configureTransaction struct {
+	rules         []route.Rule
+	routes        []routeChange
+	deletedRoutes []netlink.Route
+}
+
+func (tx *configureTransaction) replaceRule(spec route.Rule) error {
+	existing, err := route.ListRules(netlink.FAMILY_V4, &spec)
+	if err != nil {
+		return err
+	}
+	if err := route.ReplaceRule(spec); err != nil {
+		return err
+	}
+	if len(existing) == 0 {
+		tx.rules = append(tx.rules, spec)
+	}
+	return nil
+}
+
+func sameRouteDestination(first, second *net.IPNet) bool {
+	isDefault := func(destination *net.IPNet) bool {
+		if destination == nil {
+			return true
+		}
+		ones, bits := destination.Mask.Size()
+		return bits == 32 && ones == 0 && destination.IP.To4() != nil
+	}
+	if isDefault(first) || isDefault(second) {
+		return isDefault(first) && isDefault(second)
+	}
+	return first.String() == second.String()
+}
+
+func sameIP(first, second net.IP) bool {
+	if first == nil || second == nil {
+		return first == nil && second == nil
+	}
+	return first.Equal(second)
+}
+
+func (tx *configureTransaction) replaceRoute(spec netlink.Route) error {
+	existing, err := safenetlink.RouteListFiltered(netlink.FAMILY_V4, &netlink.Route{Table: spec.Table}, netlink.RT_FILTER_TABLE)
+	if err != nil {
+		return err
+	}
+	var previous *netlink.Route
+	for index := range existing {
+		if !sameRouteDestination(existing[index].Dst, spec.Dst) {
+			continue
+		}
+		if existing[index].Table == spec.Table &&
+			(spec.LinkIndex == 0 || existing[index].LinkIndex == spec.LinkIndex) &&
+			existing[index].Scope == spec.Scope && sameIP(existing[index].Gw, spec.Gw) {
+			return nil
+		}
+		copy := existing[index]
+		previous = &copy
+		break
+	}
+	if err := netlink.RouteReplace(&spec); err != nil {
+		return err
+	}
+	tx.routes = append(tx.routes, routeChange{installed: spec, previous: previous})
+	return nil
+}
+
+func (tx *configureTransaction) deleteRoute(spec netlink.Route) error {
+	if err := netlink.RouteDel(&spec); err != nil {
+		return err
+	}
+	tx.deletedRoutes = append(tx.deletedRoutes, spec)
+	return nil
+}
+
+func (tx *configureTransaction) rollback() error {
+	var rollbackErrors []string
+	for index := len(tx.deletedRoutes) - 1; index >= 0; index-- {
+		if err := netlink.RouteReplace(&tx.deletedRoutes[index]); err != nil {
+			rollbackErrors = append(rollbackErrors, err.Error())
+		}
+	}
+	for index := len(tx.routes) - 1; index >= 0; index-- {
+		change := tx.routes[index]
+		var err error
+		if change.previous != nil {
+			err = netlink.RouteReplace(change.previous)
+		} else {
+			err = netlink.RouteDel(&change.installed)
+			if errors.Is(err, unix.ENOENT) || errors.Is(err, unix.ESRCH) {
+				err = nil
+			}
+		}
+		if err != nil {
+			rollbackErrors = append(rollbackErrors, err.Error())
+		}
+	}
+	for index := len(tx.rules) - 1; index >= 0; index-- {
+		if err := route.DeleteRule(netlink.FAMILY_V4, tx.rules[index]); err != nil && !errors.Is(err, unix.ENOENT) && !errors.Is(err, unix.ESRCH) {
+			rollbackErrors = append(rollbackErrors, err.Error())
+		}
+	}
+	if len(rollbackErrors) > 0 {
+		return errors.New(strings.Join(rollbackErrors, "; "))
+	}
+	return nil
+}
+
+func inspectHuaweiCloudRouteTableOwnership(tableID, ifindex int, gateway net.IP) ([]netlink.Route, error) {
+	routes, err := safenetlink.RouteListFiltered(netlink.FAMILY_V4, &netlink.Route{Table: tableID}, netlink.RT_FILTER_TABLE)
+	if err != nil {
+		return nil, fmt.Errorf("unable to inspect HuaweiCloud route table %d: %w", tableID, err)
+	}
+	var conflicting []netlink.Route
+	for _, existing := range routes {
+		isDefault := existing.Dst == nil || existing.Dst.String() == "0.0.0.0/0"
+		if isDefault && existing.Gw != nil && existing.Gw.Equal(gateway) {
+			continue
+		}
+		isGatewayHostRoute := false
+		if existing.Dst != nil {
+			ones, bits := existing.Dst.Mask.Size()
+			isGatewayHostRoute = bits == 32 && ones == 32 && existing.Dst.IP.Equal(gateway) && existing.LinkIndex == ifindex
+		}
+		if !isGatewayHostRoute {
+			conflicting = append(conflicting, existing)
+		}
+	}
+	if len(conflicting) == 0 {
+		return nil, nil
+	}
+	rules, err := route.ListRules(netlink.FAMILY_V4, &route.Rule{Table: tableID})
+	if err != nil {
+		return nil, fmt.Errorf("unable to inspect rules for HuaweiCloud route table %d: %w", tableID, err)
+	}
+	if len(rules) != 0 || len(routes) != 2 {
+		return nil, fmt.Errorf("HuaweiCloud route table %d is already owned by conflicting route %s", tableID, conflicting[0].String())
+	}
+	var oldDefault, oldNexthop *netlink.Route
+	for index := range routes {
+		existing := &routes[index]
+		if existing.Dst == nil || existing.Dst.String() == "0.0.0.0/0" {
+			if existing.Gw == nil || oldDefault != nil {
+				return nil, fmt.Errorf("HuaweiCloud route table %d has an invalid retained default route", tableID)
+			}
+			oldDefault = existing
+			continue
+		}
+		ones, bits := existing.Dst.Mask.Size()
+		if bits != 32 || ones != 32 || existing.Scope != netlink.SCOPE_LINK || existing.LinkIndex != ifindex || oldNexthop != nil {
+			return nil, fmt.Errorf("HuaweiCloud route table %d is already owned by conflicting route %s", tableID, existing.String())
+		}
+		oldNexthop = existing
+	}
+	if oldDefault == nil || oldNexthop == nil || !oldNexthop.Dst.IP.Equal(oldDefault.Gw) {
+		return nil, fmt.Errorf("HuaweiCloud route table %d does not contain a complete retained route pair", tableID)
+	}
+	return []netlink.Route{*oldNexthop}, nil
+}
+
+func cleanupStaleHuaweiCloudEgressRules(ip *net.IPNet, priority, tableID int) error {
+	var deleted []route.Rule
+	restoreDeleted := func(cause error) error {
+		var restoreErrors []string
+		for index := len(deleted) - 1; index >= 0; index-- {
+			if err := route.ReplaceRule(deleted[index]); err != nil {
+				restoreErrors = append(restoreErrors, err.Error())
+			}
+		}
+		if len(restoreErrors) > 0 {
+			return fmt.Errorf("%w; restoring stale rules failed: %s", cause, strings.Join(restoreErrors, "; "))
+		}
+		return cause
+	}
+	for _, candidatePriority := range []int{linux_defaults.RulePriorityEgress, linux_defaults.RulePriorityEgressv2} {
+		rules, err := route.ListRules(netlink.FAMILY_V4, &route.Rule{Priority: candidatePriority, From: ip})
+		if err != nil {
+			return restoreDeleted(err)
+		}
+		for _, existing := range rules {
+			if existing.Priority == priority && existing.Table == tableID {
+				continue
+			}
+			var mask uint32
+			if existing.Mask != nil {
+				mask = *existing.Mask
+			}
+			spec := route.Rule{Priority: existing.Priority, Mark: existing.Mark, Mask: mask, From: existing.Src, To: existing.Dst, Table: existing.Table}
+			deleted = append(deleted, spec)
+			if err := route.DeleteRule(netlink.FAMILY_V4, spec); err != nil {
+				return restoreDeleted(err)
+			}
+		}
+	}
+	return nil
+}
