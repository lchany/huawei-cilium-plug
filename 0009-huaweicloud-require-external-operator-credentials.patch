From e9ff42f7508bb2da085519f828225157e8b4b480 Mon Sep 17 00:00:00 2001
From: lchany <lchany@users.noreply.github.com>
Date: Mon, 13 Jul 2026 19:49:18 +0800
Subject: [PATCH 9/9] huaweicloud: require external operator credentials

---
 .../cilium/templates/cilium-operator/deployment.yaml |  8 ++++----
 .../cilium/templates/cilium-operator/secret.yaml     | 12 ------------
 install/kubernetes/cilium/values.yaml                |  5 +++--
 install/kubernetes/cilium/values.yaml.tmpl           |  5 +++--
 4 files changed, 10 insertions(+), 20 deletions(-)

diff --git a/install/kubernetes/cilium/templates/cilium-operator/deployment.yaml b/install/kubernetes/cilium/templates/cilium-operator/deployment.yaml
index 1474a5ea..7221d4ea 100644
--- a/install/kubernetes/cilium/templates/cilium-operator/deployment.yaml
+++ b/install/kubernetes/cilium/templates/cilium-operator/deployment.yaml
@@ -116,15 +116,15 @@ spec:
         - name: CILIUM_HUAWEI_CLOUD_ACCESS_KEY
           valueFrom:
             secretKeyRef:
-              name: cilium-huaweicloud
+              name: {{ required "huaweicloud.existingSecret is required when HuaweiCloud is enabled" .Values.huaweicloud.existingSecret }}
               key: CILIUM_HUAWEI_CLOUD_ACCESS_KEY
-              optional: true
+              optional: false
         - name: CILIUM_HUAWEI_CLOUD_SECRET_KEY
           valueFrom:
             secretKeyRef:
-              name: cilium-huaweicloud
+              name: {{ .Values.huaweicloud.existingSecret }}
               key: CILIUM_HUAWEI_CLOUD_SECRET_KEY
-              optional: true
+              optional: false
         {{- end }}
         {{- if .Values.k8sServiceHost }}
         - name: KUBERNETES_SERVICE_HOST
diff --git a/install/kubernetes/cilium/templates/cilium-operator/secret.yaml b/install/kubernetes/cilium/templates/cilium-operator/secret.yaml
index 085a4739..42096412 100644
--- a/install/kubernetes/cilium/templates/cilium-operator/secret.yaml
+++ b/install/kubernetes/cilium/templates/cilium-operator/secret.yaml
@@ -10,16 +10,4 @@ data:
   AZURE_CLIENT_ID: {{ default "" .Values.azure.clientID | b64enc | quote }}
   AZURE_CLIENT_SECRET: {{ default "" .Values.azure.clientSecret | b64enc | quote }}
 {{- end }}
-{{- if .Values.huaweicloud.enabled }}
----
-apiVersion: v1
-kind: Secret
-metadata:
-  name: cilium-huaweicloud
-  namespace: {{ .Release.Namespace }}
-type: Opaque
-data:
-  CILIUM_HUAWEI_CLOUD_ACCESS_KEY: {{ default "" .Values.huaweicloud.accessKey | b64enc | quote }}
-  CILIUM_HUAWEI_CLOUD_SECRET_KEY: {{ default "" .Values.huaweicloud.secretKey | b64enc | quote }}
-{{- end }}
 {{- end }}
diff --git a/install/kubernetes/cilium/values.yaml b/install/kubernetes/cilium/values.yaml
index 65351da9..863ed367 100644
--- a/install/kubernetes/cilium/values.yaml
+++ b/install/kubernetes/cilium/values.yaml
@@ -259,8 +259,9 @@ alibabacloud:
 huaweicloud:
   # -- Enable HuaweiCloud Sub-ENI integration.
   enabled: false
-  # accessKey: ""
-  # secretKey: ""
+  # -- Name of a pre-created Secret containing CILIUM_HUAWEI_CLOUD_ACCESS_KEY
+  # and CILIUM_HUAWEI_CLOUD_SECRET_KEY. Required when enabled is true.
+  existingSecret: cilium-huaweicloud
   # projectID: ""
   # region: ""
   # endpoint: ""
diff --git a/install/kubernetes/cilium/values.yaml.tmpl b/install/kubernetes/cilium/values.yaml.tmpl
index 0ddd06c4..6665c20a 100644
--- a/install/kubernetes/cilium/values.yaml.tmpl
+++ b/install/kubernetes/cilium/values.yaml.tmpl
@@ -256,8 +256,9 @@ alibabacloud:
 huaweicloud:
   # -- Enable HuaweiCloud Sub-ENI integration.
   enabled: false
-  # accessKey: ""
-  # secretKey: ""
+  # -- Name of a pre-created Secret containing CILIUM_HUAWEI_CLOUD_ACCESS_KEY
+  # and CILIUM_HUAWEI_CLOUD_SECRET_KEY. Required when enabled is true.
+  existingSecret: cilium-huaweicloud
   # projectID: ""
   # region: ""
   # endpoint: ""
-- 
2.43.0
