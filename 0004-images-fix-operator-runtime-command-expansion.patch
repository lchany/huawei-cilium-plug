Date: Sat, 11 Jul 2026 09:47:41 +0800
Subject: [PATCH] images: fix operator runtime command expansion

---
 images/operator/Dockerfile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/images/operator/Dockerfile b/images/operator/Dockerfile
index 4eaec0f2..ea38511d 100644
--- a/images/operator/Dockerfile
+++ b/images/operator/Dockerfile
@@ -66,8 +66,8 @@ ARG OPERATOR_VARIANT
 LABEL maintainer="maintainer@cilium.io"
 COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
 COPY --from=gops /out/${TARGETOS}/${TARGETARCH}/bin/gops /bin/gops
-COPY --from=builder /out/${TARGETOS}/${TARGETARCH}/usr/bin/cilium-${OPERATOR_VARIANT} /usr/bin/cilium-${OPERATOR_VARIANT}
+COPY --from=builder /out/${TARGETOS}/${TARGETARCH}/usr/bin/cilium-${OPERATOR_VARIANT} /usr/bin/cilium-operator
 COPY --from=builder /out/${TARGETOS}/${TARGETARCH}/LICENSE.all /LICENSE.all
 WORKDIR /
 ENV GOPS_CONFIG_DIR=/
-CMD ["/usr/bin/cilium-${OPERATOR_VARIANT}"]
+CMD ["/usr/bin/cilium-operator"]
