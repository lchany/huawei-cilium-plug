index 0000000000..287f54a55e
--- /dev/null
+++ b/bpf/lib/huaweicloud.h
@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/* Copyright Authors of Cilium */
+
+#pragma once
+
+#ifdef ENABLE_HUAWEICLOUD_VLAN
+
+#include "common.h"
+#include "eth.h"
+#include "local_delivery.h"
+#include "drop.h"
+
+/* ===== Stage 9: BPF Map definitions ===== */
+/*
+ * Map 1: source IP -> SubENI info  (used by egress path)
+ * Key:   pod IPv4 address
+ * Value: SubENI VLAN ID, MAC address, LXC ID
+ */
+
+struct hwc_srcip_key4 {
+	__u32 addr;     /* Pod IPv4 address */
+};
+
+struct hwc_srcip_key6 {
+	__u8 addr[16];  /* Pod IPv6 address */
+};
+
+struct hwc_subeni_info {
+	__u16 vlan_id;  /* SubENI VLAN ID */
+	__u8  mac[6];   /* SubENI MAC address */
+	__u16 pad;
+	__u16 reserved;
+	__u32 lxc_id;   /* Endpoint LXC ID */
+};
+
+struct {
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__type(key, struct hwc_srcip_key4);
+	__type(value, struct hwc_subeni_info);
+	__uint(max_entries, 65536);
+	__uint(pinning, LIBBPF_PIN_BY_NAME);
+} cilium_hwc_srcip4 __section_maps_btf;
+
+struct {
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__type(key, struct hwc_srcip_key6);
+	__type(value, struct hwc_subeni_info);
+	__uint(max_entries, 65536);
+	__uint(pinning, LIBBPF_PIN_BY_NAME);
+} cilium_hwc_srcip6 __section_maps_btf;
+
+/*
+ * Map 2: (VLAN ID + dst MAC) -> endpoint info  (used by ingress path)
+ * Key:   VLAN ID + destination MAC
+ * Value: veth ifindex, LXC ID, flags
+ */
+
+struct hwc_vlan_mac_key {
+	__u16 vlan_id;
+	__u8  mac[6];   /* Destination MAC */
+};
+
+struct hwc_ep_info {
+	__u32 ifindex;  /* Endpoint veth ifindex */
+	__u16 lxc_id;
+	__u16 flags;
+};
+
+struct {
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__type(key, struct hwc_vlan_mac_key);
+	__type(value, struct hwc_ep_info);
+	__uint(max_entries, 65536);
+	__uint(pinning, LIBBPF_PIN_BY_NAME);
+} cilium_hwc_vlan_mac __section_maps_btf;
+
+/* ===== Stage 10: Egress — hwc_to_netdev ===== */
+/*
+ * hwc_to_netdev: called from cil_to_netdev on the trunk interface.
+ *
+ * For packets originating from SubENI-managed pods:
+ *   1. Look up the pod's source IP in Map 1 to get the SubENI's VLAN ID and MAC.
+ *   2. Rewrite the source MAC to the SubENI's MAC address.
+ *   3. Push an 802.1Q VLAN tag with the SubENI's VLAN ID.
+ *
+ * Non-SubENI traffic (map miss) is passed through unchanged.
+ */
+static __always_inline int
+hwc_to_netdev(struct __ctx_buff *ctx, __be16 proto)
+{
+	struct hwc_subeni_info *info;
+	__u32 src_ip4 = 0;
+
+	/* Only process traffic on the trunk interface. */
+	if (ctx->ifindex != HWC_TRUNK_IFINDEX)
+		return CTX_ACT_OK;
+
+	/* Only handle IPv4 for now; IPv6 is a future extension. */
+	if (proto != bpf_htons(ETH_P_IP))
+		return CTX_ACT_OK;
+
+	if (ctx_load_bytes(ctx, ETH_HLEN + offsetof(struct iphdr, saddr),
+			   &src_ip4, sizeof(src_ip4)) < 0)
+		return CTX_ACT_OK;
+
+	struct hwc_srcip_key4 key = { .addr = src_ip4 };
+
+	info = map_lookup_elem(&cilium_hwc_srcip4, &key);
+	if (!info)
+		return CTX_ACT_OK; /* Not a SubENI pod — pass through. */
+
+	/* Rewrite source MAC to the SubENI's MAC address. */
+	if (eth_store_saddr(ctx, info->mac, 0) < 0)
+		return DROP_HWC_MAC_REWRITE_FAIL;
+
+	/* Push 802.1Q VLAN tag with the SubENI's VLAN ID. */
+	if (skb_vlan_push(ctx, bpf_htons(ETH_P_8021Q), info->vlan_id) < 0)
+		return DROP_HWC_VLAN_PUSH_FAIL;
+
+	return CTX_ACT_OK;
+}
+
+/* ===== Stage 11: Ingress — hwc_from_netdev ===== */
+/*
+ * hwc_from_netdev: called from cil_from_netdev on the trunk interface.
+ *
+ * For inbound 802.1Q-tagged packets destined for SubENI-managed pods:
+ *   1. Check that the packet carries a VLAN tag on the trunk interface.
+ *   2. Look up (VLAN ID + dst MAC) in Map 2 to find the target endpoint.
+ *   3. Strip the VLAN tag.
+ *   4. Fall back to the generic host ingress path so normal local-delivery
+ *      logic can rewrite L2 headers, enforce policy, and redirect.
+ *
+ * Packets without a VLAN tag or with an unknown (VLAN, MAC) pair are
+ * returned as CTX_ACT_OK so the caller can continue with default processing.
+ */
+static __always_inline int
+hwc_from_netdev(struct __ctx_buff *ctx)
+{
+	struct hwc_vlan_mac_key key __align_stack_8 = {};
+	struct hwc_ep_info *ep;
+	void *data, *data_end;
+	struct ethhdr *eth;
+
+	/* Only process traffic on the trunk interface. */
+	if (ctx->ifindex != HWC_TRUNK_IFINDEX)
+		return CTX_ACT_OK;
+
+	/* Packets without a VLAN tag are not SubENI traffic. */
+	if (!ctx->vlan_present)
+		return CTX_ACT_OK;
+
+	/* Validate Ethernet header bounds. */
+	data     = (void *)(long)ctx->data;
+	data_end = (void *)(long)ctx->data_end;
+	eth = data;
+	if ((void *)(eth + 1) > data_end)
+		return DROP_INVALID;
+
+	/* Build the lookup key from VLAN ID and destination MAC. */
+	key.vlan_id = ctx->vlan_tci & 0xfff;
+	key.mac[0] = eth->h_dest[0];
+	key.mac[1] = eth->h_dest[1];
+	key.mac[2] = eth->h_dest[2];
+	key.mac[3] = eth->h_dest[3];
+	key.mac[4] = eth->h_dest[4];
+	key.mac[5] = eth->h_dest[5];
+
+	ep = map_lookup_elem(&cilium_hwc_vlan_mac, &key);
+	if (!ep)
+		return CTX_ACT_OK; /* Unknown (VLAN, MAC) — continue default path. */
+
+	/* Strip the VLAN tag before handing off to the endpoint. */
+	if (skb_vlan_pop(ctx) < 0)
+		return DROP_HWC_VLAN_POP_FAIL;
+
+	ctx_change_type(ctx, PACKET_HOST);
+
+	return CTX_ACT_OK;
+}
+
+#endif /* ENABLE_HUAWEICLOUD_VLAN */
