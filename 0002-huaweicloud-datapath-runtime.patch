+func parseEndpointConditionsV1Beta1(conditions discoveryv1beta1.EndpointConditions) (bc BackendCondition) {
+	if conditions.Ready == nil || *conditions.Ready {
+		bc |= BackendConditionReady
+	}
+	if conditions.Serving == nil || conditions.Serving != nil && *conditions.Serving {
+		bc |= BackendConditionServing
+	}
+	if conditions.Terminating != nil && *conditions.Terminating {
+		bc |= BackendConditionTerminating
+	}
+	return
+}
+
+func parseEndpointSliceV1Beta1(logger *slog.Logger, ep *discoveryv1beta1.EndpointSlice) *Endpoints {
+	backendCount := 0
+	for _, sub := range ep.Endpoints {
+		backendCount += len(sub.Addresses)
+	}
+	endpoints := newEndpoints(backendCount)
+	endpoints.ObjectMeta = slimObjectMetaFromMetaV1(ep.ObjectMeta)
+	endpoints.EndpointSliceID = ParseEndpointSliceID(ep)
+
+	if ep.AddressType != discoveryv1beta1.AddressTypeIPv4 &&
+		ep.AddressType != discoveryv1beta1.AddressTypeIPv6 {
+		return endpoints
+	}
+
+	logger.Debug("Processing endpoints for EndpointSlice v1beta1",
+		logfields.LenEndpoints, len(ep.Endpoints),
+		logfields.Name, ep.Name,
+	)
+
+	ports := make(map[loadbalancer.L4Addr][]string, len(ep.Ports))
+	for _, port := range ep.Ports {
+		if name, lbPort, ok := parseEndpointPortV1Beta1(port); ok {
+			ports[lbPort] = append(ports[lbPort], name)
+		}
+	}
+
+	for i, sub := range ep.Endpoints {
+		backend := &Backend{
+			Conditions: parseEndpointConditionsV1Beta1(sub.Conditions),
+			Ports:      ports,
+		}
+
+		if sub.NodeName != nil {
+			backend.NodeName = *sub.NodeName
+		} else if nodeName, ok := sub.Topology[corev1.LabelHostname]; ok {
+			backend.NodeName = nodeName
+		}
+
+		if sub.Hostname != nil {
+			backend.Hostname = *sub.Hostname
+		}
+		if zoneName, ok := sub.Topology[corev1.LabelTopologyZone]; ok {
+			backend.Zone = zoneName
+		}
+
+		if sub.Hints != nil && len(sub.Hints.ForZones) > 0 {
+			hints := sub.Hints.ForZones
+			backend.HintsForZones = make([]string, len(hints))
+			for i, hint := range hints {
+				backend.HintsForZones[i] = hint.Name
+			}
+		}
+
+		for _, addr := range sub.Addresses {
+			addrCluster, err := cmtypes.ParseAddrCluster(addr)
+			if err != nil {
+				logger.Info(
+					"Unable to parse address in EndpointSlice v1beta1",
+					logfields.Error, err,
+					logfields.Address, addr,
+					logfields.Name, ep.Name,
+				)
+				continue
+			}
+			endpoints.Backends[addrCluster] = backend
+		}
+
+		if backend.Conditions.IsTerminating() {
+			metrics.TerminatingEndpointsEvents.Inc()
+		}
+
+		logger.Debug("Processed endpoint",
+			logfields.Index, i,
+			logfields.Name, ep.Name,
+			logfields.Addresses, sub.Addresses,
+			logfields.Backend, backend,
+			logfieldTerminating, backend.Conditions.IsTerminating(),
+		)
+	}
+
+	return endpoints
+}
+
+func parseEndpointPortV1Beta1(port discoveryv1beta1.EndpointPort) (name string, addr loadbalancer.L4Addr, ok bool) {
+	proto := loadbalancer.TCP
+	if port.Protocol != nil {
+		switch *port.Protocol {
+		case corev1.ProtocolTCP:
+			proto = loadbalancer.TCP
+		case corev1.ProtocolUDP:
+			proto = loadbalancer.UDP
+		case corev1.ProtocolSCTP:
+			proto = loadbalancer.SCTP
+		default:
+			return
+		}
+	}
+	if port.Port == nil {
+		return
+	}
+	if port.Name != nil {
+		name = *port.Name
+	}
+	return name, loadbalancer.NewL4Addr(proto, uint16(*port.Port)), true
+}
diff --git a/pkg/k8s/endpointslice_compat.go b/pkg/k8s/endpointslice_compat.go
new file mode 100644
index 0000000000..eefef4ec95
--- /dev/null
+++ b/pkg/k8s/endpointslice_compat.go
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package k8s
+
+import (
+	"fmt"
+	"log/slog"
+
+	discoveryv1 "k8s.io/api/discovery/v1"
+	discoveryv1beta1 "k8s.io/api/discovery/v1beta1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	k8sRuntime "k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/client-go/tools/cache"
+
+	"github.com/cilium/cilium/pkg/k8s/client"
+	slim_discoveryv1 "github.com/cilium/cilium/pkg/k8s/slim/k8s/api/discovery/v1"
+	"github.com/cilium/cilium/pkg/k8s/utils"
+	"github.com/cilium/cilium/pkg/logging/logfields"
+)
+
+const endpointSliceResourceName = "endpointslices"
+
+func NewEndpointSliceListerWatcher(logger *slog.Logger, cs client.Clientset, opts ...func(*metav1.ListOptions)) (cache.ListerWatcher, k8sRuntime.Object) {
+	if endpointSliceV1Supported(logger, cs) {
+		logger.Info("Using discoveryv1.EndpointSlice")
+		lw := utils.ListerWatcherFromTyped[*slim_discoveryv1.EndpointSliceList](cs.Slim().DiscoveryV1().EndpointSlices(""))
+		return utils.ListerWatcherWithModifiers(lw, opts...), &slim_discoveryv1.EndpointSlice{}
+	}
+
+	logger.Info("Using discoveryv1beta1.EndpointSlice")
+	lw := utils.ListerWatcherFromTyped[*discoveryv1beta1.EndpointSliceList](cs.DiscoveryV1beta1().EndpointSlices(""))
+	return utils.ListerWatcherWithModifiers(lw, opts...), &discoveryv1beta1.EndpointSlice{}
+}
+
+func endpointSliceV1Supported(logger *slog.Logger, cs client.Clientset) bool {
+	resources, err := cs.Discovery().ServerResourcesForGroupVersion(discoveryv1.SchemeGroupVersion.String())
+	switch {
+	case err == nil:
+		return hasEndpointSliceResource(resources)
+	case apierrors.IsNotFound(err):
+		return false
+	default:
+		logger.Warn("Unable to detect discovery/v1 EndpointSlice support, defaulting to discovery/v1",
+			logfields.Error, err,
+		)
+		return true
+	}
+}
+
+func hasEndpointSliceResource(resources *metav1.APIResourceList) bool {
+	if resources == nil {
+		return false
+	}
+	for _, resource := range resources.APIResources {
+		if resource.Name == endpointSliceResourceName {
+			return true
+		}
+	}
+	return false
+}
+
+func ParseEndpointSlice(logger *slog.Logger, obj any) (*Endpoints, error) {
+	switch obj := obj.(type) {
+	case *slim_discoveryv1.EndpointSlice:
+		return ParseEndpointSliceV1(logger, obj), nil
+	case *discoveryv1beta1.EndpointSlice:
+		return parseEndpointSliceV1Beta1(logger, obj), nil
+	default:
+		return nil, fmt.Errorf("%T not a known endpoint slice object", obj)
+	}
+}
