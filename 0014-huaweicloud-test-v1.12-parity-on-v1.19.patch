+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package neighbor
+
+import (
+	"net"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestRegistryMatchesExactGatewayNeighbor(t *testing.T) {
+	registry := NewRegistry()
+	ip := net.ParseIP("10.0.0.1")
+	mac, err := net.ParseMAC("fa:16:3e:00:00:fe")
+	require.NoError(t, err)
+	key, ok := NewKey("eth0", ip, mac)
+	require.True(t, ok)
+	registry.Replace([]Key{key, key})
+	require.True(t, registry.Ready())
+	require.True(t, registry.Contains("eth0", ip, mac))
+	require.False(t, registry.Contains("eth1", ip, mac))
+	otherMAC, err := net.ParseMAC("fa:16:3e:00:00:ff")
+	require.NoError(t, err)
+	require.False(t, registry.Contains("eth0", ip, otherMAC))
+	require.Len(t, registry.Snapshot(), 1)
+}
+
+func TestRegistryTracksStaleNeighbors(t *testing.T) {
+	registry := NewRegistry()
+	firstMAC, _ := net.ParseMAC("fa:16:3e:00:00:01")
+	secondMAC, _ := net.ParseMAC("fa:16:3e:00:00:02")
+	first, _ := NewKey("eth0", net.ParseIP("10.0.0.1"), firstMAC)
+	second, _ := NewKey("eth0", net.ParseIP("10.0.1.1"), secondMAC)
+	registry.Replace([]Key{first})
+	registry.Replace([]Key{second})
+	require.Equal(t, []Key{first}, registry.StaleSnapshot())
+	registry.ForgetStale([]Key{first})
+	require.Empty(t, registry.StaleSnapshot())
+	registry.Clear()
+	require.False(t, registry.Ready())
+}
