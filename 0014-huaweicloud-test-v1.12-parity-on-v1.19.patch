+func TestGatewayNeighborOwnershipFollowsBindings(t *testing.T) {
+	huaweiCloudNeighbor.Default.Clear()
+	t.Cleanup(huaweiCloudNeighbor.Default.Clear)
+	subscriber := &huaweiCloudSubENISubscriber{}
+	gatewayIP := net.ParseIP("10.0.0.1")
+	gatewayMAC, err := net.ParseMAC("fa:16:3e:00:00:fe")
+	require.NoError(t, err)
+	first := &huaweiCloudEndpointInfo{id: 1, gatewayIP: gatewayIP, gatewayMAC: gatewayMAC, trunkInterface: "eth0"}
+	second := &huaweiCloudEndpointInfo{id: 2, gatewayIP: gatewayIP, gatewayMAC: gatewayMAC, trunkInterface: "eth0"}
+	subscriber.bindings.Store(uint64(1), first)
+	subscriber.bindings.Store(uint64(2), second)
+	subscriber.refreshGatewayNeighborOwnership()
+	require.True(t, huaweiCloudNeighbor.Default.Ready())
+	require.Len(t, huaweiCloudNeighbor.Default.Snapshot(), 1)
+
+	subscriber.bindings.Delete(uint64(1))
+	subscriber.refreshGatewayNeighborOwnership()
+	require.True(t, huaweiCloudNeighbor.Default.Contains("eth0", gatewayIP, gatewayMAC))
+	subscriber.bindings.Delete(uint64(2))
+	subscriber.refreshGatewayNeighborOwnership()
+	require.False(t, huaweiCloudNeighbor.Default.Contains("eth0", gatewayIP, gatewayMAC))
+}
