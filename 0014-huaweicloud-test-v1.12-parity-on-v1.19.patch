+func TestFillSubENIsGatewayInfoBatchesListPorts(t *testing.T) {
+	portRequests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		require.Contains(t, r.URL.Path, "ports")
+		portRequests++
+		require.Equal(t, []string{"network:router_interface_distributed"}, r.URL.Query()["device_owner"])
+		require.Equal(t, []string{"subnet-1"}, r.URL.Query()["virsubnet_id"])
+		require.Equal(t, []string{"ip_address=10.0.0.1"}, r.URL.Query()["private_ips"])
+		_, _ = fmt.Fprint(w, `{"ports":[{"virsubnet_id":"subnet-1","mac_address":"fa:16:3e:00:00:fe","private_ips":[{"ip_address":"10.0.0.1"}]}]}`)
+	}))
+	defer server.Close()
+
+	client := newParityTestClient(t, server.URL)
+	subENIs := []*eniTypes.SubENI{
+		{ID: "eni-1", SubnetID: "subnet-1", PrivateIPAddress: "10.0.0.2"},
+		{ID: "eni-2", SubnetID: "subnet-1", PrivateIPAddress: "10.0.0.3"},
+		{ID: "eni-3", SubnetID: "subnet-1", PrivateIPAddress: "10.0.0.4"},
+	}
+	prefix := ipamTypes.SubnetMap{"subnet-1": {ID: "subnet-1", GatewayIP: "10.0.0.1"}}
+	parsed, err := netip.ParsePrefix("10.0.0.0/24")
+	require.NoError(t, err)
+	prefix["subnet-1"].CIDR = parsed
+	require.NoError(t, client.fillSubENIsGatewayInfo(context.Background(), subENIs, prefix))
+	require.Equal(t, 1, portRequests)
+	for _, subENI := range subENIs {
+		require.Equal(t, "10.0.0.1", subENI.GatewayIP)
+		require.Equal(t, "10.0.0.0/24", subENI.SubnetCIDR)
+		require.Equal(t, "fa:16:3e:00:00:fe", subENI.GatewayMAC)
+	}
+}
+
+func TestGetSubnetsPopulatesAvailableAddresses(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/subnets"):
+			_, _ = fmt.Fprint(w, `{"subnets":[{"id":"subnet-empty","available_ip_address_count":0},{"id":"subnet-ready","available_ip_address_count":37}]}`)
+		case strings.Contains(r.URL.Path, "virsubnets"):
+			_, _ = fmt.Fprint(w, `{"virsubnets":[{"id":"subnet-empty","name":"empty","vpc_id":"vpc-1","zone_id":"az-1","subnet_cidrs":[{"ip_version":"4","cidr":"10.0.2.0/24","gateway_ip":"10.0.2.1"}]},{"id":"subnet-ready","name":"ready","vpc_id":"vpc-1","zone_id":"az-1","subnet_cidrs":[{"ip_version":"4","cidr":"10.0.0.0/24","gateway_ip":"10.0.0.1"}]}]}`)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+
+	client := newParityTestClient(t, server.URL)
+	subnets, err := client.GetSubnets(context.Background(), "vpc-1")
+	require.NoError(t, err)
+	require.Equal(t, 0, subnets["subnet-empty"].AvailableAddresses)
+	require.Equal(t, 37, subnets["subnet-ready"].AvailableAddresses)
+}
+
+func TestListSubnetsV2ResponseDecodesCapacity(t *testing.T) {
+	var response listSubnetsV2Response
+	require.NoError(t, json.Unmarshal([]byte(`{"subnets":[{"id":"subnet-ready","available_ip_address_count":37}]}`), &response))
+	require.NotNil(t, response.Subnets)
+	require.Equal(t, int32(37), (*response.Subnets)[0].AvailableIPAddressCount)
+}
