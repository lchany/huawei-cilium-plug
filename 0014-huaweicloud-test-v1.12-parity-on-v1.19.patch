+func newParityTestClient(t *testing.T, endpoint string) *Client {
+	t.Helper()
+	credentials, err := auth.NewBasicCredentialsBuilder().
+		WithAk("test-ak").
+		WithSk("test-sk").
+		WithProjectId("project-1").
+		SafeBuild()
+	require.NoError(t, err)
+	hcClient, err := hwVPC.VpcClientBuilder().WithEndpoint(endpoint).WithCredential(credentials).SafeBuild()
+	require.NoError(t, err)
+	return &Client{
