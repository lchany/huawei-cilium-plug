+func (c *Client) fillSubENIGatewayInfo(ctx context.Context, subENI *eniTypes.SubENI, cachedSubnets ipamTypes.SubnetMap) error {
+	if subENI == nil || subENI.SubnetID == "" {
+		return nil
+	}
+	if subENI.GatewayIP == "" || subENI.SubnetCIDR == "" {
+		gatewayIP, subnetCIDR, err := c.resolveSubENISubnetMetadata(ctx, subENI.SubnetID, subENI.PrivateIPAddress, cachedSubnets)
+		if err != nil {
+			return err
+		}
+		if subENI.GatewayIP == "" {
+			subENI.GatewayIP = gatewayIP
+		}
+		if subENI.SubnetCIDR == "" {
+			subENI.SubnetCIDR = subnetCIDR
+		}
+	}
+	if subENI.GatewayIP == "" || subENI.GatewayMAC != "" {
+		return nil
+	}
+
+	deviceOwners := []string{"network:router_interface_distributed"}
+	privateIPs := []string{fmt.Sprintf("ip_address=%s", subENI.GatewayIP)}
+	virsubnetIDs := []string{subENI.SubnetID}
+	request := &vpcmodel.ListPortsRequest{
+		DeviceOwner: &deviceOwners,
+		PrivateIps:  &privateIPs,
+		VirsubnetId: &virsubnetIDs,
+	}
+
+	c.limiter.Limit(ctx, "ListPorts")
+	response, err := c.vpcClient.ListPorts(request)
+	if err != nil {
+		return normalizeAPIError(err)
+	}
+	if response.Ports == nil || len(*response.Ports) == 0 {
+		return nil
+	}
+
+	subENI.GatewayMAC = (*response.Ports)[0].MacAddress
+	return nil
+}
+
+func (c *Client) resolveSubENISubnetMetadata(ctx context.Context, subnetID, privateIP string, cachedSubnets ipamTypes.SubnetMap) (string, string, error) {
+	if subnetID == "" {
+		return "", "", nil
+	}
+	if subnet := cachedSubnets[subnetID]; subnet != nil {
+		cidr := ""
+		if subnet.CIDR.IsValid() {
+			cidr = subnet.CIDR.String()
+		}
+		if subnet.GatewayIP != "" {
+			if privateIP == "" || cidr == "" || belongsToCIDR(privateIP, cidr) {
+				return subnet.GatewayIP, cidr, nil
+			}
+		}
+	}
+
+	limit := int32(1)
+	ids := []string{subnetID}
+	request := &vpcmodel.ListVirsubnetsRequest{Limit: &limit, Id: &ids}
+
+	c.limiter.Limit(ctx, "ListVirsubnets")
+	response, err := c.vpcClient.ListVirsubnets(request)
+	if err != nil {
+		return "", "", normalizeAPIError(err)
+	}
+	if response.Virsubnets == nil || len(*response.Virsubnets) == 0 {
+		return "", "", nil
+	}
+
+	gatewayIP, subnetCIDR := selectIPv4SubnetCIDRAndGateway((*response.Virsubnets)[0].SubnetCidrs, privateIP)
+	return gatewayIP, subnetCIDR, nil
+}
+
+func belongsToCIDR(ipStr, cidrStr string) bool {
+	ip, err := netip.ParseAddr(ipStr)
+	if err != nil {
+		return false
+	}
+	prefix, err := netip.ParsePrefix(cidrStr)
+	if err != nil {
+		return false
+	}
+	return prefix.Contains(ip)
+}
+
+func selectIPv4SubnetCIDRAndGateway(subnetCIDRs []vpcmodel.SubnetCidr, privateIP string) (gatewayIP, subnetCIDR string) {
+	for _, entry := range subnetCIDRs {
+		if entry.IpVersion != "4" || entry.Cidr == "" {
+			continue
+		}
+		if privateIP != "" && belongsToCIDR(privateIP, entry.Cidr) {
+			return entry.GatewayIp, entry.Cidr
+		}
+	}
+
+	for _, entry := range subnetCIDRs {
+		if entry.IpVersion == "4" && entry.Cidr != "" {
+			return entry.GatewayIp, entry.Cidr
+		}
+	}
+
+	return "", ""
+}
