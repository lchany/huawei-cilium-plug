+func (c *Client) listSubNetworkInterfaces(ctx context.Context, parentIDs []string) ([]vpcmodel.SubNetworkInterface, error) {
+	limit := int32(2000)
+	request := &vpcmodel.ListSubNetworkInterfacesRequest{Limit: &limit}
+	if len(parentIDs) > 0 {
+		request.ParentId = &parentIDs
+	}
+	var result []vpcmodel.SubNetworkInterface
+	seenMarkers := map[string]struct{}{}
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		if err := c.limiter.Limit(ctx, "ListSubNetworkInterfaces"); err != nil {
+			return nil, err
+		}
+		response, err := c.vpcClient.ListSubNetworkInterfaces(request)
+		if err != nil {
+			return nil, normalizeAPIError(err)
+		}
+		if response.SubNetworkInterfaces != nil {
+			result = append(result, (*response.SubNetworkInterfaces)...)
+		}
+		marker, err := nextUniqueMarker(response.PageInfo, seenMarkers, "ListSubNetworkInterfaces")
+		if err != nil {
+			return nil, err
+		}
+		request.Marker = marker
+		if marker == nil {
+			return result, nil
+		}
+	}
+}
+
+func nextMarker(pageInfo *vpcmodel.PageInfo) *string {
+	if pageInfo == nil || pageInfo.NextMarker == nil || *pageInfo.NextMarker == "" {
+		return nil
+	}
+	return pageInfo.NextMarker
+}
+
+func nextUniqueMarker(pageInfo *vpcmodel.PageInfo, seen map[string]struct{}, operation string) (*string, error) {
+	marker := nextMarker(pageInfo)
+	if marker == nil {
+		return nil, nil
+	}
+	if _, exists := seen[*marker]; exists {
+		return nil, fmt.Errorf("%s returned repeated marker %q", operation, *marker)
+	}
+	seen[*marker] = struct{}{}
+	return marker, nil
+}
