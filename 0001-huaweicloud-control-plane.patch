index 0000000000..6d486e936a
--- /dev/null
+++ b/operator/provider_huaweicloud_flags.go
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+//go:build ipam_provider_huaweicloud
+
+package main
+
+import (
+	"github.com/spf13/viper"
+
+	operatorOption "github.com/cilium/cilium/operator/option"
+	"github.com/cilium/cilium/pkg/option"
+)
+
+func init() {
+	flags := rootCmd.Flags()
+
+	flags.String(operatorOption.HuaweiCloudAccessKey, "", "Access key for HuaweiCloud API")
+	option.BindEnv(operatorOption.HuaweiCloudAccessKey)
+
