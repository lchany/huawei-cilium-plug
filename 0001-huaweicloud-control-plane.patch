+func (c *Client) GetInstanceLimits(ctx context.Context, instanceID string) (ipamTypes.Limits, error) {
+	if err := ctx.Err(); err != nil {
+		return ipamTypes.Limits{}, err
+	}
+	if strings.TrimSpace(instanceID) == "" {
+		return ipamTypes.Limits{}, fmt.Errorf("instanceID is required")
+	}
+
+	serverReq := &ecsmodel.ShowServerRequest{ServerId: instanceID}
+	c.limiter.Limit(ctx, "ShowServer")
+	serverResp, err := c.ecsClient.ShowServer(serverReq)
+	if err != nil {
+		return ipamTypes.Limits{}, normalizeAPIError(err)
+	}
+
+	flavorID, err := flavorIDFromServer(serverResp.Server, instanceID)
+	if err != nil {
+		return ipamTypes.Limits{}, err
+	}
+
+	flavorsReq := &ecsmodel.ListFlavorsRequest{FlavorId: &flavorID}
+	c.limiter.Limit(ctx, "ListFlavors")
+	flavorsResp, err := c.ecsClient.ListFlavors(flavorsReq)
+	if err != nil {
+		return ipamTypes.Limits{}, normalizeAPIError(err)
+	}
+
+	maxSubENIs, err := subENILimitFromFlavors(flavorsResp.Flavors, flavorID)
+	if err != nil {
+		return ipamTypes.Limits{}, err
+	}
+
+	return ipamTypes.Limits{Adapters: 1, IPv4: maxSubENIs}, nil
+}
+
+func flavorIDFromServer(server *ecsmodel.ServerDetail, instanceID string) (string, error) {
+	if server == nil {
+		return "", fmt.Errorf("empty server detail for instance %s", instanceID)
+	}
+	if server.Flavor == nil || strings.TrimSpace(server.Flavor.Id) == "" {
+		return "", fmt.Errorf("empty flavor id for instance %s", instanceID)
+	}
+
+	return server.Flavor.Id, nil
+}
+
+func subENILimitFromFlavors(flavors *[]ecsmodel.Flavor, flavorID string) (int, error) {
+	if flavors == nil || len(*flavors) == 0 {
+		return 0, fmt.Errorf("no flavors found for flavor %s", flavorID)
+	}
+
+	for _, flavor := range *flavors {
+		if flavor.Id != flavorID && flavor.Name != flavorID {
+			continue
+		}
+		if flavor.OsExtraSpecs == nil || flavor.OsExtraSpecs.QuotasubNetworkInterfaceMaxNum == nil {
+			return 0, fmt.Errorf("sub network interface limit is missing for flavor %s", flavorID)
+		}
+
+		limit, err := strconv.Atoi(strings.TrimSpace(*flavor.OsExtraSpecs.QuotasubNetworkInterfaceMaxNum))
+		if err != nil {
+			return 0, fmt.Errorf("parse sub network interface limit for flavor %s: %w", flavorID, err)
+		}
+		if limit < 0 {
+			return 0, fmt.Errorf("sub network interface limit for flavor %s is negative", flavorID)
+		}
+
+		return limit, nil
+	}
+
+	return 0, fmt.Errorf("flavor %s not found", flavorID)
+}
+
+func (c *Client) GetInstances(ctx context.Context, vpcs ipamTypes.VirtualNetworkMap, subnets ipamTypes.SubnetMap) (*ipamTypes.InstanceMap, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	_ = vpcs
+	_ = subnets
+
+	limit := int32(1000)
+	serversReq := &ecsmodel.ListServersDetailsRequest{Limit: &limit}
+	c.limiter.Limit(ctx, "ListServersDetails")
+	serversResp, err := c.ecsClient.ListServersDetails(serversReq)
+	if err != nil {
+		return nil, normalizeAPIError(err)
+	}
+
+	parentToInstance := map[string]string{}
+	if serversResp.Servers != nil {
+		for _, server := range *serversResp.Servers {
+			for _, portID := range getParentPortsFromServer(&server) {
+				parentToInstance[portID] = server.Id
+			}
+		}
+	}
+
+	listReq := &vpcmodel.ListSubNetworkInterfacesRequest{}
+	listLimit := int32(2000)
+	listReq.Limit = &listLimit
+	c.limiter.Limit(ctx, "ListSubNetworkInterfaces")
+	listResp, err := c.vpcClient.ListSubNetworkInterfaces(listReq)
+	if err != nil {
+		return nil, normalizeAPIError(err)
+	}
+
+	instances := ipamTypes.NewInstanceMap()
+	if listResp.SubNetworkInterfaces == nil {
+		return instances, nil
+	}
+	for _, item := range *listResp.SubNetworkInterfaces {
+		subENI := parseSubENI(&item)
+		if err := c.fillSubENIGatewayInfo(ctx, subENI, subnets); err != nil {
+			return nil, err
+		}
+		instanceID := parentToInstance[subENI.ParentID]
+		if instanceID == "" {
+			instanceID = item.InstanceId
+		}
+		if instanceID == "" {
+			continue
+		}
+		instances.Update(instanceID, ipamTypes.InterfaceRevision{Resource: subENI})
+	}
+
+	return instances, nil
+}
+
+func (c *Client) GetSubnets(ctx context.Context, vpcID string) (ipamTypes.SubnetMap, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	request := &vpcmodel.ListVirsubnetsRequest{}
+	limit := int32(2000)
+	request.Limit = &limit
+	if vpcID != "" {
+		vpcIDs := []string{vpcID}
+		request.VpcId = &vpcIDs
+	}
+
+	c.limiter.Limit(ctx, "ListVirsubnets")
+	response, err := c.vpcClient.ListVirsubnets(request)
+	if err != nil {
+		return nil, normalizeAPIError(err)
+	}
+
+	result := ipamTypes.SubnetMap{}
+	if response.Virsubnets == nil {
+		return result, nil
+	}
+	for _, item := range *response.Virsubnets {
+		gatewayIP, subnetCIDR := selectIPv4SubnetCIDRAndGateway(item.SubnetCidrs, "")
+		subnet := &ipamTypes.Subnet{ID: item.Id, Name: item.Name, VirtualNetworkID: item.VpcId, AvailabilityZone: item.ZoneId, Tags: parseResponseTags(item.Tags), GatewayIP: gatewayIP}
+		if subnetCIDR != "" {
+			if parsedCIDR, err := netip.ParsePrefix(subnetCIDR); err == nil {
+				subnet.CIDR = parsedCIDR
+			}
+		}
+		result[subnet.ID] = subnet
+	}
+
+	return result, nil
+}
+
+func (c *Client) GetVPCs(ctx context.Context) (ipamTypes.VirtualNetworkMap, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	request := &vpcmodel.ListVpcsRequest{}
+	limit := int32(2000)
+	request.Limit = &limit
+
+	c.limiter.Limit(ctx, "ListVpcs")
+	response, err := c.vpcClient.ListVpcs(request)
+	if err != nil {
+		return nil, normalizeAPIError(err)
+	}
+
+	result := ipamTypes.VirtualNetworkMap{}
+	if response.Vpcs == nil {
+		return result, nil
+	}
+	for _, item := range *response.Vpcs {
+		result[item.Id] = &ipamTypes.VirtualNetwork{ID: item.Id, PrimaryCIDR: item.Cidr, CIDRs: append([]string(nil), item.ExtendCidrs...)}
+	}
+
+	return result, nil
+}
+
+func (c *Client) GetSecurityGroups(ctx context.Context, vpcID string) (hwTypes.SecurityGroupMap, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	request := &vpcmodel.ListSecurityGroupsRequest{}
+	limit := int32(2000)
+	request.Limit = &limit
+
+	c.limiter.Limit(ctx, "ListSecurityGroups")
+	response, err := c.vpcClient.ListSecurityGroups(request)
+	if err != nil {
+		return nil, normalizeAPIError(err)
+	}
+
+	result := hwTypes.SecurityGroupMap{}
+	if response.SecurityGroups == nil {
+		return result, nil
+	}
+	for _, item := range *response.SecurityGroups {
+		result[item.Id] = &hwTypes.SecurityGroup{ID: item.Id, VPCID: vpcID, Tags: parseResourceTags(item.Tags)}
+	}
+
+	return result, nil
+}
+
+func (c *Client) WaitSubENIActive(ctx context.Context, subENIID string) (*eniTypes.SubENI, error) {
+	ticker := time.NewTicker(1 * time.Second)
+	defer ticker.Stop()
+	timeout := time.NewTimer(60 * time.Second)
+	defer timeout.Stop()
+
+	for {
+		subENI, err := c.GetSubNetworkInterface(ctx, subENIID)
+		if err != nil {
+			return nil, fmt.Errorf("wait sub-eni %s: %w", subENIID, err)
+		}
+		switch subENI.State {
+		case "ACTIVE":
+			return subENI, nil
+		case "ERROR":
+			return nil, fmt.Errorf("sub-eni %s entered ERROR state", subENIID)
+		}
+
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-timeout.C:
+			return nil, fmt.Errorf("timed out waiting for sub-eni %s to become ACTIVE", subENIID)
+		case <-ticker.C:
+		}
+	}
+}
+
+func parseSubENI(subENI *vpcmodel.SubNetworkInterface) *eniTypes.SubENI {
+	if subENI == nil {
+		return nil
+	}
+	return &eniTypes.SubENI{
+		ID:               subENI.Id,
+		PrivateIPAddress: subENI.PrivateIpAddress,
+		MACAddress:       subENI.MacAddress,
+		VlanID:           subENI.VlanId,
+		SubnetID:         subENI.VirsubnetId,
+		SecurityGroups:   append([]string(nil), subENI.SecurityGroups...),
+		State:            subENI.State,
+		ParentID:         subENI.ParentId,
+		VPCID:            subENI.VpcId,
+	}
+}
+
+func parseResourceTags(tags []vpcmodel.ResourceTag) map[string]string {
+	result := make(map[string]string, len(tags))
+	for _, tag := range tags {
+		result[tag.Key] = tag.Value
+	}
+	return result
+}
+
+func parseResponseTags(tags []vpcmodel.ResponseTag) ipamTypes.Tags {
+	result := make(ipamTypes.Tags, len(tags))
+	for _, tag := range tags {
+		result[tag.Key] = tag.Value
+	}
+	return result
+}
+
+func getParentPortsFromServer(server *ecsmodel.ServerDetail) []string {
+	if server == nil {
+		return nil
+	}
+
+	portSet := map[string]struct{}{}
+	if server.NetworkInterfaces != nil {
+		for _, networkInterface := range *server.NetworkInterfaces {
+			if networkInterface.PortId != nil && *networkInterface.PortId != "" {
+				portSet[*networkInterface.PortId] = struct{}{}
+			}
+		}
+	}
+
+	for _, addresses := range server.Addresses {
+		for _, address := range addresses {
+			if address.OSEXTIPSportId != nil && *address.OSEXTIPSportId != "" {
+				portSet[*address.OSEXTIPSportId] = struct{}{}
+			}
+		}
+	}
+
+	result := make([]string, 0, len(portSet))
+	for port := range portSet {
+		result = append(result, port)
+	}
+	return result
+}
diff --git a/pkg/huaweicloud/api/error.go b/pkg/huaweicloud/api/error.go
new file mode 100644
index 0000000000..b5c05fa804
--- /dev/null
+++ b/pkg/huaweicloud/api/error.go
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package api
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/huaweicloud/huaweicloud-sdk-go-v3/core/sdkerr"
+)
+
+// Sentinel errors returned by the HuaweiCloud API client.
+// Callers should use errors.Is() to check for specific conditions.
+var (
+	// ErrSubnetInsufficientIP is returned when a subnet has no more available IP addresses.
+	// HuaweiCloud VPC API error codes: VPC.0703, VPC.0532 (HTTP 409)
+	ErrSubnetInsufficientIP = errors.New("subnet insufficient ip")
+
+	// ErrUnauthorized is returned on authentication/authorization failures (HTTP 401/403).
+	ErrUnauthorized = errors.New("unauthorized")
+
+	// ErrInvalidArgument is returned when request parameters are invalid (HTTP 400).
+	ErrInvalidArgument = errors.New("invalid argument")
+
+	// ErrRateLimited is returned when the API rate limit is exceeded (HTTP 429).
+	ErrRateLimited = errors.New("rate limited")
+
+	// ErrNotFound is returned when the requested resource does not exist (HTTP 404).
+	ErrNotFound = errors.New("not found")
+)
+
+// normalizeAPIError converts a HuaweiCloud SDK ServiceResponseError into one of the
+// sentinel errors above so callers can use errors.Is() for semantic error handling.
+// Non-SDK errors are returned unchanged.
+func normalizeAPIError(err error) error {
+	if err == nil {
+		return nil
+	}
+
+	var sdkErr *sdkerr.ServiceResponseError
+	if !errors.As(err, &sdkErr) {
+		return err
+	}
+
+	switch {
+	case sdkErr.StatusCode == 401 || sdkErr.StatusCode == 403:
+		return fmt.Errorf("%w: %s (request_id: %s)", ErrUnauthorized, sdkErr.ErrorMessage, sdkErr.RequestId)
+	case sdkErr.StatusCode == 404:
+		return fmt.Errorf("%w: %s (request_id: %s)", ErrNotFound, sdkErr.ErrorMessage, sdkErr.RequestId)
+	case sdkErr.StatusCode == 429:
+		return fmt.Errorf("%w: %s (request_id: %s)", ErrRateLimited, sdkErr.ErrorMessage, sdkErr.RequestId)
+	case isSubnetInsufficientIP(sdkErr.ErrorCode):
+		// HTTP 409 + VPC.0703/VPC.0532 = subnet IP exhaustion
+		return fmt.Errorf("%w: %s (request_id: %s)", ErrSubnetInsufficientIP, sdkErr.ErrorMessage, sdkErr.RequestId)
+	case sdkErr.StatusCode == 400:
+		return fmt.Errorf("%w: [%s] %s (request_id: %s)", ErrInvalidArgument, sdkErr.ErrorCode, sdkErr.ErrorMessage, sdkErr.RequestId)
+	default:
+		return fmt.Errorf("huaweicloud api error [%s] %s (status: %d, request_id: %s): %w",
+			sdkErr.ErrorCode, sdkErr.ErrorMessage, sdkErr.StatusCode, sdkErr.RequestId, err)
+	}
+}
+
+// isSubnetInsufficientIP reports whether the HuaweiCloud VPC error code indicates
+// that a subnet has no more available IP addresses.
+// VPC.0703: "No more IP addresses available on network xxx." (private IP allocation)
+// VPC.0532: "No more IP addresses available on network." (port-level IP exhaustion)
+// Both return HTTP 409 Conflict.
+func isSubnetInsufficientIP(code string) bool {
+	return code == "VPC.0703" || code == "VPC.0532"
+}
diff --git a/pkg/huaweicloud/api/mock/mock.go b/pkg/huaweicloud/api/mock/mock.go
new file mode 100644
index 0000000000..187c6e18e8
--- /dev/null
