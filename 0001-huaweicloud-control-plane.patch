@@ -0,0 +1,649 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package eni
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/sirupsen/logrus"
+
+	hwAPI "github.com/cilium/cilium/pkg/huaweicloud/api"
+	"github.com/cilium/cilium/pkg/huaweicloud/eni/limits"
+	eniTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+	"github.com/cilium/cilium/pkg/ipam"
+	ipamTypes "github.com/cilium/cilium/pkg/ipam/types"
+	v2 "github.com/cilium/cilium/pkg/k8s/apis/cilium.io/v2"
+	"github.com/cilium/cilium/pkg/lock"
+)
+
+const (
+	errUnableToDetermineLimits    = "unable to determine limits"
+	unableToDetermineLimits       = "unableToDetermineLimits"
+	errUnableToGetSecurityGroups  = "unable to get security groups"
+	unableToGetSecurityGroups     = "unableToGetSecurityGroups"
+	errUnableToDetermineParentENI = "unable to determine parent ENI"
+	unableToDetermineParentENI    = "unableToDetermineParentENI"
+	errUnableToCreateSubENI       = "unable to create Sub-ENI"
+	unableToCreateSubENI          = "unableToCreateSubENI"
+	unableToFindSubnet            = "unableToFindSubnet"
+	maxSubENIBatchCreate          = 10
+)
+
+type ipamNodeActions interface {
+	InstanceID() string
+}
+
+type Node struct {
+	logger     *logrus.Entry
+	node       ipamNodeActions
+	createLock lock.Mutex
+	mutex      lock.RWMutex
+	subENIs    map[string]eniTypes.SubENI
+	k8sObj     *v2.CiliumNode
+	manager    *InstancesManager
+	instanceID string
+}
+
+var _ ipam.NodeOperations = (*Node)(nil)
+
+func (n *Node) UpdatedNode(obj *v2.CiliumNode) {
+	n.mutex.Lock()
+	defer n.mutex.Unlock()
+	n.k8sObj = obj
+	if obj == nil {
+		n.instanceID = ""
+		return
+	}
+	n.instanceID = strings.TrimSpace(obj.InstanceID())
+}
+
+func (n *Node) currentInstanceID() string {
+	n.mutex.RLock()
+	defer n.mutex.RUnlock()
+	return n.instanceID
+}
+
+func (n *Node) PopulateStatusFields(resource *v2.CiliumNode) {
+	if resource == nil {
+		return
+	}
+	if n.manager == nil || n.node == nil {
+		return
+	}
+	if resource.Status.HuaweiCloud == nil {
+		resource.Status.HuaweiCloud = &eniTypes.ENIStatus{}
+	}
+	resource.Status.HuaweiCloud.VPCPrimaryCIDR = ""
+	resource.Status.HuaweiCloud.VPCCIDRs = nil
+	if resource.Spec.HuaweiCloud != nil {
+		if vpc := n.manager.GetVPC(resource.Spec.HuaweiCloud.VPCID); vpc != nil {
+			resource.Status.HuaweiCloud.VPCPrimaryCIDR = vpc.PrimaryCIDR
+			resource.Status.HuaweiCloud.VPCCIDRs = append([]string(nil), vpc.CIDRs...)
+		}
+	}
+
+	resource.Status.HuaweiCloud.SubENIs = map[string]eniTypes.SubENI{}
+	n.manager.ForeachInstance(n.currentInstanceID(),
+		func(instanceID, interfaceID string, rev ipamTypes.InterfaceRevision) error {
+			e, ok := rev.Resource.(*eniTypes.SubENI)
+			if ok {
+				subENI := e.DeepCopy()
+				if resource.Spec.HuaweiCloud != nil {
+					if subENI.TrunkInterface == "" {
+						subENI.TrunkInterface = resource.Spec.HuaweiCloud.TrunkInterface
+					}
+					if subENI.TrunkInterfaceID == "" {
+						subENI.TrunkInterfaceID = resource.Spec.HuaweiCloud.TrunkInterfaceID
+					}
+				}
+				resource.Status.HuaweiCloud.SubENIs[interfaceID] = *subENI
+			}
+			return nil
+		})
+}
+
+func (n *Node) CreateInterface(ctx context.Context, allocation *ipam.AllocationAction, scopedLog *logrus.Entry) (int, string, error) {
+	if n.node == nil || n.manager == nil || allocation == nil {
+		return 0, unableToDetermineLimits, errors.New(errUnableToDetermineLimits)
+	}
+	n.createLock.Lock()
+	defer n.createLock.Unlock()
+	n.mutex.RLock()
+	if n.k8sObj == nil {
+		n.mutex.RUnlock()
+		return 0, unableToDetermineLimits, errors.New(errUnableToDetermineLimits)
+	}
+	resource := n.k8sObj.DeepCopy()
+	instanceID := n.instanceID
+	n.mutex.RUnlock()
+	if instanceID == "" {
+		return 0, unableToDetermineLimits, errors.New("HuaweiCloud instance ID is required")
+	}
+	if resource.Spec.HuaweiCloud == nil {
+		return 0, unableToDetermineLimits, errors.New(errUnableToDetermineLimits)
+	}
+	l, limitsAvailable := n.getLimitsFor(resource.Spec.HuaweiCloud.InstanceType, instanceID)
+	if !limitsAvailable {
+		return 0, unableToDetermineLimits, errors.New(errUnableToDetermineLimits)
+	}
+
+	toAllocate := minInt(allocation.MaxIPsToAllocate, l.IPv4)
+	toAllocate = minInt(allocation.AvailableInterfaces, toAllocate)
+	toAllocate = minInt(maxSubENIBatchCreate, toAllocate)
+	n.mutex.RLock()
+	toAllocate = minInt(maxInt(l.IPv4-len(n.subENIs), 0), toAllocate)
+	n.mutex.RUnlock()
+	if toAllocate == 0 {
+		return 0, "", nil
+	}
+
+	spec := *resource.Spec.HuaweiCloud
+
+	securityGroupIDs, err := n.getSecurityGroupIDs(ctx, spec)
+	if err != nil {
+		return 0, unableToGetSecurityGroups, fmt.Errorf("%s: %w", errUnableToGetSecurityGroups, err)
+	}
+
+	// If explicit subnet list is configured, use ordered fallback.
+	if len(spec.Subnets) > 0 {
+		trunkInterfaceID := spec.TrunkInterfaceID
+		if trunkInterfaceID == "" {
+			trunkInterfaceID = n.getParentENIID()
+		}
+		if trunkInterfaceID == "" {
+			return 0, unableToDetermineParentENI, errors.New(errUnableToDetermineParentENI)
+		}
+		return n.createSubENIWithFallback(ctx, instanceID, spec.Subnets, trunkInterfaceID, securityGroupIDs, toAllocate, allocation, scopedLog)
+	}
+
+	// No explicit subnet list: use FindOneSubnet (legacy path).
+	bestSubnet := n.manager.FindOneSubnet(spec, toAllocate)
+	if bestSubnet == nil {
+		return 0, unableToFindSubnet, fmt.Errorf(
+			"no matching subnet for Sub-ENI creation (VPC=%s AZ=%s)",
+			spec.VPCID,
+			spec.AvailabilityZone,
+		)
+	}
+	allocation.PoolID = ipamTypes.PoolID(bestSubnet.ID)
+
+	parentENIID := spec.TrunkInterfaceID
+	if parentENIID == "" {
+		parentENIID = n.getParentENIID()
+	}
+	if parentENIID == "" {
+		return 0, unableToDetermineParentENI, errors.New(errUnableToDetermineParentENI)
+	}
+
+	created, err := n.createSubENIsInSubnet(ctx, instanceID, bestSubnet.ID, parentENIID, securityGroupIDs, toAllocate, scopedLog)
+	if err != nil {
+		return 0, unableToCreateSubENI, fmt.Errorf("%s: %w", errUnableToCreateSubENI, err)
+	}
+	return created, "", nil
+}
+
+func (n *Node) createSubENIsInSubnet(
+	ctx context.Context,
+	instanceID, subnetID, trunkInterfaceID string,
+	securityGroupIDs []string,
+	toAllocate int,
+	scopedLog *logrus.Entry,
+) (int, error) {
+	scopedLog = scopedLog.WithFields(logrus.Fields{
+		"securityGroupIDs": securityGroupIDs,
+		"subnetID":         subnetID,
+		"trunkInterfaceID": trunkInterfaceID,
+		"toAllocate":       toAllocate,
+	})
+	scopedLog.Info("Creating Sub-ENIs")
+
+	subENIs, err := n.manager.api.BatchCreateSubNetworkInterfaces(ctx, toAllocate, hwAPI.CreateSubENIRequest{
+		TrunkInterfaceID: trunkInterfaceID,
+		SubnetID:         subnetID,
+		SecurityGroupIDs: securityGroupIDs,
+		Tags:             n.manager.subENITags,
+	})
+	if err != nil {
+		return 0, err
+	}
+
+	created := 0
+	n.mutex.Lock()
+	if n.subENIs == nil {
+		n.subENIs = map[string]eniTypes.SubENI{}
+	}
+	for _, subENI := range subENIs {
+		if subENI == nil {
+			continue
+		}
+		created++
+		n.subENIs[subENI.ID] = *subENI
+		n.manager.UpdateSubENI(instanceID, subENI)
+	}
+	n.mutex.Unlock()
+
+	if created == 0 {
+		return 0, errors.New("BatchCreateSubNetworkInterfaces returned no valid Sub-ENIs")
+	}
+	scopedLog.WithField("created", created).Info("Created Sub-ENIs")
+	return created, nil
+}
+
+// createSubENIWithFallback tries each subnet in order, skipping to the next
+// when ErrSubnetInsufficientIP is returned. Other errors abort immediately.
+func (n *Node) createSubENIWithFallback(
+	ctx context.Context,
+	instanceID string,
+	subnetIDs []string,
+	trunkInterfaceID string,
+	securityGroupIDs []string,
+	toAllocate int,
+	allocation *ipam.AllocationAction,
+	scopedLog *logrus.Entry,
+) (int, string, error) {
+	var lastErr error
+
+	for _, subnetID := range subnetIDs {
+		created, err := n.createSubENIsInSubnet(ctx, instanceID, subnetID, trunkInterfaceID, securityGroupIDs, toAllocate, scopedLog)
+		if err == nil {
+			allocation.PoolID = ipamTypes.PoolID(subnetID)
+			return created, "", nil
+		}
+
+		if errors.Is(err, hwAPI.ErrSubnetInsufficientIP) {
+			scopedLog.WithField("subnetID", subnetID).Warn("Subnet IP exhausted, trying next subnet")
+			lastErr = err
+			continue
+		}
+
+		return 0, unableToCreateSubENI, fmt.Errorf("%s: %w", errUnableToCreateSubENI, err)
+	}
+
+	return 0, unableToCreateSubENI, fmt.Errorf("all subnets exhausted: %w", lastErr)
+}
+
+func (n *Node) ResyncInterfacesAndIPs(ctx context.Context, scopedLog *logrus.Entry) (ipamTypes.AllocationMap, error) {
+	if n.node == nil || n.manager == nil {
+		return nil, fmt.Errorf(errUnableToDetermineLimits)
+	}
+	instanceID := n.currentInstanceID()
+	if instanceID == "" {
+		return nil, errors.New("HuaweiCloud instance ID is required")
+	}
+	scopedLog.Info("Starting HuaweiCloud ResyncInterfacesAndIPs")
+	scopedLog.Info("Resolving HuaweiCloud instance limits")
+	l, limitsAvailable := n.getLimits()
+	scopedLog.WithFields(logrus.Fields{"limitsAvailable": limitsAvailable, "ipv4Limit": l.IPv4}).Info("Resolved HuaweiCloud instance limits")
+	if !limitsAvailable {
+		return nil, fmt.Errorf(errUnableToDetermineLimits)
+	}
+
+	available := ipamTypes.AllocationMap{}
+
+	n.mutex.Lock()
+	defer n.mutex.Unlock()
+	nextSubENIs := map[string]eniTypes.SubENI{}
+
+	subENICount := 0
+	seenIPs := map[string]string{}
+	var resyncErr error
+	scopedLog.WithField("instanceID", instanceID).Info("Iterating HuaweiCloud instance interfaces")
+	n.manager.ForeachInstance(instanceID,
+		func(instanceID, interfaceID string, rev ipamTypes.InterfaceRevision) error {
+			e, ok := rev.Resource.(*eniTypes.SubENI)
+			if !ok {
+				scopedLog.WithField("interfaceID", interfaceID).Warn("Ignoring unexpected HuaweiCloud interface resource type")
+				return nil
+			}
+
+			nextSubENIs[e.ID] = *e
+			subENICount++
+
+			if e.PrivateIPAddress != "" {
+				if previousID, exists := seenIPs[e.PrivateIPAddress]; exists && previousID != e.ID {
+					resyncErr = fmt.Errorf("duplicate private IP %s on Sub-ENIs %s and %s", e.PrivateIPAddress, previousID, e.ID)
+					return resyncErr
+				}
+				seenIPs[e.PrivateIPAddress] = e.ID
+				available[e.PrivateIPAddress] = ipamTypes.AllocationIP{Resource: e.ID}
+			}
+
+			return nil
+		})
+	if resyncErr != nil {
+		return nil, resyncErr
+	}
+	n.subENIs = nextSubENIs
+	scopedLog.WithFields(logrus.Fields{"instanceID": instanceID, "subENICount": subENICount, "availableIPs": len(available)}).Info("Completed HuaweiCloud instance interface iteration")
+
+	scopedLog.WithField("remainingInterfaces", maxInt(l.IPv4-subENICount, 0)).Info("Completed HuaweiCloud ResyncInterfacesAndIPs")
+	return available, nil
+}
+
+func (n *Node) PrepareIPAllocation(scopedLog *logrus.Entry) (*ipam.AllocationAction, error) {
+	l, limitsAvailable := n.getLimits()
+	if !limitsAvailable {
+		return nil, errors.New(errUnableToDetermineLimits)
+	}
+
+	a := &ipam.AllocationAction{}
+
+	n.mutex.RLock()
+	defer n.mutex.RUnlock()
+
+	currentCount := len(n.subENIs)
+	a.AvailableForAllocation = 0
+	a.AvailableInterfaces = maxInt(l.IPv4-currentCount, 0)
+	a.MaxIPsToAllocate = a.AvailableInterfaces
+
+	return a, nil
+}
+
+func (n *Node) AllocateIPs(ctx context.Context, allocation *ipam.AllocationAction) error {
+	return nil
+}
+
+// AllocateStaticIP is not supported for HuaweiCloud Sub-ENI IPAM. Static IP
+// allocation requires dedicated API support that is not yet available in this
+// provider. Callers must not enable static IP mode when using HuaweiCloud IPAM.
+func (n *Node) AllocateStaticIP(_ context.Context, _ ipamTypes.Tags) (string, error) {
+	return "", fmt.Errorf("AllocateStaticIP is not supported by HuaweiCloud Sub-ENI IPAM")
+}
+
+// ReleaseIPPrefixes is a no-op on HuaweiCloud since Sub-ENIs don't support prefix delegation.
+func (n *Node) ReleaseIPPrefixes(ctx context.Context, r *ipam.ReleaseAction) error {
+	return nil
+}
+
+func (n *Node) PrepareIPRelease(excessIPs int, scopedLog *logrus.Entry) *ipam.ReleaseAction {
+	r := &ipam.ReleaseAction{}
+
+	n.mutex.RLock()
+	defer n.mutex.RUnlock()
+
+	if n.k8sObj == nil {
+		return r
+	}
+	if n.k8sObj.Status.IPAM.Used == nil {
+		return r
+	}
+
+	var freeIPs []string
+	for _, subENI := range n.subENIs {
+		if subENI.PrivateIPAddress == "" {
+			continue
+		}
+
+		_, used := n.k8sObj.Status.IPAM.Used[subENI.PrivateIPAddress]
+		if !used {
+			freeIPs = append(freeIPs, subENI.PrivateIPAddress)
+		}
+	}
+
+	if len(freeIPs) > 0 {
+		// Keep release candidates stable across reconciliation loops. Go map
+		// iteration is randomized, while the generic release handshake requires
+		// an IP to remain a release candidate until the agent acknowledges it.
+		sort.Strings(freeIPs)
+		toRelease := minInt(len(freeIPs), excessIPs)
+		if toRelease > 0 {
+			r.IPsToRelease = freeIPs[:toRelease]
+		}
+	}
+
+	return r
+}
+
+func minInt(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
+
+func maxInt(a, b int) int {
+	if a > b {
+		return a
+	}
+	return b
+}
+
+func (n *Node) ReleaseIPs(ctx context.Context, r *ipam.ReleaseAction) error {
+	if r == nil || len(r.IPsToRelease) == 0 {
+		return nil
+	}
+
+	n.mutex.RLock()
+	ipToSubENI := make(map[string]string, len(n.subENIs))
+	for _, subENI := range n.subENIs {
+		if subENI.PrivateIPAddress != "" {
+			ipToSubENI[subENI.PrivateIPAddress] = subENI.ID
+		}
+	}
+	n.mutex.RUnlock()
+
+	seenSubENIs := map[string]struct{}{}
+	for _, ip := range r.IPsToRelease {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		subENIID, ok := ipToSubENI[ip]
+		if !ok {
+			continue
+		}
+		if _, duplicate := seenSubENIs[subENIID]; duplicate {
+			continue
+		}
+		seenSubENIs[subENIID] = struct{}{}
+
+		n.mutex.RLock()
+		usedStateKnown := n.k8sObj != nil && n.k8sObj.Status.IPAM.Used != nil
+		nowUsed := false
+		if usedStateKnown {
+			_, nowUsed = n.k8sObj.Status.IPAM.Used[ip]
+		}
+		n.mutex.RUnlock()
+		if !usedStateKnown || nowUsed {
+			continue
+		}
+
+		if err := n.manager.api.DeleteSubNetworkInterface(ctx, subENIID); err != nil && !errors.Is(err, hwAPI.ErrNotFound) {
+			return fmt.Errorf("failed to delete Sub-ENI %s (IP %s): %w", subENIID, ip, err)
+		}
+		n.manager.DeleteSubENI(n.currentInstanceID(), subENIID)
+
+		n.mutex.Lock()
+		delete(n.subENIs, subENIID)
+		n.mutex.Unlock()
+	}
+
+	return nil
+}
+
+func (n *Node) GetMaximumAllocatableIPv4() int {
+	l, ok := n.getLimits()
+	if !ok {
+		return 0
+	}
+
+	return l.IPv4
+}
+
+func (n *Node) GetMinimumAllocatableIPv4() int {
+	return 2
+}
+
+func (n *Node) IsPrefixDelegated() bool {
+	return false
+}
+
+func (n *Node) GetUsedIPWithPrefixes() int {
+	n.mutex.RLock()
+	defer n.mutex.RUnlock()
+	if n.k8sObj == nil {
+		return 0
+	}
+
+	return len(n.k8sObj.Status.IPAM.Used)
+}
+
+func (n *Node) getLimits() (ipamTypes.Limits, bool) {
+	n.mutex.RLock()
+	if n.k8sObj == nil || n.k8sObj.Spec.HuaweiCloud == nil {
+		n.mutex.RUnlock()
+		return ipamTypes.Limits{}, false
+	}
+	instanceType := n.k8sObj.Spec.HuaweiCloud.InstanceType
+	instanceID := n.instanceID
+	n.mutex.RUnlock()
+
+	return n.getLimitsFor(instanceType, instanceID)
+}
+
+func (n *Node) getLimitsFor(instanceType, instanceID string) (ipamTypes.Limits, bool) {
+	if n.manager != nil && n.manager.api != nil && instanceID != "" {
+		lookupCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+
+		l, err := n.manager.api.GetInstanceLimits(lookupCtx, instanceID)
+		if err == nil {
+			if instanceType != "" {
+				limits.Update(instanceType, l)
+			}
+
+			return l, true
+		}
+	}
+	if l, ok := limits.Get(instanceType); ok {
+		return l, true
+	}
+
+	return ipamTypes.Limits{}, false
+}
+
+func (n *Node) getSecurityGroupIDs(ctx context.Context, spec eniTypes.Spec) ([]string, error) {
+	if len(spec.SecurityGroups) > 0 {
+		groups := normalizeSecurityGroupIDs(spec.SecurityGroups)
+		if len(groups) == 0 {
+			return nil, errors.New("explicit security group list contains no valid IDs")
+		}
+		return validateSecurityGroupIDs(groups)
+	}
+
+	if len(spec.SecurityGroupTags) > 0 {
+		groups := n.manager.FindSecurityGroupByTags(spec.VPCID, spec.SecurityGroupTags)
+		ids := make([]string, 0, len(groups))
+		for _, sg := range groups {
+			if sg != nil {
+				ids = append(ids, sg.ID)
+			}
+		}
+		ids = normalizeSecurityGroupIDs(ids)
+		if len(ids) == 0 {
+			return nil, fmt.Errorf("no security groups match configured tags %v", spec.SecurityGroupTags)
+		}
+		return validateSecurityGroupIDs(ids)
+	}
+
+	if spec.TrunkInterfaceID != "" {
+		groups, err := n.manager.api.GetPortSecurityGroups(ctx, spec.TrunkInterfaceID)
+		if err != nil {
+			return nil, fmt.Errorf("get trunk port security groups: %w", err)
+		}
+		groups = normalizeSecurityGroupIDs(groups)
+		if len(groups) > 0 {
+			return validateSecurityGroupIDs(groups)
+		}
+	}
+
+	securityGroups := make([]string, 0)
+	seen := map[string]struct{}{}
+
+	n.manager.ForeachInstance(n.currentInstanceID(),
+		func(instanceID, interfaceID string, rev ipamTypes.InterfaceRevision) error {
+			e, ok := rev.Resource.(*eniTypes.SubENI)
+			if !ok || len(e.SecurityGroups) == 0 {
+				return nil
+			}
+
+			for _, secGroupID := range e.SecurityGroups {
+				if secGroupID == "" {
+					continue
+				}
+				if _, ok := seen[secGroupID]; ok {
+					continue
+				}
+				seen[secGroupID] = struct{}{}
+				securityGroups = append(securityGroups, secGroupID)
+			}
+
+			return nil
+		})
+
+	if len(securityGroups) > 0 {
+		sort.Strings(securityGroups)
+		return validateSecurityGroupIDs(securityGroups)
+	}
+
+	return nil, errors.New("failed to get security group ids")
+}
+
+func validateSecurityGroupIDs(groups []string) ([]string, error) {
+	if len(groups) > 100 {
+		return nil, fmt.Errorf("security group count %d exceeds cloud limit 100", len(groups))
+	}
+	return groups, nil
+}
+
+func normalizeSecurityGroupIDs(groups []string) []string {
+	seen := make(map[string]struct{}, len(groups))
+	result := make([]string, 0, len(groups))
+	for _, group := range groups {
+		group = strings.TrimSpace(group)
+		if group == "" {
+			continue
+		}
+		if _, exists := seen[group]; exists {
+			continue
+		}
+		seen[group] = struct{}{}
+		result = append(result, group)
+	}
+	sort.Strings(result)
+	return result
+}
+
+func (n *Node) getParentENIID() string {
+	n.mutex.RLock()
+	for _, subENI := range n.subENIs {
+		if subENI.ParentID != "" {
+			parentID := subENI.ParentID
+			n.mutex.RUnlock()
+			return parentID
+		}
+	}
+	n.mutex.RUnlock()
+
+	var parentENIID string
+	n.manager.ForeachInstance(n.currentInstanceID(),
+		func(instanceID, interfaceID string, rev ipamTypes.InterfaceRevision) error {
+			if parentENIID != "" {
+				return nil
+			}
+
+			e, ok := rev.Resource.(*eniTypes.SubENI)
+			if ok && e.ParentID != "" {
+				parentENIID = e.ParentID
+			}
+
+			return nil
+		})
+
+	return parentENIID
+}
