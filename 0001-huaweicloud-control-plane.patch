+	}
+	if delay == 0 {
+		return nil
+	}
+	l.metrics.ObserveRateLimit(operation, delay)
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		r.CancelAt(time.Now())
+		return ctx.Err()
+	case <-timer.C:
+		return nil
 	}
 }
