+	option.BindEnv(operatorOption.HuaweiCloudProjectID)
+
+	flags.String(operatorOption.HuaweiCloudRegion, "", "Region for HuaweiCloud API. If empty, metadata is used")
+	option.BindEnv(operatorOption.HuaweiCloudRegion)
+
+	flags.String(operatorOption.HuaweiCloudEndpoint, "", "Optional HuaweiCloud API endpoint override")
+	option.BindEnv(operatorOption.HuaweiCloudEndpoint)
+
+	flags.String(operatorOption.HuaweiCloudVPCID, "", "Specific VPC ID for HuaweiCloud Sub-ENI discovery")
+	option.BindEnv(operatorOption.HuaweiCloudVPCID)
+
+	flags.Var(option.NewNamedMapOptions(operatorOption.HuaweiCloudSubENITags, &operatorOption.Config.HuaweiCloudSubENITags, nil),
+		operatorOption.HuaweiCloudSubENITags, "HuaweiCloud Sub-ENI port tags in the form of k1=v1,k2=v2")
+	option.BindEnv(operatorOption.HuaweiCloudSubENITags)
+
+	flags.Bool(operatorOption.HuaweiCloudReleaseExcessIPs, false, "Release excess free HuaweiCloud Sub-ENIs")
+	option.BindEnv(operatorOption.HuaweiCloudReleaseExcessIPs)
+
