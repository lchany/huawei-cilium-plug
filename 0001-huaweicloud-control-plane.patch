+func (r *DefaultHttpResponse) GetBody() string {
+	body, err := ioutil.ReadAll(r.Response.Body)
+	if err != nil {
+		return ""
+	}
+	if err := r.Response.Body.Close(); err == nil {
+		r.Response.Body = ioutil.NopCloser(bytes.NewBuffer(body))
