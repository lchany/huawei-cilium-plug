+func (a *crdAllocator) resolveHuaweiCloudPrimaryMAC(subENI huaweiCloudTypes.SubENI) (string, error) {
+	if a.store.ownNode != nil && a.store.ownNode.Spec.HuaweiCloud != nil {
+		trunkInterface := a.store.ownNode.Spec.HuaweiCloud.TrunkInterface
+		if trunkInterface != "" {
+			link, err := netlink.LinkByName(trunkInterface)
+			if err != nil {
+				return "", fmt.Errorf("unable to resolve HuaweiCloud trunk interface %s: %w", trunkInterface, err)
+			}
+			if mac := link.Attrs().HardwareAddr.String(); mac != "" {
+				return mac, nil
+			}
+			return "", fmt.Errorf("HuaweiCloud trunk interface %s has empty MAC address", trunkInterface)
+		}
+	}
+
+	if subENI.MACAddress != "" {
+		return subENI.MACAddress, nil
+	}
+
+	return "", fmt.Errorf("HuaweiCloud primary MAC is unavailable for Sub-ENI %s", subENI.ID)
