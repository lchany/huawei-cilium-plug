diff --git a/pkg/huaweicloud/eni/types/types.go b/pkg/huaweicloud/eni/types/types.go
new file mode 100644
index 0000000000..775f745740
--- /dev/null
+++ b/pkg/huaweicloud/eni/types/types.go
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package types
+
+import (
+	"github.com/cilium/cilium/pkg/ipam/types"
+)
+
+// Spec is the Sub-ENI specification of a node for HuaweiCloud.
+// This specification is used by the cilium-operator to manage Sub-ENI based IPAM.
+type Spec struct {
+	// +kubebuilder:validation:Optional
+	InstanceID string `json:"instance-id,omitempty"`
+
+	// InstanceType is the ECS instance type, e.g. "c7.large.4"
+	//
+	// +kubebuilder:validation:Optional
+	InstanceType string `json:"instance-type,omitempty"`
+
+	// AvailabilityZone is the availability zone to use when allocating Sub-ENIs.
+	//
+	// +kubebuilder:validation:Optional
+	AvailabilityZone string `json:"availability-zone,omitempty"`
+
+	// VPCID is the VPC ID to use when allocating Sub-ENIs.
+	//
+	// +kubebuilder:validation:Optional
+	VPCID string `json:"vpc-id,omitempty"`
+
+	// Subnets is the list of subnet IDs available for Sub-ENI allocation.
+	//
+	// +kubebuilder:validation:Optional
+	Subnets []string `json:"subnet-ids,omitempty"`
+
+	// SubnetTags is the list of tags to use when evaluating which
+	// subnet to use for Sub-ENI allocation.
+	//
+	// +kubebuilder:validation:Optional
+	SubnetTags map[string]string `json:"subnet-tags,omitempty"`
+
+	// SecurityGroups is the list of security group IDs to attach to Sub-ENIs.
+	// If empty, the node's security groups will be inherited.
+	//
+	// +kubebuilder:validation:Optional
+	SecurityGroups []string `json:"security-group-ids,omitempty"`
+
+	// SecurityGroupTags is the list of tags to use when evaluating which
+	// security groups to use for the Sub-ENI.
+	//
+	// +kubebuilder:validation:Optional
+	SecurityGroupTags map[string]string `json:"security-group-tags,omitempty"`
+
+	// TrunkMode indicates whether the node uses trunk ENI mode for Sub-ENIs.
+	//
+	// +kubebuilder:validation:Optional
+	TrunkMode bool `json:"trunk-mode,omitempty"`
+
+	// TrunkInterface is the name of the trunk ENI network interface (e.g. "eth0").
+	//
+	// +kubebuilder:validation:Optional
+	TrunkInterface string `json:"trunk-interface,omitempty"`
+
+	// TrunkInterfaceID is the port ID of the trunk ENI, obtained from instance metadata.
+	//
+	// +kubebuilder:validation:Optional
+	TrunkInterfaceID string `json:"trunk-interface-id,omitempty"`
+}
+
+// SubENI represents a HuaweiCloud Supplementary Network Interface (辅助弹性网卡).
+// Each SubENI has exactly one private IP address, independent MAC, and security groups.
+type SubENI struct {
+	// ID is the unique identifier of the Sub-ENI
+	//
+	// +optional
+	ID string `json:"id,omitempty"`
+
+	// PrivateIPAddress is the private IPv4 address of the Sub-ENI
+	//
+	// +optional
+	PrivateIPAddress string `json:"ipv4-address,omitempty"`
+
+	// MACAddress is the MAC address of the Sub-ENI
+	//
+	// +optional
+	MACAddress string `json:"mac,omitempty"`
+
+	// VlanID is the VLAN ID of the Sub-ENI (1-4094, assigned by system)
+	//
+	// +optional
+	VlanID int32 `json:"vlan-id,omitempty"`
+
+	// GatewayMAC is the MAC address of the subnet's distributed router port.
+	//
+	// +optional
+	GatewayMAC string `json:"gateway-mac,omitempty"`
+
+	// GatewayIP is the IPv4 address of the subnet's distributed router port.
+	//
+	// +optional
+	GatewayIP string `json:"gateway-ip,omitempty"`
+
+	// SubnetID is the subnet (virsubnet) to which the Sub-ENI belongs
+	//
+	// +optional
+	SubnetID string `json:"subnet-id,omitempty"`
+
+	// SubnetCIDR is the IPv4 CIDR of the subnet to which the Sub-ENI belongs.
+	//
+	// +optional
+	SubnetCIDR string `json:"subnet-cidr,omitempty"`
+
+	// SecurityGroups is the list of security group IDs attached to this Sub-ENI
+	//
+	// +optional
+	SecurityGroups []string `json:"security-group-ids,omitempty"`
+
+	// State is the current state of the Sub-ENI (ACTIVE, BUILD, DOWN, ERROR)
+	//
+	// +optional
+	State string `json:"state,omitempty"`
+
+	// ParentID is the ID of the parent ENI (宿主网卡)
+	//
+	// +optional
+	ParentID string `json:"parent-id,omitempty"`
+
+	// VPCID is the VPC the Sub-ENI belongs to
+	//
+	// +optional
+	VPCID string `json:"vpc-id,omitempty"`
+
+	// IPv6Address is the private IPv6 address of the Sub-ENI, if assigned.
+	//
+	// +optional
+	IPv6Address string `json:"ipv6-address,omitempty"`
+
+	// TrunkInterface is the name of the trunk ENI network interface this Sub-ENI belongs to.
+	//
+	// +optional
+	TrunkInterface string `json:"trunk-interface,omitempty"`
+
+	// TrunkInterfaceID is the port ID of the trunk ENI that owns this Sub-ENI.
+	//
+	// +optional
+	TrunkInterfaceID string `json:"trunk-interface-id,omitempty"`
+}
+
+// DeepCopyInterface returns a deep copy implementing the ipam.Interface interface
+func (s *SubENI) DeepCopyInterface() types.Interface {
+	return s.DeepCopy()
+}
+
+// InterfaceID returns the identifier of the Sub-ENI
+func (s *SubENI) InterfaceID() string {
+	return s.ID
+}
+
+// ForeachAddress iterates over the single IP address of this Sub-ENI and calls fn.
+// Each Sub-ENI has exactly 1 private IP address (unlike ENI which can have multiple).
+func (s *SubENI) ForeachAddress(instanceID string, fn types.AddressIterator) error {
+	if s.PrivateIPAddress == "" {
+		return nil
+	}
+	return fn(instanceID, s.ID, s.PrivateIPAddress, s.SubnetID, s)
+}
+
+// ENIStatus is the status of Sub-ENI addressing of the node
+type ENIStatus struct {
+	// SubENIs is the map of Sub-ENIs on the node, keyed by Sub-ENI ID
+	//
+	// +optional
+	SubENIs map[string]SubENI `json:"subenis,omitempty"`
+}
diff --git a/pkg/huaweicloud/metadata/metadata.go b/pkg/huaweicloud/metadata/metadata.go
new file mode 100644
index 0000000000..8834daff13
--- /dev/null
+++ b/pkg/huaweicloud/metadata/metadata.go
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package metadata
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+
+	"github.com/cilium/cilium/pkg/safeio"
+	"github.com/cilium/cilium/pkg/time"
+)
+
+var (
+	// metadataEC2URL is the EC2-compatible metadata path.
+	metadataEC2URL = "http://169.254.169.254/latest/meta-data"
+	// metadataOpenStackURL is the OpenStack metadata path.
+	metadataOpenStackURL = "http://169.254.169.254/openstack/latest/meta_data.json"
+	// metadataNetworkDataURL is the OpenStack network_data.json metadata path.
+	metadataNetworkDataURL = "http://169.254.169.254/openstack/latest/network_data.json"
+)
+
+// openStackMetadata is the JSON structure returned by the OpenStack metadata endpoint.
+type openStackMetadata struct {
+	// UUID is the full UUID of the ECS instance (used for HuaweiCloud ECS API calls).
+	// NOTE: The EC2-compatible path (/latest/meta-data/instance-id) returns a short
+	// "i-xxxxxxxx" format which HuaweiCloud ECS ShowServer API does not accept.
+	// Must use this OpenStack UUID instead.
+	UUID string `json:"uuid"`
+	Meta struct {
+		VPCID string `json:"vpc_id"`
+	} `json:"meta"`
+	AvailabilityZone string `json:"availability_zone"`
+}
+
+// networkData is the JSON structure of the network_data.json metadata endpoint.
+type networkData struct {
+	Links []struct {
+		VifID string `json:"vif_id"`
+	} `json:"links"`
+}
+
+// GetInstanceID returns the ECS instance UUID from OpenStack metadata.
+// The EC2-compatible path (/latest/meta-data/instance-id) returns a short "i-xxxxxxxx"
+// format that HuaweiCloud ECS API (ShowServer) does not accept. The OpenStack
+// meta_data.json "uuid" field returns the correct UUID format required by the API.
+func GetInstanceID(ctx context.Context) (string, error) {
+	meta, err := getOpenStackMetadata(ctx)
+	if err != nil {
+		return "", err
+	}
+	if meta.UUID == "" {
+		return "", fmt.Errorf("uuid not found in OpenStack metadata")
+	}
+	return meta.UUID, nil
+}
+
+// GetInstanceType returns the instance type from metadata.
+func GetInstanceType(ctx context.Context) (string, error) {
+	return getMetadata(ctx, "instance-type")
+}
+
+// GetRegionID returns the region ID from metadata.
+// HuaweiCloud does not expose a direct region-id path, so region is derived from AZ.
+func GetRegionID(ctx context.Context) (string, error) {
+	meta, err := getOpenStackMetadata(ctx)
+	if err != nil {
+		return "", err
+	}
+
+	az := meta.AvailabilityZone
+	if az == "" {
+		return "", fmt.Errorf("availability_zone not found in OpenStack metadata")
+	}
+
+	if len(az) > 1 {
+		return az[:len(az)-1], nil
+	}
+
+	return az, nil
+}
+
+// GetZoneID returns the zone ID from metadata.
+func GetZoneID(ctx context.Context) (string, error) {
+	return getMetadata(ctx, "placement/availability-zone")
+}
+
+// GetVPCID returns the VPC ID that belongs to the ECS instance from metadata.
+func GetVPCID(ctx context.Context) (string, error) {
+	meta, err := getOpenStackMetadata(ctx)
+	if err != nil {
+		return "", err
+	}
+
+	if meta.Meta.VPCID == "" {
+		return "", fmt.Errorf("vpc_id not found in OpenStack metadata")
+	}
+
+	return meta.Meta.VPCID, nil
+}
+
+// getMetadata gets metadata.
+func getMetadata(ctx context.Context, path string) (string, error) {
+	client := &http.Client{
+		Timeout: time.Second * 10,
+	}
+
+	url := fmt.Sprintf("%s/%s", metadataEC2URL, path)
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return "", err
+	}
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("metadata service returned status code %d for path %s", resp.StatusCode, path)
+	}
+
+	respBytes, err := safeio.ReadAllLimit(resp.Body, safeio.MB)
+	if err != nil {
+		return "", err
+	}
+
+	return string(respBytes), nil
+}
+
+// getOpenStackMetadata gets and parses OpenStack metadata JSON.
+func getOpenStackMetadata(ctx context.Context) (*openStackMetadata, error) {
+	client := &http.Client{
+		Timeout: time.Second * 10,
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, metadataOpenStackURL, nil)
+	if err != nil {
+		return nil, err
+	}
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("OpenStack metadata service returned status code %d", resp.StatusCode)
+	}
+
+	respBytes, err := safeio.ReadAllLimit(resp.Body, safeio.MB)
+	if err != nil {
+		return nil, err
+	}
+
+	var meta openStackMetadata
+	if err := json.Unmarshal(respBytes, &meta); err != nil {
+		return nil, fmt.Errorf("failed to parse OpenStack metadata JSON: %w", err)
+	}
+
+	return &meta, nil
+}
+
+// GetTrunkInterfaceID returns the port ID of the trunk ENI for this instance.
+// It reads the network_data.json metadata endpoint and extracts links[0].vif_id.
+func GetTrunkInterfaceID(ctx context.Context) (string, error) {
+	client := &http.Client{Timeout: time.Second * 10}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, metadataNetworkDataURL, nil)
+	if err != nil {
+		return "", err
+	}
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("network_data metadata returned status code %d", resp.StatusCode)
+	}
+
+	respBytes, err := safeio.ReadAllLimit(resp.Body, safeio.MB)
+	if err != nil {
+		return "", err
+	}
+
+	var data networkData
+	if err := json.Unmarshal(respBytes, &data); err != nil {
+		return "", fmt.Errorf("failed to parse network_data.json: %w", err)
+	}
+
+	if len(data.Links) == 0 {
+		return "", fmt.Errorf("network_data.json: links array is empty")
+	}
+	if data.Links[0].VifID == "" {
+		return "", fmt.Errorf("network_data.json: links[0].vif_id is empty")
+	}
+
+	return data.Links[0].VifID, nil
+}
