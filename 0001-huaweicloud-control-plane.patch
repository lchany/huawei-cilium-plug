+package auth
+
+import (
+	"sync"
+)
+
+var (
+	instance *cache
+	once     sync.Once
+)
+
+func getCache() *cache {
+	once.Do(func() {
+		instance = &cache{
+			data: make(map[string]string),
+		}
+	})
+	return instance
+}
+
+type cache struct {
+	data map[string]string
+	mu   sync.RWMutex
+}
+
+func (s *cache) put(key, value string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.data[key] = value
+}
+
+func (s *cache) get(key string) (string, bool) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	val, ok := s.data[key]
+	return val, ok
+}
