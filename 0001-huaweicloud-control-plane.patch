+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package huaweicloud
+
+import (
+	"context"
+	"fmt"
+
+	operatorMetrics "github.com/cilium/cilium/operator/metrics"
+	operatorOption "github.com/cilium/cilium/operator/option"
+	hwAPI "github.com/cilium/cilium/pkg/huaweicloud/api"
+	"github.com/cilium/cilium/pkg/huaweicloud/eni"
+	"github.com/cilium/cilium/pkg/huaweicloud/metadata"
+	"github.com/cilium/cilium/pkg/ipam"
+	"github.com/cilium/cilium/pkg/ipam/allocator"
+	ipamMetrics "github.com/cilium/cilium/pkg/ipam/metrics"
+	"github.com/cilium/cilium/pkg/logging"
+	"github.com/cilium/cilium/pkg/logging/logfields"
+)
+
+var log = logging.DefaultLogger.WithField(logfields.LogSubsys, "ipam-allocator-huawei-cloud")
+
+type AllocatorHuaweiCloud struct {
+	client *hwAPI.Client
+	vpcID  string
+}
+
+func (a *AllocatorHuaweiCloud) Init(ctx context.Context) error {
+	ak := operatorOption.Config.HuaweiCloudAccessKey
+	sk := operatorOption.Config.HuaweiCloudSecretKey
+	projectID := operatorOption.Config.HuaweiCloudProjectID
+	region := operatorOption.Config.HuaweiCloudRegion
+	vpcID := operatorOption.Config.HuaweiCloudVPCID
+	endpoint := operatorOption.Config.HuaweiCloudEndpoint
+
+	if ak == "" {
+		return fmt.Errorf("--huawei-cloud-access-key is required for HuaweiCloud IPAM")
+	}
+	if sk == "" {
+		return fmt.Errorf("--huawei-cloud-secret-key is required for HuaweiCloud IPAM")
+	}
+	if projectID == "" {
+		return fmt.Errorf("--huawei-cloud-project-id is required for HuaweiCloud IPAM")
+	}
+	if len(operatorOption.Config.HuaweiCloudSubENITags) > 20 {
+		return fmt.Errorf("--huawei-cloud-subeni-tags supports at most 20 tags")
+	}
+
+	if region == "" {
+		var err error
+		region, err = metadata.GetRegionID(ctx)
+		if err != nil {
+			return fmt.Errorf("--huawei-cloud-region not set and failed to get region from instance metadata: %w", err)
+		}
+	}
+
+	if vpcID == "" {
+		var err error
+		vpcID, err = metadata.GetVPCID(ctx)
+		if err != nil {
+			log.WithError(err).Warn("Unable to get VPC ID from instance metadata, proceeding without VPC ID constraint")
+		}
+	}
+
+	a.vpcID = vpcID
+
+	client, err := hwAPI.NewClient(ak, sk, projectID, region, endpoint)
+	if err != nil {
+		return fmt.Errorf("unable to create HuaweiCloud API client: %w", err)
+	}
+
+	a.client = client
+	log.Info("HuaweiCloud IPAM allocator initialized")
+	return nil
+}
+
+func (a *AllocatorHuaweiCloud) Start(ctx context.Context, getterUpdater ipam.CiliumNodeGetterUpdater) (allocator.NodeEventHandler, error) {
+	var iMetrics ipam.MetricsAPI
+
+	log.Info("Starting HuaweiCloud Sub-ENI allocator...")
+
+	if operatorOption.Config.EnableMetrics {
+		iMetrics = ipamMetrics.NewPrometheusMetrics(operatorMetrics.Namespace, operatorMetrics.Registry)
+	} else {
+		iMetrics = &ipamMetrics.NoOpMetrics{}
+	}
+
+	instances := eni.NewInstancesManager(a.client, a.vpcID, operatorOption.Config.HuaweiCloudSubENITags)
+	nodeManager, err := ipam.NewNodeManager(instances, getterUpdater, iMetrics,
+		operatorOption.Config.ParallelAllocWorkers,
+		operatorOption.Config.HuaweiCloudReleaseExcessIPs,
+		false,
+	)
+	if err != nil {
+		return nil, fmt.Errorf("unable to initialize HuaweiCloud node manager: %w", err)
+	}
+
+	if err := nodeManager.Start(ctx); err != nil {
+		return nil, err
+	}
+
+	return nodeManager, nil
+}
