+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package types
+
+import (
+	"github.com/cilium/cilium/pkg/ipam/types"
+)
+
+// Spec is the Sub-ENI specification of a node for HuaweiCloud.
+// This specification is used by the cilium-operator to manage Sub-ENI based IPAM.
+type Spec struct {
+	// +kubebuilder:validation:Optional
+	InstanceID string `json:"instance-id,omitempty"`
+
+	// InstanceType is the ECS instance type, e.g. "c7.large.4"
+	//
+	// +kubebuilder:validation:Optional
+	InstanceType string `json:"instance-type,omitempty"`
+
+	// AvailabilityZone is the availability zone to use when allocating Sub-ENIs.
+	//
+	// +kubebuilder:validation:Optional
+	AvailabilityZone string `json:"availability-zone,omitempty"`
+
+	// VPCID is the VPC ID to use when allocating Sub-ENIs.
+	//
+	// +kubebuilder:validation:Optional
+	VPCID string `json:"vpc-id,omitempty"`
+
+	// Subnets is the list of subnet IDs available for Sub-ENI allocation.
+	//
+	// +kubebuilder:validation:Optional
+	Subnets []string `json:"subnet-ids,omitempty"`
+
+	// SubnetTags is the list of tags to use when evaluating which
+	// subnet to use for Sub-ENI allocation.
+	//
+	// +kubebuilder:validation:Optional
+	SubnetTags map[string]string `json:"subnet-tags,omitempty"`
+
+	// SecurityGroups is the list of security group IDs to attach to Sub-ENIs.
+	// If empty, the node's security groups will be inherited.
+	//
+	// +kubebuilder:validation:Optional
+	SecurityGroups []string `json:"security-group-ids,omitempty"`
+
+	// SecurityGroupTags is the list of tags to use when evaluating which
+	// security groups to use for the Sub-ENI.
+	//
+	// +kubebuilder:validation:Optional
+	SecurityGroupTags map[string]string `json:"security-group-tags,omitempty"`
+
+	// TrunkMode indicates whether the node uses trunk ENI mode for Sub-ENIs.
+	//
+	// +kubebuilder:validation:Optional
+	TrunkMode bool `json:"trunk-mode,omitempty"`
+
+	// TrunkInterface is the name of the trunk ENI network interface (e.g. "eth0").
+	//
+	// +kubebuilder:validation:Optional
+	TrunkInterface string `json:"trunk-interface,omitempty"`
+
+	// TrunkInterfaceID is the port ID of the trunk ENI, obtained from instance metadata.
+	//
+	// +kubebuilder:validation:Optional
+	TrunkInterfaceID string `json:"trunk-interface-id,omitempty"`
+}
+
+// SubENI represents a HuaweiCloud Supplementary Network Interface (辅助弹性网卡).
+// Each SubENI has exactly one private IP address, independent MAC, and security groups.
+type SubENI struct {
+	// ID is the unique identifier of the Sub-ENI
+	//
+	// +optional
+	ID string `json:"id,omitempty"`
+
+	// PrivateIPAddress is the private IPv4 address of the Sub-ENI
+	//
+	// +optional
+	PrivateIPAddress string `json:"ipv4-address,omitempty"`
+
+	// MACAddress is the MAC address of the Sub-ENI
+	//
+	// +optional
+	MACAddress string `json:"mac,omitempty"`
+
+	// VlanID is the VLAN ID of the Sub-ENI (1-4094, assigned by system)
+	//
+	// +optional
+	VlanID int32 `json:"vlan-id,omitempty"`
+
+	// GatewayMAC is the MAC address of the subnet's distributed router port.
+	//
+	// +optional
+	GatewayMAC string `json:"gateway-mac,omitempty"`
+
+	// GatewayIP is the IPv4 address of the subnet's distributed router port.
+	//
+	// +optional
+	GatewayIP string `json:"gateway-ip,omitempty"`
+
+	// SubnetID is the subnet (virsubnet) to which the Sub-ENI belongs
+	//
+	// +optional
+	SubnetID string `json:"subnet-id,omitempty"`
+
+	// SubnetCIDR is the IPv4 CIDR of the subnet to which the Sub-ENI belongs.
+	//
+	// +optional
+	SubnetCIDR string `json:"subnet-cidr,omitempty"`
+
+	// SecurityGroups is the list of security group IDs attached to this Sub-ENI
+	//
+	// +optional
+	SecurityGroups []string `json:"security-group-ids,omitempty"`
+
+	// State is the current state of the Sub-ENI (ACTIVE, BUILD, DOWN, ERROR)
+	//
+	// +optional
+	State string `json:"state,omitempty"`
+
+	// ParentID is the ID of the parent ENI (宿主网卡)
+	//
+	// +optional
+	ParentID string `json:"parent-id,omitempty"`
+
+	// VPCID is the VPC the Sub-ENI belongs to
+	//
+	// +optional
+	VPCID string `json:"vpc-id,omitempty"`
+
+	// IPv6Address is the private IPv6 address of the Sub-ENI, if assigned.
+	//
+	// +optional
+	IPv6Address string `json:"ipv6-address,omitempty"`
+
+	// TrunkInterface is the name of the trunk ENI network interface this Sub-ENI belongs to.
+	//
+	// +optional
+	TrunkInterface string `json:"trunk-interface,omitempty"`
+
+	// TrunkInterfaceID is the port ID of the trunk ENI that owns this Sub-ENI.
+	//
+	// +optional
+	TrunkInterfaceID string `json:"trunk-interface-id,omitempty"`
+}
+
+// DeepCopyInterface returns a deep copy implementing the ipam.Interface interface
+func (s *SubENI) DeepCopyInterface() types.Interface {
+	return s.DeepCopy()
+}
+
+// InterfaceID returns the identifier of the Sub-ENI
+func (s *SubENI) InterfaceID() string {
+	return s.ID
+}
+
+// ForeachAddress iterates over the single IP address of this Sub-ENI and calls fn.
+// Each Sub-ENI has exactly 1 private IP address (unlike ENI which can have multiple).
+func (s *SubENI) ForeachAddress(instanceID string, fn types.AddressIterator) error {
+	if s.PrivateIPAddress == "" {
+		return nil
+	}
+	return fn(instanceID, s.ID, s.PrivateIPAddress, s.SubnetID, s)
+}
+
+// ENIStatus is the status of Sub-ENI addressing of the node
+type ENIStatus struct {
+	// VPCPrimaryCIDR is the primary IPv4 CIDR of the node's VPC.
+	//
+	// +optional
+	VPCPrimaryCIDR string `json:"vpc-primary-cidr,omitempty"`
+
+	// VPCCIDRs contains additional IPv4 CIDRs of the node's VPC.
+	//
+	// +optional
+	VPCCIDRs []string `json:"vpc-cidrs,omitempty"`
+
+	// SubENIs is the map of Sub-ENIs on the node, keyed by Sub-ENI ID
+	//
+	// +optional
+	SubENIs map[string]SubENI `json:"subenis,omitempty"`
+}
diff --git a/pkg/huaweicloud/metadata/metadata.go b/pkg/huaweicloud/metadata/metadata.go
new file mode 100644
index 0000000000..41b7e91061
--- /dev/null
+++ b/pkg/huaweicloud/metadata/metadata.go
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package metadata
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"time"
+)
+
+var (
+	// metadataEC2URL is the EC2-compatible metadata path.
+	metadataEC2URL = "http://169.254.169.254/latest/meta-data"
+	// metadataOpenStackURL is the OpenStack metadata path.
+	metadataOpenStackURL = "http://169.254.169.254/openstack/latest/meta_data.json"
+	// metadataNetworkDataURL is the OpenStack network_data.json metadata path.
+	metadataNetworkDataURL = "http://169.254.169.254/openstack/latest/network_data.json"
+	metadataMaxRead        = int64(1 << 20)
+)
+
+// openStackMetadata is the JSON structure returned by the OpenStack metadata endpoint.
+type openStackMetadata struct {
+	// UUID is the full UUID of the ECS instance (used for HuaweiCloud ECS API calls).
+	// NOTE: The EC2-compatible path (/latest/meta-data/instance-id) returns a short
+	// "i-xxxxxxxx" format which HuaweiCloud ECS ShowServer API does not accept.
+	// Must use this OpenStack UUID instead.
+	UUID string `json:"uuid"`
+	Meta struct {
+		VPCID string `json:"vpc_id"`
+	} `json:"meta"`
+	AvailabilityZone string `json:"availability_zone"`
+}
+
+// networkData is the JSON structure of the network_data.json metadata endpoint.
+type networkData struct {
+	Links []struct {
+		VifID string `json:"vif_id"`
+	} `json:"links"`
+}
+
+// GetInstanceID returns the ECS instance UUID from OpenStack metadata.
+// The EC2-compatible path (/latest/meta-data/instance-id) returns a short "i-xxxxxxxx"
+// format that HuaweiCloud ECS API (ShowServer) does not accept. The OpenStack
+// meta_data.json "uuid" field returns the correct UUID format required by the API.
+func GetInstanceID(ctx context.Context) (string, error) {
+	meta, err := getOpenStackMetadata(ctx)
+	if err != nil {
+		return "", err
+	}
+	if meta.UUID == "" {
+		return "", fmt.Errorf("uuid not found in OpenStack metadata")
+	}
+	return meta.UUID, nil
+}
+
+// GetInstanceType returns the instance type from metadata.
+func GetInstanceType(ctx context.Context) (string, error) {
+	return getMetadata(ctx, "instance-type")
+}
+
+// GetRegionID returns the region ID from metadata.
+// HuaweiCloud does not expose a direct region-id path, so region is derived from AZ.
+func GetRegionID(ctx context.Context) (string, error) {
+	meta, err := getOpenStackMetadata(ctx)
+	if err != nil {
+		return "", err
+	}
+
+	az := meta.AvailabilityZone
+	if az == "" {
+		return "", fmt.Errorf("availability_zone not found in OpenStack metadata")
+	}
+
+	if len(az) > 1 {
+		return az[:len(az)-1], nil
+	}
+
+	return az, nil
+}
+
+// GetZoneID returns the zone ID from metadata.
+func GetZoneID(ctx context.Context) (string, error) {
+	return getMetadata(ctx, "placement/availability-zone")
+}
+
+// GetVPCID returns the VPC ID that belongs to the ECS instance from metadata.
+func GetVPCID(ctx context.Context) (string, error) {
+	meta, err := getOpenStackMetadata(ctx)
+	if err != nil {
+		return "", err
+	}
+
+	if meta.Meta.VPCID == "" {
+		return "", fmt.Errorf("vpc_id not found in OpenStack metadata")
+	}
+
+	return meta.Meta.VPCID, nil
+}
+
+// getMetadata gets metadata.
+func getMetadata(ctx context.Context, path string) (string, error) {
+	client := &http.Client{
+		Timeout: time.Second * 10,
+	}
+
+	url := fmt.Sprintf("%s/%s", metadataEC2URL, path)
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return "", err
+	}
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("metadata service returned status code %d for path %s", resp.StatusCode, path)
+	}
+
+	respBytes, err := io.ReadAll(io.LimitReader(resp.Body, metadataMaxRead))
+	if err != nil {
+		return "", err
+	}
+
+	return string(respBytes), nil
+}
+
+// getOpenStackMetadata gets and parses OpenStack metadata JSON.
+func getOpenStackMetadata(ctx context.Context) (*openStackMetadata, error) {
+	client := &http.Client{
+		Timeout: time.Second * 10,
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, metadataOpenStackURL, nil)
+	if err != nil {
+		return nil, err
+	}
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("OpenStack metadata service returned status code %d", resp.StatusCode)
+	}
+
+	respBytes, err := io.ReadAll(io.LimitReader(resp.Body, metadataMaxRead))
+	if err != nil {
+		return nil, err
+	}
+
+	var meta openStackMetadata
+	if err := json.Unmarshal(respBytes, &meta); err != nil {
+		return nil, fmt.Errorf("failed to parse OpenStack metadata JSON: %w", err)
+	}
+
+	return &meta, nil
+}
+
+// GetTrunkInterfaceID returns the port ID of the trunk ENI for this instance.
+// It reads the network_data.json metadata endpoint and extracts links[0].vif_id.
+func GetTrunkInterfaceID(ctx context.Context) (string, error) {
+	client := &http.Client{Timeout: time.Second * 10}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, metadataNetworkDataURL, nil)
+	if err != nil {
+		return "", err
+	}
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("network_data metadata returned status code %d", resp.StatusCode)
+	}
+
+	respBytes, err := io.ReadAll(io.LimitReader(resp.Body, metadataMaxRead))
+	if err != nil {
+		return "", err
+	}
+
+	var data networkData
+	if err := json.Unmarshal(respBytes, &data); err != nil {
+		return "", fmt.Errorf("failed to parse network_data.json: %w", err)
+	}
+
+	if len(data.Links) == 0 {
+		return "", fmt.Errorf("network_data.json: links array is empty")
+	}
+	if data.Links[0].VifID == "" {
+		return "", fmt.Errorf("network_data.json: links[0].vif_id is empty")
+	}
+
+	return data.Links[0].VifID, nil
+}
diff --git a/pkg/huaweicloud/subenimap/manager.go b/pkg/huaweicloud/subenimap/manager.go
new file mode 100644
index 0000000000..ec52513bce
--- /dev/null
+++ b/pkg/huaweicloud/subenimap/manager.go
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package subenimap
+
+import (
+	"errors"
+	"fmt"
+	"net"
+
+	"github.com/sirupsen/logrus"
+	"golang.org/x/sys/unix"
+
+	"github.com/cilium/cilium/pkg/bpf"
+	"github.com/cilium/cilium/pkg/lock"
+)
+
+const (
+	srcIPMapName   = "cilium_hwc_srcip4"
+	vlanMACMapName = "cilium_hwc_vlan_mac"
+	maxEntries     = 65536
+)
+
+// EndpointInfo provides the data needed to populate the SubENI BPF maps.
+type EndpointInfo interface {
+	// GetIPv4Address returns the Pod IPv4 address (e.g. "10.0.0.5").
+	GetIPv4Address() string
+	// GetID returns the endpoint's LXC ID.
+	GetID() uint32
+	// GetIfIndex returns the interface ifindex of the endpoint's veth.
+	GetIfIndex() uint32
+	// GetMACAddress returns the MAC address of the SubENI bound to this endpoint.
+	GetMACAddress() [6]byte
+	// GetVLANID returns the VLAN ID from the SubENI binding.
+	GetVLANID() int32
+}
+
+// mapBackend abstracts bpf.Map operations to allow test injection.
+type mapBackend interface {
+	Lookup(key bpf.MapKey) (bpf.MapValue, error)
+	Update(key bpf.MapKey, value bpf.MapValue) error
+	Delete(key bpf.MapKey) (bool, error)
+}
+
+// bpfMapAdapter wraps *bpf.Map so it satisfies mapBackend.
+// bpf.Map.Delete returns (error), but mapBackend.Delete returns (bool, error),
+// so we delegate to SilentDelete which already returns (bool, error).
+type bpfMapAdapter struct {
+	m *bpf.Map
+}
+
+func (a *bpfMapAdapter) Update(key bpf.MapKey, value bpf.MapValue) error {
+	return a.m.Update(key, value)
+}
+
+func (a *bpfMapAdapter) Lookup(key bpf.MapKey) (bpf.MapValue, error) {
+	return a.m.Lookup(key)
+}
+
+func (a *bpfMapAdapter) Delete(key bpf.MapKey) (bool, error) {
+	return a.m.SilentDelete(key)
+}
+
+// SubENIMapManager maintains two BPF maps used by the HuaweiCloud SubENI
+// datapath:
+//
+//   - cilium_hwc_srcip4   (egress):  Pod IPv4 → SubENI VLAN/MAC/LXC-ID
+//   - cilium_hwc_vlan_mac (ingress): (VLAN ID, dst MAC) → endpoint ifindex/LXC-ID
+type SubENIMapManager struct {
+	logger     *logrus.Entry
+	srcIPMap   mapBackend
+	vlanMACMap mapBackend
+	mutex      lock.RWMutex
+}
+
+// NewSubENIMapManager creates a SubENIMapManager that attaches to the pinned
+// HuaweiCloud datapath maps on first use.
+func NewSubENIMapManager(logger *logrus.Entry) (*SubENIMapManager, error) {
+	return &SubENIMapManager{
+		logger: logger,
+	}, nil
+}
+
+func (m *SubENIMapManager) ensureMapsOpenLocked() error {
+	if m.srcIPMap != nil && m.vlanMACMap != nil {
+		return nil
+	}
+
+	srcIP, err := bpf.OpenMap(bpf.MapPath(srcIPMapName))
+	if err != nil {
+		return fmt.Errorf("failed to open pinned %s: %w", srcIPMapName, err)
+	}
+
+	vlanMAC, err := bpf.OpenMap(bpf.MapPath(vlanMACMapName))
+	if err != nil {
+		_ = srcIP.Close()
+		return fmt.Errorf("failed to open pinned %s: %w", vlanMACMapName, err)
+	}
+
+	m.srcIPMap = &bpfMapAdapter{m: srcIP}
+	m.vlanMACMap = &bpfMapAdapter{m: vlanMAC}
+
+	return nil
+}
+
+// newWithBackends is used in tests to inject fake map backends without opening
+// real BPF file descriptors.
+func newWithBackends(logger *logrus.Entry, srcIP mapBackend, vlanMAC mapBackend) *SubENIMapManager {
+	return &SubENIMapManager{
+		logger:     logger,
+		srcIPMap:   srcIP,
+		vlanMACMap: vlanMAC,
+	}
+}
+
+func parseIPv4(addr string) ([4]byte, error) {
+	ip := net.ParseIP(addr)
+	if ip == nil {
+		return [4]byte{}, fmt.Errorf("invalid IPv4 address: %q", addr)
+	}
+	ip4 := ip.To4()
+	if ip4 == nil {
+		return [4]byte{}, fmt.Errorf("address is not IPv4: %q", addr)
+	}
+	var out [4]byte
+	copy(out[:], ip4)
+	return out, nil
+}
+
+// OnEndpointReady upserts one entry in each BPF map for the given endpoint.
+// It is safe to call concurrently.
+func (m *SubENIMapManager) OnEndpointReady(ep EndpointInfo) error {
+	addrBytes, err := parseIPv4(ep.GetIPv4Address())
+	if err != nil {
+		return fmt.Errorf("OnEndpointReady: %w", err)
+	}
+
+	mac := ep.GetMACAddress()
+	var macArr [6]uint8
+	copy(macArr[:], mac[:])
+
+	vlanID := uint16(ep.GetVLANID()) //nolint:gosec // vlan IDs fit in uint16
+
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+
+	if err := m.ensureMapsOpenLocked(); err != nil {
+		return fmt.Errorf("OnEndpointReady: %w", err)
+	}
+
+	// --- Map 1: srcip → subeni info (egress) ---
+	srcKey := &SrcIPKey4{Addr: addrBytes}
+	srcVal := &SubENIInfo{
+		VlanID: vlanID,
+		MAC:    macArr,
+		LxcID:  ep.GetID(),
+	}
+	oldSrcVal, err := m.srcIPMap.Lookup(srcKey)
+	if err != nil && !errors.Is(err, unix.ENOENT) {
+		return fmt.Errorf("OnEndpointReady: lookup %s key=%s: %w", srcIPMapName, srcKey, err)
+	}
+	if err := m.srcIPMap.Update(srcKey, srcVal); err != nil {
+		return fmt.Errorf("OnEndpointReady: update %s key=%s: %w", srcIPMapName, srcKey, err)
+	}
+
+	// --- Map 2: (vlan-id, dst-mac) → endpoint (ingress) ---
+	vlanKey := &VLANMACKey{
+		VlanID: vlanID,
+		MAC:    macArr,
+	}
+	epVal := &EPInfo{
+		IfIndex: ep.GetIfIndex(),
+		LxcID:   uint16(ep.GetID()), //nolint:gosec // LXC IDs fit in uint16
+	}
+	if err := m.vlanMACMap.Update(vlanKey, epVal); err != nil {
+		var rollbackErr error
+		if oldSrcVal != nil {
+			rollbackErr = m.srcIPMap.Update(srcKey, oldSrcVal)
+		} else {
+			_, rollbackErr = m.srcIPMap.Delete(srcKey)
+		}
+		if rollbackErr != nil {
+			return fmt.Errorf("OnEndpointReady: update %s key=%s: %w; rollback %s: %v", vlanMACMapName, vlanKey, err, srcIPMapName, rollbackErr)
+		}
+		return fmt.Errorf("OnEndpointReady: update %s key=%s: %w", vlanMACMapName, vlanKey, err)
+	}
+
+	return nil
+}
+
+// OnEndpointDelete removes the entries for the given endpoint from both BPF
+// maps on a best-effort basis (individual delete errors are logged but not
+// returned).
+func (m *SubENIMapManager) OnEndpointDelete(ep EndpointInfo) error {
+	addrBytes, err := parseIPv4(ep.GetIPv4Address())
+	if err != nil {
+		return fmt.Errorf("OnEndpointDelete: %w", err)
+	}
+
+	mac := ep.GetMACAddress()
+	var macArr [6]uint8
+	copy(macArr[:], mac[:])
+
+	vlanID := uint16(ep.GetVLANID()) //nolint:gosec
+
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+
+	if err := m.ensureMapsOpenLocked(); err != nil {
+		return fmt.Errorf("OnEndpointDelete: %w", err)
+	}
+
+	// best-effort: log errors but do not propagate them.
+	if _, err := m.srcIPMap.Delete(&SrcIPKey4{Addr: addrBytes}); err != nil {
+		m.logger.WithError(err).WithFields(logrus.Fields{
+			"map":  srcIPMapName,
+			"addr": ep.GetIPv4Address(),
+		}).Warn("failed to delete srcip entry")
+	}
+
+	if _, err := m.vlanMACMap.Delete(&VLANMACKey{VlanID: vlanID, MAC: macArr}); err != nil {
+		m.logger.WithError(err).WithFields(logrus.Fields{
+			"map":  vlanMACMapName,
+			"addr": ep.GetIPv4Address(),
+		}).Warn("failed to delete vlan-mac entry")
+	}
+
+	return nil
+}
+
+// Close releases any resources held by the manager.
+// After Close the manager must not be used.
+func (m *SubENIMapManager) Close() {
+	// If the underlying backends are real bpf.Map adapters, close the maps.
+	if a, ok := m.srcIPMap.(*bpfMapAdapter); ok {
+		_ = a.m.Close()
+	}
+	if a, ok := m.vlanMACMap.(*bpfMapAdapter); ok {
+		_ = a.m.Close()
+	}
+}
diff --git a/pkg/huaweicloud/subenimap/types.go b/pkg/huaweicloud/subenimap/types.go
new file mode 100644
index 0000000000..e4e1d0bc83
--- /dev/null
+++ b/pkg/huaweicloud/subenimap/types.go
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package subenimap
+
+import (
+	"fmt"
+	"net"
+	"unsafe"
+
+	"github.com/cilium/cilium/pkg/bpf"
+)
+
+// SrcIPKey4 is the key for the cilium_hwc_srcip4 BPF map.
+// It corresponds to struct hwc_srcip_key4 in BPF C code.
+//
+// Egress path: look up SubENI info by Pod IPv4 source IP.
+type SrcIPKey4 struct {
+	Addr [4]byte `align:"addr"`
+}
+
+// String returns a human-readable representation of the key.
+func (k *SrcIPKey4) String() string {
+	return fmt.Sprintf("addr=%s", net.IP(k.Addr[:]).String())
+}
+
+// New returns a pointer to a new SrcIPKey4, satisfying bpf.MapKey.
+func (k *SrcIPKey4) New() bpf.MapKey { return &SrcIPKey4{} }
+
+// GetKeyPtr returns the unsafe pointer to this map key.
+func (k *SrcIPKey4) GetKeyPtr() unsafe.Pointer { return unsafe.Pointer(k) }
+
+// NewValue returns a new value for this key.
+func (k *SrcIPKey4) NewValue() bpf.MapValue { return &SubENIInfo{} }
+
+// DeepCopyMapKey returns a copy of this map key.
+func (k *SrcIPKey4) DeepCopyMapKey() bpf.MapKey {
+	if k == nil {
+		return nil
+	}
+	copy := *k
+	return &copy
+}
+
+// SubENIInfo is the value for the cilium_hwc_srcip4 BPF map.
+// It corresponds to struct hwc_subeni_info in BPF C code.
+type SubENIInfo struct {
+	// VlanID is the VLAN ID of the SubENI.
+	VlanID uint16 `align:"vlan_id"`
+	// MAC is the MAC address of the SubENI.
+	MAC [6]uint8 `align:"mac"`
+	// Pad is alignment padding.
+	Pad      uint16 `align:"pad"`
+	Reserved uint16 `align:"reserved"`
+	// LxcID is the endpoint (LXC) ID.
+	LxcID uint32 `align:"lxc_id"`
+}
+
+// String returns a human-readable representation of the value.
+func (v *SubENIInfo) String() string {
+	return fmt.Sprintf("vlan_id=%d mac=%02x:%02x:%02x:%02x:%02x:%02x lxc_id=%d",
+		v.VlanID,
+		v.MAC[0], v.MAC[1], v.MAC[2], v.MAC[3], v.MAC[4], v.MAC[5],
+		v.LxcID,
+	)
+}
+
