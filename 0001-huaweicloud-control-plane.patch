+}
+
+func (c *Client) fillSubENIGatewayInfo(ctx context.Context, subENI *eniTypes.SubENI, cachedSubnets ipamTypes.SubnetMap) error {
+	if subENI == nil || subENI.SubnetID == "" {
+		return nil
+	}
+	if subENI.GatewayIP == "" || subENI.SubnetCIDR == "" {
+		gatewayIP, subnetCIDR, err := c.resolveSubENISubnetMetadata(ctx, subENI.SubnetID, subENI.PrivateIPAddress, cachedSubnets)
+		if err != nil {
+			return err
+		}
+		if subENI.GatewayIP == "" {
+			subENI.GatewayIP = gatewayIP
+		}
+		if subENI.SubnetCIDR == "" {
+			subENI.SubnetCIDR = subnetCIDR
+		}
+	}
+	if subENI.GatewayIP == "" || subENI.GatewayMAC != "" {
+		return nil
+	}
+
+	deviceOwners := []string{"network:router_interface_distributed"}
+	privateIPs := []string{fmt.Sprintf("ip_address=%s", subENI.GatewayIP)}
+	virsubnetIDs := []string{subENI.SubnetID}
+	request := &vpcmodel.ListPortsRequest{
+		DeviceOwner: &deviceOwners,
+		PrivateIps:  &privateIPs,
+		VirsubnetId: &virsubnetIDs,
+	}
+
+	c.limiter.Limit(ctx, "ListPorts")
+	response, err := c.vpcClient.ListPorts(request)
+	if err != nil {
+		return normalizeAPIError(err)
+	}
+	if response.Ports == nil || len(*response.Ports) == 0 {
+		return nil
+	}
+
+	subENI.GatewayMAC = (*response.Ports)[0].MacAddress
+	return nil
+}
+
+func (c *Client) resolveSubENISubnetMetadata(ctx context.Context, subnetID, privateIP string, cachedSubnets ipamTypes.SubnetMap) (string, string, error) {
+	if subnetID == "" {
+		return "", "", nil
+	}
+	if subnet := cachedSubnets[subnetID]; subnet != nil {
+		cidr := ""
+		if subnet.CIDR != nil {
+			cidr = subnet.CIDR.String()
+		}
+		if subnet.GatewayIP != "" && cidr != "" && (privateIP == "" || belongsToCIDR(privateIP, cidr)) {
+			return subnet.GatewayIP, cidr, nil
+		}
+	}
+
+	limit := int32(1)
+	ids := []string{subnetID}
+	request := &vpcmodel.ListVirsubnetsRequest{Limit: &limit, Id: &ids}
+
+	c.limiter.Limit(ctx, "ListVirsubnets")
+	response, err := c.vpcClient.ListVirsubnets(request)
+	if err != nil {
+		return "", "", normalizeAPIError(err)
+	}
+	if response.Virsubnets == nil || len(*response.Virsubnets) == 0 {
+		return "", "", nil
+	}
+
+	gatewayIP, subnetCIDR := selectIPv4SubnetCIDRAndGateway((*response.Virsubnets)[0].SubnetCidrs, privateIP)
+	return gatewayIP, subnetCIDR, nil
+}
+
+func belongsToCIDR(ipStr, cidrStr string) bool {
+	ip, err := netip.ParseAddr(ipStr)
+	if err != nil {
+		return false
+	}
+	prefix, err := netip.ParsePrefix(cidrStr)
+	if err != nil {
+		return false
+	}
+	return prefix.Contains(ip)
+}
+
+func selectIPv4SubnetCIDRAndGateway(subnetCIDRs []vpcmodel.SubnetCidr, privateIP string) (gatewayIP, subnetCIDR string) {
+	for _, entry := range subnetCIDRs {
+		if entry.IpVersion != "4" || entry.Cidr == "" {
+			continue
+		}
+		if privateIP != "" && belongsToCIDR(privateIP, entry.Cidr) {
+			return entry.GatewayIp, entry.Cidr
+		}
+	}
+
+	for _, entry := range subnetCIDRs {
+		if entry.IpVersion == "4" && entry.Cidr != "" {
+			return entry.GatewayIp, entry.Cidr
+		}
+	}
+
+	return "", ""
+}
+
+func (c *Client) GetInstance(ctx context.Context, instanceID string) (*ipamTypes.Instance, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	request := &ecsmodel.ShowServerRequest{ServerId: instanceID}
+	c.limiter.Limit(ctx, "ShowServer")
+	serverResp, err := c.ecsClient.ShowServer(request)
+	if err != nil {
+		return nil, normalizeAPIError(err)
+	}
+
+	instance := &ipamTypes.Instance{Interfaces: map[string]ipamTypes.InterfaceRevision{}}
+	if serverResp.Server == nil {
+		return instance, nil
+	}
+
+	parentPorts := getParentPortsFromServer(serverResp.Server)
+	if len(parentPorts) == 0 {
+		return instance, nil
+	}
+
+	items, err := c.listSubNetworkInterfaces(ctx, parentPorts)
+	if err != nil {
+		return nil, err
+	}
+	for _, item := range items {
+		subENI := parseSubENI(&item)
+		if err := c.fillSubENIGatewayInfo(ctx, subENI, nil); err != nil {
+			return nil, err
+		}
+		instance.Interfaces[subENI.ID] = ipamTypes.InterfaceRevision{Resource: subENI}
+	}
+
+	return instance, nil
+}
+
+func (c *Client) GetInstanceLimits(ctx context.Context, instanceID string) (ipamTypes.Limits, error) {
+	if err := ctx.Err(); err != nil {
+		return ipamTypes.Limits{}, err
+	}
+	if strings.TrimSpace(instanceID) == "" {
+		return ipamTypes.Limits{}, fmt.Errorf("instanceID is required")
+	}
+
+	serverReq := &ecsmodel.ShowServerRequest{ServerId: instanceID}
+	c.limiter.Limit(ctx, "ShowServer")
+	serverResp, err := c.ecsClient.ShowServer(serverReq)
+	if err != nil {
+		return ipamTypes.Limits{}, normalizeAPIError(err)
+	}
+
+	flavorID, err := flavorIDFromServer(serverResp.Server, instanceID)
+	if err != nil {
+		return ipamTypes.Limits{}, err
+	}
+
+	flavorsReq := &ecsmodel.ListFlavorsRequest{FlavorId: &flavorID}
+	c.limiter.Limit(ctx, "ListFlavors")
+	flavorsResp, err := c.ecsClient.ListFlavors(flavorsReq)
+	if err != nil {
+		return ipamTypes.Limits{}, normalizeAPIError(err)
+	}
+
+	maxSubENIs, err := subENILimitFromFlavors(flavorsResp.Flavors, flavorID)
+	if err != nil {
+		return ipamTypes.Limits{}, err
+	}
+
+	return ipamTypes.Limits{Adapters: 1, IPv4: maxSubENIs}, nil
+}
+
+func flavorIDFromServer(server *ecsmodel.ServerDetail, instanceID string) (string, error) {
+	if server == nil {
+		return "", fmt.Errorf("empty server detail for instance %s", instanceID)
+	}
+	if server.Flavor == nil || strings.TrimSpace(server.Flavor.Id) == "" {
+		return "", fmt.Errorf("empty flavor id for instance %s", instanceID)
+	}
+
+	return server.Flavor.Id, nil
+}
+
+func subENILimitFromFlavors(flavors *[]ecsmodel.Flavor, flavorID string) (int, error) {
+	if flavors == nil || len(*flavors) == 0 {
+		return 0, fmt.Errorf("no flavors found for flavor %s", flavorID)
+	}
+
+	for _, flavor := range *flavors {
+		if flavor.Id != flavorID && flavor.Name != flavorID {
+			continue
+		}
+		if flavor.OsExtraSpecs == nil || flavor.OsExtraSpecs.QuotasubNetworkInterfaceMaxNum == nil {
+			return 0, fmt.Errorf("sub network interface limit is missing for flavor %s", flavorID)
+		}
+
+		limit, err := strconv.Atoi(strings.TrimSpace(*flavor.OsExtraSpecs.QuotasubNetworkInterfaceMaxNum))
+		if err != nil {
+			return 0, fmt.Errorf("parse sub network interface limit for flavor %s: %w", flavorID, err)
+		}
+		if limit < 0 {
+			return 0, fmt.Errorf("sub network interface limit for flavor %s is negative", flavorID)
+		}
+
+		return limit, nil
+	}
+
+	return 0, fmt.Errorf("flavor %s not found", flavorID)
+}
+
+func (c *Client) GetInstances(ctx context.Context, vpcs ipamTypes.VirtualNetworkMap, subnets ipamTypes.SubnetMap) (*ipamTypes.InstanceMap, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	_ = vpcs
+	_ = subnets
+
+	servers, err := c.listServers(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	parentToInstance := map[string]string{}
+	for _, server := range servers {
+		for _, portID := range getParentPortsFromServer(&server) {
+			parentToInstance[portID] = server.Id
+		}
+	}
+
+	items, err := c.listSubNetworkInterfaces(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+
+	instances := ipamTypes.NewInstanceMap()
+	for _, item := range items {
+		subENI := parseSubENI(&item)
+		if err := c.fillSubENIGatewayInfo(ctx, subENI, subnets); err != nil {
+			return nil, err
+		}
+		instanceID := parentToInstance[subENI.ParentID]
+		if instanceID == "" {
+			instanceID = item.InstanceId
+		}
+		if instanceID == "" {
+			continue
+		}
+		instances.Update(instanceID, ipamTypes.InterfaceRevision{Resource: subENI})
+	}
+
+	return instances, nil
+}
+
+func (c *Client) listServers(ctx context.Context) ([]ecsmodel.ServerDetail, error) {
+	limit := int32(1000)
+	request := &ecsmodel.ListServersDetailsRequest{Limit: &limit}
+	var result []ecsmodel.ServerDetail
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		c.limiter.Limit(ctx, "ListServersDetails")
+		response, err := c.ecsClient.ListServersDetails(request)
+		if err != nil {
+			return nil, normalizeAPIError(err)
+		}
+		if response.Servers == nil || len(*response.Servers) == 0 {
+			return result, nil
+		}
+		result = append(result, (*response.Servers)...)
+		if len(*response.Servers) < int(limit) || response.Count != nil && len(result) >= int(*response.Count) {
+			return result, nil
+		}
+		marker := (*response.Servers)[len(*response.Servers)-1].Id
+		request.Marker = &marker
+	}
+}
+
+func (c *Client) GetSubnets(ctx context.Context, vpcID string) (ipamTypes.SubnetMap, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	request := &vpcmodel.ListVirsubnetsRequest{}
+	limit := int32(2000)
+	request.Limit = &limit
+	if vpcID != "" {
+		vpcIDs := []string{vpcID}
+		request.VpcId = &vpcIDs
+	}
+
+	result := ipamTypes.SubnetMap{}
+	for {
+		c.limiter.Limit(ctx, "ListVirsubnets")
+		response, err := c.vpcClient.ListVirsubnets(request)
+		if err != nil {
+			return nil, normalizeAPIError(err)
+		}
+		if response.Virsubnets != nil {
+			for _, item := range *response.Virsubnets {
+				gatewayIP, subnetCIDR := selectIPv4SubnetCIDRAndGateway(item.SubnetCidrs, "")
+				subnet := &ipamTypes.Subnet{ID: item.Id, Name: item.Name, VirtualNetworkID: item.VpcId, AvailabilityZone: item.ZoneId, GatewayIP: gatewayIP, Tags: parseResponseTags(item.Tags)}
+				if _, parsedCIDR, err := net.ParseCIDR(subnetCIDR); err == nil {
+					subnet.CIDR = cidr.NewCIDR(parsedCIDR)
+				}
+				result[subnet.ID] = subnet
+			}
+		}
+		request.Marker = nextMarker(response.PageInfo)
+		if request.Marker == nil {
+			return result, nil
+		}
+	}
+}
+
+func (c *Client) GetVPCs(ctx context.Context) (ipamTypes.VirtualNetworkMap, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
