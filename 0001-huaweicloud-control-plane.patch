@@ -0,0 +1,512 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package eni
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"time"
+
+	hwAPI "github.com/cilium/cilium/pkg/huaweicloud/api"
+	"github.com/cilium/cilium/pkg/huaweicloud/eni/limits"
+	eniTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+	"github.com/cilium/cilium/pkg/ipam"
+	"github.com/cilium/cilium/pkg/ipam/stats"
+	ipamTypes "github.com/cilium/cilium/pkg/ipam/types"
+	v2 "github.com/cilium/cilium/pkg/k8s/apis/cilium.io/v2"
+	"github.com/cilium/cilium/pkg/lock"
+)
+
+const (
+	errUnableToDetermineLimits    = "unable to determine limits"
+	unableToDetermineLimits       = "unableToDetermineLimits"
+	errUnableToGetSecurityGroups  = "unable to get security groups"
+	unableToGetSecurityGroups     = "unableToGetSecurityGroups"
+	errUnableToDetermineParentENI = "unable to determine parent ENI"
+	unableToDetermineParentENI    = "unableToDetermineParentENI"
+	errUnableToCreateSubENI       = "unable to create Sub-ENI"
+	unableToCreateSubENI          = "unableToCreateSubENI"
+	unableToFindSubnet            = "unableToFindSubnet"
+	maxSubENIBatchCreate          = 10
+)
+
+type ipamNodeActions interface {
+	InstanceID() string
+}
+
+type Node struct {
+	logger     *slog.Logger
+	node       ipamNodeActions
+	mutex      lock.RWMutex
+	subENIs    map[string]eniTypes.SubENI
+	k8sObj     *v2.CiliumNode
+	manager    *InstancesManager
+	instanceID string
+}
+
+var _ ipam.NodeOperations = (*Node)(nil)
+
+func (n *Node) UpdatedNode(obj *v2.CiliumNode) {
+	n.mutex.Lock()
+	defer n.mutex.Unlock()
+	n.k8sObj = obj
+	n.instanceID = obj.InstanceID()
+}
+
+func (n *Node) PopulateStatusFields(resource *v2.CiliumNode) {
+	if resource == nil {
+		return
+	}
+	if resource.Status.HuaweiCloud == nil {
+		resource.Status.HuaweiCloud = &eniTypes.ENIStatus{}
+	}
+
+	resource.Status.HuaweiCloud.SubENIs = map[string]eniTypes.SubENI{}
+	n.manager.ForeachInstance(n.node.InstanceID(),
+		func(instanceID, interfaceID string, rev ipamTypes.InterfaceRevision) error {
+			e, ok := rev.Resource.(*eniTypes.SubENI)
+			if ok {
+				subENI := e.DeepCopy()
+				if resource.Spec.HuaweiCloud != nil {
+					if subENI.TrunkInterface == "" {
+						subENI.TrunkInterface = resource.Spec.HuaweiCloud.TrunkInterface
+					}
+					if subENI.TrunkInterfaceID == "" {
+						subENI.TrunkInterfaceID = resource.Spec.HuaweiCloud.TrunkInterfaceID
+					}
+				}
+				resource.Status.HuaweiCloud.SubENIs[interfaceID] = *subENI
+			}
+			return nil
+		})
+}
+
+func (n *Node) CreateInterface(ctx context.Context, allocation *ipam.AllocationAction, scopedLog *slog.Logger) (int, string, error) {
+	l, limitsAvailable := n.getLimits()
+	if !limitsAvailable {
+		return 0, unableToDetermineLimits, errors.New(errUnableToDetermineLimits)
+	}
+
+	n.mutex.RLock()
+	if n.k8sObj == nil {
+		n.mutex.RUnlock()
+		return 0, unableToDetermineLimits, errors.New(errUnableToDetermineLimits)
+	}
+	resource := n.k8sObj.DeepCopy()
+	n.mutex.RUnlock()
+
+	if resource.Spec.HuaweiCloud == nil {
+		return 0, unableToDetermineLimits, errors.New(errUnableToDetermineLimits)
+	}
+
+	toAllocate := min(allocation.IPv4.MaxIPsToAllocate, l.IPv4)
+	toAllocate = min(allocation.EmptyInterfaceSlots, toAllocate)
+	toAllocate = min(maxSubENIBatchCreate, toAllocate)
+	if toAllocate == 0 {
+		return 0, "", nil
+	}
+
+	spec := *resource.Spec.HuaweiCloud
+
+	securityGroupIDs, err := n.getSecurityGroupIDs(ctx, spec)
+	if err != nil {
+		return 0, unableToGetSecurityGroups, fmt.Errorf("%s: %w", errUnableToGetSecurityGroups, err)
+	}
+
+	// If explicit subnet list is configured, use ordered fallback.
+	if len(spec.Subnets) > 0 {
+		trunkInterfaceID := spec.TrunkInterfaceID
+		if trunkInterfaceID == "" {
+			trunkInterfaceID = n.getParentENIID()
+		}
+		if trunkInterfaceID == "" {
+			return 0, unableToDetermineParentENI, errors.New(errUnableToDetermineParentENI)
+		}
+		return n.createSubENIWithFallback(ctx, spec.Subnets, trunkInterfaceID, securityGroupIDs, toAllocate, allocation, scopedLog)
+	}
+
+	// No explicit subnet list: use FindOneSubnet (legacy path).
+	bestSubnet := n.manager.FindOneSubnet(spec, toAllocate)
+	if bestSubnet == nil {
+		return 0, unableToFindSubnet, fmt.Errorf(
+			"no matching subnet for Sub-ENI creation (VPC=%s AZ=%s)",
+			spec.VPCID,
+			spec.AvailabilityZone,
+		)
+	}
+	allocation.PoolID = ipamTypes.PoolID(bestSubnet.ID)
+
+	parentENIID := n.getParentENIID()
+	if parentENIID == "" {
+		return 0, unableToDetermineParentENI, errors.New(errUnableToDetermineParentENI)
+	}
+
+	scopedLog = scopedLog.With(
+		"securityGroupIDs", securityGroupIDs,
+		"subnetID", bestSubnet.ID,
+		"parentENIID", parentENIID,
+		"toAllocate", toAllocate,
+	)
+	scopedLog.Info("Creating Sub-ENIs")
+
+	subENIs, err := n.manager.api.BatchCreateSubNetworkInterfaces(ctx, toAllocate, hwAPI.CreateSubENIRequest{
+		TrunkInterfaceID: parentENIID,
+		SubnetID:         bestSubnet.ID,
+		SecurityGroupIDs: securityGroupIDs,
+	})
+	if err != nil {
+		return 0, unableToCreateSubENI, fmt.Errorf("%s: %w", errUnableToCreateSubENI, err)
+	}
+
+	n.mutex.Lock()
+	if n.subENIs == nil {
+		n.subENIs = map[string]eniTypes.SubENI{}
+	}
+	instanceID := n.node.InstanceID()
+	for _, subENI := range subENIs {
+		if subENI == nil {
+			continue
+		}
+		n.subENIs[subENI.ID] = *subENI
+		n.manager.UpdateSubENI(instanceID, subENI)
+	}
+	n.mutex.Unlock()
+
+	scopedLog.Info("Created Sub-ENIs", "created", len(subENIs))
+	return len(subENIs), "", nil
+}
+
+// createSubENIWithFallback tries each subnet in order, skipping to the next
+// when ErrSubnetInsufficientIP is returned. Other errors abort immediately.
+func (n *Node) createSubENIWithFallback(
+	ctx context.Context,
+	subnetIDs []string,
+	trunkInterfaceID string,
+	securityGroupIDs []string,
+	toAllocate int,
+	allocation *ipam.AllocationAction,
+	scopedLog *slog.Logger,
+) (int, string, error) {
+	var lastErr error
+
+	for _, subnetID := range subnetIDs {
+		scopedLog = scopedLog.With(
+			"securityGroupIDs", securityGroupIDs,
+			"subnetID", subnetID,
+			"trunkInterfaceID", trunkInterfaceID,
+			"toAllocate", toAllocate,
+		)
+		scopedLog.Info("Creating Sub-ENIs (subnet fallback)")
+
+		subENIs, err := n.manager.api.BatchCreateSubNetworkInterfaces(ctx, toAllocate, hwAPI.CreateSubENIRequest{
+			TrunkInterfaceID: trunkInterfaceID,
+			SubnetID:         subnetID,
+			SecurityGroupIDs: securityGroupIDs,
+		})
+		if err == nil {
+			allocation.PoolID = ipamTypes.PoolID(subnetID)
+
+			n.mutex.Lock()
+			if n.subENIs == nil {
+				n.subENIs = map[string]eniTypes.SubENI{}
+			}
+			instanceID := n.node.InstanceID()
+			for _, subENI := range subENIs {
+				if subENI == nil {
+					continue
+				}
+				n.subENIs[subENI.ID] = *subENI
+				n.manager.UpdateSubENI(instanceID, subENI)
+			}
+			n.mutex.Unlock()
+
+			scopedLog.Info("Created Sub-ENIs", "created", len(subENIs))
+			return len(subENIs), "", nil
+		}
+
+		if errors.Is(err, hwAPI.ErrSubnetInsufficientIP) {
+			scopedLog.Warn("Subnet IP exhausted, trying next subnet", "subnetID", subnetID)
+			lastErr = err
+			continue
+		}
+
+		return 0, unableToCreateSubENI, fmt.Errorf("%s: %w", errUnableToCreateSubENI, err)
+	}
+
+	return 0, unableToCreateSubENI, fmt.Errorf("all subnets exhausted: %w", lastErr)
+}
+
+func (n *Node) ResyncInterfacesAndIPs(ctx context.Context, scopedLog *slog.Logger) (ipamTypes.AllocationMap, stats.InterfaceStats, error) {
+	scopedLog.Info("Starting HuaweiCloud ResyncInterfacesAndIPs")
+	scopedLog.Info("Resolving HuaweiCloud instance limits")
+	l, limitsAvailable := n.getLimits()
+	scopedLog.Info("Resolved HuaweiCloud instance limits", "limitsAvailable", limitsAvailable, "ipv4Limit", l.IPv4)
+	if !limitsAvailable {
+		return nil, stats.InterfaceStats{}, fmt.Errorf(errUnableToDetermineLimits)
+	}
+
+	st := stats.InterfaceStats{NodeCapacity: l.IPv4}
+	instanceID := n.node.InstanceID()
+	available := ipamTypes.AllocationMap{}
+
+	n.mutex.Lock()
+	defer n.mutex.Unlock()
+	n.subENIs = map[string]eniTypes.SubENI{}
+
+	subENICount := 0
+	scopedLog.Info("Iterating HuaweiCloud instance interfaces", "instanceID", instanceID)
+	n.manager.ForeachInstance(instanceID,
+		func(instanceID, interfaceID string, rev ipamTypes.InterfaceRevision) error {
+			e, ok := rev.Resource.(*eniTypes.SubENI)
+			if !ok {
+				return nil
+			}
+
+			n.subENIs[e.ID] = *e
+			subENICount++
+
+			if e.PrivateIPAddress != "" {
+				available[e.PrivateIPAddress] = ipamTypes.AllocationIP{Resource: e.ID}
+			}
+
+			return nil
+		})
+	scopedLog.Info("Completed HuaweiCloud instance interface iteration", "instanceID", instanceID, "subENICount", subENICount, "availableIPs", len(available))
+
+	st.RemainingAvailableInterfaceCount = max(l.IPv4-subENICount, 0)
+	scopedLog.Info("Completed HuaweiCloud ResyncInterfacesAndIPs", "remainingInterfaces", st.RemainingAvailableInterfaceCount)
+	return available, st, nil
+}
+
+func (n *Node) PrepareIPAllocation(scopedLog *slog.Logger) (*ipam.AllocationAction, error) {
+	l, limitsAvailable := n.getLimits()
+	if !limitsAvailable {
+		return nil, errors.New(errUnableToDetermineLimits)
+	}
+
+	a := &ipam.AllocationAction{}
+
+	n.mutex.RLock()
+	defer n.mutex.RUnlock()
+
+	currentCount := len(n.subENIs)
+	a.IPv4.AvailableForAllocation = 0
+	a.EmptyInterfaceSlots = max(l.IPv4-currentCount, 0)
+	a.IPv4.MaxIPsToAllocate = a.EmptyInterfaceSlots
+
+	return a, nil
+}
+
+func (n *Node) AllocateIPs(ctx context.Context, allocation *ipam.AllocationAction) error {
+	return nil
+}
+
+// AllocateStaticIP is not supported for HuaweiCloud Sub-ENI IPAM. Static IP
+// allocation requires dedicated API support that is not yet available in this
+// provider. Callers must not enable static IP mode when using HuaweiCloud IPAM.
+func (n *Node) AllocateStaticIP(_ context.Context, _ ipamTypes.Tags) (string, error) {
+	return "", fmt.Errorf("AllocateStaticIP is not supported by HuaweiCloud Sub-ENI IPAM")
+}
+
+// ReleaseIPPrefixes is a no-op on HuaweiCloud since Sub-ENIs don't support prefix delegation.
+func (n *Node) ReleaseIPPrefixes(ctx context.Context, r *ipam.ReleaseAction) error {
+	return nil
+}
+
+func (n *Node) PrepareIPRelease(excessIPs int, scopedLog *slog.Logger) *ipam.ReleaseAction {
+	r := &ipam.ReleaseAction{}
+
+	n.mutex.RLock()
+	defer n.mutex.RUnlock()
+
+	if n.k8sObj == nil {
+		return r
+	}
+
+	var freeIPs []string
+	for _, subENI := range n.subENIs {
+		if subENI.PrivateIPAddress == "" {
+			continue
+		}
+
+		_, used := n.k8sObj.Status.IPAM.Used[subENI.PrivateIPAddress]
+		if !used {
+			freeIPs = append(freeIPs, subENI.PrivateIPAddress)
+		}
+	}
+
+	if len(freeIPs) > 0 {
+		toRelease := min(len(freeIPs), excessIPs)
+		if toRelease > 0 {
+			r.IPsToRelease = freeIPs[:toRelease]
+		}
+	}
+
+	return r
+}
+
+func (n *Node) ReleaseIPs(ctx context.Context, r *ipam.ReleaseAction) error {
+	if r == nil || len(r.IPsToRelease) == 0 {
+		return nil
+	}
+
+	n.mutex.RLock()
+	ipToSubENI := make(map[string]string, len(n.subENIs))
+	for _, subENI := range n.subENIs {
+		if subENI.PrivateIPAddress != "" {
+			ipToSubENI[subENI.PrivateIPAddress] = subENI.ID
+		}
+	}
+	n.mutex.RUnlock()
+
+	for _, ip := range r.IPsToRelease {
+		subENIID, ok := ipToSubENI[ip]
+		if !ok {
+			continue
+		}
+
+		if err := n.manager.api.DeleteSubNetworkInterface(ctx, subENIID); err != nil {
+			return fmt.Errorf("failed to delete Sub-ENI %s (IP %s): %w", subENIID, ip, err)
+		}
+
+		n.mutex.Lock()
+		delete(n.subENIs, subENIID)
+		n.mutex.Unlock()
+	}
+
+	return nil
+}
+
+func (n *Node) GetMaximumAllocatableIPv4() int {
+	l, ok := n.getLimits()
+	if !ok {
+		return 0
+	}
+
+	return l.IPv4
+}
+
+func (n *Node) GetMinimumAllocatableIPv4() int {
+	return 2
+}
+
+func (n *Node) IsPrefixDelegated() bool {
+	return false
+}
+
+func (n *Node) GetUsedIPWithPrefixes() int {
+	if n.k8sObj == nil {
+		return 0
+	}
+
+	return len(n.k8sObj.Status.IPAM.Used)
+}
+
+func (n *Node) getLimits() (ipamTypes.Limits, bool) {
+	n.mutex.RLock()
+	if n.k8sObj == nil || n.k8sObj.Spec.HuaweiCloud == nil {
+		n.mutex.RUnlock()
+		return ipamTypes.Limits{}, false
+	}
+	instanceType := n.k8sObj.Spec.HuaweiCloud.InstanceType
+	instanceID := n.instanceID
+	n.mutex.RUnlock()
+
+	if n.manager != nil && n.manager.api != nil && instanceID != "" {
+		lookupCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+
+		l, err := n.manager.api.GetInstanceLimits(lookupCtx, instanceID)
+		if err == nil {
+			if instanceType != "" {
+				limits.Update(instanceType, l)
+			}
+
+			return l, true
+		}
+	}
+	if l, ok := limits.Get(instanceType); ok {
+		return l, true
+	}
+
+	return ipamTypes.Limits{}, false
+}
+
+func (n *Node) getSecurityGroupIDs(ctx context.Context, spec eniTypes.Spec) ([]string, error) {
+	if len(spec.SecurityGroups) > 0 {
+		return spec.SecurityGroups, nil
+	}
+
+	if len(spec.SecurityGroupTags) > 0 {
+		groups := n.manager.FindSecurityGroupByTags(spec.VPCID, spec.SecurityGroupTags)
+		if len(groups) > 0 {
+			ids := make([]string, 0, len(groups))
+			for _, sg := range groups {
+				ids = append(ids, sg.ID)
+			}
+			return ids, nil
+		}
+	}
+
+	securityGroups := make([]string, 0)
+	seen := map[string]struct{}{}
+
+	n.manager.ForeachInstance(n.node.InstanceID(),
+		func(instanceID, interfaceID string, rev ipamTypes.InterfaceRevision) error {
+			e, ok := rev.Resource.(*eniTypes.SubENI)
+			if !ok || len(e.SecurityGroups) == 0 {
+				return nil
+			}
+
+			for _, secGroupID := range e.SecurityGroups {
+				if secGroupID == "" {
+					continue
+				}
+				if _, ok := seen[secGroupID]; ok {
+					continue
+				}
+				seen[secGroupID] = struct{}{}
+				securityGroups = append(securityGroups, secGroupID)
+			}
+
+			return nil
+		})
+
+	if len(securityGroups) > 0 {
+		return securityGroups, nil
+	}
+
+	return nil, errors.New("failed to get security group ids")
+}
+
+func (n *Node) getParentENIID() string {
+	n.mutex.RLock()
+	for _, subENI := range n.subENIs {
+		if subENI.ParentID != "" {
+			parentID := subENI.ParentID
+			n.mutex.RUnlock()
+			return parentID
+		}
+	}
+	n.mutex.RUnlock()
+
+	var parentENIID string
+	n.manager.ForeachInstance(n.node.InstanceID(),
+		func(instanceID, interfaceID string, rev ipamTypes.InterfaceRevision) error {
+			if parentENIID != "" {
+				return nil
+			}
+
+			e, ok := rev.Resource.(*eniTypes.SubENI)
+			if ok && e.ParentID != "" {
+				parentENIID = e.ParentID
+			}
+
+			return nil
+		})
+
+	return parentENIID
+}
