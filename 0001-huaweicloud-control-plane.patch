+// Copyright Authors of Cilium
+
+package types
+
+// SecurityGroup represents a HuaweiCloud security group
+type SecurityGroup struct {
+	// ID is the ID of the security group
+	ID string
+	// VPCID is the VPC this security group is associated with
+	VPCID string
+	// Tags is the tags on this security group
+	Tags map[string]string
+}
+
+// SecurityGroupMap is the map of security groups indexed by security group ID
+type SecurityGroupMap map[string]*SecurityGroup
