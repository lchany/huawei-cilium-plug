@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+//go:build ipam_provider_huaweicloud
+
+package cmd
+
+import (
+	"github.com/spf13/cobra"
+	"github.com/spf13/viper"
+
+	operatorOption "github.com/cilium/cilium/operator/option"
+	"github.com/cilium/cilium/pkg/option"
+)
+
+func init() {
+	FlagsHooks = append(FlagsHooks, &huaweicloudFlagsHooks{})
+}
+
+type huaweicloudFlagsHooks struct{}
+
+func (hook *huaweicloudFlagsHooks) RegisterProviderFlag(cmd *cobra.Command, vp *viper.Viper) {
+	flags := cmd.Flags()
+
+	flags.String(operatorOption.HuaweiCloudAccessKey, "", "Access key for HuaweiCloud API authentication")
+	option.BindEnv(vp, operatorOption.HuaweiCloudAccessKey)
+
+	flags.String(operatorOption.HuaweiCloudSecretKey, "", "Secret key for HuaweiCloud API authentication")
+	option.BindEnv(vp, operatorOption.HuaweiCloudSecretKey)
+
+	flags.String(operatorOption.HuaweiCloudProjectID, "", "Project ID for HuaweiCloud API")
+	option.BindEnv(vp, operatorOption.HuaweiCloudProjectID)
+
+	flags.String(operatorOption.HuaweiCloudRegion, "", "Region for HuaweiCloud API (auto-detected from instance metadata if not set)")
+	option.BindEnv(vp, operatorOption.HuaweiCloudRegion)
+
+	flags.String(operatorOption.HuaweiCloudVPCID, "", "VPC ID for HuaweiCloud ENI IPAM (auto-detected from instance metadata if not set)")
+	option.BindEnv(vp, operatorOption.HuaweiCloudVPCID)
+
+	flags.String(operatorOption.HuaweiCloudEndpoint, "", "Custom API endpoint for HuaweiCloud (optional, for private cloud deployments)")
+	option.BindEnv(vp, operatorOption.HuaweiCloudEndpoint)
+
+	vp.BindPFlags(flags)
+}
