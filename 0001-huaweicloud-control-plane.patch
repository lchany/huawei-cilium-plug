diff --git a/pkg/huaweicloud/api/api.go b/pkg/huaweicloud/api/api.go
new file mode 100644
index 0000000000..c67436d913
--- /dev/null
+++ b/pkg/huaweicloud/api/api.go
@@ -0,0 +1,781 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package api
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"net/netip"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/huaweicloud/huaweicloud-sdk-go-v3/core/auth"
+	"github.com/huaweicloud/huaweicloud-sdk-go-v3/core/config"
+	coreregion "github.com/huaweicloud/huaweicloud-sdk-go-v3/core/region"
+	hwECS "github.com/huaweicloud/huaweicloud-sdk-go-v3/services/ecs/v2"
+	ecsmodel "github.com/huaweicloud/huaweicloud-sdk-go-v3/services/ecs/v2/model"
+	hwECSRegion "github.com/huaweicloud/huaweicloud-sdk-go-v3/services/ecs/v2/region"
+	hwVPC "github.com/huaweicloud/huaweicloud-sdk-go-v3/services/vpc/v3"
+	vpcmodel "github.com/huaweicloud/huaweicloud-sdk-go-v3/services/vpc/v3/model"
+	hwVPCRegion "github.com/huaweicloud/huaweicloud-sdk-go-v3/services/vpc/v3/region"
+
+	"github.com/cilium/cilium/pkg/api/helpers"
+	"github.com/cilium/cilium/pkg/cidr"
+	eniTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+	hwTypes "github.com/cilium/cilium/pkg/huaweicloud/types"
+	ipamTypes "github.com/cilium/cilium/pkg/ipam/types"
+)
+
+type HuaweiCloudAPI interface {
+	CreateSubNetworkInterface(ctx context.Context, req CreateSubENIRequest) (string, *eniTypes.SubENI, error)
+	BatchCreateSubNetworkInterfaces(ctx context.Context, count int, req CreateSubENIRequest) ([]*eniTypes.SubENI, error)
+	TagSubNetworkInterface(ctx context.Context, subENIID string, tags map[string]string) error
+	DeleteSubNetworkInterface(ctx context.Context, subENIID string) error
+	GetSubNetworkInterface(ctx context.Context, subENIID string) (*eniTypes.SubENI, error)
+	ListSubNetworkInterfaces(ctx context.Context, parentID string) ([]*eniTypes.SubENI, error)
+	GetPortSecurityGroups(ctx context.Context, portID string) ([]string, error)
+	GetInstance(ctx context.Context, instanceID string) (*ipamTypes.Instance, error)
+	GetInstanceLimits(ctx context.Context, instanceID string) (ipamTypes.Limits, error)
+	GetInstances(ctx context.Context, vpcs ipamTypes.VirtualNetworkMap, subnets ipamTypes.SubnetMap) (*ipamTypes.InstanceMap, error)
+	GetSubnets(ctx context.Context, vpcID string) (ipamTypes.SubnetMap, error)
+	GetVPCs(ctx context.Context) (ipamTypes.VirtualNetworkMap, error)
+	GetSecurityGroups(ctx context.Context, vpcID string) (hwTypes.SecurityGroupMap, error)
+}
+
+type Client struct {
+	vpcClient *hwVPC.VpcClient
+	ecsClient *hwECS.EcsClient
+	limiter   *helpers.ApiLimiter
+}
+
+type noOpRateLimitMetrics struct{}
+
+func (n noOpRateLimitMetrics) ObserveRateLimit(operation string, duration time.Duration) {}
+
+var _ HuaweiCloudAPI = &Client{}
+
+func NewClient(accessKey, secretKey, projectID, region, endpoint string) (*Client, error) {
+	credentials, err := auth.NewBasicCredentialsBuilder().
+		WithAk(accessKey).
+		WithSk(secretKey).
+		WithProjectId(projectID).
+		SafeBuild()
+	if err != nil {
+		return nil, fmt.Errorf("build credentials: %w", err)
+	}
+
+	vpcBuilder := hwVPC.VpcClientBuilder().WithCredential(credentials)
+	ecsBuilder := hwECS.EcsClientBuilder().WithCredential(credentials)
+	httpConfig := config.DefaultHttpConfig().WithTimeout(10 * time.Second)
+	vpcBuilder = vpcBuilder.WithHttpConfig(httpConfig)
+	ecsBuilder = ecsBuilder.WithHttpConfig(httpConfig)
+
+	if strings.TrimSpace(endpoint) != "" {
+		vpcBuilder = vpcBuilder.WithEndpoint(endpoint)
+		ecsBuilder = ecsBuilder.WithEndpoint(endpoint)
+	} else {
+		if strings.TrimSpace(region) == "" {
+			return nil, fmt.Errorf("region is required when endpoint is empty")
+		}
+
+		vpcRegion, err := hwVPCRegion.SafeValueOf(region)
+		if err != nil {
+			vpcRegion = coreregion.NewRegion(region, fmt.Sprintf("https://vpc.%s.myhuaweicloud.com", region))
+		}
+		ecsRegion, err := hwECSRegion.SafeValueOf(region)
+		if err != nil {
+			ecsRegion = coreregion.NewRegion(region, fmt.Sprintf("https://ecs.%s.myhuaweicloud.com", region))
+		}
+
+		vpcBuilder = vpcBuilder.WithRegion(vpcRegion)
+		ecsBuilder = ecsBuilder.WithRegion(ecsRegion)
+	}
+
+	vpcHTTPClient, err := vpcBuilder.SafeBuild()
+	if err != nil {
+		return nil, fmt.Errorf("build vpc client: %w", err)
+	}
+	ecsHTTPClient, err := ecsBuilder.SafeBuild()
+	if err != nil {
+		return nil, fmt.Errorf("build ecs client: %w", err)
+	}
+
+	return &Client{
+		vpcClient: hwVPC.NewVpcClient(vpcHTTPClient),
+		ecsClient: hwECS.NewEcsClient(ecsHTTPClient),
+		limiter:   helpers.NewApiLimiter(noOpRateLimitMetrics{}, 20.0, 40),
+	}, nil
+}
+
+func (c *Client) CreateSubNetworkInterface(ctx context.Context, req CreateSubENIRequest) (string, *eniTypes.SubENI, error) {
+	if err := ctx.Err(); err != nil {
+		return "", nil, err
+	}
+	option := &vpcmodel.CreateSubNetworkInterfaceOption{VirsubnetId: req.SubnetID, ParentId: req.TrunkInterfaceID}
+	if len(req.SecurityGroupIDs) > 0 {
+		option.SecurityGroups = &req.SecurityGroupIDs
+	}
+	request := &vpcmodel.CreateSubNetworkInterfaceRequest{Body: &vpcmodel.CreateSubNetworkInterfaceRequestBody{SubNetworkInterface: option}}
+
+	c.limiter.Limit(ctx, "CreateSubNetworkInterface")
+	response, err := c.vpcClient.CreateSubNetworkInterface(request)
+	if err != nil {
+		return "", nil, normalizeAPIError(err)
+	}
+	if response.SubNetworkInterface == nil {
+		return "", nil, fmt.Errorf("empty sub_network_interface in create response")
+	}
+
+	subENI := parseSubENI(response.SubNetworkInterface)
+	if err := c.finalizeCreatedSubENIs(ctx, []*eniTypes.SubENI{subENI}, req.Tags); err != nil {
+		return "", nil, err
+	}
+	return subENI.ID, subENI, nil
+}
+
+func (c *Client) BatchCreateSubNetworkInterfaces(ctx context.Context, count int, req CreateSubENIRequest) ([]*eniTypes.SubENI, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if count <= 0 {
+		return nil, fmt.Errorf("count must be positive")
+	}
+	if count > 10 {
+		return nil, fmt.Errorf("batch create count exceeds max 10")
+	}
+
+	option := &vpcmodel.BatchCreateSubNetworkInterfaceOption{VirsubnetId: req.SubnetID, ParentId: req.TrunkInterfaceID}
+	if len(req.SecurityGroupIDs) > 0 {
+		option.SecurityGroups = &req.SecurityGroupIDs
+	}
+	request := &vpcmodel.BatchCreateSubNetworkInterfaceRequest{Body: &vpcmodel.BatchCreateSubNetworkInterfaceRequestBody{SubNetworkInterface: option, Count: int32(count)}}
+
+	c.limiter.Limit(ctx, "BatchCreateSubNetworkInterface")
+	response, err := c.vpcClient.BatchCreateSubNetworkInterface(request)
+	if err != nil {
+		return nil, normalizeAPIError(err)
+	}
+
+	if response.SubNetworkInterfaces == nil {
+		return []*eniTypes.SubENI{}, nil
+	}
+	result := make([]*eniTypes.SubENI, 0, len(*response.SubNetworkInterfaces))
+	for _, item := range *response.SubNetworkInterfaces {
+		result = append(result, parseSubENI(&item))
+	}
+	if err := c.finalizeCreatedSubENIs(ctx, result, req.Tags); err != nil {
+		return nil, err
+	}
+
+	return result, nil
+}
+
+func (c *Client) finalizeCreatedSubENIs(ctx context.Context, subENIs []*eniTypes.SubENI, tags map[string]string) error {
+	for _, subENI := range subENIs {
+		if err := c.fillSubENIGatewayInfo(ctx, subENI, nil); err != nil {
+			return c.rollbackCreatedSubENIs(subENIs, err)
+		}
+		if err := c.TagSubNetworkInterface(ctx, subENI.ID, tags); err != nil {
+			return c.rollbackCreatedSubENIs(subENIs, err)
+		}
+	}
+	return nil
+}
+
+func (c *Client) rollbackCreatedSubENIs(subENIs []*eniTypes.SubENI, cause error) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	var rollbackErr error
+	for _, subENI := range subENIs {
+		if err := c.DeleteSubNetworkInterface(ctx, subENI.ID); err != nil {
+			rollbackErr = fmt.Errorf("rollback sub-eni %s: %v", subENI.ID, err)
+		}
+	}
+	if rollbackErr != nil {
+		return fmt.Errorf("%w; %v", cause, rollbackErr)
+	}
+	return cause
+}
+
+func (c *Client) TagSubNetworkInterface(ctx context.Context, subENIID string, tags map[string]string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if len(tags) == 0 {
+		return nil
+	}
+	resourceTags := make([]vpcmodel.ResourceTag, 0, len(tags))
+	for key, value := range tags {
+		resourceTags = append(resourceTags, vpcmodel.ResourceTag{Key: key, Value: value})
+	}
+	request := &vpcmodel.BatchCreatePortTagsRequest{
+		PortId: subENIID,
+		Body:   &vpcmodel.BatchCreatePortTagsRequestBody{Tags: resourceTags},
+	}
+	c.limiter.Limit(ctx, "BatchCreatePortTags")
+	_, err := c.vpcClient.BatchCreatePortTags(request)
+	return normalizeAPIError(err)
+}
+
+func (c *Client) DeleteSubNetworkInterface(ctx context.Context, subENIID string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	request := &vpcmodel.DeleteSubNetworkInterfaceRequest{SubNetworkInterfaceId: subENIID}
+	c.limiter.Limit(ctx, "DeleteSubNetworkInterface")
+	_, err := c.vpcClient.DeleteSubNetworkInterface(request)
+	return normalizeAPIError(err)
+}
+
+func (c *Client) GetSubNetworkInterface(ctx context.Context, subENIID string) (*eniTypes.SubENI, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	request := &vpcmodel.ShowSubNetworkInterfaceRequest{SubNetworkInterfaceId: subENIID}
+	c.limiter.Limit(ctx, "ShowSubNetworkInterface")
+	response, err := c.vpcClient.ShowSubNetworkInterface(request)
+	if err != nil {
+		return nil, normalizeAPIError(err)
+	}
+	if response.SubNetworkInterface == nil {
+		return nil, fmt.Errorf("sub-eni %s not found", subENIID)
+	}
+	subENI := parseSubENI(response.SubNetworkInterface)
+	if err := c.fillSubENIGatewayInfo(ctx, subENI, nil); err != nil {
+		return nil, err
+	}
+	return subENI, nil
+}
+
+func (c *Client) ListSubNetworkInterfaces(ctx context.Context, parentID string) ([]*eniTypes.SubENI, error) {
+	var parentIDs []string
+	if parentID != "" {
+		parentIDs = []string{parentID}
+	}
+	items, err := c.listSubNetworkInterfaces(ctx, parentIDs)
+	if err != nil {
+		return nil, err
+	}
+	result := make([]*eniTypes.SubENI, 0, len(items))
+	for _, item := range items {
+		subENI := parseSubENI(&item)
+		if err := c.fillSubENIGatewayInfo(ctx, subENI, nil); err != nil {
+			return nil, err
+		}
+		result = append(result, subENI)
+	}
+
+	return result, nil
+}
+
+func (c *Client) listSubNetworkInterfaces(ctx context.Context, parentIDs []string) ([]vpcmodel.SubNetworkInterface, error) {
+	limit := int32(2000)
+	request := &vpcmodel.ListSubNetworkInterfacesRequest{Limit: &limit}
+	if len(parentIDs) > 0 {
+		request.ParentId = &parentIDs
+	}
+	var result []vpcmodel.SubNetworkInterface
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		c.limiter.Limit(ctx, "ListSubNetworkInterfaces")
+		response, err := c.vpcClient.ListSubNetworkInterfaces(request)
+		if err != nil {
+			return nil, normalizeAPIError(err)
+		}
+		if response.SubNetworkInterfaces != nil {
+			result = append(result, (*response.SubNetworkInterfaces)...)
+		}
+		request.Marker = nextMarker(response.PageInfo)
+		if request.Marker == nil {
+			return result, nil
+		}
+	}
+}
+
+func nextMarker(pageInfo *vpcmodel.PageInfo) *string {
+	if pageInfo == nil || pageInfo.NextMarker == nil || *pageInfo.NextMarker == "" {
+		return nil
+	}
+	return pageInfo.NextMarker
+}
