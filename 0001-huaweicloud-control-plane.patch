+func (c *Client) WaitSubENIActive(ctx context.Context, subENIID string) (*eniTypes.SubENI, error) {
+	return waitSubENIActive(ctx, subENIID, time.Second, 60*time.Second, c.GetSubNetworkInterface)
+}
+
+func waitSubENIActive(ctx context.Context, subENIID string, pollInterval, timeoutDuration time.Duration, get func(context.Context, string) (*eniTypes.SubENI, error)) (*eniTypes.SubENI, error) {
+	ticker := time.NewTicker(pollInterval)
+	defer ticker.Stop()
+	timeout := time.NewTimer(timeoutDuration)
+	defer timeout.Stop()
+
+	for {
+		subENI, err := get(ctx, subENIID)
+		if err != nil {
+			if !errors.Is(err, ErrNotFound) {
+				return nil, fmt.Errorf("wait sub-eni %s: %w", subENIID, err)
+			}
+		} else {
+			if subENI == nil {
+				return nil, fmt.Errorf("wait sub-eni %s: get returned nil without error", subENIID)
+			}
+			ready, err := classifySubENIState(subENI.State)
+			if err != nil {
+				return nil, fmt.Errorf("wait sub-eni %s: %w", subENIID, err)
+			}
+			if ready {
+				return subENI, nil
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-timeout.C:
+			// Perform one final observation at the deadline. Without this probe an
+			// interface which becomes ACTIVE exactly at 60 seconds can lose a
+			// scheduler race between the polling ticker and timeout timer.
+			subENI, err := get(ctx, subENIID)
+			if err == nil && subENI != nil {
+				ready, stateErr := classifySubENIState(subENI.State)
+				if stateErr != nil {
+					return nil, fmt.Errorf("wait sub-eni %s: %w", subENIID, stateErr)
+				}
+				if ready {
+					return subENI, nil
+				}
+			} else if err != nil && !errors.Is(err, ErrNotFound) {
+				return nil, fmt.Errorf("wait sub-eni %s: %w", subENIID, err)
+			} else if err == nil && subENI == nil {
+				return nil, fmt.Errorf("wait sub-eni %s: get returned nil without error", subENIID)
+			}
+			return nil, fmt.Errorf("timed out waiting for sub-eni %s to become ACTIVE", subENIID)
+		case <-ticker.C:
+		}
+	}
+}
+
+func classifySubENIState(state string) (bool, error) {
+	switch strings.ToUpper(strings.TrimSpace(state)) {
+	case "ACTIVE":
+		return true, nil
+	case "BUILD", "DOWN":
+		return false, nil
+	case "ERROR":
+		return false, fmt.Errorf("sub-ENI entered ERROR state")
+	default:
+		return false, fmt.Errorf("sub-ENI returned unknown state %q", state)
+	}
+}
+
+func parseSubENI(subENI *vpcmodel.SubNetworkInterface) *eniTypes.SubENI {
+	if subENI == nil {
+		return nil
+	}
+	return &eniTypes.SubENI{
+		ID:               subENI.Id,
+		PrivateIPAddress: subENI.PrivateIpAddress,
+		MACAddress:       subENI.MacAddress,
+		VlanID:           subENI.VlanId,
+		SubnetID:         subENI.VirsubnetId,
+		SecurityGroups:   append([]string(nil), subENI.SecurityGroups...),
+		State:            subENI.State,
+		ParentID:         subENI.ParentId,
+		VPCID:            subENI.VpcId,
+	}
+}
+
+func parseResourceTags(tags []vpcmodel.ResourceTag) map[string]string {
+	result := make(map[string]string, len(tags))
+	for _, tag := range tags {
+		result[tag.Key] = tag.Value
+	}
+	return result
+}
+
+func parseResponseTags(tags []vpcmodel.ResponseTag) ipamTypes.Tags {
+	result := make(ipamTypes.Tags, len(tags))
+	for _, tag := range tags {
+		result[tag.Key] = tag.Value
+	}
+	return result
+}
+
+func getParentPortsFromServer(server *ecsmodel.ServerDetail) []string {
+	if server == nil {
+		return nil
+	}
+
+	portSet := map[string]struct{}{}
+	if server.NetworkInterfaces != nil {
+		for _, networkInterface := range *server.NetworkInterfaces {
+			if networkInterface.PortId != nil && *networkInterface.PortId != "" {
+				portSet[*networkInterface.PortId] = struct{}{}
+			}
+		}
+	}
+
+	for _, addresses := range server.Addresses {
+		for _, address := range addresses {
+			if address.OSEXTIPSportId != nil && *address.OSEXTIPSportId != "" {
+				portSet[*address.OSEXTIPSportId] = struct{}{}
+			}
+		}
+	}
+
+	result := make([]string, 0, len(portSet))
+	for port := range portSet {
+		result = append(result, port)
+	}
+	return result
+}
