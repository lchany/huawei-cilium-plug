+	ipamMetrics "github.com/cilium/cilium/pkg/ipam/metrics"
+	"github.com/cilium/cilium/pkg/logging/logfields"
+	"github.com/cilium/cilium/pkg/metrics"
+)
+
+var subsysLogAttr = []any{logfields.LogSubsys, "ipam-allocator-huawei-cloud"}
+
+type AllocatorHuaweiCloud struct {
+	rootLogger *slog.Logger
+	logger     *slog.Logger
+	client     *hwAPI.Client
+	vpcID      string
+}
+
+func (a *AllocatorHuaweiCloud) Init(ctx context.Context, logger *slog.Logger, reg *metrics.Registry) error {
+	a.rootLogger = logger
+	a.logger = logger.With(subsysLogAttr...)
+
+	ak := operatorOption.Config.HuaweiCloudAccessKey
+	sk := operatorOption.Config.HuaweiCloudSecretKey
+	projectID := operatorOption.Config.HuaweiCloudProjectID
+	region := operatorOption.Config.HuaweiCloudRegion
+	vpcID := operatorOption.Config.HuaweiCloudVPCID
+	endpoint := operatorOption.Config.HuaweiCloudEndpoint
+
+	if ak == "" {
+		return fmt.Errorf("--huawei-cloud-access-key is required for HuaweiCloud IPAM")
+	}
+	if sk == "" {
+		return fmt.Errorf("--huawei-cloud-secret-key is required for HuaweiCloud IPAM")
+	}
+	if projectID == "" {
+		return fmt.Errorf("--huawei-cloud-project-id is required for HuaweiCloud IPAM")
+	}
+
+	if region == "" {
+		var err error
+		region, err = metadata.GetRegionID(ctx)
+		if err != nil {
+			return fmt.Errorf("--huawei-cloud-region not set and failed to get region from instance metadata: %w", err)
+		}
+	}
+
+	if vpcID == "" {
+		var err error
+		vpcID, err = metadata.GetVPCID(ctx)
+		if err != nil {
+			a.logger.Warn("Unable to get VPC ID from instance metadata, proceeding without VPC ID constraint", logfields.Error, err)
+		}
+	}
+
+	a.vpcID = vpcID
+
+	client, err := hwAPI.NewClient(ak, sk, projectID, region, endpoint)
+	if err != nil {
+		return fmt.Errorf("unable to create HuaweiCloud API client: %w", err)
+	}
+
+	a.client = client
+	a.logger.Info("HuaweiCloud IPAM allocator initialized")
+	return nil
+}
+
+func (a *AllocatorHuaweiCloud) Start(ctx context.Context, getterUpdater ipam.CiliumNodeGetterUpdater, reg *metrics.Registry) (allocator.NodeEventHandler, error) {
+	var iMetrics ipam.MetricsAPI
+
+	a.logger.Info("Starting HuaweiCloud Sub-ENI allocator...")
+
+	if operatorOption.Config.EnableMetrics {
+		iMetrics = ipamMetrics.NewPrometheusMetrics(metrics.Namespace, reg)
+	} else {
+		iMetrics = &ipamMetrics.NoOpMetrics{}
+	}
+
+	instances := eni.NewInstancesManager(a.rootLogger, a.client, a.vpcID)
+	nodeManager, err := ipam.NewNodeManager(a.logger, instances, getterUpdater, iMetrics,
+		operatorOption.Config.ParallelAllocWorkers,
+		false,
+		false,
+	)
+	if err != nil {
+		return nil, fmt.Errorf("unable to initialize HuaweiCloud node manager: %w", err)
+	}
+
+	if err := nodeManager.Start(ctx); err != nil {
+		return nil, err
+	}
+
+	return nodeManager, nil
+}
