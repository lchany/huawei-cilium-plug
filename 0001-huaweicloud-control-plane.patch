diff --git a/pkg/huaweicloud/eni/instances.go b/pkg/huaweicloud/eni/instances.go
new file mode 100644
index 0000000000..fc1c1fa236
--- /dev/null
+++ b/pkg/huaweicloud/eni/instances.go
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package eni
+
+import (
+	"context"
+	"log/slog"
+
+	hwAPI "github.com/cilium/cilium/pkg/huaweicloud/api"
+	eniTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+	hwTypes "github.com/cilium/cilium/pkg/huaweicloud/types"
+	"github.com/cilium/cilium/pkg/ipam"
+	ipamTypes "github.com/cilium/cilium/pkg/ipam/types"
+	v2 "github.com/cilium/cilium/pkg/k8s/apis/cilium.io/v2"
+	"github.com/cilium/cilium/pkg/lock"
+	"github.com/cilium/cilium/pkg/logging/logfields"
+	"github.com/cilium/cilium/pkg/time"
+)
+
+var _ ipam.AllocationImplementation = (*InstancesManager)(nil)
+
+type InstancesManager struct {
+	logger         *slog.Logger
+	mutex          lock.RWMutex
+	resyncLock     lock.RWMutex
+	instances      *ipamTypes.InstanceMap
+	subnets        ipamTypes.SubnetMap
+	vpcs           ipamTypes.VirtualNetworkMap
+	securityGroups hwTypes.SecurityGroupMap
+	api            hwAPI.HuaweiCloudAPI
+	vpcID          string
+}
+
+func NewInstancesManager(logger *slog.Logger, api hwAPI.HuaweiCloudAPI, vpcID string) *InstancesManager {
+	return &InstancesManager{
+		logger:    logger.With(subsysLogAttr...),
+		instances: ipamTypes.NewInstanceMap(),
+		api:       api,
+		vpcID:     vpcID,
+	}
+}
+
+func (m *InstancesManager) CreateNode(obj *v2.CiliumNode, node *ipam.Node) ipam.NodeOperations {
+	return &Node{
+		logger:     m.logger,
+		k8sObj:     obj,
+		manager:    m,
+		node:       node,
+		instanceID: node.InstanceID(),
+		subENIs:    map[string]eniTypes.SubENI{},
+	}
+}
+
+func (m *InstancesManager) HasInstance(instanceID string) bool {
+	m.mutex.RLock()
+	defer m.mutex.RUnlock()
+	return m.instances.Exists(instanceID)
+}
+
+func (m *InstancesManager) DeleteInstance(instanceID string) {
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+	m.instances.Delete(instanceID)
+}
+
+func (m *InstancesManager) GetPoolQuota() ipamTypes.PoolQuotaMap {
+	pool := ipamTypes.PoolQuotaMap{}
+	for subnetID, subnet := range m.GetSubnets() {
+		pool[ipamTypes.PoolID(subnetID)] = ipamTypes.PoolQuota{
+			AvailabilityZone: subnet.AvailabilityZone,
+			AvailableIPs:     subnet.AvailableAddresses,
+		}
+	}
+
+	return pool
+}
+
+func (m *InstancesManager) Resync(ctx context.Context) time.Time {
+	m.resyncLock.Lock()
+	defer m.resyncLock.Unlock()
+	return m.resync(ctx, "")
+}
+
+func (m *InstancesManager) InstanceSync(ctx context.Context, instanceID string) time.Time {
+	m.resyncLock.RLock()
+	defer m.resyncLock.RUnlock()
+	return m.resync(ctx, instanceID)
+}
+
+func (m *InstancesManager) resync(ctx context.Context, instanceID string) time.Time {
+	resyncStart := time.Now()
+
+	vpcs, err := m.api.GetVPCs(ctx)
+	if err != nil {
+		m.logger.Warn("Unable to synchronize VPC list", logfields.Error, err)
+		return time.Time{}
+	}
+
+	subnets, err := m.api.GetSubnets(ctx, "")
+	if err != nil {
+		m.logger.Warn("Unable to retrieve subnet list", logfields.Error, err)
+		return time.Time{}
+	}
+
+	securityGroups, err := m.api.GetSecurityGroups(ctx, m.vpcID)
+	if err != nil {
+		m.logger.Warn("Unable to retrieve security group list", logfields.Error, err)
+		return time.Time{}
+	}
+
+	if instanceID == "" {
+		instances, err := m.api.GetInstances(ctx, vpcs, subnets)
+		if err != nil {
+			m.logger.Warn("Unable to synchronize instance list", logfields.Error, err)
+			return time.Time{}
+		}
+
+		m.logger.Info("Synchronized Sub-ENI information",
+			"numInstances", instances.NumInstances(),
+			"numVPCs", len(vpcs),
+			"numSubnets", len(subnets),
+			"numSecurityGroups", len(securityGroups),
+		)
+
+		m.mutex.Lock()
+		m.instances = instances
+		m.subnets = subnets
+		m.vpcs = vpcs
+		m.securityGroups = securityGroups
+		m.mutex.Unlock()
+	} else {
+		instance, err := m.api.GetInstance(ctx, instanceID)
+		if err != nil {
+			m.logger.Warn("Unable to synchronize instance", logfields.Error, err)
+			return time.Time{}
+		}
+
+		m.mutex.Lock()
+		m.instances.UpdateInstance(instanceID, instance)
+		m.subnets = subnets
+		m.vpcs = vpcs
+		m.securityGroups = securityGroups
+		m.mutex.Unlock()
+	}
+
+	return resyncStart
+}
+
+func (m *InstancesManager) GetSubnets() ipamTypes.SubnetMap {
+	m.mutex.RLock()
+	defer m.mutex.RUnlock()
+
+	subnetsCopy := make(ipamTypes.SubnetMap, len(m.subnets))
+	for k, v := range m.subnets {
+		subnetsCopy[k] = v
+	}
+
+	return subnetsCopy
+}
+
+func (m *InstancesManager) GetSubnet(id string) *ipamTypes.Subnet {
+	m.mutex.RLock()
+	defer m.mutex.RUnlock()
+	return m.subnets[id]
+}
+
+func (m *InstancesManager) ForeachInstance(instanceID string, fn ipamTypes.InterfaceIterator) {
+	m.mutex.RLock()
+	defer m.mutex.RUnlock()
+	m.instances.ForeachInterface(instanceID, fn)
+}
+
+func (m *InstancesManager) UpdateSubENI(instanceID string, subENI *eniTypes.SubENI) {
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+	m.instances.Update(instanceID, ipamTypes.InterfaceRevision{Resource: subENI})
+}
+
+func (m *InstancesManager) FindOneSubnet(spec eniTypes.Spec, toAllocate int) *ipamTypes.Subnet {
+	if len(spec.Subnets) > 0 {
+		return m.findSubnetByIDs(spec, toAllocate)
+	}
+
+	var bestSubnet *ipamTypes.Subnet
+	for _, subnet := range m.GetSubnets() {
+		if subnet.VirtualNetworkID != spec.VPCID {
+			continue
+		}
+		if subnet.AvailabilityZone != spec.AvailabilityZone {
+			continue
+		}
+		if subnet.AvailableAddresses < toAllocate {
+			continue
+		}
+		if len(spec.SubnetTags) > 0 && !subnet.Tags.Match(spec.SubnetTags) {
+			continue
+		}
+		if bestSubnet == nil || bestSubnet.AvailableAddresses < subnet.AvailableAddresses {
+			bestSubnet = subnet
+		}
+	}
+
+	return bestSubnet
+}
+
+func (m *InstancesManager) findSubnetByIDs(spec eniTypes.Spec, toAllocate int) *ipamTypes.Subnet {
+	m.mutex.RLock()
+	defer m.mutex.RUnlock()
+
+	var bestSubnet *ipamTypes.Subnet
+	for _, subnet := range m.subnets {
+		if subnet.VirtualNetworkID != spec.VPCID || subnet.AvailabilityZone != spec.AvailabilityZone {
+			continue
+		}
+		if subnet.AvailableAddresses < toAllocate {
+			continue
+		}
+		for _, subnetID := range spec.Subnets {
+			if subnet.ID != subnetID {
+				continue
+			}
+			if bestSubnet == nil || bestSubnet.AvailableAddresses < subnet.AvailableAddresses {
+				bestSubnet = subnet
+			}
+		}
+	}
+
+	return bestSubnet
+}
+
+func (m *InstancesManager) FindSecurityGroupByTags(vpcID string, required ipamTypes.Tags) []*hwTypes.SecurityGroup {
+	m.mutex.RLock()
+	defer m.mutex.RUnlock()
+
+	groups := []*hwTypes.SecurityGroup{}
+	for _, sg := range m.securityGroups {
+		// sg.VPCID is populated by the operator at cache time using the operator's
+		// own VPCID. If that was unavailable (metadata failure), sg.VPCID is "".
+		// In that case skip the VPC filter rather than silently excluding all SGs.
+		if sg.VPCID != "" && sg.VPCID != vpcID {
+			continue
+		}
+
+		match := true
+		for k, v := range required {
+			if sg.Tags[k] != v {
+				match = false
+				break
+			}
+		}
+
+		if match {
+			groups = append(groups, sg)
+		}
+	}
+
+	return groups
+}
