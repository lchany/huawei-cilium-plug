+func applyHuaweiCloudIPAMNetConf(dst *ipamTypes.IPAMSpec, src ipamTypes.IPAMSpec) {
+	if dst == nil {
+		return
+	}
+	if src.MinAllocate != 0 {
+		dst.MinAllocate = src.MinAllocate
+	}
+	if src.PreAllocate != 0 {
+		dst.PreAllocate = src.PreAllocate
+	}
+}
+
+func applyHuaweiCloudNetConf(dst *huaweiCloudTypes.Spec, src huaweiCloudTypes.Spec) {
+	if dst == nil {
+		return
+	}
+	if len(src.Subnets) > 0 {
+		dst.Subnets = append([]string(nil), src.Subnets...)
+	}
+	if len(src.SubnetTags) > 0 {
+		dst.SubnetTags = cloneStringMap(src.SubnetTags)
+	}
+	if len(src.SecurityGroups) > 0 {
+		dst.SecurityGroups = append([]string(nil), src.SecurityGroups...)
+	}
+	if len(src.SecurityGroupTags) > 0 {
+		dst.SecurityGroupTags = cloneStringMap(src.SecurityGroupTags)
+	}
+}
+
+func cloneStringMap(src map[string]string) map[string]string {
+	dst := make(map[string]string, len(src))
+	for key, value := range src {
+		dst[key] = value
+	}
+	return dst
+}
