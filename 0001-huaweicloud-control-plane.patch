+}
+
+type huaweiCloudEndpointInfo struct {
+	ipv4           string
+	id             uint32
+	ifIndex        uint32
+	mac            [6]byte
+	vlanID         int32
+	gatewayIP      net.IP
+	gatewayMAC     net.HardwareAddr
+	trunkInterface string
+}
+
+func (e *huaweiCloudEndpointInfo) GetIPv4Address() string { return e.ipv4 }
+func (e *huaweiCloudEndpointInfo) GetID() uint32          { return e.id }
+func (e *huaweiCloudEndpointInfo) GetIfIndex() uint32     { return e.ifIndex }
+func (e *huaweiCloudEndpointInfo) GetMACAddress() [6]byte { return e.mac }
+func (e *huaweiCloudEndpointInfo) GetVLANID() int32       { return e.vlanID }
+
+func registerHuaweiCloudSubENIManager(p huaweiCloudSubENIParams) error {
+	if option.Config.IPAM != ipamOption.IPAMHuaweiCloud || !p.Clientset.IsEnabled() {
+		return nil
+	}
+
+	mapMgr, err := subenimap.NewSubENIMapManager(p.Logger)
+	if err != nil {
+		return fmt.Errorf("create HuaweiCloud SubENI map manager: %w", err)
+	}
+
+	subscriber := &huaweiCloudSubENISubscriber{
+		logger:    p.Logger,
+		clientset: p.Clientset,
+		mapMgr:    mapMgr,
+	}
+	p.Manager.Subscribe(subscriber)
+	for _, ep := range p.Manager.GetEndpoints() {
+		subscriber.upsertEndpoint(ep, "initial-sync")
+	}
+
+	p.Lifecycle.Append(cell.Hook{
+		OnStop: func(cell.HookContext) error {
+			p.Manager.Unsubscribe(subscriber)
+			mapMgr.Close()
+			return nil
+		},
+	})
+
+	return nil
+}
+
+func (s *huaweiCloudSubENISubscriber) EndpointCreated(ep *endpoint.Endpoint) {
+	s.upsertEndpoint(ep, "created")
+}
+
+func (s *huaweiCloudSubENISubscriber) EndpointRestored(ep *endpoint.Endpoint) {
+	s.upsertEndpoint(ep, "restored")
+}
+
+func (s *huaweiCloudSubENISubscriber) EndpointDeleted(ep *endpoint.Endpoint, _ endpoint.DeleteConfig) {
+	info, err := s.resolveEndpointInfo(ep)
+	if err != nil {
+		s.logger.Warn("Failed to resolve HuaweiCloud SubENI endpoint info on delete",
+			logfields.Error, err,
+			logfields.EndpointID, ep.GetID(),
+			logfields.IPv4, ep.GetIPv4Address(),
+		)
+		return
+	}
+	if info == nil {
+		return
+	}
+	if err := s.mapMgr.OnEndpointDelete(info); err != nil {
+		s.logger.Warn("Failed to delete HuaweiCloud SubENI BPF map entries",
+			logfields.Error, err,
+			logfields.EndpointID, ep.GetID(),
+			logfields.IPv4, ep.GetIPv4Address(),
+		)
+	}
+}
+
+func (s *huaweiCloudSubENISubscriber) upsertEndpoint(ep *endpoint.Endpoint, reason string) {
+	info, err := s.resolveEndpointInfo(ep)
+	if err != nil {
+		s.logger.Warn("Failed to resolve HuaweiCloud SubENI endpoint info",
+			logfields.Error, err,
+			logfields.EndpointID, ep.GetID(),
+			logfields.IPv4, ep.GetIPv4Address(),
+			slog.String("reason", reason),
+		)
+		return
+	}
+	if info == nil {
+		return
+	}
+	if err := s.ensureGatewayNeighbor(info); err != nil {
+		s.logger.Warn("Failed to install HuaweiCloud gateway neighbor entry",
+			logfields.Error, err,
+			logfields.EndpointID, ep.GetID(),
+			logfields.IPv4, ep.GetIPv4Address(),
+			slog.String("reason", reason),
+		)
+	}
+	if err := s.mapMgr.OnEndpointReady(info); err != nil {
+		s.logger.Warn("Failed to upsert HuaweiCloud SubENI BPF map entries",
+			logfields.Error, err,
+			logfields.EndpointID, ep.GetID(),
+			logfields.IPv4, ep.GetIPv4Address(),
+			slog.String("reason", reason),
+		)
+	}
+}
+
+func (s *huaweiCloudSubENISubscriber) resolveEndpointInfo(ep *endpoint.Endpoint) (*huaweiCloudEndpointInfo, error) {
+	if ep == nil || ep.GetIfIndex() == 0 || ep.GetID() == 0 {
+		return nil, nil
+	}
+
+	ipv4 := ep.GetIPv4Address()
+	if ipv4 == "" {
+		return nil, nil
+	}
+
+	nodeName := nodeTypes.GetName()
+	cn, err := s.clientset.CiliumV2().CiliumNodes().Get(context.Background(), nodeName, metav1.GetOptions{})
+	if err != nil {
+		return nil, fmt.Errorf("get CiliumNode %s: %w", nodeName, err)
+	}
+
+	return subENIInfoForEndpoint(cn, ep)
+}
+
+func subENIInfoForEndpoint(cn *cilium_v2.CiliumNode, ep subENIEndpoint) (*huaweiCloudEndpointInfo, error) {
+	if cn == nil || cn.Status.HuaweiCloud == nil {
+		return nil, nil
+	}
+
+	ipv4 := ep.GetIPv4Address()
+	for _, subENI := range cn.Status.HuaweiCloud.SubENIs {
+		if subENI.PrivateIPAddress != ipv4 {
+			continue
+		}
+
+		parsedMAC, err := net.ParseMAC(subENI.MACAddress)
+		if err != nil {
+			return nil, fmt.Errorf("parse HuaweiCloud SubENI MAC %q for %s: %w", subENI.MACAddress, ipv4, err)
+		}
+		var macArr [6]byte
+		copy(macArr[:], parsedMAC)
+
+		gatewayMAC, err := parseOptionalMAC(subENI.GatewayMAC)
+		if err != nil {
+			return nil, fmt.Errorf("parse HuaweiCloud gateway MAC %q for %s: %w", subENI.GatewayMAC, ipv4, err)
+		}
+		gatewayIP, err := parseOptionalIPv4(subENI.GatewayIP)
+		if err != nil {
+			return nil, fmt.Errorf("parse HuaweiCloud gateway IP %q for %s: %w", subENI.GatewayIP, ipv4, err)
+		}
+
+		return &huaweiCloudEndpointInfo{
+			ipv4:           ipv4,
+			id:             uint32(ep.GetID()),
+			ifIndex:        uint32(ep.GetIfIndex()),
+			mac:            macArr,
+			vlanID:         subENI.VlanID,
+			gatewayIP:      gatewayIP,
+			gatewayMAC:     gatewayMAC,
+			trunkInterface: subENI.TrunkInterface,
+		}, nil
+	}
+
+	return nil, nil
+}
+
+func parseOptionalMAC(raw string) (net.HardwareAddr, error) {
+	if raw == "" {
+		return nil, nil
+	}
+	return net.ParseMAC(raw)
+}
+
+func parseOptionalIPv4(raw string) (net.IP, error) {
+	if raw == "" {
+		return nil, nil
+	}
+	ip := net.ParseIP(raw).To4()
+	if ip == nil {
+		return nil, fmt.Errorf("invalid IPv4 address")
+	}
+	return ip, nil
+}
+
+func (s *huaweiCloudSubENISubscriber) ensureGatewayNeighbor(info *huaweiCloudEndpointInfo) error {
+	if info == nil || info.gatewayIP == nil || len(info.gatewayMAC) == 0 || info.trunkInterface == "" {
+		return nil
+	}
+
+	link, err := safenetlink.LinkByName(info.trunkInterface)
+	if err != nil {
+		return fmt.Errorf("resolve trunk interface %s: %w", info.trunkInterface, err)
+	}
+
+	return netlink.NeighSet(&netlink.Neigh{
+		LinkIndex:    link.Attrs().Index,
+		Family:       netlink.FAMILY_V4,
+		State:        netlink.NUD_PERMANENT,
+		IP:           info.gatewayIP,
+		HardwareAddr: info.gatewayMAC,
+	})
+}
+
+var _ Subscriber = (*huaweiCloudSubENISubscriber)(nil)
+var _ subENIMapUpdater = (*subenimap.SubENIMapManager)(nil)
+var _ = huaweiCloudTypes.SubENI{}
diff --git a/pkg/huaweicloud/subenimap/manager.go b/pkg/huaweicloud/subenimap/manager.go
new file mode 100644
index 0000000000..192f4d8cef
--- /dev/null
+++ b/pkg/huaweicloud/subenimap/manager.go
@@ -0,0 +1,220 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package subenimap
+
+import (
+	"fmt"
+	"log/slog"
+	"net"
+
+	"github.com/cilium/cilium/pkg/bpf"
+	"github.com/cilium/cilium/pkg/lock"
+)
+
+const (
+	srcIPMapName   = "cilium_hwc_srcip4"
+	vlanMACMapName = "cilium_hwc_vlan_mac"
+	maxEntries     = 65536
+)
+
+// EndpointInfo provides the data needed to populate the SubENI BPF maps.
+type EndpointInfo interface {
+	// GetIPv4Address returns the Pod IPv4 address (e.g. "10.0.0.5").
+	GetIPv4Address() string
+	// GetID returns the endpoint's LXC ID.
+	GetID() uint32
+	// GetIfIndex returns the interface ifindex of the endpoint's veth.
+	GetIfIndex() uint32
+	// GetMACAddress returns the MAC address of the SubENI bound to this endpoint.
+	GetMACAddress() [6]byte
+	// GetVLANID returns the VLAN ID from the SubENI binding.
+	GetVLANID() int32
+}
+
+// mapBackend abstracts bpf.Map operations to allow test injection.
+type mapBackend interface {
+	Update(key bpf.MapKey, value bpf.MapValue) error
+	Delete(key bpf.MapKey) (bool, error)
+}
+
+// bpfMapAdapter wraps *bpf.Map so it satisfies mapBackend.
+// bpf.Map.Delete returns (error), but mapBackend.Delete returns (bool, error),
+// so we delegate to SilentDelete which already returns (bool, error).
+type bpfMapAdapter struct {
+	m *bpf.Map
+}
+
+func (a *bpfMapAdapter) Update(key bpf.MapKey, value bpf.MapValue) error {
+	return a.m.Update(key, value)
+}
+
+func (a *bpfMapAdapter) Delete(key bpf.MapKey) (bool, error) {
+	return a.m.SilentDelete(key)
+}
+
+// SubENIMapManager maintains two BPF maps used by the HuaweiCloud SubENI
+// datapath:
+//
+//   - cilium_hwc_srcip4   (egress):  Pod IPv4 → SubENI VLAN/MAC/LXC-ID
+//   - cilium_hwc_vlan_mac (ingress): (VLAN ID, dst MAC) → endpoint ifindex/LXC-ID
+type SubENIMapManager struct {
+	logger     *slog.Logger
+	srcIPMap   mapBackend
+	vlanMACMap mapBackend
+	mutex      lock.RWMutex
+}
+
+// NewSubENIMapManager creates a SubENIMapManager that attaches to the pinned
+// HuaweiCloud datapath maps on first use.
+func NewSubENIMapManager(logger *slog.Logger) (*SubENIMapManager, error) {
+	return &SubENIMapManager{
+		logger: logger,
+	}, nil
+}
+
+func (m *SubENIMapManager) ensureMapsOpenLocked() error {
+	if m.srcIPMap != nil && m.vlanMACMap != nil {
+		return nil
+	}
+
+	srcIP, err := bpf.OpenMap(bpf.MapPath(m.logger, srcIPMapName), &SrcIPKey4{}, &SubENIInfo{})
+	if err != nil {
+		return fmt.Errorf("failed to open pinned %s: %w", srcIPMapName, err)
+	}
+
+	vlanMAC, err := bpf.OpenMap(bpf.MapPath(m.logger, vlanMACMapName), &VLANMACKey{}, &EPInfo{})
+	if err != nil {
+		_ = srcIP.Close()
+		return fmt.Errorf("failed to open pinned %s: %w", vlanMACMapName, err)
+	}
+
+	m.srcIPMap = &bpfMapAdapter{m: srcIP}
+	m.vlanMACMap = &bpfMapAdapter{m: vlanMAC}
+
+	return nil
+}
+
+// newWithBackends is used in tests to inject fake map backends without opening
+// real BPF file descriptors.
+func newWithBackends(logger *slog.Logger, srcIP mapBackend, vlanMAC mapBackend) *SubENIMapManager {
+	return &SubENIMapManager{
+		logger:     logger,
+		srcIPMap:   srcIP,
+		vlanMACMap: vlanMAC,
+	}
+}
+
+func parseIPv4(addr string) ([4]byte, error) {
+	ip := net.ParseIP(addr)
+	if ip == nil {
+		return [4]byte{}, fmt.Errorf("invalid IPv4 address: %q", addr)
+	}
+	ip4 := ip.To4()
+	if ip4 == nil {
+		return [4]byte{}, fmt.Errorf("address is not IPv4: %q", addr)
+	}
+	return [4]byte(ip4), nil
+}
+
+// OnEndpointReady upserts one entry in each BPF map for the given endpoint.
+// It is safe to call concurrently.
+func (m *SubENIMapManager) OnEndpointReady(ep EndpointInfo) error {
+	addrBytes, err := parseIPv4(ep.GetIPv4Address())
+	if err != nil {
+		return fmt.Errorf("OnEndpointReady: %w", err)
+	}
+
+	mac := ep.GetMACAddress()
+	var macArr [6]uint8
+	copy(macArr[:], mac[:])
+
+	vlanID := uint16(ep.GetVLANID()) //nolint:gosec // vlan IDs fit in uint16
+
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+
+	if err := m.ensureMapsOpenLocked(); err != nil {
+		return fmt.Errorf("OnEndpointReady: %w", err)
+	}
+
+	// --- Map 1: srcip → subeni info (egress) ---
+	srcKey := &SrcIPKey4{Addr: addrBytes}
+	srcVal := &SubENIInfo{
+		VlanID: vlanID,
+		MAC:    macArr,
+		LxcID:  ep.GetID(),
+	}
+	if err := m.srcIPMap.Update(srcKey, srcVal); err != nil {
+		return fmt.Errorf("OnEndpointReady: update %s key=%s: %w", srcIPMapName, srcKey, err)
+	}
+
+	// --- Map 2: (vlan-id, dst-mac) → endpoint (ingress) ---
+	vlanKey := &VLANMACKey{
+		VlanID: vlanID,
+		MAC:    macArr,
+	}
+	epVal := &EPInfo{
+		IfIndex: ep.GetIfIndex(),
+		LxcID:   uint16(ep.GetID()), //nolint:gosec // LXC IDs fit in uint16
+	}
+	if err := m.vlanMACMap.Update(vlanKey, epVal); err != nil {
+		return fmt.Errorf("OnEndpointReady: update %s key=%s: %w", vlanMACMapName, vlanKey, err)
+	}
+
+	return nil
+}
+
+// OnEndpointDelete removes the entries for the given endpoint from both BPF
+// maps on a best-effort basis (individual delete errors are logged but not
+// returned).
+func (m *SubENIMapManager) OnEndpointDelete(ep EndpointInfo) error {
+	addrBytes, err := parseIPv4(ep.GetIPv4Address())
+	if err != nil {
+		return fmt.Errorf("OnEndpointDelete: %w", err)
+	}
+
+	mac := ep.GetMACAddress()
+	var macArr [6]uint8
+	copy(macArr[:], mac[:])
+
+	vlanID := uint16(ep.GetVLANID()) //nolint:gosec
+
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+
+	if err := m.ensureMapsOpenLocked(); err != nil {
+		return fmt.Errorf("OnEndpointDelete: %w", err)
+	}
+
+	// best-effort: log errors but do not propagate them.
+	if _, err := m.srcIPMap.Delete(&SrcIPKey4{Addr: addrBytes}); err != nil {
+		m.logger.Warn("failed to delete srcip entry",
+			slog.String("map", srcIPMapName),
+			slog.String("addr", ep.GetIPv4Address()),
+			slog.Any("error", err),
+		)
+	}
+
+	if _, err := m.vlanMACMap.Delete(&VLANMACKey{VlanID: vlanID, MAC: macArr}); err != nil {
+		m.logger.Warn("failed to delete vlan-mac entry",
+			slog.String("map", vlanMACMapName),
+			slog.String("addr", ep.GetIPv4Address()),
+			slog.Any("error", err),
+		)
+	}
+
+	return nil
+}
+
+// Close releases any resources held by the manager.
+// After Close the manager must not be used.
+func (m *SubENIMapManager) Close() {
+	// If the underlying backends are real bpf.Map adapters, close the maps.
+	if a, ok := m.srcIPMap.(*bpfMapAdapter); ok {
+		_ = a.m.Close()
+	}
+	if a, ok := m.vlanMACMap.(*bpfMapAdapter); ok {
+		_ = a.m.Close()
+	}
+}
diff --git a/pkg/huaweicloud/subenimap/types.go b/pkg/huaweicloud/subenimap/types.go
new file mode 100644
index 0000000000..62e4f1d24c
--- /dev/null
+++ b/pkg/huaweicloud/subenimap/types.go
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package subenimap
+
+import (
+	"fmt"
+	"net"
+
+	"github.com/cilium/cilium/pkg/bpf"
+)
+
+// SrcIPKey4 is the key for the cilium_hwc_srcip4 BPF map.
+// It corresponds to struct hwc_srcip_key4 in BPF C code.
+//
+// Egress path: look up SubENI info by Pod IPv4 source IP.
+type SrcIPKey4 struct {
+	Addr [4]byte `align:"addr"`
+}
+
+// String returns a human-readable representation of the key.
+func (k *SrcIPKey4) String() string {
+	return fmt.Sprintf("addr=%s", net.IP(k.Addr[:]).String())
+}
+
+// New returns a pointer to a new SrcIPKey4, satisfying bpf.MapKey.
+func (k *SrcIPKey4) New() bpf.MapKey { return &SrcIPKey4{} }
+
+// SubENIInfo is the value for the cilium_hwc_srcip4 BPF map.
+// It corresponds to struct hwc_subeni_info in BPF C code.
+type SubENIInfo struct {
+	// VlanID is the VLAN ID of the SubENI.
+	VlanID uint16 `align:"vlan_id"`
+	// MAC is the MAC address of the SubENI.
+	MAC [6]uint8 `align:"mac"`
+	// Pad is alignment padding.
+	Pad      uint16 `align:"pad"`
+	Reserved uint16 `align:"reserved"`
+	// LxcID is the endpoint (LXC) ID.
+	LxcID uint32 `align:"lxc_id"`
+}
+
+// String returns a human-readable representation of the value.
+func (v *SubENIInfo) String() string {
+	return fmt.Sprintf("vlan_id=%d mac=%02x:%02x:%02x:%02x:%02x:%02x lxc_id=%d",
+		v.VlanID,
+		v.MAC[0], v.MAC[1], v.MAC[2], v.MAC[3], v.MAC[4], v.MAC[5],
+		v.LxcID,
+	)
+}
+
+// New returns a pointer to a new SubENIInfo, satisfying bpf.MapValue.
+func (v *SubENIInfo) New() bpf.MapValue { return &SubENIInfo{} }
+
+// VLANMACKey is the key for the cilium_hwc_vlan_mac BPF map.
+// It corresponds to struct hwc_vlan_mac_key in BPF C code.
+//
+// Ingress path: look up endpoint by (VLAN ID, destination MAC).
+type VLANMACKey struct {
+	// VlanID is the VLAN ID of the SubENI.
+	VlanID uint16 `align:"vlan_id"`
+	// MAC is the destination MAC address.
+	MAC [6]uint8 `align:"mac"`
+}
+
+// String returns a human-readable representation of the key.
+func (k *VLANMACKey) String() string {
+	return fmt.Sprintf("vlan_id=%d mac=%02x:%02x:%02x:%02x:%02x:%02x",
+		k.VlanID,
+		k.MAC[0], k.MAC[1], k.MAC[2], k.MAC[3], k.MAC[4], k.MAC[5],
+	)
+}
+
+// New returns a pointer to a new VLANMACKey, satisfying bpf.MapKey.
+func (k *VLANMACKey) New() bpf.MapKey { return &VLANMACKey{} }
+
+// EPInfo is the value for the cilium_hwc_vlan_mac BPF map.
+// It corresponds to struct hwc_ep_info in BPF C code.
+type EPInfo struct {
+	// IfIndex is the interface index of the endpoint's veth.
+	IfIndex uint32 `align:"ifindex"`
+	// LxcID is the endpoint (LXC) ID.
+	LxcID uint16 `align:"lxc_id"`
+	// Flags holds endpoint flags.
+	Flags uint16 `align:"flags"`
+}
+
+// String returns a human-readable representation of the value.
+func (v *EPInfo) String() string {
+	return fmt.Sprintf("ifindex=%d lxc_id=%d flags=0x%04x", v.IfIndex, v.LxcID, v.Flags)
+}
+
+// New returns a pointer to a new EPInfo, satisfying bpf.MapValue.
+func (v *EPInfo) New() bpf.MapValue { return &EPInfo{} }
