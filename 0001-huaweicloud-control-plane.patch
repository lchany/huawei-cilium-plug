+
+func update(instanceType string, l ipamTypes.Limits) {
+	limits.table[instanceType] = l
+}
+
+func Get(instanceType string) (ipamTypes.Limits, bool) {
+	limits.mutex.RLock()
+	defer limits.mutex.RUnlock()
+
+	l, ok := limits.table[instanceType]
+	return l, ok
+}
+
+func Update(instanceType string, l ipamTypes.Limits) {
+	limits.mutex.Lock()
+	defer limits.mutex.Unlock()
+
+	update(instanceType, l)
+}
