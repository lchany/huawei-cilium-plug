+				nodeResource.Spec.IPAM.PreAllocate = c.IPAM.PreAllocate
+			}
+		}
 	}
 
 	return nil
 }
 
+func applyHuaweiCloudNetConf(dst *huaweiCloudTypes.Spec, src huaweiCloudTypes.Spec) {
+	if dst == nil {
+		return
+	}
+	if len(src.Subnets) > 0 {
+		dst.Subnets = src.Subnets
+	}
+	if len(src.SubnetTags) > 0 {
+		dst.SubnetTags = src.SubnetTags
+	}
+	if len(src.SecurityGroups) > 0 {
+		dst.SecurityGroups = src.SecurityGroups
+	}
+	if len(src.SecurityGroupTags) > 0 {
+		dst.SecurityGroupTags = src.SecurityGroupTags
+	}
+}
