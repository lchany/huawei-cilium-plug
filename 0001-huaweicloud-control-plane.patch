index 0000000000..024f70d3a1
--- /dev/null
+++ b/pkg/huaweicloud/utils/utils.go
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package utils
+
+import (
+	"strconv"
+
+	"github.com/sirupsen/logrus"
+)
+
+const subENIIndexTagKey = "cilium-sub-eni-index"
+
+// GetSubENIIndexFromTags returns the Sub-ENI index from the given tags.
+// Returns the index and true if found, or 0 and false if not.
+func GetSubENIIndexFromTags(tags map[string]string) (int, bool) {
+	v, ok := tags[subENIIndexTagKey]
+	if !ok {
+		return 0, false
+	}
+	index, err := strconv.Atoi(v)
+	if err != nil {
+		logrus.WithError(err).Warning("Unable to retrieve index from Sub-ENI tags")
+		return 0, false
+	}
+	return index, true
+}
+
+// FillTagWithSubENIIndex sets the Sub-ENI index in the tags map and returns it.
+func FillTagWithSubENIIndex(tags map[string]string, index int) map[string]string {
+	if tags == nil {
+		tags = map[string]string{}
+	}
+	tags[subENIIndexTagKey] = strconv.Itoa(index)
+	return tags
+}
