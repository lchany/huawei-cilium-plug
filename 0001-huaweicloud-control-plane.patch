+			}
+		}
+		request.Marker = nextMarker(response.PageInfo)
+		if request.Marker == nil {
+			return result, nil
+		}
+	}
+}
+
+func (c *Client) WaitSubENIActive(ctx context.Context, subENIID string) (*eniTypes.SubENI, error) {
+	ticker := time.NewTicker(1 * time.Second)
+	defer ticker.Stop()
+	timeout := time.NewTimer(60 * time.Second)
+	defer timeout.Stop()
+
+	for {
+		subENI, err := c.GetSubNetworkInterface(ctx, subENIID)
+		if err != nil {
+			return nil, fmt.Errorf("wait sub-eni %s: %w", subENIID, err)
+		}
+		switch subENI.State {
+		case "ACTIVE":
+			return subENI, nil
+		case "ERROR":
+			return nil, fmt.Errorf("sub-eni %s entered ERROR state", subENIID)
+		}
+
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-timeout.C:
+			return nil, fmt.Errorf("timed out waiting for sub-eni %s to become ACTIVE", subENIID)
+		case <-ticker.C:
+		}
+	}
+}
+
+func parseSubENI(subENI *vpcmodel.SubNetworkInterface) *eniTypes.SubENI {
+	if subENI == nil {
+		return nil
+	}
+	return &eniTypes.SubENI{
+		ID:               subENI.Id,
+		PrivateIPAddress: subENI.PrivateIpAddress,
+		MACAddress:       subENI.MacAddress,
+		VlanID:           subENI.VlanId,
+		SubnetID:         subENI.VirsubnetId,
+		SecurityGroups:   append([]string(nil), subENI.SecurityGroups...),
+		State:            subENI.State,
+		ParentID:         subENI.ParentId,
+		VPCID:            subENI.VpcId,
+	}
+}
+
+func parseResourceTags(tags []vpcmodel.ResourceTag) map[string]string {
+	result := make(map[string]string, len(tags))
+	for _, tag := range tags {
+		result[tag.Key] = tag.Value
+	}
+	return result
+}
+
+func parseResponseTags(tags []vpcmodel.ResponseTag) ipamTypes.Tags {
+	result := make(ipamTypes.Tags, len(tags))
+	for _, tag := range tags {
+		result[tag.Key] = tag.Value
+	}
+	return result
+}
+
+func getParentPortsFromServer(server *ecsmodel.ServerDetail) []string {
+	if server == nil {
+		return nil
+	}
+
+	portSet := map[string]struct{}{}
+	if server.NetworkInterfaces != nil {
+		for _, networkInterface := range *server.NetworkInterfaces {
+			if networkInterface.PortId != nil && *networkInterface.PortId != "" {
+				portSet[*networkInterface.PortId] = struct{}{}
+			}
+		}
+	}
+
+	for _, addresses := range server.Addresses {
+		for _, address := range addresses {
+			if address.OSEXTIPSportId != nil && *address.OSEXTIPSportId != "" {
+				portSet[*address.OSEXTIPSportId] = struct{}{}
+			}
+		}
+	}
+
+	result := make([]string, 0, len(portSet))
+	for port := range portSet {
+		result = append(result, port)
+	}
+	return result
+}
diff --git a/pkg/huaweicloud/api/error.go b/pkg/huaweicloud/api/error.go
new file mode 100644
index 0000000000..b5c05fa804
--- /dev/null
+++ b/pkg/huaweicloud/api/error.go
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package api
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/huaweicloud/huaweicloud-sdk-go-v3/core/sdkerr"
+)
+
+// Sentinel errors returned by the HuaweiCloud API client.
+// Callers should use errors.Is() to check for specific conditions.
+var (
+	// ErrSubnetInsufficientIP is returned when a subnet has no more available IP addresses.
+	// HuaweiCloud VPC API error codes: VPC.0703, VPC.0532 (HTTP 409)
+	ErrSubnetInsufficientIP = errors.New("subnet insufficient ip")
+
+	// ErrUnauthorized is returned on authentication/authorization failures (HTTP 401/403).
+	ErrUnauthorized = errors.New("unauthorized")
+
+	// ErrInvalidArgument is returned when request parameters are invalid (HTTP 400).
+	ErrInvalidArgument = errors.New("invalid argument")
+
+	// ErrRateLimited is returned when the API rate limit is exceeded (HTTP 429).
+	ErrRateLimited = errors.New("rate limited")
+
+	// ErrNotFound is returned when the requested resource does not exist (HTTP 404).
+	ErrNotFound = errors.New("not found")
+)
+
+// normalizeAPIError converts a HuaweiCloud SDK ServiceResponseError into one of the
+// sentinel errors above so callers can use errors.Is() for semantic error handling.
+// Non-SDK errors are returned unchanged.
+func normalizeAPIError(err error) error {
+	if err == nil {
+		return nil
+	}
+
+	var sdkErr *sdkerr.ServiceResponseError
+	if !errors.As(err, &sdkErr) {
+		return err
+	}
+
+	switch {
+	case sdkErr.StatusCode == 401 || sdkErr.StatusCode == 403:
+		return fmt.Errorf("%w: %s (request_id: %s)", ErrUnauthorized, sdkErr.ErrorMessage, sdkErr.RequestId)
+	case sdkErr.StatusCode == 404:
+		return fmt.Errorf("%w: %s (request_id: %s)", ErrNotFound, sdkErr.ErrorMessage, sdkErr.RequestId)
+	case sdkErr.StatusCode == 429:
+		return fmt.Errorf("%w: %s (request_id: %s)", ErrRateLimited, sdkErr.ErrorMessage, sdkErr.RequestId)
+	case isSubnetInsufficientIP(sdkErr.ErrorCode):
+		// HTTP 409 + VPC.0703/VPC.0532 = subnet IP exhaustion
+		return fmt.Errorf("%w: %s (request_id: %s)", ErrSubnetInsufficientIP, sdkErr.ErrorMessage, sdkErr.RequestId)
+	case sdkErr.StatusCode == 400:
+		return fmt.Errorf("%w: [%s] %s (request_id: %s)", ErrInvalidArgument, sdkErr.ErrorCode, sdkErr.ErrorMessage, sdkErr.RequestId)
+	default:
+		return fmt.Errorf("huaweicloud api error [%s] %s (status: %d, request_id: %s): %w",
+			sdkErr.ErrorCode, sdkErr.ErrorMessage, sdkErr.StatusCode, sdkErr.RequestId, err)
+	}
+}
+
+// isSubnetInsufficientIP reports whether the HuaweiCloud VPC error code indicates
+// that a subnet has no more available IP addresses.
+// VPC.0703: "No more IP addresses available on network xxx." (private IP allocation)
+// VPC.0532: "No more IP addresses available on network." (port-level IP exhaustion)
+// Both return HTTP 409 Conflict.
+func isSubnetInsufficientIP(code string) bool {
+	return code == "VPC.0703" || code == "VPC.0532"
+}
