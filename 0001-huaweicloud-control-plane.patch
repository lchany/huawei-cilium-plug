+func validateCreateSubENIRequest(req CreateSubENIRequest) error {
+	if strings.TrimSpace(req.SubnetID) == "" {
+		return fmt.Errorf("subnet ID is required")
+	}
+	if strings.TrimSpace(req.TrunkInterfaceID) == "" {
+		return fmt.Errorf("parent trunk interface ID is required")
+	}
+	if len(req.SecurityGroupIDs) > 100 {
+		return fmt.Errorf("security group count %d exceeds cloud limit 100", len(req.SecurityGroupIDs))
+	}
+	seenSecurityGroups := map[string]struct{}{}
+	for _, securityGroupID := range req.SecurityGroupIDs {
+		if strings.TrimSpace(securityGroupID) == "" {
+			return fmt.Errorf("security group ID must not be empty")
+		}
+		if _, exists := seenSecurityGroups[securityGroupID]; exists {
+			return fmt.Errorf("duplicate security group ID %q", securityGroupID)
+		}
+		seenSecurityGroups[securityGroupID] = struct{}{}
+	}
+	if err := validateResourceTags(req.Tags); err != nil {
+		return err
+	}
+	return nil
+}
+
+func validateResourceTags(tags map[string]string) error {
+	if len(tags) > 20 {
+		return fmt.Errorf("tag count %d exceeds cloud limit 20", len(tags))
+	}
+	for key, value := range tags {
+		if strings.TrimSpace(key) == "" {
+			return fmt.Errorf("tag key must not be empty")
+		}
+		if utf8.RuneCountInString(key) > 128 {
+			return fmt.Errorf("tag key %q exceeds cloud limit 128 characters", key)
+		}
+		if utf8.RuneCountInString(value) > 255 {
+			return fmt.Errorf("tag value for key %q exceeds cloud limit 255 characters", key)
+		}
+	}
+	return nil
+}
+
+func validateCreatedSubENIs(subENIs []*eniTypes.SubENI, expected int) error {
+	if len(subENIs) != expected {
+		return fmt.Errorf("create response returned %d sub-ENIs, expected %d", len(subENIs), expected)
+	}
+	seen := make(map[string]struct{}, len(subENIs))
+	for i, subENI := range subENIs {
+		if subENI == nil {
+			return fmt.Errorf("create response contains nil sub-ENI at index %d", i)
+		}
+		if strings.TrimSpace(subENI.ID) == "" {
+			return fmt.Errorf("create response contains empty sub-ENI ID at index %d", i)
+		}
+		if err := validateSubENI(subENI); err != nil {
+			return fmt.Errorf("invalid created sub-ENI at index %d: %w", i, err)
+		}
+		if _, exists := seen[subENI.ID]; exists {
+			return fmt.Errorf("create response contains duplicate sub-ENI ID %q", subENI.ID)
+		}
+		seen[subENI.ID] = struct{}{}
+	}
+	return nil
+}
+
+func validateSubENI(subENI *eniTypes.SubENI) error {
+	if subENI == nil {
+		return fmt.Errorf("sub-ENI is nil")
+	}
+	if strings.TrimSpace(subENI.ID) == "" {
+		return fmt.Errorf("sub-ENI ID is empty")
+	}
+	privateIP, err := netip.ParseAddr(subENI.PrivateIPAddress)
+	if err != nil || !privateIP.Is4() {
+		return fmt.Errorf("sub-ENI %s has invalid private IPv4 address %q", subENI.ID, subENI.PrivateIPAddress)
+	}
+	mac, err := net.ParseMAC(subENI.MACAddress)
+	if err != nil || len(mac) != 6 || bytes.Equal(mac, []byte{0, 0, 0, 0, 0, 0}) || mac[0]&1 != 0 {
+		return fmt.Errorf("sub-ENI %s has invalid MAC address %q", subENI.ID, subENI.MACAddress)
+	}
+	if subENI.VlanID < 1 || subENI.VlanID > 4094 {
+		return fmt.Errorf("sub-ENI %s has invalid VLAN ID %d", subENI.ID, subENI.VlanID)
+	}
+	if strings.TrimSpace(subENI.SubnetID) == "" {
+		return fmt.Errorf("sub-ENI %s has empty subnet ID", subENI.ID)
+	}
+	if strings.TrimSpace(subENI.ParentID) == "" {
+		return fmt.Errorf("sub-ENI %s has empty parent ID", subENI.ID)
+	}
+	return nil
+}
+
+func (c *Client) finalizeCreatedSubENIs(ctx context.Context, subENIs []*eniTypes.SubENI) error {
+	for _, subENI := range subENIs {
+		if err := c.fillSubENIGatewayInfo(ctx, subENI, nil); err != nil {
+			return c.rollbackCreatedSubENIs(subENIs, err)
+		}
+	}
+	return nil
+}
+
+func (c *Client) rollbackCreatedSubENIs(subENIs []*eniTypes.SubENI, cause error) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	var rollbackErrors []string
+	seen := map[string]struct{}{}
+	for _, subENI := range subENIs {
+		if subENI == nil || subENI.ID == "" {
+			continue
+		}
+		if _, exists := seen[subENI.ID]; exists {
+			continue
+		}
+		seen[subENI.ID] = struct{}{}
+		if err := c.DeleteSubNetworkInterface(ctx, subENI.ID); err != nil {
+			rollbackErrors = append(rollbackErrors, fmt.Sprintf("rollback sub-eni %s: %v", subENI.ID, err))
+		}
+	}
+	if len(rollbackErrors) != 0 {
+		return fmt.Errorf("%w; %s", cause, strings.Join(rollbackErrors, "; "))
+	}
+	return cause
+}
