+func GetIamEndpoint() string {
+	if endpoint := os.Getenv(IamEndpointEnv); endpoint != "" {
+		https := "https://"
+		if !strings.HasPrefix(endpoint, https) {
+			endpoint = https + endpoint
+		}
+		return endpoint
+	}
+	return DefaultIamEndpoint
+}
