+			}
+		} else {
+			if subENI == nil {
+				return nil, fmt.Errorf("wait sub-eni %s: get returned nil without error", subENIID)
+			}
+			ready, err := classifySubENIState(subENI.State)
+			if err != nil {
+				return nil, fmt.Errorf("wait sub-eni %s: %w", subENIID, err)
+			}
+			if ready {
+				return subENI, nil
+			}
 		}
 
 		select {
 		case <-ctx.Done():
 			return nil, ctx.Err()
 		case <-timeout.C:
+			// Perform one final observation at the deadline. Without this probe an
+			// interface which becomes ACTIVE exactly at 60 seconds can lose a
+			// scheduler race between the polling ticker and timeout timer.
+			subENI, err := get(ctx, subENIID)
+			if err == nil && subENI != nil {
+				ready, stateErr := classifySubENIState(subENI.State)
+				if stateErr != nil {
+					return nil, fmt.Errorf("wait sub-eni %s: %w", subENIID, stateErr)
+				}
+				if ready {
+					return subENI, nil
+				}
+			} else if err != nil && !errors.Is(err, ErrNotFound) {
+				return nil, fmt.Errorf("wait sub-eni %s: %w", subENIID, err)
+			} else if err == nil && subENI == nil {
+				return nil, fmt.Errorf("wait sub-eni %s: get returned nil without error", subENIID)
+			}
 			return nil, fmt.Errorf("timed out waiting for sub-eni %s to become ACTIVE", subENIID)
 		case <-ticker.C:
 		}
 	}
 }
 
+func classifySubENIState(state string) (bool, error) {
+	switch strings.ToUpper(strings.TrimSpace(state)) {
+	case "ACTIVE":
+		return true, nil
+	case "BUILD", "DOWN":
+		return false, nil
+	case "ERROR":
+		return false, fmt.Errorf("sub-ENI entered ERROR state")
+	default:
+		return false, fmt.Errorf("sub-ENI returned unknown state %q", state)
+	}
+}
