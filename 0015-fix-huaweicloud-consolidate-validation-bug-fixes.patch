+)
+
+type fakeSubENIMapUpdater struct {
+	deleted []subenimap.EndpointInfo
+	ready   []subenimap.EndpointInfo
+	err     error
+}
+
+func (f *fakeSubENIMapUpdater) Reconcile([]subenimap.EndpointInfo) error { return nil }
+func (f *fakeSubENIMapUpdater) OnEndpointReady(info subenimap.EndpointInfo) error {
+	f.ready = append(f.ready, info)
+	return nil
+}
+func (f *fakeSubENIMapUpdater) OnEndpointDelete(info subenimap.EndpointInfo) error {
+	f.deleted = append(f.deleted, info)
+	return f.err
+}
+func (f *fakeSubENIMapUpdater) Close() {}
+
+type testSubENIEndpoint struct {
+	ip      string
+	id      uint64
+	ifindex int
+}
+
+func TestEnsureGatewayNeighborRejectsNonexistentTrunk(t *testing.T) {
+	subscriber := &huaweiCloudSubENISubscriber{}
+	info := &huaweiCloudEndpointInfo{
+		gatewayIP:      net.ParseIP("10.0.0.1").To4(),
+		gatewayMAC:     net.HardwareAddr{0xfa, 0x16, 0x3e, 0, 0, 1},
+		trunkInterface: "cilium-test-nonexistent-trunk",
+	}
+	if err := subscriber.ensureGatewayNeighbor(info); err == nil || !strings.Contains(err.Error(), "resolve trunk interface") {
+		t.Fatalf("nonexistent trunk did not fail closed: %v", err)
+	}
+}
+
+func TestGatewayNeighborFailureBlocksBPFMapUpdate(t *testing.T) {
+	mapMgr := &fakeSubENIMapUpdater{}
+	subscriber := &huaweiCloudSubENISubscriber{
+		logger: logging.DefaultLogger.WithField("test", t.Name()),
+		mapMgr: mapMgr,
+		cache:  map[string]subenimap.EndpointInfo{},
+	}
+	info := &huaweiCloudEndpointInfo{
+		ipv4:           "10.0.0.2",
+		id:             1,
+		gatewayIP:      net.ParseIP("10.0.0.1").To4(),
+		gatewayMAC:     net.HardwareAddr{0xfa, 0x16, 0x3e, 0, 0, 1},
+		trunkInterface: "cilium-test-nonexistent-trunk",
+	}
+	subscriber.upsertEndpointInfo(info, 1, info.ipv4, "test")
+	if len(mapMgr.ready) != 0 {
+		t.Fatalf("BPF map was updated after gateway neighbor failure: %d calls", len(mapMgr.ready))
+	}
+	if len(subscriber.cache) != 0 {
+		t.Fatalf("endpoint was cached after gateway neighbor failure: %#v", subscriber.cache)
+	}
+}
+
+func (e testSubENIEndpoint) GetIPv4Address() string { return e.ip }
+func (e testSubENIEndpoint) GetID() uint64          { return e.id }
+func (e testSubENIEndpoint) GetIfIndex() int        { return e.ifindex }
+
+func testCiliumNode(subENIs map[string]eniTypes.SubENI) *ciliumv2.CiliumNode {
+	return &ciliumv2.CiliumNode{Status: ciliumv2.NodeStatus{HuaweiCloud: &eniTypes.ENIStatus{SubENIs: subENIs}}}
+}
+
+func validSubENI() eniTypes.SubENI {
+	return eniTypes.SubENI{
+		ID: "eni-1", PrivateIPAddress: "10.0.0.2", MACAddress: "fa:16:3e:00:00:01",
+		VlanID: 100, GatewayIP: "10.0.0.1", GatewayMAC: "fa:16:3e:00:00:fe", TrunkInterface: "eth0",
+	}
+}
+
+func TestSubENIInfoRequiresExactlyOneIPMatch(t *testing.T) {
+	ep := testSubENIEndpoint{ip: "10.0.0.2", id: 1, ifindex: 2}
+	info, err := subENIInfoForEndpoint(testCiliumNode(nil), ep)
