index 000000000..6f063d197
--- /dev/null
+++ b/pkg/endpointmanager/huaweicloud_subeni_privileged_test.go
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+//go:build privileged_tests
+
+package endpointmanager
+
+import (
+	"bytes"
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/vishvananda/netlink"
+)
+
+func testHuaweiCloudDummyLink(t *testing.T, name string) netlink.Link {
+	t.Helper()
+	attrs := netlink.NewLinkAttrs()
+	attrs.Name = name
+	link := &netlink.Dummy{LinkAttrs: attrs}
+	if err := netlink.LinkAdd(link); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = netlink.LinkDel(link) })
+	if err := netlink.LinkSetUp(link); err != nil {
+		t.Fatal(err)
+	}
+	return link
+}
+
+func testHuaweiCloudNeighbor(t *testing.T, link netlink.Link, ip net.IP) *netlink.Neigh {
+	t.Helper()
+	neighbors, err := netlink.NeighList(link.Attrs().Index, netlink.FAMILY_V4)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := range neighbors {
+		if neighbors[i].IP.Equal(ip) {
+			return &neighbors[i]
+		}
+	}
+	t.Fatalf("neighbor %s not found on %s", ip, link.Attrs().Name)
+	return nil
+}
+
+func TestEnsureGatewayNeighborRejectsPermanentMACConflict(t *testing.T) {
+	link := testHuaweiCloudDummyLink(t, "hwc-bmap15")
+	gateway := net.ParseIP("10.42.15.1").To4()
+	originalMAC, _ := net.ParseMAC("02:00:00:00:15:01")
+	conflictingMAC, _ := net.ParseMAC("02:00:00:00:15:02")
+	if err := netlink.NeighSet(&netlink.Neigh{
+		LinkIndex: link.Attrs().Index, Family: netlink.FAMILY_V4,
+		State: netlink.NUD_PERMANENT, IP: gateway, HardwareAddr: originalMAC,
+	}); err != nil {
+		t.Fatal(err)
+	}
+
+	subscriber := &huaweiCloudSubENISubscriber{}
+	err := subscriber.ensureGatewayNeighbor(&huaweiCloudEndpointInfo{
+		gatewayIP: gateway, gatewayMAC: conflictingMAC, trunkInterface: link.Attrs().Name,
+	})
+	if err == nil || !strings.Contains(err.Error(), "conflicts") {
+		t.Fatalf("permanent MAC conflict was not rejected: %v", err)
+	}
+	if got := testHuaweiCloudNeighbor(t, link, gateway); !bytes.Equal(got.HardwareAddr, originalMAC) {
+		t.Fatalf("conflicting neighbor was modified: got %s want %s", got.HardwareAddr, originalMAC)
+	}
+}
+
+func TestEnsureGatewayNeighborScopesSameGatewayByLink(t *testing.T) {
+	firstLink := testHuaweiCloudDummyLink(t, "hwc-bmap16a")
+	secondLink := testHuaweiCloudDummyLink(t, "hwc-bmap16b")
+	gateway := net.ParseIP("10.42.16.1").To4()
+	firstMAC, _ := net.ParseMAC("02:00:00:00:16:01")
+	secondMAC, _ := net.ParseMAC("02:00:00:00:16:02")
+	subscriber := &huaweiCloudSubENISubscriber{}
+
+	first := &huaweiCloudEndpointInfo{
+		gatewayIP: gateway, gatewayMAC: firstMAC, trunkInterface: firstLink.Attrs().Name,
+	}
+	if err := subscriber.ensureGatewayNeighbor(first); err != nil {
+		t.Fatal(err)
+	}
+	if err := subscriber.ensureGatewayNeighbor(&huaweiCloudEndpointInfo{
+		gatewayIP: gateway, gatewayMAC: secondMAC, trunkInterface: firstLink.Attrs().Name,
+	}); err == nil || !strings.Contains(err.Error(), "conflicts") {
+		t.Fatalf("same-link gateway conflict was not rejected: %v", err)
+	}
+	if got := testHuaweiCloudNeighbor(t, firstLink, gateway); !bytes.Equal(got.HardwareAddr, firstMAC) {
+		t.Fatalf("first link neighbor changed: got %s want %s", got.HardwareAddr, firstMAC)
+	}
+
+	if err := subscriber.ensureGatewayNeighbor(&huaweiCloudEndpointInfo{
+		gatewayIP: gateway, gatewayMAC: secondMAC, trunkInterface: secondLink.Attrs().Name,
+	}); err != nil {
+		t.Fatalf("same gateway on a different trunk was rejected: %v", err)
+	}
+	if got := testHuaweiCloudNeighbor(t, secondLink, gateway); !bytes.Equal(got.HardwareAddr, secondMAC) {
+		t.Fatalf("second link neighbor MAC: got %s want %s", got.HardwareAddr, secondMAC)
+	}
+}
