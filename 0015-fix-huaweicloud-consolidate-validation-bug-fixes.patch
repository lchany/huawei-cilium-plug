+	now := time.Now()
+	if !r.OK() {
+		return context.DeadlineExceeded
+	}
+	delay := r.DelayFrom(now)
+	if delay == rate.InfDuration {
+		r.CancelAt(now)
+		return context.DeadlineExceeded
+	}
+	if delay == 0 {
+		return nil
+	}
+	l.metrics.ObserveRateLimit(operation, delay)
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		r.CancelAt(time.Now())
+		return ctx.Err()
+	case <-timer.C:
+		return nil
 	}
 }
