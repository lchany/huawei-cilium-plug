@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package cmd
+
+import (
+	"testing"
+
+	"github.com/cilium/cilium/pkg/option"
+)
+
+func TestShouldDisableProbeFeaturesForExplicitNodePort(t *testing.T) {
+	tests := []struct {
+		name            string
+		mode            string
+		nodePortIsSet   bool
+		nodePortEnabled bool
+		want            bool
+	}{
+		{name: "probe explicit false", mode: option.KubeProxyReplacementProbe, nodePortIsSet: true, want: true},
+		{name: "probe explicit true", mode: option.KubeProxyReplacementProbe, nodePortIsSet: true, nodePortEnabled: true},
+		{name: "probe unset", mode: option.KubeProxyReplacementProbe},
+		{name: "strict explicit false", mode: option.KubeProxyReplacementStrict, nodePortIsSet: true},
+		{name: "disabled explicit false", mode: option.KubeProxyReplacementDisabled, nodePortIsSet: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := shouldDisableProbeFeaturesForExplicitNodePort(tt.mode, tt.nodePortIsSet, tt.nodePortEnabled)
+			if got != tt.want {
+				t.Fatalf("shouldDisableProbeFeaturesForExplicitNodePort() = %t, want %t", got, tt.want)
+			}
+		})
+	}
+}
