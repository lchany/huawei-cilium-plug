+func TestCreateInterfaceFollowsSubnetAndSecurityGroupConfigTransition(t *testing.T) {
+	base := mock.NewAPI([]*ipamTypes.Subnet{
+		{ID: "subnet-old", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 10, Tags: ipamTypes.Tags{"role": "old"}},
+		{ID: "subnet-new", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 10, Tags: ipamTypes.Tags{"role": "new"}},
+	}, []*ipamTypes.VirtualNetwork{{ID: "vpc-1"}}, nil)
+	base.SetInstanceLimit("instance-1", ipamTypes.Limits{IPv4: 2})
+	api := &recordingBatchAPI{API: base}
+	manager := NewInstancesManager(api, "vpc-1", nil)
+	if manager.Resync(context.Background()).IsZero() {
+		t.Fatal("initial manager resync failed")
+	}
+	oldObj := &v2.CiliumNode{Spec: v2.NodeSpec{InstanceID: "instance-1", HuaweiCloud: &eniTypes.Spec{
+		InstanceType:     "flavor-1",
+		VPCID:            "vpc-1",
+		AvailabilityZone: "az-1",
+		TrunkInterfaceID: "trunk-1",
+		SecurityGroups:   []string{"sg-a"},
+		Subnets:          []string{"subnet-old"},
+	}}}
+	node := &Node{node: testNodeID("instance-1"), manager: manager, k8sObj: oldObj, instanceID: "instance-1", subENIs: map[string]eniTypes.SubENI{}}
+	if count, _, err := node.CreateInterface(context.Background(), &ipam.AllocationAction{AvailableInterfaces: 1, MaxIPsToAllocate: 1}, log); err != nil || count != 1 {
+		t.Fatalf("old configuration create failed: count=%d err=%v", count, err)
+	}
+
+	newObj := oldObj.DeepCopy()
+	newObj.Spec.HuaweiCloud.Subnets = nil
+	newObj.Spec.HuaweiCloud.SubnetTags = map[string]string{"role": "new"}
+	newObj.Spec.HuaweiCloud.SecurityGroups = []string{"sg-b"}
+	node.UpdatedNode(newObj)
+	if count, _, err := node.CreateInterface(context.Background(), &ipam.AllocationAction{AvailableInterfaces: 1, MaxIPsToAllocate: 1}, log); err != nil || count != 1 {
+		t.Fatalf("new configuration create failed: count=%d err=%v", count, err)
+	}
+
+	api.mutex.Lock()
+	requests := append([]hwAPI.CreateSubENIRequest(nil), api.requests...)
+	api.mutex.Unlock()
+	if len(requests) != 2 {
+		t.Fatalf("request count=%d, want 2", len(requests))
+	}
+	if requests[0].SubnetID != "subnet-old" || !reflect.DeepEqual(requests[0].SecurityGroupIDs, []string{"sg-a"}) {
+		t.Fatalf("old request mismatch: %#v", requests[0])
+	}
+	if requests[1].SubnetID != "subnet-new" || !reflect.DeepEqual(requests[1].SecurityGroupIDs, []string{"sg-b"}) {
+		t.Fatalf("new request retained stale configuration: %#v", requests[1])
+	}
+}
