+		if existing.Dst != nil {
+			ones, bits := existing.Dst.Mask.Size()
+			isGatewayHostRoute = existing.Dst.IP.Equal(gateway) && bits == 32 && ones == 32 && existing.LinkIndex == ifindex
+		}
+		if isGatewayHostRoute {
