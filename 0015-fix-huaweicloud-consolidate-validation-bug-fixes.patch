+func TestCreateInterfaceUsesOneNodeRevisionDuringConcurrentUpdate(t *testing.T) {
+	base := mock.NewAPI(nil, nil, nil)
+	base.SetInstanceLimit("instance-old", ipamTypes.Limits{IPv4: 8})
+	base.SetInstanceLimit("instance-new", ipamTypes.Limits{IPv4: 2})
+	api := &blockingBatchAPI{API: base, started: make(chan hwAPI.CreateSubENIRequest, 1), proceed: make(chan struct{})}
+	manager := NewInstancesManager(api, "vpc-1", nil)
+	oldObj := &v2.CiliumNode{Spec: v2.NodeSpec{InstanceID: "instance-old", HuaweiCloud: &eniTypes.Spec{
+		InstanceType:     "flavor-old",
+		VPCID:            "vpc-1",
+		AvailabilityZone: "az-1",
+		TrunkInterfaceID: "trunk-old",
+		SecurityGroups:   []string{"sg-old"},
+		Subnets:          []string{"subnet-old"},
+	}}}
+	node := &Node{node: testNodeID("instance-old"), manager: manager, k8sObj: oldObj, instanceID: "instance-old", subENIs: map[string]eniTypes.SubENI{}}
+
+	result := make(chan error, 1)
+	go func() {
+		count, _, err := node.CreateInterface(context.Background(), &ipam.AllocationAction{AvailableInterfaces: 1, MaxIPsToAllocate: 1}, log)
+		if err == nil && count != 1 {
+			err = fmt.Errorf("created count %d, want 1", count)
+		}
+		result <- err
+	}()
+	req := <-api.started
+	newObj := oldObj.DeepCopy()
+	newObj.Spec.InstanceID = "instance-new"
+	newObj.Spec.HuaweiCloud.InstanceType = "flavor-new"
+	newObj.Spec.HuaweiCloud.TrunkInterfaceID = "trunk-new"
+	newObj.Spec.HuaweiCloud.SecurityGroups = []string{"sg-new"}
+	newObj.Spec.HuaweiCloud.Subnets = []string{"subnet-new"}
+	node.UpdatedNode(newObj)
+	close(api.proceed)
+	if err := <-result; err != nil {
+		t.Fatal(err)
+	}
+	if req.TrunkInterfaceID != "trunk-old" || req.SubnetID != "subnet-old" || !reflect.DeepEqual(req.SecurityGroupIDs, []string{"sg-old"}) {
+		t.Fatalf("create request mixed node revisions: %#v", req)
+	}
+	seenOld, seenNew := false, false
+	manager.ForeachInstance("instance-old", func(_, interfaceID string, _ ipamTypes.InterfaceRevision) error {
+		seenOld = seenOld || interfaceID == "eni-created"
+		return nil
+	})
+	manager.ForeachInstance("instance-new", func(_, interfaceID string, _ ipamTypes.InterfaceRevision) error {
+		seenNew = seenNew || interfaceID == "eni-created"
+		return nil
+	})
+	if !seenOld || seenNew {
+		t.Fatalf("created SubENI attributed to wrong revision: old=%v new=%v", seenOld, seenNew)
+	}
+}
