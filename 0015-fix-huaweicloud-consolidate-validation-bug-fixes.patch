+		manager.UpdateSubENI("instance-1", &eniTypes.SubENI{ID: "eni-new"})
+		close(updateDone)
+	}()
+	select {
+	case <-updateDone:
+		manager.resyncLock.Unlock()
+		t.Fatal("SubENI update bypassed an in-progress full resync")
+	case <-time.After(20 * time.Millisecond):
+	}
+	manager.resyncLock.Unlock()
+	wg.Wait()
+
+	manager.resyncLock.Lock()
+	deleteDone := make(chan struct{})
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		manager.DeleteSubENI("instance-1", "eni-old")
+		close(deleteDone)
+	}()
+	select {
+	case <-deleteDone:
+		manager.resyncLock.Unlock()
+		t.Fatal("SubENI delete bypassed an in-progress full resync")
+	case <-time.After(20 * time.Millisecond):
+	}
+	manager.resyncLock.Unlock()
+	wg.Wait()
+
+	seen := map[string]bool{}
+	manager.ForeachInstance("instance-1", func(_, interfaceID string, _ ipamTypes.InterfaceRevision) error {
+		seen[interfaceID] = true
+		return nil
+	})
+	if !seen["eni-new"] || seen["eni-old"] {
+		t.Fatalf("unexpected post-resync mutation state: %#v", seen)
+	}
+}
