diff --git a/bpf/lib/huaweicloud.h b/bpf/lib/huaweicloud.h
index 187df88e7..b060344de 100644
--- a/bpf/lib/huaweicloud.h
+++ b/bpf/lib/huaweicloud.h
@@ -67,6 +67,48 @@ struct {
 	__uint(pinning, LIBBPF_PIN_BY_NAME);
 } cilium_hwc_vlan_mac __section_maps_btf;
 
+static __always_inline __u16 hwc_vlan_id(__u16 tci)
+{
+	return tci & 0x0fff;
+}
+
+static __always_inline bool hwc_ethernet_header_complete(__u32 packet_len)
+{
+	return packet_len >= sizeof(struct ethhdr);
+}
+
+static __always_inline bool hwc_vlan_header_complete(__u32 packet_len)
+{
+	return packet_len >= sizeof(struct ethhdr) + sizeof(struct hwc_vlan_hdr);
+}
+
+static __always_inline bool hwc_vlan_id_valid(__u16 vlan_id)
+{
+	return vlan_id >= 1 && vlan_id <= 4094;
+}
+
+static __always_inline bool
+hwc_vlan_representations_match(__u16 inline_tci, __u16 metadata_tci)
+{
+	return hwc_vlan_id(inline_tci) == hwc_vlan_id(metadata_tci);
+}
+
+static __always_inline int
+hwc_vlan_pop_count(bool inline_vlan, bool metadata_vlan)
+{
+	return inline_vlan && metadata_vlan ? 2 : 1;
+}
+
+static __always_inline int hwc_vlan_map_miss_action(bool inline_vlan)
+{
+	/* An inline VLAN has already bypassed the kernel's metadata VLAN path.
+	 * It must not continue as apparently untagged traffic after an HWC map
+	 * miss. A metadata-only miss is intentionally left for the generic VLAN
+	 * allow/drop logic in bpf_host.c.
+	 */
+	return inline_vlan ? DROP_INVALID : CTX_ACT_OK;
+}
+
 static __always_inline int
 hwc_to_netdev(struct __ctx_buff *ctx, __be16 proto)
 {
@@ -105,6 +147,8 @@ hwc_from_netdev(struct __ctx_buff *ctx, bool *handled)
 	void *data, *data_end;
 	struct ethhdr *eth;
 	__u16 vlan_id;
+	__u16 inline_tci = 0;
+	__be16 inner_proto;
 	bool inline_vlan = false;
 	bool metadata_vlan;
 
@@ -115,6 +159,8 @@ hwc_from_netdev(struct __ctx_buff *ctx, bool *handled)
 	data = (void *)(long)ctx->data;
 	data_end = (void *)(long)ctx->data_end;
 	eth = data;
+	if (!hwc_ethernet_header_complete((__u32)((long)data_end - (long)data)))
+		return DROP_INVALID;
 	if ((void *)(eth + 1) > data_end)
 		return DROP_INVALID;
 
@@ -126,15 +172,28 @@ hwc_from_netdev(struct __ctx_buff *ctx, bool *handled)
 	    eth->h_proto == bpf_htons(ETH_P_8021AD)) {
 		struct hwc_vlan_hdr *vlan = (void *)(eth + 1);
 
+		if (!hwc_vlan_header_complete((__u32)((long)data_end - (long)data)))
+			return DROP_INVALID;
 		if ((void *)(vlan + 1) > data_end)
 			return DROP_INVALID;
-		vlan_id = bpf_ntohs(vlan->tci) & 0x0fff;
+		inline_tci = bpf_ntohs(vlan->tci);
+		vlan_id = hwc_vlan_id(inline_tci);
+		inner_proto = vlan->encapsulated_proto;
 		inline_vlan = true;
 	} else if (ctx->vlan_present) {
-		vlan_id = ctx->vlan_tci & 0x0fff;
+		vlan_id = hwc_vlan_id((__u16)ctx->vlan_tci);
+		inner_proto = eth->h_proto;
 	} else {
 		return CTX_ACT_OK;
 	}
+	metadata_vlan = ctx->vlan_present;
+	if (!hwc_vlan_id_valid(vlan_id))
+		return DROP_INVALID;
+	if (inline_vlan && metadata_vlan &&
+	    !hwc_vlan_representations_match(inline_tci, (__u16)ctx->vlan_tci))
+		return DROP_INVALID;
+	if (inner_proto != bpf_htons(ETH_P_IP))
+		return inline_vlan ? DROP_INVALID : CTX_ACT_OK;
 
 	key.vlan_id = vlan_id;
 	key.mac[0] = eth->h_dest[0];
@@ -146,11 +205,11 @@ hwc_from_netdev(struct __ctx_buff *ctx, bool *handled)
 
 	ep = map_lookup_elem(&cilium_hwc_vlan_mac, &key);
 	if (!ep)
-		return CTX_ACT_OK;
+		return hwc_vlan_map_miss_action(inline_vlan);
 	*handled = true;
 
-	metadata_vlan = ctx->vlan_present;
-	if (inline_vlan && metadata_vlan && skb_vlan_pop(ctx) < 0)
+	if (hwc_vlan_pop_count(inline_vlan, metadata_vlan) == 2 &&
+	    skb_vlan_pop(ctx) < 0)
 		return DROP_HWC_VLAN_POP_FAIL;
 
 	if (skb_vlan_pop(ctx) < 0)
diff --git a/bpf/tests/huaweicloud_test.c b/bpf/tests/huaweicloud_test.c
new file mode 100644
index 000000000..4b7a2bbb5
--- /dev/null
+++ b/bpf/tests/huaweicloud_test.c
@@ -0,0 +1,322 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/* Copyright Authors of Cilium */
+
+#include "common.h"
+
+#include "bpf/ctx/skb.h"
+#include "node_config.h"
+
+#define ENABLE_HUAWEICLOUD_VLAN
+#define HWC_TRUNK_IFINDEX ctx->ifindex
+#include "lib/huaweicloud.h"
+
+static long (*test_skb_change_tail)(struct __ctx_buff *ctx, __u32 len,
+				    __u64 flags) = (void *)BPF_FUNC_skb_change_tail;
+
+CHECK("tc", "huaweicloud_vlan_scalars")
+int test_huaweicloud_vlan_scalars(__maybe_unused struct __ctx_buff *ctx)
+{
+	test_init();
+
+	TEST("pcp_dei_do_not_pollute_vlan_id", {
+		assert(hwc_vlan_id(0xb123) == 0x123);
+	});
+	TEST("vlan_id_boundaries", {
+		assert(!hwc_vlan_id_valid(0));
+		assert(hwc_vlan_id_valid(1));
+		assert(hwc_vlan_id_valid(4094));
+		assert(!hwc_vlan_id_valid(4095));
+	});
+	TEST("truncated_headers_are_rejected", {
+		assert(!hwc_ethernet_header_complete(sizeof(struct ethhdr) - 1));
+		assert(hwc_ethernet_header_complete(sizeof(struct ethhdr)));
+		assert(!hwc_vlan_header_complete(sizeof(struct ethhdr) + sizeof(struct hwc_vlan_hdr) - 1));
+		assert(hwc_vlan_header_complete(sizeof(struct ethhdr) + sizeof(struct hwc_vlan_hdr)));
+	});
+	TEST("inline_and_metadata_must_match", {
+		assert(hwc_vlan_representations_match(0xa123, 0x2123));
+		assert(!hwc_vlan_representations_match(0x0123, 0x0124));
+	});
+	TEST("pop_count_matches_representations", {
+		assert(hwc_vlan_pop_count(true, true) == 2);
+		assert(hwc_vlan_pop_count(true, false) == 1);
+		assert(hwc_vlan_pop_count(false, true) == 1);
+	});
+	TEST("inline_map_miss_is_fail_closed", {
+		assert(hwc_vlan_map_miss_action(true) == DROP_INVALID);
+		assert(hwc_vlan_map_miss_action(false) == CTX_ACT_OK);
+	});
+
+	test_finish();
+}
+
+CHECK("tc", "huaweicloud_unknown_inline_vlan")
+int test_huaweicloud_unknown_inline_vlan(struct __ctx_buff *ctx)
+{
+	void *data;
+	void *data_end;
+	struct ethhdr *eth;
+	struct hwc_vlan_hdr *vlan;
+	bool handled = true;
+
+	test_init();
+	assert(test_skb_change_tail(ctx, sizeof(struct ethhdr) + sizeof(struct hwc_vlan_hdr), 0) == 0);
+	data = (void *)(long)ctx->data;
+	data_end = (void *)(long)ctx->data_end;
+	eth = data;
+	vlan = (void *)(eth + 1);
+	assert((void *)(vlan + 1) <= data_end);
+	eth->h_proto = bpf_htons(ETH_P_8021AD);
+	vlan->tci = bpf_htons(202);
+	vlan->encapsulated_proto = bpf_htons(ETH_P_IP);
+	assert(hwc_from_netdev(ctx, &handled) == DROP_INVALID);
+	assert(!handled);
+	test_finish();
+}
+
+struct hwc_test_frame_tail {
+	__u8 dest_tail[2];
+	__u8 source[6];
+	__be16 h_proto;
+	struct hwc_vlan_hdr vlan;
+	struct iphdr ip;
+} __packed;
+
+SETUP("tc", "huaweicloud_matching_inline_metadata_vlan")
+int test_huaweicloud_matching_inline_metadata_vlan_setup(struct __ctx_buff *ctx)
+{
+	struct hwc_test_frame_tail frame = {
+		.h_proto = bpf_htons(ETH_P_8021Q),
+		.vlan = {
+			.tci = bpf_htons(101),
+			.encapsulated_proto = bpf_htons(ETH_P_IP),
+		},
+		.ip = {
+			.version = 4,
+			.ihl = 5,
+		},
+	};
+	void *data;
+	void *data_end;
+
+	if (test_skb_change_tail(ctx, sizeof(frame), 0) < 0)
+		return TEST_ERROR;
+	data = (void *)(long)ctx->data;
+	data_end = (void *)(long)ctx->data_end;
+	if (data + sizeof(frame) > data_end)
+		return TEST_ERROR;
+	memcpy(data, &frame, sizeof(frame));
+
+	/* The Go runner prepends this TEST_PASS return value as four bytes to
+	 * the setup output before executing the check program. Together with
+	 * frame.dest_tail those bytes form the six-byte destination MAC, so the
+	 * check run receives a kernel-parsed Ethernet/VLAN packet from byte zero.
+	 */
+	return TEST_PASS;
+}
+
+CHECK("tc", "huaweicloud_matching_inline_metadata_vlan")
+int test_huaweicloud_matching_inline_metadata_vlan_check(struct __ctx_buff *ctx)
+{
+	void *data;
+	void *data_end;
+	struct ethhdr *eth;
+	struct hwc_vlan_mac_key vlan_key = {
+		.vlan_id = 101,
+	};
+	struct hwc_ep_info ep = {
+		.ifindex = 1,
+		.lxc_id = 1,
+	};
+	bool handled = false;
+	int ret;
+
+	test_init();
+	data = (void *)(long)ctx->data;
+	data_end = (void *)(long)ctx->data_end;
+	eth = data;
+	assert((void *)(eth + 1) <= data_end);
+	assert((__u32)((long)data_end - (long)data) ==
+	       sizeof(struct ethhdr) + sizeof(struct hwc_vlan_hdr) +
+	       sizeof(struct iphdr));
+	assert(eth->h_proto == bpf_htons(ETH_P_8021Q));
+	assert(ctx->protocol == bpf_htons(ETH_P_8021Q));
+	assert(!ctx->vlan_present);
+	vlan_key.mac[0] = eth->h_dest[0];
+	vlan_key.mac[1] = eth->h_dest[1];
+	vlan_key.mac[2] = eth->h_dest[2];
+	vlan_key.mac[3] = eth->h_dest[3];
+	vlan_key.mac[4] = eth->h_dest[4];
+	vlan_key.mac[5] = eth->h_dest[5];
+	assert(map_update_elem(&cilium_hwc_vlan_mac, &vlan_key, &ep, BPF_ANY) == 0);
+
+	/* Add a matching hardware-accelerated metadata representation while the
+	 * original 802.1Q header remains inline.
+	 */
+	assert(skb_vlan_push(ctx, bpf_htons(ETH_P_8021Q), 101) == 0);
+	assert(ctx->vlan_present);
+	assert(hwc_vlan_id((__u16)ctx->vlan_tci) == 101);
+	ret = hwc_from_netdev(ctx, &handled);
+	test_log("dual VLAN hwc_from_netdev ret=%d handled=%u", ret,
+		 (__u32)handled);
+	assert(ret == CTX_ACT_OK);
+	assert(handled);
+	assert(!ctx->vlan_present);
+
+	data = (void *)(long)ctx->data;
+	data_end = (void *)(long)ctx->data_end;
+	eth = data;
+	assert((void *)(eth + 1) <= data_end);
+	assert((__u32)((long)data_end - (long)data) ==
+	       sizeof(struct ethhdr) + sizeof(struct iphdr));
+	assert(eth->h_proto == bpf_htons(ETH_P_IP));
+	test_finish();
+}
+
+static __always_inline int
+test_huaweicloud_inline_non_ipv4(struct __ctx_buff *ctx, __be16 proto)
+{
+	void *data;
+	void *data_end;
+	struct ethhdr *eth;
+	struct hwc_vlan_hdr *vlan;
+	bool handled = true;
+
+	if (test_skb_change_tail(ctx,
+				 sizeof(struct ethhdr) + sizeof(struct hwc_vlan_hdr),
+				 0) < 0)
+		return TEST_FAIL;
+	data = (void *)(long)ctx->data;
+	data_end = (void *)(long)ctx->data_end;
+	eth = data;
+	vlan = (void *)(eth + 1);
+	if ((void *)(vlan + 1) > data_end)
+		return TEST_FAIL;
+	eth->h_proto = bpf_htons(ETH_P_8021AD);
+	vlan->tci = bpf_htons(101);
+	vlan->encapsulated_proto = proto;
+	if (hwc_from_netdev(ctx, &handled) != DROP_INVALID || handled)
+		return TEST_FAIL;
+	return TEST_PASS;
+}
+
+CHECK("tc", "huaweicloud_inline_non_ipv4")
+int test_huaweicloud_inline_non_ipv4_protocols(struct __ctx_buff *ctx)
+{
+	test_init();
+	TEST("arp_is_rejected", {
+		assert(test_huaweicloud_inline_non_ipv4(ctx,
+						     bpf_htons(ETH_P_ARP)) == TEST_PASS);
+	});
+	TEST("ipv6_is_rejected", {
+		assert(test_huaweicloud_inline_non_ipv4(ctx,
+						     bpf_htons(ETH_P_IPV6)) == TEST_PASS);
+	});
+	TEST("lldp_is_rejected", {
+		assert(test_huaweicloud_inline_non_ipv4(ctx,
+						     bpf_htons(0x88cc)) == TEST_PASS);
+	});
+	test_finish();
+}
+
+static __always_inline int
+test_huaweicloud_metadata_non_ipv4(struct __ctx_buff *ctx, __be16 proto)
+{
+	void *data;
+	void *data_end;
+	struct ethhdr *eth;
+	bool handled = true;
+
+	if (test_skb_change_tail(ctx, sizeof(struct ethhdr), 0) < 0)
+		return TEST_FAIL;
+	data = (void *)(long)ctx->data;
+	data_end = (void *)(long)ctx->data_end;
+	eth = data;
+	if ((void *)(eth + 1) > data_end)
+		return TEST_FAIL;
+	eth->h_proto = proto;
+	if (skb_vlan_push(ctx, bpf_htons(ETH_P_8021Q), 101) < 0)
+		return TEST_FAIL;
+	if (!ctx->vlan_present)
+		return TEST_FAIL;
+	if (hwc_from_netdev(ctx, &handled) != CTX_ACT_OK || handled)
+		return TEST_FAIL;
+	if (skb_vlan_pop(ctx) < 0 || ctx->vlan_present)
+		return TEST_FAIL;
+	return TEST_PASS;
+}
+
+CHECK("tc", "huaweicloud_metadata_non_ipv4")
+int test_huaweicloud_metadata_non_ipv4_protocols(struct __ctx_buff *ctx)
+{
+	test_init();
+	TEST("arp_reaches_generic_path", {
+		assert(test_huaweicloud_metadata_non_ipv4(ctx,
+						       bpf_htons(ETH_P_ARP)) == TEST_PASS);
+	});
+	TEST("ipv6_reaches_generic_path", {
+		assert(test_huaweicloud_metadata_non_ipv4(ctx,
+						       bpf_htons(ETH_P_IPV6)) == TEST_PASS);
+	});
+	TEST("lldp_reaches_generic_path", {
+		assert(test_huaweicloud_metadata_non_ipv4(ctx,
+						       bpf_htons(0x88cc)) == TEST_PASS);
+	});
+	test_finish();
+}
+
+static __always_inline int
+test_huaweicloud_nested_vlan(struct __ctx_buff *ctx, bool three_tags)
+{
+	void *data;
+	void *data_end;
+	struct ethhdr *eth;
+	struct hwc_vlan_hdr *outer;
+	struct hwc_vlan_hdr *middle;
+	struct hwc_vlan_hdr *inner;
+	__u32 packet_len = sizeof(struct ethhdr) + 2 * sizeof(struct hwc_vlan_hdr);
+	bool handled = true;
+
+	if (three_tags)
+		packet_len += sizeof(struct hwc_vlan_hdr);
+	if (test_skb_change_tail(ctx, packet_len, 0) < 0)
+		return TEST_FAIL;
+	data = (void *)(long)ctx->data;
+	data_end = (void *)(long)ctx->data_end;
+	eth = data;
+	outer = (void *)(eth + 1);
+	middle = outer + 1;
+	inner = middle + 1;
+	if ((void *)(middle + 1) > data_end)
+		return TEST_FAIL;
+	eth->h_proto = bpf_htons(ETH_P_8021AD);
+	outer->tci = bpf_htons(101);
+	outer->encapsulated_proto = bpf_htons(ETH_P_8021Q);
+	middle->tci = bpf_htons(102);
+	middle->encapsulated_proto = three_tags ? bpf_htons(ETH_P_8021AD) :
+						       bpf_htons(ETH_P_IP);
+	if (three_tags) {
+		if ((void *)(inner + 1) > data_end)
+			return TEST_FAIL;
+		inner->tci = bpf_htons(103);
+		inner->encapsulated_proto = bpf_htons(ETH_P_IP);
+	}
+	if (hwc_from_netdev(ctx, &handled) != DROP_INVALID || handled)
+		return TEST_FAIL;
+	return TEST_PASS;
+}
+
+CHECK("tc", "huaweicloud_nested_vlan")
+int test_huaweicloud_nested_vlan_protocols(struct __ctx_buff *ctx)
+{
+	test_init();
+	TEST("qinq_is_rejected", {
+		assert(test_huaweicloud_nested_vlan(ctx, false) == TEST_PASS);
+	});
+	TEST("three_tags_are_rejected", {
+		assert(test_huaweicloud_nested_vlan(ctx, true) == TEST_PASS);
+	});
+	test_finish();
+}
+
+BPF_LICENSE("Dual BSD/GPL");
diff --git a/daemon/cmd/kube_proxy_replacement.go b/daemon/cmd/kube_proxy_replacement.go
index aaf3abd48..5b2e924c2 100644
--- a/daemon/cmd/kube_proxy_replacement.go
+++ b/daemon/cmd/kube_proxy_replacement.go
@@ -77,6 +77,21 @@ func initKubeProxyReplacementOptions() (bool, error) {
 		return false, nil
 	}
 
+	if shouldDisableProbeFeaturesForExplicitNodePort(
+		option.Config.KubeProxyReplacement,
+		viper.IsSet(option.EnableNodePort),
+		viper.GetBool(option.EnableNodePort),
+	) {
+		log.Infof("Disabling kube-proxy replacement features because %q is explicitly false in probe mode",
+			option.EnableNodePort)
+		disableNodePort()
+		option.Config.EnableSocketLB = false
+		option.Config.EnableHostServicesTCP = false
+		option.Config.EnableHostServicesUDP = false
+		option.Config.EnableSessionAffinity = false
+		return false, nil
+	}
+
 	probesManager := probes.NewProbeManager()
 
 	// strict denotes to panic if any to-be enabled feature cannot be enabled
@@ -432,6 +447,10 @@ func initKubeProxyReplacementOptions() (bool, error) {
 	return strict, nil
 }
 
+func shouldDisableProbeFeaturesForExplicitNodePort(mode string, nodePortIsSet, nodePortEnabled bool) bool {
+	return mode == option.KubeProxyReplacementProbe && nodePortIsSet && !nodePortEnabled
+}
+
 func probeManagedNeighborSupport() {
