+}
+
+func (tx *configureTransaction) rollback() error {
+	var rollbackErrors []string
+	for i := len(tx.deletedRoutes) - 1; i >= 0; i-- {
+		if err := routingRouteReplace(&tx.deletedRoutes[i]); err != nil {
+			rollbackErrors = append(rollbackErrors, err.Error())
+		}
+	}
+	for i := len(tx.routes) - 1; i >= 0; i-- {
+		change := tx.routes[i]
