+func (m *testMap) Dump(callback func(bpf.MapKey, bpf.MapValue)) error {
+	m.mutex.Lock()
+	defer m.mutex.Unlock()
+	if m.dumpErr != nil {
+		return m.dumpErr
+	}
+	for keyString, value := range m.entries {
+		key, ok := m.keys[keyString]
+		if !ok {
+			return errors.New("test map entry has no key")
+		}
+		callback(key.DeepCopyMapKey(), value.DeepCopyMapValue())
+	}
+	return nil
+}
