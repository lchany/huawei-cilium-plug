+		t.Fatal("duplicate private-IP matches were accepted")
+	}
+}
+
+func TestSubENIInfoRejectsNarrowingAndGatewayBoundaries(t *testing.T) {
+	baseEP := testSubENIEndpoint{ip: "10.0.0.2", id: 1, ifindex: 2}
+	baseSubENI := validSubENI()
+	tests := map[string]struct {
+		ep     testSubENIEndpoint
+		mutate func(*eniTypes.SubENI)
+		want   string
+	}{
+		"zero-id":          {ep: testSubENIEndpoint{ip: baseEP.ip, ifindex: 2}, want: "ID"},
+		"overflow-id":      {ep: testSubENIEndpoint{ip: baseEP.ip, id: 65536, ifindex: 2}, want: "ID"},
+		"zero-ifindex":     {ep: testSubENIEndpoint{ip: baseEP.ip, id: 1}, want: "ifindex"},
+		"gateway-ip-only":  {ep: baseEP, mutate: func(e *eniTypes.SubENI) { e.GatewayMAC = "" }, want: "together"},
+		"gateway-mac-only": {ep: baseEP, mutate: func(e *eniTypes.SubENI) { e.GatewayIP = "" }, want: "together"},
+		"missing-trunk":    {ep: baseEP, mutate: func(e *eniTypes.SubENI) { e.TrunkInterface = "" }, want: "trunk"},
+	}
+	for name, tt := range tests {
+		t.Run(name, func(t *testing.T) {
+			subENI := baseSubENI
+			if tt.mutate != nil {
+				tt.mutate(&subENI)
+			}
+			_, err := subENIInfoForEndpoint(testCiliumNode(map[string]eniTypes.SubENI{"eni": subENI}), tt.ep)
+			if err == nil || !strings.Contains(err.Error(), tt.want) {
+				t.Fatalf("expected %q validation error, got %v", tt.want, err)
+			}
+		})
+	}
+}
+
+func TestQueuedDeleteUsesInitialReconcileCache(t *testing.T) {
+	mapMgr := &fakeSubENIMapUpdater{}
+	subscriber := &huaweiCloudSubENISubscriber{
+		mapMgr: mapMgr,
+		cache:  map[string]subenimap.EndpointInfo{},
+	}
+	ep := &endpoint.Endpoint{
+		ID:   7,
+		IPv4: addressing.DeriveCiliumIPv4(net.ParseIP("10.0.0.7")),
+	}
+	info := &huaweiCloudEndpointInfo{id: 7, ipv4: "10.0.0.7"}
+	subscriber.cacheEndpointInfo(info)
+
+	subscriber.EndpointDeleted(ep, endpoint.DeleteConfig{})
+	if len(mapMgr.deleted) != 0 || len(subscriber.pending) != 1 {
+		t.Fatalf("delete was not queued before initialization: deleted=%d pending=%d", len(mapMgr.deleted), len(subscriber.pending))
+	}
+	subscriber.finishInitialization()
+	if !subscriber.initialized || len(subscriber.pending) != 0 || len(mapMgr.deleted) != 1 {
+		t.Fatalf("queued delete was not replayed exactly once: initialized=%v pending=%d deleted=%d", subscriber.initialized, len(subscriber.pending), len(mapMgr.deleted))
+	}
+	if got := subscriber.cachedEndpointInfo(ep); got != nil {
+		t.Fatalf("successfully deleted endpoint remained cached: %#v", got)
+	}
+}
+
+func TestFailedDeleteRetainsInitialReconcileCache(t *testing.T) {
+	mapMgr := &fakeSubENIMapUpdater{err: errors.New("injected delete failure")}
+	subscriber := &huaweiCloudSubENISubscriber{
+		logger:      logging.DefaultLogger.WithField("test", t.Name()),
+		mapMgr:      mapMgr,
+		initialized: true,
+		cache:       map[string]subenimap.EndpointInfo{},
+	}
+	ep := &endpoint.Endpoint{
+		ID:   8,
+		IPv4: addressing.DeriveCiliumIPv4(net.ParseIP("10.0.0.8")),
+	}
+	info := &huaweiCloudEndpointInfo{id: 8, ipv4: "10.0.0.8"}
+	subscriber.cacheEndpointInfo(info)
+
+	subscriber.EndpointDeleted(ep, endpoint.DeleteConfig{})
+	if len(mapMgr.deleted) != 1 {
+		t.Fatalf("delete attempt count=%d, want 1", len(mapMgr.deleted))
+	}
+	if got := subscriber.cachedEndpointInfo(ep); got != info {
+		t.Fatalf("failed delete discarded cached endpoint: got=%#v want=%#v", got, info)
+	}
+}
