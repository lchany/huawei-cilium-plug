+type syncResult struct {
+	value interface{}
+	err   error
+}
+
+func syncWithContext(ctx context.Context, call func() (interface{}, error)) (interface{}, error) {
+	result := make(chan syncResult, 1)
+	go func() {
+		value, err := call()
+		result <- syncResult{value: value, err: err}
+	}()
+
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case response := <-result:
+		return response.value, response.err
+	}
+}
