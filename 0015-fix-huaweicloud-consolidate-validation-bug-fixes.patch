+func TestNewSubENIMapManagerCreatesPinnedMapsBeforeEndpointEvents(t *testing.T) {
+	if err := rlimit.RemoveMemlock(); err != nil {
+		t.Fatalf("remove memlock limit: %v", err)
+	}
+
+	paths := []string{bpf.MapPath(srcIPMapName), bpf.MapPath(vlanMACMapName)}
+	for _, path := range paths {
+		if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
+			t.Fatalf("remove stale test map %s: %v", path, err)
+		}
+	}
+	defer func() {
+		for _, path := range paths {
+			_ = os.Remove(path)
+		}
+	}()
+
+	manager, err := NewSubENIMapManager(logging.DefaultLogger.WithField("test", t.Name()))
+	if err != nil {
+		t.Fatalf("create manager before endpoint programs: %v", err)
+	}
+	defer manager.Close()
+
+	for _, path := range paths {
+		if _, err := os.Stat(path); err != nil {
+			t.Fatalf("expected pinned map %s: %v", path, err)
+		}
+	}
+
+	ep := validEndpoint()
+	if err := manager.OnEndpointReady(ep); err != nil {
+		t.Fatalf("populate newly created maps: %v", err)
+	}
+	srcKey := &SrcIPKey4{Addr: [4]byte{10, 0, 0, 2}}
+	got, err := manager.srcIPMap.Lookup(srcKey)
+	if err != nil {
+		t.Fatalf("lookup source entry: %v", err)
+	}
+	want := &SubENIInfo{VlanID: uint16(ep.vlan), MAC: ep.mac, LxcID: ep.id}
+	if value, ok := got.(*SubENIInfo); !ok || *value != *want {
+		t.Fatalf("unexpected source entry: got=%v want=%v", got, want)
+	}
+
+	// Pinned maps outlive the Agent process. Verify that a replacement
+	// endpoint with the same IP but a new LXC/VLAN owner atomically takes over
+	// rather than being rejected by the stale owner left by the prior process.
+	desired := ep
+	desired.id = 22
+	desired.ifindex = 33
+	desired.vlan = 202
+	desired.mac = [6]byte{2, 20, 21, 22, 23, 24}
+	if err := manager.Reconcile([]EndpointInfo{desired}); err != nil {
+		t.Fatalf("reconcile persisted owner: %v", err)
+	}
+	got, err = manager.srcIPMap.Lookup(srcKey)
+	if err != nil {
+		t.Fatalf("lookup reconciled source entry: %v", err)
+	}
+	want = &SubENIInfo{VlanID: uint16(desired.vlan), MAC: desired.mac, LxcID: desired.id}
+	if value, ok := got.(*SubENIInfo); !ok || *value != *want {
+		t.Fatalf("unexpected reconciled source entry: got=%v want=%v", got, want)
+	}
+	oldVLANKey := &VLANMACKey{VlanID: uint16(ep.vlan), MAC: ep.mac}
+	if _, err := manager.vlanMACMap.Lookup(oldVLANKey); !errors.Is(err, unix.ENOENT) {
+		t.Fatalf("stale ingress owner lookup returned %v, want ENOENT: %s", err, oldVLANKey)
+	}
+	newVLANKey := &VLANMACKey{VlanID: uint16(desired.vlan), MAC: desired.mac}
+	got, err = manager.vlanMACMap.Lookup(newVLANKey)
+	if err != nil {
+		t.Fatalf("lookup reconciled ingress entry: %v", err)
+	}
+	wantEP := &EPInfo{IfIndex: desired.ifindex, LxcID: uint16(desired.id)}
+	if value, ok := got.(*EPInfo); !ok || *value != *wantEP {
+		t.Fatalf("unexpected reconciled ingress entry: got=%v want=%v", got, wantEP)
+	}
+}
