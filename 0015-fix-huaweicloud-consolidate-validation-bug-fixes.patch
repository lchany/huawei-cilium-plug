+func TestDeriveHuaweiCloudVPCCIDRBoundaries(t *testing.T) {
+	tests := []struct {
+		name          string
+		primary       string
+		secondary     []string
+		wantPrimary   string
+		wantSecondary []string
+	}{
+		{name: "empty primary", secondary: []string{"10.1.0.0/16"}},
+		{name: "invalid primary", primary: "invalid", secondary: []string{"10.1.0.0/16"}},
+		{name: "IPv6 primary", primary: "2001:db8::/64", secondary: []string{"10.1.0.0/16"}},
+		{
+			name: "filter invalid duplicate and overlapping secondary", primary: "10.0.0.0/16",
+			secondary: []string{
+				"", "invalid", "2001:db8::/64", "10.0.0.0/16", "10.0.1.0/24",
+				"10.1.0.0/16", "10.1.0.0/16", "10.1.1.0/24", "10.2.0.0/16",
+			},
+			wantPrimary: "10.0.0.0/16", wantSecondary: []string{"10.1.0.0/16", "10.2.0.0/16"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			node := &ciliumv2.CiliumNode{Status: ciliumv2.NodeStatus{HuaweiCloud: &eniTypes.ENIStatus{
+				VPCPrimaryCIDR: tt.primary, VPCCIDRs: tt.secondary,
+			}}}
+			primary, secondary := deriveVpcCIDRs(node)
+			if tt.wantPrimary == "" {
+				if primary != nil || len(secondary) != 0 {
+					t.Fatalf("invalid primary leaked CIDRs: primary=%v secondary=%v", primary, secondary)
+				}
+				return
+			}
+			if primary == nil || primary.String() != tt.wantPrimary {
+				t.Fatalf("primary=%v, want %s", primary, tt.wantPrimary)
+			}
+			if len(secondary) != len(tt.wantSecondary) {
+				t.Fatalf("secondary=%v, want %v", secondary, tt.wantSecondary)
+			}
+			for i := range secondary {
+				if secondary[i].String() != tt.wantSecondary[i] {
+					t.Fatalf("secondary[%d]=%s, want %s", i, secondary[i], tt.wantSecondary[i])
+				}
+			}
