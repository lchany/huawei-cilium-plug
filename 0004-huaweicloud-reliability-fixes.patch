+func (s *huaweiCloudSubENISubscriber) run(ctx context.Context, manager EndpointManager) {
+	ticker := time.NewTicker(30 * time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			s.reconcileEndpoints(manager.GetEndpoints(), "periodic-sync")
+			s.pending.Range(func(key, value any) bool {
+				if err := s.mapMgr.OnEndpointDelete(value.(*huaweiCloudEndpointInfo)); err != nil {
+					s.logger.Warn("Failed to retry HuaweiCloud SubENI BPF map deletion", logfields.Error, err)
+					return true
+				}
+				s.pending.Delete(key)
+				s.bindings.Delete(key)
+				return true
+			})
+		}
+	}
+}
+
+func (s *huaweiCloudSubENISubscriber) reconcileEndpoints(endpoints []*endpoint.Endpoint, reason string) {
+	if len(endpoints) == 0 {
+		return
+	}
+	nodeName := nodeTypes.GetName()
+	cn, err := s.clientset.CiliumV2().CiliumNodes().Get(context.Background(), nodeName, metav1.GetOptions{})
+	if err != nil {
+		s.logger.Warn("Failed to get CiliumNode for HuaweiCloud SubENI reconciliation", logfields.Error, err)
+		return
+	}
+	for _, ep := range endpoints {
+		info, err := subENIInfoForEndpoint(cn, ep)
+		s.programEndpoint(ep, info, err, reason)
+	}
+}
