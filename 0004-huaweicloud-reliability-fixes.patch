+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package api
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	eniTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+	"github.com/stretchr/testify/require"
+)
+
+func TestValidateCreateRequest(t *testing.T) {
+	require.ErrorIs(t, validateCreateRequest(CreateSubENIRequest{}), ErrInvalidArgument)
+	require.ErrorIs(t, validateCreateRequest(CreateSubENIRequest{TrunkInterfaceID: "parent"}), ErrInvalidArgument)
+	require.NoError(t, validateCreateRequest(CreateSubENIRequest{TrunkInterfaceID: "parent", SubnetID: "subnet"}))
+}
+
+func TestValidateSubENI(t *testing.T) {
+	require.Error(t, validateSubENI(nil))
+	require.Error(t, validateSubENI(&eniTypes.SubENI{ID: "id", VlanID: 0}))
+	require.Error(t, validateSubENI(&eniTypes.SubENI{ID: "id", VlanID: 4095}))
+	require.NoError(t, validateSubENI(&eniTypes.SubENI{ID: "id", VlanID: 4094}))
+}
+
+func TestCollectPages(t *testing.T) {
+	items, err := collectPages(context.Background(), func(marker *string) ([]int, *string, error) {
+		if marker == nil {
+			next := "page-2"
+			return []int{1}, &next, nil
+		}
+		require.Equal(t, "page-2", *marker)
+		return []int{2}, nil, nil
+	})
+	require.NoError(t, err)
+	require.Equal(t, []int{1, 2}, items)
+}
+
+func TestCollectPagesRejectsRepeatedMarker(t *testing.T) {
+	_, err := collectPages(context.Background(), func(marker *string) ([]int, *string, error) {
+		next := "same"
+		return nil, &next, nil
+	})
+	require.ErrorContains(t, err, "did not advance")
+}
+
+func TestGatewayMetadataIsRequired(t *testing.T) {
+	err := (&Client{}).fillSubENIGatewayInfo(context.Background(), nil, nil, nil)
+	require.True(t, errors.Is(err, ErrGatewayNotReady))
+}
