+func collectPages[T any](ctx context.Context, fetch func(*string) ([]T, *string, error)) ([]T, error) {
+	var result []T
+	var marker *string
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		page, next, err := fetch(marker)
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, page...)
+		if next == nil || strings.TrimSpace(*next) == "" {
+			return result, nil
+		}
+		if marker != nil && *next == *marker {
+			return nil, fmt.Errorf("pagination marker did not advance: %s", *next)
+		}
+		nextMarker := *next
+		marker = &nextMarker
+	}
+}
