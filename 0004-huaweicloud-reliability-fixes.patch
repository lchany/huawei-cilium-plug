+func (c *Client) listSubNetworkInterfaces(ctx context.Context, parentIDs []string) ([]vpcmodel.SubNetworkInterface, error) {
+	limit := int32(2000)
+	return collectPages(ctx, func(marker *string) ([]vpcmodel.SubNetworkInterface, *string, error) {
+		request := &vpcmodel.ListSubNetworkInterfacesRequest{Limit: &limit, Marker: marker}
+		if len(parentIDs) > 0 {
