@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package neighbor
+
+import (
+	"net"
+	"testing"
+)
+
+func TestRegistryMatchesExactGatewayNeighbor(t *testing.T) {
+	registry := NewRegistry()
+	if registry.Ready() {
+		t.Fatal("new registry was unexpectedly ready")
+	}
+	ip := net.ParseIP("10.0.0.1")
+	mac, _ := net.ParseMAC("fa:16:3e:00:00:fe")
+	key, ok := NewKey("eth0", ip, mac)
+	if !ok {
+		t.Fatal("valid gateway neighbor key was rejected")
+	}
+	registry.Replace([]Key{key, key})
+	if !registry.Ready() {
+		t.Fatal("published registry was not ready")
+	}
+
+	if !registry.Contains("eth0", ip, mac) {
+		t.Fatal("desired gateway neighbor was not found")
+	}
+	if registry.Contains("eth1", ip, mac) {
+		t.Fatal("same gateway on another link was matched")
+	}
+	otherMAC, _ := net.ParseMAC("fa:16:3e:00:00:ff")
+	if registry.Contains("eth0", ip, otherMAC) {
+		t.Fatal("same gateway with another MAC was matched")
+	}
+	if registry.Contains("eth0", net.ParseIP("2001:db8::1"), mac) {
+		t.Fatal("IPv6 gateway was matched")
+	}
+
+	if got := len(registry.Snapshot()); got != 1 {
+		t.Fatalf("registry size=%d, want 1", got)
+	}
+	registry.Clear()
+	if registry.Ready() {
+		t.Fatal("cleared registry remained ready")
+	}
+	if registry.Contains("eth0", ip, mac) {
+		t.Fatal("cleared gateway neighbor remained registered")
+	}
+}
+
+func TestRegistryReplaceIsAtomicAtSetLevel(t *testing.T) {
+	registry := NewRegistry()
+	firstMAC, _ := net.ParseMAC("fa:16:3e:00:00:01")
+	secondMAC, _ := net.ParseMAC("fa:16:3e:00:00:02")
+	first, _ := NewKey("eth0", net.ParseIP("10.0.0.1"), firstMAC)
+	second, _ := NewKey("eth0", net.ParseIP("10.0.1.1"), secondMAC)
+
+	registry.Replace([]Key{first})
+	registry.Replace([]Key{second})
+	if registry.Contains(first.LinkName, net.ParseIP(first.IPv4), firstMAC) {
+		t.Fatal("replaced gateway neighbor remained registered")
+	}
+	if !registry.Contains(second.LinkName, net.ParseIP(second.IPv4), secondMAC) {
+		t.Fatal("replacement gateway neighbor was not registered")
+	}
+	stale := registry.StaleSnapshot()
+	if len(stale) != 1 || stale[0] != first {
+		t.Fatalf("stale registry entries=%v, want [%v]", stale, first)
+	}
+	registry.ForgetStale(stale)
+	if got := registry.StaleSnapshot(); len(got) != 0 {
+		t.Fatalf("stale registry entries remained after acknowledgement: %v", got)
+	}
+}
