+	t.Cleanup(huaweiCloudNeighbor.Default.Clear)
+
+	desiredIP := net.ParseIP("10.42.18.1").To4()
+	desiredMAC, _ := net.ParseMAC("02:00:00:00:18:01")
+	staleIP := net.ParseIP("10.42.18.2").To4()
+	staleMAC, _ := net.ParseMAC("02:00:00:00:18:02")
+	for _, neighbor := range []netlink.Neigh{
+		{LinkIndex: link.Attrs().Index, Family: netlink.FAMILY_V4, State: netlink.NUD_PERMANENT,
+			Flags: netlink.NTF_EXT_LEARNED, IP: desiredIP, HardwareAddr: desiredMAC},
+		{LinkIndex: link.Attrs().Index, Family: netlink.FAMILY_V4, State: netlink.NUD_PERMANENT,
+			Flags: netlink.NTF_EXT_LEARNED, IP: staleIP, HardwareAddr: staleMAC},
+	} {
+		if err := netlink.NeighSet(&neighbor); err != nil {
+			t.Fatal(err)
+		}
+	}
+	desiredKey, _ := huaweiCloudNeighbor.NewKey(link.Attrs().Name, desiredIP, desiredMAC)
+	staleKey, _ := huaweiCloudNeighbor.NewKey(link.Attrs().Name, staleIP, staleMAC)
+	huaweiCloudNeighbor.Default.Replace([]huaweiCloudNeighbor.Key{desiredKey, staleKey})
+	huaweiCloudNeighbor.Default.Replace([]huaweiCloudNeighbor.Key{desiredKey})
+
+	if err := (&huaweiCloudSubENISubscriber{}).reconcileGatewayNeighbors(); err != nil {
+		t.Fatal(err)
