+func TestCreateSubNetworkInterfacesTagsAfterCreate(t *testing.T) {
+	for _, batch := range []bool{false, true} {
+		name := "single"
+		if batch {
+			name = "batch"
+		}
+		t.Run(name, func(t *testing.T) {
+			var inlineTags json.RawMessage
+			var taggedIDs []string
+			var taggedValues map[string]string
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				switch {
+				case strings.Contains(r.URL.Path, "/tags/create"):
+					taggedIDs = append(taggedIDs, strings.Split(r.URL.Path, "/")[4])
+					var body struct {
+						Tags []struct {
+							Key   string `json:"key"`
+							Value string `json:"value"`
+						} `json:"tags"`
+					}
+					if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+						t.Errorf("decode tag body: %v", err)
+						return
+					}
+					taggedValues = make(map[string]string, len(body.Tags))
+					for _, tag := range body.Tags {
+						taggedValues[tag.Key] = tag.Value
+					}
+					w.WriteHeader(http.StatusNoContent)
+				case strings.Contains(r.URL.Path, "sub-network-interfaces") && r.Method == http.MethodPost:
+					var body struct {
+						SubNetworkInterface map[string]json.RawMessage `json:"sub_network_interface"`
+					}
+					if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+						t.Errorf("decode create body: %v", err)
+						return
+					}
+					inlineTags = body.SubNetworkInterface["tags"]
+					item := map[string]interface{}{
+						"id": "eni-1", "private_ip_address": "10.0.0.2", "mac_address": "fa:16:3e:00:00:01",
+						"vlan_id": 101, "virsubnet_id": "subnet-1", "parent_id": "port-1",
+					}
+					if batch {
+						_ = json.NewEncoder(w).Encode(map[string]interface{}{"sub_network_interfaces": []interface{}{item}})
+					} else {
+						_ = json.NewEncoder(w).Encode(map[string]interface{}{"sub_network_interface": item})
+					}
+				case strings.Contains(r.URL.Path, "virsubnets"):
+					_, _ = fmt.Fprint(w, `{"virsubnets":[{"id":"subnet-1","subnet_cidrs":[{"ip_version":"4","cidr":"10.0.0.0/24","gateway_ip":"10.0.0.1"}]}]}`)
+				default:
+					_, _ = fmt.Fprint(w, `{"ports":[{"virsubnet_id":"subnet-1","mac_address":"fa:16:3e:00:00:fe","private_ips":[{"ip_address":"10.0.0.1"}]}]}`)
+				}
+			}))
+			defer server.Close()
+
+			client := newTestClient(t, server.URL)
+			req := CreateSubENIRequest{
+				SubnetID: "subnet-1", TrunkInterfaceID: "port-1",
+				Tags: map[string]string{"role": "pod", "owner": "cilium"},
+			}
+			if batch {
+				_, err := client.BatchCreateSubNetworkInterfaces(context.Background(), 1, req)
+				if err != nil {
+					t.Fatal(err)
+				}
+			} else if _, _, err := client.CreateSubNetworkInterface(context.Background(), req); err != nil {
+				t.Fatal(err)
+			}
+
+			if inlineTags != nil {
+				t.Fatalf("create request still contains inline tags: %s", inlineTags)
+			}
+			if len(taggedIDs) != 1 || taggedIDs[0] != "eni-1" {
+				t.Fatalf("tagged IDs=%v, want [eni-1]", taggedIDs)
+			}
+			if len(taggedValues) != 2 || taggedValues["owner"] != "cilium" || taggedValues["role"] != "pod" {
+				t.Fatalf("tagged values=%v", taggedValues)
+			}
+		})
+	}
+}
