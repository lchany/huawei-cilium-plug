+func TestNodeCleanNeighborsLinkPreservesDesiredHuaweiCloudGateway(t *testing.T) {
+	attrs := netlink.NewLinkAttrs()
+	attrs.Name = "hwc-cleangw"
+	link := &netlink.Dummy{LinkAttrs: attrs}
+	if err := netlink.LinkAdd(link); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = netlink.LinkDel(link) })
+	if err := netlink.LinkSetUp(link); err != nil {
+		t.Fatal(err)
+	}
+	huaweiCloudNeighbor.Default.Clear()
+	t.Cleanup(huaweiCloudNeighbor.Default.Clear)
+
+	desiredIP := net.ParseIP("10.43.0.1").To4()
+	desiredMAC, _ := net.ParseMAC("02:00:00:00:43:01")
+	key, _ := huaweiCloudNeighbor.NewKey(attrs.Name, desiredIP, desiredMAC)
+	huaweiCloudNeighbor.Default.Replace([]huaweiCloudNeighbor.Key{key})
+	if err := netlink.NeighSet(&netlink.Neigh{
+		LinkIndex: link.Attrs().Index, Family: netlink.FAMILY_V4,
+		State: netlink.NUD_PERMANENT, Flags: netlink.NTF_EXT_LEARNED,
+		IP: desiredIP, HardwareAddr: desiredMAC,
+	}); err != nil {
+		t.Fatal(err)
+	}
+
+	handler := &linuxNodeHandler{}
+	for _, migrateOnly := range []bool{false, true} {
+		staleIP := net.ParseIP("10.43.0.2").To4()
+		staleMAC, _ := net.ParseMAC("02:00:00:00:43:02")
+		if err := netlink.NeighSet(&netlink.Neigh{
+			LinkIndex: link.Attrs().Index, Family: netlink.FAMILY_V4,
+			State: netlink.NUD_PERMANENT, IP: staleIP, HardwareAddr: staleMAC,
+		}); err != nil {
+			t.Fatal(err)
+		}
+		if !handler.NodeCleanNeighborsLink(link, migrateOnly) {
+			t.Fatalf("neighbor cleanup failed, migrateOnly=%v", migrateOnly)
+		}
+		neighbors, err := netlink.NeighList(link.Attrs().Index, netlink.FAMILY_V4)
+		if err != nil {
+			t.Fatal(err)
+		}
+		foundDesired := false
+		for _, neighbor := range neighbors {
+			if neighbor.IP.Equal(desiredIP) && bytes.Equal(neighbor.HardwareAddr, desiredMAC) {
+				foundDesired = true
+			}
+			if neighbor.IP.Equal(staleIP) {
+				t.Fatalf("ordinary stale neighbor was protected, migrateOnly=%v: %+v", migrateOnly, neighbor)
+			}
+		}
+		if !foundDesired {
+			t.Fatalf("desired HuaweiCloud gateway was removed, migrateOnly=%v", migrateOnly)
+		}
+	}
+}
