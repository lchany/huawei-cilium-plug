+				{"id": "eni-2", "private_ip_address": "10.0.0.3", "mac_address": "fa:16:3e:00:00:02", "vlan_id": 102, "virsubnet_id": "subnet-1", "parent_id": "port-1"},
+			}
+			_ = json.NewEncoder(w).Encode(map[string]interface{}{"sub_network_interfaces": items})
+		case strings.Contains(r.URL.Path, "virsubnets"):
+			_, _ = fmt.Fprint(w, `{"virsubnets":[{"id":"subnet-1","subnet_cidrs":[{"ip_version":"4","cidr":"10.0.0.0/24","gateway_ip":"10.0.0.1"}]}]}`)
+		default:
+			_, _ = fmt.Fprint(w, `{"ports":[{"virsubnet_id":"subnet-1","mac_address":"fa:16:3e:00:00:fe","private_ips":[{"ip_address":"10.0.0.1"}]}]}`)
