 	for _, neigh := range neighList {
 		var err error
+		// HuaweiCloud gateway neighbors share the trunk link with Cilium's
+		// neighbor discovery entries. Preserve only exact entries published by
+		// the Sub-ENI endpoint manager; NTF_EXT_LEARNED alone is also used by
+		// Cilium and therefore cannot identify ownership.
+		if neigh.State&netlink.NUD_PERMANENT != 0 &&
+			huaweiCloudNeighbor.Default.Contains(l.Attrs().Name, neigh.IP, neigh.HardwareAddr) {
+			continue
+		}
 		// If this is a non-static neighbor entry, it will be GC'ed by
 		// the kernel eventually. Older Cilium versions might have left-
 		// overs installed as NUD_PERMANENT.
