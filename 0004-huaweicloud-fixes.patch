+	handler := &linuxNodeHandler{}
+	handler.NodeCleanNeighbors(false)
+	if _, err := os.Stat(filepath.Join(option.Config.StateDir, neighFileName)); err != nil {
+		t.Fatalf("neighbor state file was removed before ownership initialization: %v", err)
+	}
+	neighbors, err := netlink.NeighList(link.Attrs().Index, netlink.FAMILY_V4)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(neighbors) != 1 || !neighbors[0].IP.Equal(ip) {
+		t.Fatalf("neighbor was removed before ownership initialization: %+v", neighbors)
+	}
+
+	huaweiCloudNeighbor.Default.Replace(nil)
+	handler.NodeCleanNeighbors(false)
+	neighbors, err = netlink.NeighList(link.Attrs().Index, netlink.FAMILY_V4)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, neighbor := range neighbors {
+		if neighbor.IP.Equal(ip) {
+			t.Fatalf("stale neighbor remained after ownership initialization: %+v", neighbor)
