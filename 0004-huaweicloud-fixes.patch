+func TestEnsureGatewayNeighborSetsAndRepairsExternLearned(t *testing.T) {
+	link := testHuaweiCloudDummyLink(t, "hwc-neighflag")
+	gateway := net.ParseIP("10.42.14.1").To4()
+	gatewayMAC, _ := net.ParseMAC("02:00:00:00:14:fe")
+	subscriber := &huaweiCloudSubENISubscriber{}
+	info := &huaweiCloudEndpointInfo{
+		gatewayIP: gateway, gatewayMAC: gatewayMAC, trunkInterface: link.Attrs().Name,
+	}
+
+	if err := subscriber.ensureGatewayNeighbor(info); err != nil {
+		t.Fatal(err)
+	}
+	got := testHuaweiCloudNeighbor(t, link, gateway)
+	if got.State&netlink.NUD_PERMANENT == 0 || got.Flags&netlink.NTF_EXT_LEARNED == 0 {
+		t.Fatalf("gateway neighbor flags: state=%#x flags=%#x", got.State, got.Flags)
+	}
+
+	if err := netlink.NeighSet(&netlink.Neigh{
+		LinkIndex: link.Attrs().Index, Family: netlink.FAMILY_V4,
+		State: netlink.NUD_PERMANENT, IP: gateway, HardwareAddr: gatewayMAC,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if got := testHuaweiCloudNeighbor(t, link, gateway); got.Flags&netlink.NTF_EXT_LEARNED != 0 {
+		t.Fatalf("test setup retained extern-learned flag: %#x", got.Flags)
+	}
+	if err := subscriber.ensureGatewayNeighbor(info); err != nil {
+		t.Fatal(err)
+	}
+	if got := testHuaweiCloudNeighbor(t, link, gateway); got.Flags&netlink.NTF_EXT_LEARNED == 0 {
+		t.Fatalf("gateway neighbor extern-learned flag was not repaired: %#x", got.Flags)
+	}
+}
