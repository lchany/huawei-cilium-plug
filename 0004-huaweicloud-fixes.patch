+	subscriber.refreshGatewayNeighborOwnership()
+	if !huaweiCloudNeighbor.Default.Contains("eth0", gateway, gatewayMAC) {
+		t.Fatal("shared gateway ownership was removed while one endpoint remained")
+	}
+	subscriber.forgetEndpointInfo(&endpoint.Endpoint{ID: 2, IPv4: addressing.DeriveCiliumIPv4(net.ParseIP(second.ipv4))})
+	subscriber.refreshGatewayNeighborOwnership()
+	if huaweiCloudNeighbor.Default.Contains("eth0", gateway, gatewayMAC) {
+		t.Fatal("gateway ownership remained after the last endpoint was removed")
+	}
