+		id: 2, ipv4: "10.0.0.3", gatewayIP: gateway, gatewayMAC: gatewayMAC, trunkInterface: "eth0",
+	}
+	subscriber.cacheEndpointInfo(first)
+	subscriber.cacheEndpointInfo(second)
+	subscriber.refreshGatewayNeighborOwnership()
+	if got := len(huaweiCloudNeighbor.Default.Snapshot()); got != 1 {
+		t.Fatalf("shared gateway ownership entries=%d, want 1", got)
+	}
