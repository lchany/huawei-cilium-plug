diff --git a/pkg/huaweicloud/neighbor/registry.go b/pkg/huaweicloud/neighbor/registry.go
new file mode 100644
index 000000000..de4cef1c4
--- /dev/null
+++ b/pkg/huaweicloud/neighbor/registry.go
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+// Package neighbor tracks HuaweiCloud gateway neighbors that are currently
+// owned by the Sub-ENI endpoint manager. The datapath cleanup code uses this
+// registry to distinguish current HuaweiCloud entries from stale Cilium
+// neighbors. The kernel extern-learned flag alone is not an ownership marker.
+package neighbor
+
+import (
+	"net"
+	"strings"
+	"sync"
+)
+
+// Key identifies one HuaweiCloud gateway neighbor on one link.
+type Key struct {
+	LinkName string
+	IPv4     string
+	MAC      string
+}
+
+// NewKey normalizes an IPv4/MAC pair and rejects incomplete entries.
+func NewKey(linkName string, ip net.IP, mac net.HardwareAddr) (Key, bool) {
+	ipv4 := ip.To4()
+	if linkName == "" || ipv4 == nil || len(mac) == 0 {
+		return Key{}, false
+	}
+	return Key{
+		LinkName: linkName,
+		IPv4:     ipv4.String(),
+		MAC:      strings.ToLower(mac.String()),
+	}, true
+}
+
+// Registry contains the current desired HuaweiCloud gateway neighbors.
+type Registry struct {
+	mu    sync.RWMutex
+	keys  map[Key]struct{}
+	stale map[Key]struct{}
+	ready bool
+}
+
+// NewRegistry creates an empty registry.
+func NewRegistry() *Registry {
+	return &Registry{keys: make(map[Key]struct{}), stale: make(map[Key]struct{})}
+}
+
+// Replace atomically replaces the desired set.
+func (r *Registry) Replace(keys []Key) {
+	next := make(map[Key]struct{}, len(keys))
+	for _, key := range keys {
+		if key.LinkName == "" || key.IPv4 == "" || key.MAC == "" {
+			continue
+		}
+		next[key] = struct{}{}
+	}
+	r.mu.Lock()
+	for key := range r.keys {
+		if _, stillDesired := next[key]; !stillDesired {
+			r.stale[key] = struct{}{}
+		}
+	}
+	r.keys = next
+	for key := range next {
+		delete(r.stale, key)
+	}
+	r.ready = true
+	r.mu.Unlock()
+}
+
+// Contains reports whether the exact link/IP/MAC tuple is desired.
+func (r *Registry) Contains(linkName string, ip net.IP, mac net.HardwareAddr) bool {
+	key, ok := NewKey(linkName, ip, mac)
+	if !ok {
+		return false
+	}
+	r.mu.RLock()
+	_, found := r.keys[key]
+	r.mu.RUnlock()
+	return found
+}
+
+// Snapshot returns a copy of the desired set.
+func (r *Registry) Snapshot() []Key {
+	r.mu.RLock()
+	keys := make([]Key, 0, len(r.keys))
+	for key := range r.keys {
+		keys = append(keys, key)
+	}
+	r.mu.RUnlock()
+	return keys
+}
+
+// StaleSnapshot returns exact entries that were previously desired but are no
+// longer associated with an endpoint. Callers should remove only these keys.
+func (r *Registry) StaleSnapshot() []Key {
+	r.mu.RLock()
+	keys := make([]Key, 0, len(r.stale))
+	for key := range r.stale {
+		keys = append(keys, key)
+	}
+	r.mu.RUnlock()
+	return keys
+}
+
+// ForgetStale acknowledges entries that have been removed or are no longer
+// present in the kernel.
+func (r *Registry) ForgetStale(keys []Key) {
+	r.mu.Lock()
+	for _, key := range keys {
+		delete(r.stale, key)
+	}
+	r.mu.Unlock()
+}
+
+// Clear removes all desired entries.
+func (r *Registry) Clear() {
+	r.mu.Lock()
+	r.keys = make(map[Key]struct{})
+	r.stale = make(map[Key]struct{})
+	r.ready = false
+	r.mu.Unlock()
+}
+
+// Ready reports whether the endpoint manager has published its initial
+// desired set. An empty but published set is ready.
+func (r *Registry) Ready() bool {
+	r.mu.RLock()
+	ready := r.ready
+	r.mu.RUnlock()
+	return ready
+}
+
+// Default is the process-wide registry shared by HuaweiCloud endpoint and
+// datapath cleanup code.
+var Default = NewRegistry()
