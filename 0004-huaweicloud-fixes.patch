+func (s *huaweiCloudSubENISubscriber) refreshGatewayNeighborOwnership() {
+	s.cacheMutex.RLock()
+	keys := make([]huaweiCloudNeighbor.Key, 0, len(s.cache))
+	for _, cached := range s.cache {
+		info, ok := cached.(*huaweiCloudEndpointInfo)
+		if !ok || info == nil || info.gatewayIP == nil || len(info.gatewayMAC) == 0 {
+			continue
+		}
+		if key, ok := huaweiCloudNeighbor.NewKey(info.trunkInterface, info.gatewayIP, info.gatewayMAC); ok {
+			keys = append(keys, key)
+		}
+	}
+	s.cacheMutex.RUnlock()
+	huaweiCloudNeighbor.Default.Replace(keys)
+}
+
+func (s *huaweiCloudSubENISubscriber) reconcileGatewayNeighbors() error {
+	stale := huaweiCloudNeighbor.Default.StaleSnapshot()
+	removed := make([]huaweiCloudNeighbor.Key, 0, len(stale))
+	for _, key := range stale {
+		link, err := netlink.LinkByName(key.LinkName)
+		if err != nil {
+			if _, ok := err.(netlink.LinkNotFoundError); ok {
+				removed = append(removed, key)
+				continue
+			}
+			return fmt.Errorf("resolve trunk interface %s: %w", key.LinkName, err)
+		}
+		neighbors, err := netlink.NeighList(link.Attrs().Index, netlink.FAMILY_V4)
+		if err != nil {
+			return fmt.Errorf("list gateway neighbors on trunk interface %s: %w", key.LinkName, err)
+		}
+		found := false
+		for _, neighbor := range neighbors {
+			if !huaweiCloudNeighbor.Default.Contains(key.LinkName, neighbor.IP, neighbor.HardwareAddr) &&
+				neighbor.IP.String() == key.IPv4 && strings.EqualFold(neighbor.HardwareAddr.String(), key.MAC) {
+				found = true
+				if neighbor.State&netlink.NUD_PERMANENT != 0 && neighbor.Flags&netlink.NTF_EXT_LEARNED != 0 {
+					if err := netlink.NeighDel(&neighbor); err != nil {
+						return fmt.Errorf("remove stale HuaweiCloud gateway neighbor %s on %s: %w", neighbor.IP, key.LinkName, err)
+					}
+				}
+				break
+			}
+		}
+		if !found {
+			removed = append(removed, key)
+		}
+	}
+	huaweiCloudNeighbor.Default.ForgetStale(removed)
+	return nil
+}
