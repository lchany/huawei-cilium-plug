+func TestFillSubENIsGatewayInfoBatchesListPortsWithSDKFields(t *testing.T) {
+	portRequests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if !strings.Contains(r.URL.Path, "ports") {
+			t.Fatalf("unexpected path %s", r.URL.Path)
+		}
+		portRequests++
+		query := r.URL.Query()
+		if query.Get("limit") != "" || query.Get("marker") != "" {
+			t.Fatalf("ListPorts request used unsupported pagination fields: %s", r.URL.RawQuery)
+		}
+		if got := query["device_owner"]; len(got) != 1 || got[0] != "network:router_interface_distributed" {
+			t.Fatalf("unexpected device_owner query: %v", got)
+		}
+		if got := query["virsubnet_id"]; len(got) != 1 || got[0] != "subnet-1" {
+			t.Fatalf("unexpected virsubnet_id query: %v", got)
+		}
+		if got := query["private_ips"]; len(got) != 1 || got[0] != "ip_address=10.0.0.1" {
+			t.Fatalf("unexpected private_ips query: %v", got)
+		}
+		_, _ = fmt.Fprint(w, `{"ports":[{"virsubnet_id":"subnet-1","mac_address":"fa:16:3e:00:00:fe","private_ips":[{"ip_address":"10.0.0.1"}]}]}`)
+	}))
+	defer server.Close()
+
+	client := newTestClient(t, server.URL)
+	subENIs := []*eniTypes.SubENI{
+		{ID: "eni-1", SubnetID: "subnet-1", PrivateIPAddress: "10.0.0.2", MACAddress: "fa:16:3e:00:00:01", VlanID: 1, ParentID: "port-1"},
+		{ID: "eni-2", SubnetID: "subnet-1", PrivateIPAddress: "10.0.0.3", MACAddress: "fa:16:3e:00:00:02", VlanID: 2, ParentID: "port-1"},
+		{ID: "eni-3", SubnetID: "subnet-1", PrivateIPAddress: "10.0.0.4", MACAddress: "fa:16:3e:00:00:03", VlanID: 3, ParentID: "port-1"},
+	}
+	if err := client.fillSubENIsGatewayInfo(context.Background(), subENIs, testSubnetMap(t, "subnet-1", "10.0.0.1", "10.0.0.0/24")); err != nil {
+		t.Fatal(err)
+	}
+	if portRequests != 1 {
+		t.Fatalf("ListPorts requests=%d, want 1", portRequests)
+	}
+	for _, subENI := range subENIs {
+		if subENI.GatewayMAC != "fa:16:3e:00:00:fe" || subENI.GatewayIP != "10.0.0.1" || subENI.SubnetCIDR != "10.0.0.0/24" {
+			t.Fatalf("subENI gateway was not filled from batch lookup: %#v", subENI)
+		}
+	}
+}
