+func TestFillSubENIsGatewayInfoBatchesVirsubnetFallback(t *testing.T) {
+	virsubnetRequests := 0
+	portRequests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case strings.Contains(r.URL.Path, "virsubnets"):
+			virsubnetRequests++
+			query := r.URL.Query()
+			if got := query.Get("limit"); got != "2000" {
+				t.Fatalf("unexpected ListVirsubnets limit %q", got)
+			}
+			ids := strings.Join(query["id"], ",")
+			if !strings.Contains(ids, "subnet-1") || !strings.Contains(ids, "subnet-2") {
+				t.Fatalf("unexpected ListVirsubnets id query: %v", query["id"])
+			}
+			_, _ = fmt.Fprint(w, `{"virsubnets":[
+				{"id":"subnet-1","subnet_cidrs":[{"ip_version":"4","cidr":"10.0.0.0/24","gateway_ip":"10.0.0.1"}]},
+				{"id":"subnet-2","subnet_cidrs":[{"ip_version":"4","cidr":"10.0.1.0/24","gateway_ip":"10.0.1.1"}]}
+			]}`)
+		case strings.Contains(r.URL.Path, "ports"):
+			portRequests++
+			query := r.URL.Query()
+			if query.Get("limit") != "" || query.Get("marker") != "" {
+				t.Fatalf("ListPorts request used unsupported pagination fields: %s", r.URL.RawQuery)
+			}
+			_, _ = fmt.Fprint(w, `{"ports":[
+				{"virsubnet_id":"subnet-1","mac_address":"fa:16:3e:00:00:01","private_ips":[{"ip_address":"10.0.0.1"}]},
+				{"virsubnet_id":"subnet-2","mac_address":"fa:16:3e:00:00:02","private_ips":[{"ip_address":"10.0.1.1"}]}
+			]}`)
+		default:
+			t.Fatalf("unexpected path %s", r.URL.Path)
+		}
+	}))
+	defer server.Close()
+
+	client := newTestClient(t, server.URL)
+	subENIs := []*eniTypes.SubENI{
+		{ID: "eni-1", SubnetID: "subnet-1", PrivateIPAddress: "10.0.0.2", MACAddress: "fa:16:3e:00:00:11", VlanID: 1, ParentID: "port-1"},
+		{ID: "eni-2", SubnetID: "subnet-2", PrivateIPAddress: "10.0.1.2", MACAddress: "fa:16:3e:00:00:12", VlanID: 2, ParentID: "port-2"},
+	}
+	if err := client.fillSubENIsGatewayInfo(context.Background(), subENIs, nil); err != nil {
+		t.Fatal(err)
+	}
+	if virsubnetRequests != 1 || portRequests != 1 {
+		t.Fatalf("virsubnetRequests=%d portRequests=%d, want 1/1", virsubnetRequests, portRequests)
+	}
+	if subENIs[0].GatewayMAC != "fa:16:3e:00:00:01" || subENIs[1].GatewayMAC != "fa:16:3e:00:00:02" {
+		t.Fatalf("unexpected gateway MACs: %#v", subENIs)
+	}
+}
