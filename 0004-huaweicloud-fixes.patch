+func (c *Client) listVirsubnetsByID(ctx context.Context, subnetIDs []string) (map[string]vpcmodel.Virsubnet, error) {
+	result := make(map[string]vpcmodel.Virsubnet, len(subnetIDs))
+	for start := 0; start < len(subnetIDs); start += 2000 {
+		end := start + 2000
+		if end > len(subnetIDs) {
+			end = len(subnetIDs)
+		}
+		ids := append([]string(nil), subnetIDs[start:end]...)
+		limit := int32(2000)
+		request := &vpcmodel.ListVirsubnetsRequest{Limit: &limit, Id: &ids}
+		seenMarkers := map[string]struct{}{}
+		for {
+			if err := ctx.Err(); err != nil {
+				return nil, err
+			}
+			if err := c.limiter.Limit(ctx, "ListVirsubnets"); err != nil {
+				return nil, err
+			}
+			response, err := c.vpcClient.ListVirsubnets(request)
+			if err != nil {
+				return nil, normalizeAPIError(err)
+			}
+			if response.Virsubnets != nil {
+				for _, item := range *response.Virsubnets {
+					result[item.Id] = item
+				}
+			}
+			marker, err := nextUniqueMarker(response.PageInfo, seenMarkers, "ListVirsubnets")
+			if err != nil {
+				return nil, err
+			}
+			request.Marker = marker
+			if marker == nil {
+				break
+			}
 		}
 	}
-	subENI.GatewayMAC = gatewayMAC
-	return nil
+	return result, nil
+}
+
+func (c *Client) listGatewayMACs(ctx context.Context, keys []subENIGatewayKey) (map[subENIGatewayKey]string, error) {
+	result := make(map[subENIGatewayKey]string, len(keys))
+	deviceOwners := []string{"network:router_interface_distributed"}
+
+	for start := 0; start < len(keys); start += gatewayLookupBatchSize {
+		end := start + gatewayLookupBatchSize
+		if end > len(keys) {
+			end = len(keys)
+		}
+		batch := keys[start:end]
+		expected := make(map[subENIGatewayKey]struct{}, len(batch))
+		virsubnetSet := map[string]struct{}{}
+		privateIPSet := map[string]struct{}{}
+		for _, key := range batch {
+			expected[key] = struct{}{}
+			virsubnetSet[key.subnetID] = struct{}{}
+			privateIPSet[fmt.Sprintf("ip_address=%s", key.gatewayIP)] = struct{}{}
+		}
+		virsubnetIDs := sortedKeys(virsubnetSet)
+		privateIPs := sortedKeys(privateIPSet)
+		request := &vpcmodel.ListPortsRequest{
+			DeviceOwner: &deviceOwners,
+			PrivateIps:  &privateIPs,
+			VirsubnetId: &virsubnetIDs,
+		}
+
+		if err := c.limiter.Limit(ctx, "ListPorts"); err != nil {
+			return nil, err
+		}
+		response, err := c.vpcClient.ListPorts(request)
+		if err != nil {
+			return nil, normalizeAPIError(err)
+		}
+		if response.Ports == nil {
+			continue
+		}
+		for _, port := range *response.Ports {
+			for _, privateIP := range port.PrivateIps {
+				key := subENIGatewayKey{subnetID: port.VirsubnetId, gatewayIP: privateIP.IpAddress}
+				if _, ok := expected[key]; !ok {
+					continue
+				}
+				gatewayMAC := strings.TrimSpace(port.MacAddress)
+				if gatewayMAC == "" {
+					return nil, fmt.Errorf("router port has empty MAC for subnet %s gateway %s", key.subnetID, key.gatewayIP)
+				}
+				if existing, ok := result[key]; ok && !strings.EqualFold(existing, gatewayMAC) {
+					return nil, fmt.Errorf("multiple router ports have conflicting MACs for subnet %s gateway %s", key.subnetID, key.gatewayIP)
+				}
+				result[key] = gatewayMAC
+			}
+		}
+	}
+
+	return result, nil
 }
 
