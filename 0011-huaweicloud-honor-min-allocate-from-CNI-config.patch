From: lchany <lchany@users.noreply.github.com>
Date: Mon, 13 Jul 2026 20:57:59 +0800
Subject: [PATCH] huaweicloud: honor min-allocate from CNI config

---
 pkg/nodediscovery/huaweicloud_test.go | 16 ++++++++++++++++
 pkg/nodediscovery/nodediscovery.go    | 17 ++++++++++++++---
 2 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/pkg/nodediscovery/huaweicloud_test.go b/pkg/nodediscovery/huaweicloud_test.go
index 7112a0647..240d2ec8d 100644
--- a/pkg/nodediscovery/huaweicloud_test.go
+++ b/pkg/nodediscovery/huaweicloud_test.go
@@ -8,8 +8,24 @@ import (
 	"testing"
 
 	huaweiCloudTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+	ipamTypes "github.com/cilium/cilium/pkg/ipam/types"
 )
 
+func TestApplyHuaweiCloudIPAMNetConf(t *testing.T) {
+	dst := &ipamTypes.IPAMSpec{MinAllocate: 2, PreAllocate: 1}
+	applyHuaweiCloudIPAMNetConf(dst, ipamTypes.IPAMSpec{MinAllocate: 10, PreAllocate: 4})
+	if dst.MinAllocate != 10 || dst.PreAllocate != 4 {
+		t.Fatalf("CNI IPAM watermarks were not applied: %+v", dst)
+	}
+
+	applyHuaweiCloudIPAMNetConf(dst, ipamTypes.IPAMSpec{})
+	if dst.MinAllocate != 10 || dst.PreAllocate != 4 {
+		t.Fatalf("empty CNI IPAM watermarks overwrote existing values: %+v", dst)
+	}
+
+	applyHuaweiCloudIPAMNetConf(nil, ipamTypes.IPAMSpec{MinAllocate: 20, PreAllocate: 8})
+}
+
 func TestApplyHuaweiCloudNetConf(t *testing.T) {
 	dst := &huaweiCloudTypes.Spec{
 		Subnets:        []string{"subnet-from-agent"},
diff --git a/pkg/nodediscovery/nodediscovery.go b/pkg/nodediscovery/nodediscovery.go
index d08d2e4db..8a9880de8 100644
--- a/pkg/nodediscovery/nodediscovery.go
+++ b/pkg/nodediscovery/nodediscovery.go
@@ -31,6 +31,7 @@ import (
 	"github.com/cilium/cilium/pkg/identity"
 	"github.com/cilium/cilium/pkg/ipam"
 	ipamOption "github.com/cilium/cilium/pkg/ipam/option"
+	ipamTypes "github.com/cilium/cilium/pkg/ipam/types"
 	"github.com/cilium/cilium/pkg/k8s"
 	ciliumv2 "github.com/cilium/cilium/pkg/k8s/apis/cilium.io/v2"
 	k8sTypes "github.com/cilium/cilium/pkg/k8s/slim/k8s/api/core/v1"
@@ -783,15 +784,25 @@ func (n *NodeDiscovery) mutateNodeResource(nodeResource *ciliumv2.CiliumNode) er
 		}
 		if c := n.NetConf; c != nil {
 			applyHuaweiCloudNetConf(nodeResource.Spec.HuaweiCloud, c.HuaweiCloud)
-			if c.IPAM.PreAllocate != 0 {
-				nodeResource.Spec.IPAM.PreAllocate = c.IPAM.PreAllocate
-			}
+			applyHuaweiCloudIPAMNetConf(&nodeResource.Spec.IPAM, c.IPAM.IPAMSpec)
 		}
 	}
 
 	return nil
 }
 
+func applyHuaweiCloudIPAMNetConf(dst *ipamTypes.IPAMSpec, src ipamTypes.IPAMSpec) {
+	if dst == nil {
+		return
+	}
+	if src.MinAllocate != 0 {
+		dst.MinAllocate = src.MinAllocate
+	}
+	if src.PreAllocate != 0 {
+		dst.PreAllocate = src.PreAllocate
+	}
+}
+
 func applyHuaweiCloudNetConf(dst *huaweiCloudTypes.Spec, src huaweiCloudTypes.Spec) {
 	if dst == nil {
 		return
