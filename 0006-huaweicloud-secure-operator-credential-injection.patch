+func TestLogRegisteredSlogOptionsRedactsSecrets(t *testing.T) {
+	const secretOption = "test-secret-option"
+	const secretValue = "must-not-appear-in-logs"
+
+	MarkSecretOption(secretOption)
+	vp := viper.New()
+	vp.Set(secretOption, secretValue)
+	vp.Set("test-visible-option", "visible")
+
+	var output bytes.Buffer
+	LogRegisteredSlogOptions(vp, slog.New(slog.NewTextHandler(&output, nil)))
+
+	got := output.String()
+	assert.NotContains(t, got, secretValue)
+	assert.Contains(t, got, "test-secret-option")
+	assert.Contains(t, got, "<redacted>")
+	assert.True(t, strings.Contains(got, "test-visible-option") && strings.Contains(got, "visible"))
+}
