+// MarkSecretOption prevents the value of optName from being written to the
+// startup configuration log. The option remains available to Viper and to the
+// application exactly as before.
+func MarkSecretOption(optName string) {
+	secretOptions.Store(strings.ToLower(optName), struct{}{})
+}
+
+func isSecretOption(optName string) bool {
+	_, ok := secretOptions.Load(strings.ToLower(optName))
+	return ok
+}
+
 // LogRegisteredSlogOptions logs all options that where bound to viper.
