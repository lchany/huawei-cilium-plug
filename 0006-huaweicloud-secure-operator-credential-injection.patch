+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+//go:build ipam_provider_huaweicloud
+
+package cmd
+
+import (
+	"testing"
+
+	"github.com/spf13/cobra"
+	"github.com/spf13/viper"
+	"github.com/stretchr/testify/require"
+
+	operatorOption "github.com/cilium/cilium/operator/option"
+)
+
+func TestHuaweiCloudFlagsAcceptSecretEnvironment(t *testing.T) {
+	t.Setenv("HUAWEI_CLOUD_ACCESS_KEY", "legacy-access-key")
+	t.Setenv("HUAWEI_CLOUD_SECRET_KEY", "legacy-secret-key")
+	t.Setenv("HUAWEI_CLOUD_PROJECT_ID", "legacy-project")
+	t.Setenv("HUAWEI_CLOUD_REGION", "legacy-region")
+	t.Setenv("HUAWEI_CLOUD_VPC_ID", "legacy-vpc")
+
+	vp := viper.New()
+	new(huaweicloudFlagsHooks).RegisterProviderFlag(&cobra.Command{Use: "test"}, vp)
+
+	require.Equal(t, "legacy-access-key", vp.GetString(operatorOption.HuaweiCloudAccessKey))
+	require.Equal(t, "legacy-secret-key", vp.GetString(operatorOption.HuaweiCloudSecretKey))
+	require.Equal(t, "legacy-project", vp.GetString(operatorOption.HuaweiCloudProjectID))
+	require.Equal(t, "legacy-region", vp.GetString(operatorOption.HuaweiCloudRegion))
+	require.Equal(t, "legacy-vpc", vp.GetString(operatorOption.HuaweiCloudVPCID))
+}
+
+func TestHuaweiCloudFlagsPreferCiliumEnvironment(t *testing.T) {
+	t.Setenv("HUAWEI_CLOUD_ACCESS_KEY", "legacy-access-key")
+	t.Setenv("CILIUM_HUAWEI_CLOUD_ACCESS_KEY", "cilium-access-key")
+
+	vp := viper.New()
+	new(huaweicloudFlagsHooks).RegisterProviderFlag(&cobra.Command{Use: "test"}, vp)
+
+	require.Equal(t, "cilium-access-key", vp.GetString(operatorOption.HuaweiCloudAccessKey))
+}
