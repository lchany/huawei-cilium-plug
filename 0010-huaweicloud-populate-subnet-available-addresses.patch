+func newIPAMSubnet(item vpcmodel.Virsubnet, availableAddresses int) (*ipamTypes.Subnet, error) {
+	if availableAddresses < 0 {
+		return nil, fmt.Errorf("invalid available address count %d for subnet %s", availableAddresses, item.Id)
+	}
+
+	gatewayIP, subnetCIDR := selectIPv4SubnetCIDRAndGateway(item.SubnetCidrs, "")
+	subnet := &ipamTypes.Subnet{
+		ID:                 item.Id,
+		Name:               item.Name,
+		VirtualNetworkID:   item.VpcId,
+		AvailabilityZone:   item.ZoneId,
+		GatewayIP:          gatewayIP,
+		AvailableAddresses: availableAddresses,
+		Tags:               parseResponseTags(item.Tags),
+	}
+	if _, parsedCIDR, err := net.ParseCIDR(subnetCIDR); err == nil {
+		subnet.CIDR = cidr.NewCIDR(parsedCIDR)
+	}
+	return subnet, nil
+}
