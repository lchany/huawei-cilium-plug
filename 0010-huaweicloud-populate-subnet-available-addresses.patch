diff --git a/pkg/huaweicloud/api/subnet_capacity.go b/pkg/huaweicloud/api/subnet_capacity.go
new file mode 100644
index 00000000..4b57d0ac
--- /dev/null
+++ b/pkg/huaweicloud/api/subnet_capacity.go
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package api
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+
+	"github.com/huaweicloud/huaweicloud-sdk-go-v3/core/def"
+)
+
+type listSubnetsV2Request struct {
+	Limit  *int32  `json:"limit,omitempty"`
+	Marker *string `json:"marker,omitempty"`
+	VPCID  *string `json:"vpc_id,omitempty"`
+}
+
+type listSubnetsV2Response struct {
+	Subnets        *[]subnetCapacity `json:"subnets,omitempty"`
+	HttpStatusCode int               `json:"-"`
+}
+
+type subnetCapacity struct {
+	ID                      string `json:"id"`
+	AvailableIPAddressCount int32  `json:"available_ip_address_count"`
+}
+
+func listSubnetsV2RequestDef() *def.HttpRequestDef {
+	builder := def.NewHttpRequestDefBuilder().
+		WithMethod(http.MethodGet).
+		WithPath("/v1/{project_id}/subnets").
+		WithResponse(new(listSubnetsV2Response)).
+		WithContentType("application/json")
+	builder.WithRequestField(def.NewFieldDef().
+		WithName("Limit").
+		WithJsonTag("limit").
+		WithLocationType(def.Query))
+	builder.WithRequestField(def.NewFieldDef().
+		WithName("Marker").
+		WithJsonTag("marker").
+		WithLocationType(def.Query))
+	builder.WithRequestField(def.NewFieldDef().
+		WithName("VPCID").
+		WithJsonTag("vpc_id").
+		WithLocationType(def.Query))
+	return builder.Build()
+}
+
+func (c *Client) getSubnetAvailableAddresses(ctx context.Context, vpcID string) (map[string]int, error) {
+	const pageSize = int32(2000)
+	request := &listSubnetsV2Request{Limit: int32Ptr(pageSize)}
+	if vpcID != "" {
+		request.VPCID = stringPtr(vpcID)
+	}
+
+	result := map[string]int{}
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		c.limiter.Limit(ctx, "ListSubnets")
+		responseValue, err := c.vpcClient.HcClient.Sync(request, listSubnetsV2RequestDef())
+		if err != nil {
+			return nil, normalizeAPIError(err)
+		}
+		response, ok := responseValue.(*listSubnetsV2Response)
+		if !ok || response == nil {
+			return nil, fmt.Errorf("unexpected ListSubnets response type %T", responseValue)
+		}
+
+		var subnets []subnetCapacity
+		if response.Subnets != nil {
+			subnets = *response.Subnets
+		}
+		for _, subnet := range subnets {
+			if subnet.ID == "" {
+				return nil, fmt.Errorf("ListSubnets returned an empty subnet ID")
+			}
+			if subnet.AvailableIPAddressCount < 0 {
+				return nil, fmt.Errorf("invalid available address count %d for subnet %s", subnet.AvailableIPAddressCount, subnet.ID)
+			}
+			result[subnet.ID] = int(subnet.AvailableIPAddressCount)
+		}
+
+		if len(subnets) < int(pageSize) {
+			return result, nil
+		}
+		marker := subnets[len(subnets)-1].ID
+		request.Marker = &marker
+	}
+}
+
+func int32Ptr(value int32) *int32 { return &value }
+
+func stringPtr(value string) *string { return &value }
diff --git a/pkg/huaweicloud/api/subnet_capacity_test.go b/pkg/huaweicloud/api/subnet_capacity_test.go
