+
+func TestListSubnetsV2ResponseDecodesAvailableAddresses(t *testing.T) {
+	var response listSubnetsV2Response
+	err := json.Unmarshal([]byte(`{
+		"subnets": [
+			{"id": "subnet-empty", "available_ip_address_count": 0},
+			{"id": "subnet-ready", "available_ip_address_count": 37}
+		]
+	}`), &response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if response.Subnets == nil || len(*response.Subnets) != 2 {
+		t.Fatalf("unexpected subnets response: %#v", response.Subnets)
+	}
+	if got := (*response.Subnets)[0].AvailableIPAddressCount; got != 0 {
+		t.Fatalf("unexpected empty subnet capacity: %d", got)
+	}
+	if got := (*response.Subnets)[1].AvailableIPAddressCount; got != 37 {
+		t.Fatalf("available address count was not decoded: %d", got)
+	}
+}
+
+func TestGetSubnetAvailableAddressesUsesV2SubnetAPI(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/v1/project-1/subnets" {
+			t.Errorf("unexpected request path: %s", r.URL.Path)
+			http.NotFound(w, r)
+			return
+		}
+		if got := r.URL.Query().Get("vpc_id"); got != "vpc-1" {
+			t.Errorf("unexpected vpc_id: %q", got)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = fmt.Fprint(w, `{
+			"subnets": [
+				{"id": "subnet-empty", "available_ip_address_count": 0},
+				{"id": "subnet-ready", "available_ip_address_count": 37}
+			]
+		}`)
+	}))
+	defer server.Close()
+
+	client := newTestClient(t, server.URL)
+
+	got, err := client.getSubnetAvailableAddresses(context.Background(), "vpc-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got["subnet-empty"] != 0 || got["subnet-ready"] != 37 || len(got) != 2 {
+		t.Fatalf("unexpected available address map: %#v", got)
+	}
+}
+
+func TestGetSubnetsPopulatesAvailableAddresses(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/v1/project-1/subnets":
+			_, _ = fmt.Fprint(w, `{
+				"subnets": [
+					{"id": "subnet-empty", "available_ip_address_count": 0},
+					{"id": "subnet-ready", "available_ip_address_count": 37}
+				]
+			}`)
+		case "/v3/project-1/vpc/virsubnets":
+			_, _ = fmt.Fprint(w, `{
+				"virsubnets": [
+					{"id": "subnet-empty", "name": "empty", "vpc_id": "vpc-1", "zone_id": "az-1", "subnet_cidrs": []},
+					{"id": "subnet-ready", "name": "ready", "vpc_id": "vpc-1", "zone_id": "az-1", "subnet_cidrs": [{"ip_version": "4", "cidr": "10.0.0.0/24", "gateway_ip": "10.0.0.1"}]}
+				]
+			}`)
+		default:
+			t.Errorf("unexpected request path: %s", r.URL.Path)
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+
+	client := newTestClient(t, server.URL)
+	subnets, err := client.GetSubnets(context.Background(), "vpc-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if subnets["subnet-empty"].AvailableAddresses != 0 {
+		t.Fatalf("unexpected empty subnet capacity: %#v", subnets["subnet-empty"])
+	}
+	if subnets["subnet-ready"].AvailableAddresses != 37 {
+		t.Fatalf("available addresses were not populated: %#v", subnets["subnet-ready"])
+	}
+}
+
+func newTestClient(t *testing.T, endpoint string) *Client {
+	t.Helper()
+	credentials, err := auth.NewBasicCredentialsBuilder().
+		WithAk("test-ak").
+		WithSk("test-sk").
+		WithProjectId("project-1").
+		SafeBuild()
+	if err != nil {
+		t.Fatal(err)
+	}
+	hcClient, err := hwVPC.VpcClientBuilder().
+		WithEndpoint(endpoint).
+		WithCredential(credentials).
+		SafeBuild()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &Client{
+		vpcClient: hwVPC.NewVpcClient(hcClient),
+		limiter:   helpers.NewApiLimiter(noOpRateLimitMetrics{}, 20, 40),
+	}
+}
+
+func TestNewIPAMSubnetSetsAvailableAddresses(t *testing.T) {
+	item := vpcmodel.Virsubnet{
+		Id:     "subnet-1",
+		Name:   "pod-subnet",
+		VpcId:  "vpc-1",
+		ZoneId: "az-1",
+		SubnetCidrs: []vpcmodel.SubnetCidr{{
+			IpVersion: "4",
+			Cidr:      "10.0.0.0/24",
+			GatewayIp: "10.0.0.1",
+		}},
+	}
+
+	subnet, err := newIPAMSubnet(item, 23)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if subnet.AvailableAddresses != 23 {
+		t.Fatalf("unexpected available addresses: %d", subnet.AvailableAddresses)
+	}
+	if subnet.ID != item.Id || subnet.VirtualNetworkID != item.VpcId || subnet.AvailabilityZone != item.ZoneId {
+		t.Fatalf("unexpected subnet conversion: %#v", subnet)
+	}
+	if subnet.CIDR == nil || subnet.CIDR.String() != "10.0.0.0/24" || subnet.GatewayIP != "10.0.0.1" {
+		t.Fatalf("unexpected IPv4 metadata: %#v", subnet)
+	}
+}
+
+func TestNewIPAMSubnetRejectsNegativeAvailableAddresses(t *testing.T) {
+	if _, err := newIPAMSubnet(vpcmodel.Virsubnet{Id: "subnet-1"}, -1); err == nil {
+		t.Fatal("expected negative available address count to be rejected")
+	}
+}
