+func TestFindOneSubnetRejectsInsufficientCapacityAndSelectsMostAvailable(t *testing.T) {
+	api := mock.NewAPI(
+		[]*ipamTypes.Subnet{
+			{ID: "subnet-empty", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 0},
+			{ID: "subnet-small", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 2},
+			{ID: "subnet-ready", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 5},
+			{ID: "subnet-best", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-1", AvailableAddresses: 12},
+			{ID: "subnet-other-az", VirtualNetworkID: "vpc-1", AvailabilityZone: "az-2", AvailableAddresses: 100},
+		},
+		[]*ipamTypes.VirtualNetwork{{ID: "vpc-1"}}, nil,
+	)
+	manager := NewInstancesManager(api, "vpc-1", nil)
+	if manager.Resync(context.Background()).IsZero() {
+		t.Fatal("resync failed")
+	}
+
+	got := manager.FindOneSubnet(eniTypes.Spec{VPCID: "vpc-1", AvailabilityZone: "az-1"}, 3)
+	if got == nil || got.ID != "subnet-best" {
+		t.Fatalf("expected subnet-best, got %#v", got)
+	}
+
+	got = manager.FindOneSubnet(eniTypes.Spec{
+		VPCID:            "vpc-1",
+		AvailabilityZone: "az-1",
+		Subnets:          []string{"subnet-empty", "subnet-small"},
+	}, 3)
+	if got != nil {
+		t.Fatalf("expected no explicit subnet with sufficient capacity, got %#v", got)
+	}
+}
