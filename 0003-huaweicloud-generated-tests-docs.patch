+	require.NoError(t, err)
+	assert.Equal(t, 2, len(alloc))
+	assert.Contains(t, alloc, "10.0.0.100")
+	assert.Contains(t, alloc, "10.0.0.101")
+	assert.Equal(t, 8, st.NodeCapacity)
+	assert.Equal(t, 6, st.RemainingAvailableInterfaceCount)
