+func (f *fakeNodeResource) Store(context.Context) (resource.Store[*ciliumv2.CiliumNode], error) {
+	return nil, errors.New("unexpected store call")
+}
+
+type fakeNodeLister struct {
+	nodes []*ciliumv2.CiliumNode
+	err   error
+}
+
+func (f *fakeNodeLister) List(context.Context, metav1.ListOptions) (*ciliumv2.CiliumNodeList, error) {
+	if f.err != nil {
+		return nil, f.err
+	}
+	list := &ciliumv2.CiliumNodeList{}
