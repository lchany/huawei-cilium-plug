+func TestNodeReleaseIPs(t *testing.T) {
+	node, mockAPI := newTestNode(t)
+	seedParentENI(node, "parent-1")
+
+	a := &ipam.AllocationAction{
+		IPv4:                ipam.IPAllocationAction{MaxIPsToAllocate: 2},
+		EmptyInterfaceSlots: 2,
+	}
+
+	created, _, err := node.CreateInterface(context.Background(), a, hivetest.Logger(t))
+	require.NoError(t, err)
+	require.Equal(t, 2, created)
+
+	var releaseID, releaseIP string
+	node.mutex.RLock()
+	for _, subENI := range node.subENIs {
+		if subENI.PrivateIPAddress != "" {
+			releaseID = subENI.ID
+			releaseIP = subENI.PrivateIPAddress
+			break
+		}
+	}
+	node.mutex.RUnlock()
+	require.NotEmpty(t, releaseID)
+	require.NotEmpty(t, releaseIP)
+
+	err = node.ReleaseIPs(context.Background(), &ipam.ReleaseAction{IPsToRelease: []string{releaseIP}})
+	require.NoError(t, err)
+
+	_, showErr := mockAPI.GetSubNetworkInterface(context.Background(), releaseID)
+	assert.Error(t, showErr)
+
+	node.mutex.RLock()
+	_, exists := node.subENIs[releaseID]
+	node.mutex.RUnlock()
+	assert.False(t, exists)
+}
