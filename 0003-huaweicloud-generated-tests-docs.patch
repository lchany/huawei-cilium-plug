+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package endpointmanager
+
+import (
+	"net"
+	"testing"
+
+	huaweiCloudTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+	cilium_v2 "github.com/cilium/cilium/pkg/k8s/apis/cilium.io/v2"
+	"github.com/stretchr/testify/require"
+)
+
+type fakeSubENIEndpoint struct {
+	ipv4    string
+	id      uint64
+	ifIndex int
+}
+
+func (e fakeSubENIEndpoint) GetIPv4Address() string { return e.ipv4 }
+func (e fakeSubENIEndpoint) GetID() uint64          { return e.id }
+func (e fakeSubENIEndpoint) GetIfIndex() int        { return e.ifIndex }
+
+func TestSubENIInfoForEndpoint(t *testing.T) {
+	ep := fakeSubENIEndpoint{ipv4: "192.168.0.199", id: 123, ifIndex: 55}
+
+	cn := &cilium_v2.CiliumNode{}
+	cn.Status.HuaweiCloud = &huaweiCloudTypes.ENIStatus{SubENIs: map[string]huaweiCloudTypes.SubENI{
+		"subeni-1": {
+			PrivateIPAddress: "192.168.0.199",
+			MACAddress:       "fa:16:3e:dd:35:fc",
+			GatewayIP:        "192.168.0.254",
+			GatewayMAC:       "fa:16:3e:71:dd:9a",
+			TrunkInterface:   "eth0",
+			VlanID:           3950,
+		},
+	}}
+
+	info, err := subENIInfoForEndpoint(cn, ep)
+	require.NoError(t, err)
+	require.NotNil(t, info)
+	require.Equal(t, "192.168.0.199", info.GetIPv4Address())
+	require.Equal(t, uint32(123), info.GetID())
+	require.Equal(t, uint32(55), info.GetIfIndex())
+	require.Equal(t, int32(3950), info.GetVLANID())
+	require.Equal(t, [6]byte{0xfa, 0x16, 0x3e, 0xdd, 0x35, 0xfc}, info.GetMACAddress())
+	require.Equal(t, net.IPv4(192, 168, 0, 254).To4(), info.gatewayIP.To4())
+	require.Equal(t, net.HardwareAddr{0xfa, 0x16, 0x3e, 0x71, 0xdd, 0x9a}, info.gatewayMAC)
+	require.Equal(t, "eth0", info.trunkInterface)
+}
