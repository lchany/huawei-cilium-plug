+		err := fillCommonAttrs(builder, getCommonAttrsFromEnv())
+		if err != nil {
+			return nil, err
+		}
+		return builder.SafeBuild()
+	}
+
+	return nil, sdkerr.NewCredentialsTypeError("unsupported credential type: " + p.credentialType)
+}
