+		err := json.NewEncoder(w).Encode(map[string]any{
+			"uuid":              "19bd920c-521d-4f36-8a21-2fdfa3825b69",
+			"availability_zone": availabilityZone,
+			"meta": map[string]string{
+				"vpc_id": vpcID,
+			},
+		})
+		require.NoError(t, err)
+	})
+
+	return httptest.NewServer(mux)
+}
