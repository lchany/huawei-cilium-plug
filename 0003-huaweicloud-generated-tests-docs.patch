+	created, errStr, err := node.CreateInterface(context.Background(), a, hivetest.Logger(t))
+	require.Error(t, err)
+	assert.Equal(t, 0, created)
+	assert.Equal(t, unableToCreateSubENI, errStr)
+	assert.Contains(t, err.Error(), "all subnets exhausted")
+}
