+	applyHuaweiCloudTestConfig(t, cfg)
+
+	a := &AllocatorHuaweiCloud{}
+	err := a.Init(context.Background(), hivetest.Logger(t), nil)
+
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "access-key")
+}
+
+func TestInit_MissingSecretKey(t *testing.T) {
+	cfg := validHuaweiCloudTestConfig()
+	cfg.secretKey = ""
+	applyHuaweiCloudTestConfig(t, cfg)
+
+	a := &AllocatorHuaweiCloud{}
+	err := a.Init(context.Background(), hivetest.Logger(t), nil)
+
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "secret-key")
+}
+
+func TestInit_MissingProjectID(t *testing.T) {
+	cfg := validHuaweiCloudTestConfig()
+	cfg.projectID = ""
+	applyHuaweiCloudTestConfig(t, cfg)
+
+	a := &AllocatorHuaweiCloud{}
+	err := a.Init(context.Background(), hivetest.Logger(t), nil)
+
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "project-id")
+}
+
+func TestInit_MissingRegion(t *testing.T) {
+	cfg := validHuaweiCloudTestConfig()
+	cfg.region = ""
+	applyHuaweiCloudTestConfig(t, cfg)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	a := &AllocatorHuaweiCloud{}
+	err := a.Init(ctx, hivetest.Logger(t), nil)
+
+	require.Error(t, err)
+}
+
+func TestInit_AllFieldsSet(t *testing.T) {
+	applyHuaweiCloudTestConfig(t, validHuaweiCloudTestConfig())
+
+	a := &AllocatorHuaweiCloud{}
+	err := a.Init(context.Background(), hivetest.Logger(t), nil)
