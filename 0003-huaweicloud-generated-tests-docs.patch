+	applyHuaweiCloudTestConfig(t, cfg)
+
+	a := &AllocatorHuaweiCloud{}
+	require.NoError(t, a.Init(context.Background(), hivetest.Logger(t), nil))
+
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+
+	handler, err := a.Start(ctx, nil, nil)
+
+	require.NoError(t, err)
+	assert.NotNil(t, handler)
+}
+
+type huaweiCloudTestConfig struct {
+	accessKey string
+	secretKey string
+	projectID string
+	region    string
+	vpcID     string
+	endpoint  string
+}
+
+type huaweiCloudConfigSnapshot struct {
+	accessKey string
+	secretKey string
+	projectID string
+	region    string
+	vpcID     string
+	endpoint  string
+}
+
+func validHuaweiCloudTestConfig() huaweiCloudTestConfig {
+	return huaweiCloudTestConfig{
+		accessKey: "test-ak",
+		secretKey: "test-sk",
+		projectID: "test-project-id",
+		region:    "cn-north-4",
+		vpcID:     "test-vpc-id",
+	}
+}
+
+func applyHuaweiCloudTestConfig(t *testing.T, cfg huaweiCloudTestConfig) {
+	t.Helper()
+
+	snapshot := snapshotHuaweiCloudConfig()
+	t.Cleanup(func() {
+		restoreHuaweiCloudConfig(snapshot)
+	})
+
+	operatorOption.Config.HuaweiCloudAccessKey = cfg.accessKey
+	operatorOption.Config.HuaweiCloudSecretKey = cfg.secretKey
+	operatorOption.Config.HuaweiCloudProjectID = cfg.projectID
+	operatorOption.Config.HuaweiCloudRegion = cfg.region
+	operatorOption.Config.HuaweiCloudVPCID = cfg.vpcID
+	operatorOption.Config.HuaweiCloudEndpoint = cfg.endpoint
+}
+
+func snapshotHuaweiCloudConfig() huaweiCloudConfigSnapshot {
+	return huaweiCloudConfigSnapshot{
+		accessKey: operatorOption.Config.HuaweiCloudAccessKey,
+		secretKey: operatorOption.Config.HuaweiCloudSecretKey,
+		projectID: operatorOption.Config.HuaweiCloudProjectID,
+		region:    operatorOption.Config.HuaweiCloudRegion,
+		vpcID:     operatorOption.Config.HuaweiCloudVPCID,
+		endpoint:  operatorOption.Config.HuaweiCloudEndpoint,
+	}
+}
+
+func restoreHuaweiCloudConfig(snapshot huaweiCloudConfigSnapshot) {
+	operatorOption.Config.HuaweiCloudAccessKey = snapshot.accessKey
+	operatorOption.Config.HuaweiCloudSecretKey = snapshot.secretKey
+	operatorOption.Config.HuaweiCloudProjectID = snapshot.projectID
+	operatorOption.Config.HuaweiCloudRegion = snapshot.region
+	operatorOption.Config.HuaweiCloudVPCID = snapshot.vpcID
+	operatorOption.Config.HuaweiCloudEndpoint = snapshot.endpoint
+}
+
+func assertAllocatorClientInitialized(t *testing.T, allocator *AllocatorHuaweiCloud) {
+	t.Helper()
+
+	clientField := reflect.ValueOf(allocator).Elem().FieldByName("client")
+	require.True(t, clientField.IsValid(), "expected AllocatorHuaweiCloud.client field to exist")
+	require.Equal(t, reflect.Pointer, clientField.Kind(), "expected AllocatorHuaweiCloud.client to be a pointer")
+	assert.False(t, clientField.IsNil(), "expected AllocatorHuaweiCloud.client to be initialized")
+}
+
+func newFakeHuaweiCloudAPIServer(t *testing.T) *httptest.Server {
+	t.Helper()
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+
+		switch {
+		case strings.Contains(r.URL.Path, "/cloudservers/detail"):
+			count := int32(0)
+			servers := []ecsmodel.ServerDetail{}
+			writeJSON(w, ecsmodel.ListServersDetailsResponse{Count: &count, Servers: &servers})
+		case strings.Contains(r.URL.Path, "/sub-network-interfaces"):
+			subNetworkInterfaces := []vpcmodel.SubNetworkInterface{}
+			writeJSON(w, vpcmodel.ListSubNetworkInterfacesResponse{SubNetworkInterfaces: &subNetworkInterfaces})
+		case strings.Contains(r.URL.Path, "/virsubnets"):
+			virsubnets := []vpcmodel.Virsubnet{{
+				Id:     "subnet-1",
+				Name:   "subnet-1",
+				VpcId:  "vpc-1",
+				ZoneId: "cn-north-4a",
+				SubnetCidrs: []vpcmodel.SubnetCidr{{
+					Id:         "subnet-cidr-1",
+					IpVersion:  "4",
+					Cidr:       "10.0.0.0/24",
+					GatewayIp:  "10.0.0.1",
+					EnableDhcp: true,
+				}},
+			}}
+			writeJSON(w, vpcmodel.ListVirsubnetsResponse{Virsubnets: &virsubnets})
+		case strings.Contains(r.URL.Path, "/security-groups"):
+			securityGroups := []vpcmodel.SecurityGroup{{Id: "sg-1", Name: "sg-1"}}
+			writeJSON(w, vpcmodel.ListSecurityGroupsResponse{SecurityGroups: &securityGroups})
+		case strings.HasSuffix(r.URL.Path, "/vpcs"):
+			vpcs := []vpcmodel.Vpc{{Id: "vpc-1", Name: "vpc-1", Cidr: "10.0.0.0/16"}}
+			writeJSON(w, vpcmodel.ListVpcsResponse{Vpcs: &vpcs})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+
+	t.Cleanup(server.Close)
+	return server
+}
+
+func writeJSON(w http.ResponseWriter, body any) {
+	if err := json.NewEncoder(w).Encode(body); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+	}
+}
