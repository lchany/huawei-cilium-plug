+func TestMergeOperatorOwnedStatusPreservesAgentOwnedIPAMFields(t *testing.T) {
+	dst := &ciliumv2.CiliumNode{Status: ciliumv2.NodeStatus{
+		HuaweiCloud: &huaweiCloudTypes.ENIStatus{
+			SubENIs: map[string]huaweiCloudTypes.SubENI{
+				"subeni-old": {ID: "subeni-old"},
+			},
+		},
+		IPAM: ipamTypes.IPAMStatus{
+			Used:           ipamTypes.AllocationMap{"192.168.0.10": {Owner: "health", Resource: "subeni-agent"}},
+			IPv6Used:       ipamTypes.AllocationMap{"fd00::10": {Owner: "health-v6", Resource: "subeni-agent-v6"}},
+			PodCIDRs:       ipamTypes.PodCIDRMap{"10.244.0.0/24": {Status: ipamTypes.PodCIDRStatusInUse}},
+			OperatorStatus: ipamTypes.OperatorStatus{Error: "old-error"},
+			ReleaseIPs:     map[string]ipamTypes.IPReleaseStatus{"192.168.0.11": ipamTypes.IPReleaseStatus("do-not-release")},
+		},
+	}}
+	src := &ciliumv2.CiliumNode{Status: ciliumv2.NodeStatus{
+		HuaweiCloud: &huaweiCloudTypes.ENIStatus{
+			SubENIs: map[string]huaweiCloudTypes.SubENI{
+				"subeni-1": {ID: "subeni-1"},
+				"subeni-2": {ID: "subeni-2"},
+			},
+		},
+		IPAM: ipamTypes.IPAMStatus{
+			Used:             ipamTypes.AllocationMap{"192.168.0.200": {Owner: "should-not-overwrite", Resource: "subeni-1"}},
+			OperatorStatus:   ipamTypes.OperatorStatus{Error: "boom"},
+			ReleaseIPs:       map[string]ipamTypes.IPReleaseStatus{"192.168.0.12": ipamTypes.IPReleaseStatus("marked-for-release")},
+			ReleaseIPv6s:     map[string]ipamTypes.IPReleaseStatus{"fd00::12": ipamTypes.IPReleaseStatus("released")},
+			AssignedStaticIP: "1.1.1.1",
+		},
+	}}
+
+	mergeOperatorOwnedStatus(dst, src)
+
+	assert.Equal(t, ipamTypes.AllocationMap{"192.168.0.10": {Owner: "health", Resource: "subeni-agent"}}, dst.Status.IPAM.Used)
+	assert.Equal(t, ipamTypes.AllocationMap{"fd00::10": {Owner: "health-v6", Resource: "subeni-agent-v6"}}, dst.Status.IPAM.IPv6Used)
+	assert.Equal(t, ipamTypes.PodCIDRMap{"10.244.0.0/24": {Status: ipamTypes.PodCIDRStatusInUse}}, dst.Status.IPAM.PodCIDRs)
+	assert.Equal(t, ipamTypes.OperatorStatus{Error: "boom"}, dst.Status.IPAM.OperatorStatus)
+	assert.Equal(t, map[string]ipamTypes.IPReleaseStatus{"192.168.0.12": ipamTypes.IPReleaseStatus("marked-for-release")}, dst.Status.IPAM.ReleaseIPs)
+	assert.Equal(t, map[string]ipamTypes.IPReleaseStatus{"fd00::12": ipamTypes.IPReleaseStatus("released")}, dst.Status.IPAM.ReleaseIPv6s)
+	assert.Equal(t, "1.1.1.1", dst.Status.IPAM.AssignedStaticIP)
+	require.NotNil(t, dst.Status.HuaweiCloud)
+	assert.Len(t, dst.Status.HuaweiCloud.SubENIs, 2)
+	assert.Contains(t, dst.Status.HuaweiCloud.SubENIs, "subeni-1")
+	assert.Contains(t, dst.Status.HuaweiCloud.SubENIs, "subeni-2")
+}
