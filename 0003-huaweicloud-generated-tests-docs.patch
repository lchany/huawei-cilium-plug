+func TestNewEndpointSliceListerWatcherFallsBackToV1Beta1(t *testing.T) {
+	_, cs := clienttest.NewFakeClientsetWithVersion(hivetest.Logger(t), nil, "1.20")
+	_, obj := NewEndpointSliceListerWatcher(hivetest.Logger(t), cs)
+	require.IsType(t, &discoveryv1beta1.EndpointSlice{}, obj)
+}
+
+func TestNewEndpointSliceListerWatcherUsesV1WhenAvailable(t *testing.T) {
+	_, cs := clienttest.NewFakeClientsetWithVersion(hivetest.Logger(t), nil, "1.26")
+	_, obj := NewEndpointSliceListerWatcher(hivetest.Logger(t), cs)
+	require.IsType(t, &slim_discoveryv1.EndpointSlice{}, obj)
+}
+
+func TestParseEndpointSliceSupportsV1Beta1(t *testing.T) {
+	portName := "dns"
+	protocol := corev1.ProtocolUDP
+	port := int32(53)
+	ready := true
+
+	obj := &discoveryv1beta1.EndpointSlice{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "kube-dns-abc",
+			Namespace: "kube-system",
+			Labels: map[string]string{
+				slim_discoveryv1.LabelServiceName: "kube-dns",
+			},
+		},
+		AddressType: discoveryv1beta1.AddressTypeIPv4,
+		Endpoints: []discoveryv1beta1.Endpoint{{
+			Addresses: []string{"192.168.0.181"},
+			Conditions: discoveryv1beta1.EndpointConditions{
+				Ready: &ready,
+			},
+		}},
+		Ports: []discoveryv1beta1.EndpointPort{{
+			Name:     &portName,
+			Protocol: &protocol,
+			Port:     &port,
+		}},
+	}
+
+	got, err := ParseEndpointSlice(hivetest.Logger(t), obj)
+	require.NoError(t, err)
+	require.Equal(t, EndpointSliceID{
+		ServiceName:       loadbalancer.NewServiceName("kube-system", "kube-dns"),
+		EndpointSliceName: "kube-system/kube-dns-abc",
+	}, got.EndpointSliceID)
+	require.Equal(t, "kube-dns-abc", got.Name)
+	require.Equal(t, "kube-system", got.Namespace)
+	require.Equal(t, map[string]string{slim_discoveryv1.LabelServiceName: "kube-dns"}, got.Labels)
+
+	addr := cmtypes.MustParseAddrCluster("192.168.0.181")
+	require.Contains(t, got.Backends, addr)
+	require.Equal(t, &Backend{
+		Ports: map[loadbalancer.L4Addr][]string{
+			loadbalancer.NewL4Addr(loadbalancer.UDP, 53): {"dns"},
+		},
+		Conditions: BackendConditionReady | BackendConditionServing,
+	}, got.Backends[addr])
+}
+
+func TestTransformEndpointSupportsDeletedFinalStateUnknown(t *testing.T) {
+	obj := cache.DeletedFinalStateUnknown{Key: "foo", Obj: &discoveryv1beta1.EndpointSlice{}}
+	got, err := transformEndpoint(hivetest.Logger(t), obj)
+	require.NoError(t, err)
+	require.Equal(t, obj, got)
+}
