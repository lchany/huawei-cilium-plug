+func newTestManager(t *testing.T) (*InstancesManager, *mock.API) {
+	mockAPI := mock.NewAPI(
+		[]*ipamTypes.Subnet{
+			{ID: "subnet-1", VirtualNetworkID: "vpc-1", AvailabilityZone: "cn-north-4a", AvailableAddresses: 100},
+			{ID: "subnet-2", VirtualNetworkID: "vpc-1", AvailabilityZone: "cn-north-4a", AvailableAddresses: 200},
+		},
+		[]*ipamTypes.VirtualNetwork{{ID: "vpc-1", PrimaryCIDR: "10.0.0.0/16"}},
+		[]*hwTypes.SecurityGroup{
+			{ID: "sg-1", VPCID: "vpc-1", Tags: map[string]string{"role": "worker"}},
+			{ID: "sg-2", VPCID: "vpc-2", Tags: map[string]string{"role": "worker"}},
+		},
+	)
+
+	mgr := NewInstancesManager(hivetest.Logger(t), mockAPI, "vpc-1")
+	return mgr, mockAPI
+}
+
+func TestInstancesResync(t *testing.T) {
+	mgr, mockAPI := newTestManager(t)
+
+	mockAPI.AddSubENI("instance-1", &eniTypes.SubENI{
+		ID:               "subeni-1",
+		PrivateIPAddress: "10.0.1.1",
+		SubnetID:         "subnet-1",
+		ParentID:         "parent-1",
+		State:            "ACTIVE",
+	})
+
+	ts := mgr.Resync(context.Background())
+	require.False(t, ts.IsZero())
+	assert.True(t, mgr.HasInstance("instance-1"))
+	assert.False(t, mgr.HasInstance("nonexistent"))
+}
+
+func TestInstancesGetPoolQuota(t *testing.T) {
+	mgr, _ := newTestManager(t)
+	mgr.Resync(context.Background())
+
+	quota := mgr.GetPoolQuota()
+	require.Len(t, quota, 2)
+	assert.Equal(t, 100, quota[ipamTypes.PoolID("subnet-1")].AvailableIPs)
+	assert.Equal(t, 200, quota[ipamTypes.PoolID("subnet-2")].AvailableIPs)
+}
+
+func TestInstancesFindOneSubnet(t *testing.T) {
+	mgr, _ := newTestManager(t)
+	mgr.Resync(context.Background())
+
+	spec := eniTypes.Spec{VPCID: "vpc-1", AvailabilityZone: "cn-north-4a"}
+	subnet := mgr.FindOneSubnet(spec, 1)
+	require.NotNil(t, subnet)
+	assert.Equal(t, "subnet-2", subnet.ID)
+
+	spec.Subnets = []string{"subnet-1"}
+	subnet = mgr.FindOneSubnet(spec, 1)
+	require.NotNil(t, subnet)
+	assert.Equal(t, "subnet-1", subnet.ID)
+}
+
+func TestInstancesDeleteInstance(t *testing.T) {
+	mgr, mockAPI := newTestManager(t)
+	mockAPI.AddSubENI("instance-1", &eniTypes.SubENI{ID: "subeni-1", PrivateIPAddress: "10.0.1.1", ParentID: "parent-1"})
+	mgr.Resync(context.Background())
+	assert.True(t, mgr.HasInstance("instance-1"))
+	mgr.DeleteInstance("instance-1")
+	assert.False(t, mgr.HasInstance("instance-1"))
+}
+
+func TestInstancesFindSecurityGroupByTags(t *testing.T) {
+	mgr, _ := newTestManager(t)
+	mgr.Resync(context.Background())
+
+	groups := mgr.FindSecurityGroupByTags("vpc-1", ipamTypes.Tags{"role": "worker"})
+	require.Len(t, groups, 1)
+	assert.Equal(t, "sg-1", groups[0].ID)
+}
+
+// TestFindSecurityGroupByTags_VPCIDPropagation verifies that vpcID configured on
+// InstancesManager propagates through resync→GetSecurityGroups and enables strict
+// VPC+Tag dual filtering, matching the AlibabaCloud reference implementation.
+func TestFindSecurityGroupByTags_VPCIDPropagation(t *testing.T) {
+	mockAPI := mock.NewAPI(
+		[]*ipamTypes.Subnet{},
+		[]*ipamTypes.VirtualNetwork{},
+		[]*hwTypes.SecurityGroup{
+			{ID: "sg-1", VPCID: "vpc-1", Tags: map[string]string{"role": "worker"}},
+			{ID: "sg-2", VPCID: "vpc-2", Tags: map[string]string{"role": "worker"}},
+		},
+	)
+	mgr := NewInstancesManager(hivetest.Logger(t), mockAPI, "vpc-1")
+	mgr.Resync(context.Background())
+
+	// Strict match: only sg-1 (vpc-1) should be returned
+	groups := mgr.FindSecurityGroupByTags("vpc-1", ipamTypes.Tags{"role": "worker"})
+	require.Len(t, groups, 1)
+	assert.Equal(t, "sg-1", groups[0].ID)
+
+	// sg-2 was filtered out by mock.GetSecurityGroups("vpc-1"), so vpc-2 query returns nothing
+	groups = mgr.FindSecurityGroupByTags("vpc-2", ipamTypes.Tags{"role": "worker"})
+	assert.Empty(t, groups)
+}
+
+// TestFindSecurityGroupByTags_EmptyVPCIDFallback verifies the fallback behaviour
+// when the operator cannot obtain a VPC ID at startup (metadata failure).
+//
+// In that case GetSecurityGroups populates all cached SGs with VPCID="".
+// An empty VPCID on a cached SG means "VPC unknown at cache time", NOT "this SG
+// belongs to the empty-string VPC". The node's spec.VPCID is correctly filled by
+// the agent from metadata, so FindSecurityGroupByTags is later called with the
+// real VPC ID.  Requiring an exact match would silently exclude all SGs, breaking
+// tag-based security-group selection with no actionable error message.
+//
+// The fix: skip the VPC filter when sg.VPCID=="" so tag matching degrades
+// gracefully instead of returning an empty set.
+func TestFindSecurityGroupByTags_EmptyVPCIDFallback(t *testing.T) {
+	mockAPI := mock.NewAPI(
+		[]*ipamTypes.Subnet{},
+		[]*ipamTypes.VirtualNetwork{},
+		[]*hwTypes.SecurityGroup{
+			{ID: "sg-1", VPCID: "", Tags: map[string]string{"role": "worker"}},
+		},
+	)
+	mgr := NewInstancesManager(hivetest.Logger(t), mockAPI, "")
+	mgr.Resync(context.Background())
+
+	// Empty sg.VPCID means "unknown"; a real VPC ID query must still match
+	// so that tag-based SG selection works even when operator lost VPCID.
+	groups := mgr.FindSecurityGroupByTags("vpc-real", ipamTypes.Tags{"role": "worker"})
+	require.Len(t, groups, 1)
+	assert.Equal(t, "sg-1", groups[0].ID)
+
+	// Empty query also matches (backwards-compatible: both sides empty)
+	groups = mgr.FindSecurityGroupByTags("", ipamTypes.Tags{"role": "worker"})
+	require.Len(t, groups, 1)
+	assert.Equal(t, "sg-1", groups[0].ID)
+
+	// Non-matching tag still returns empty regardless of VPC ID
+	groups = mgr.FindSecurityGroupByTags("vpc-real", ipamTypes.Tags{"role": "control-plane"})
+	assert.Empty(t, groups)
+}
