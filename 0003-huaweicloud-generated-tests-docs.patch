+func TestCreateInterface_SubnetFallback_AllExhausted(t *testing.T) {
+	node, mockAPI := newTestNode(t)
+	mockAPI.AddSubnet(&ipamTypes.Subnet{ID: "subnet-2", VirtualNetworkID: "vpc-1", AvailabilityZone: "cn-north-4a", AvailableAddresses: 100})
+	mockAPI.SetSubnetError("subnet-1", hwAPI.ErrSubnetInsufficientIP)
+	mockAPI.SetSubnetError("subnet-2", hwAPI.ErrSubnetInsufficientIP)
+
+	node.k8sObj.Spec.HuaweiCloud.Subnets = []string{"subnet-1", "subnet-2"}
+	node.k8sObj.Spec.HuaweiCloud.TrunkInterfaceID = "trunk-port-1"
+
+	a := &ipam.AllocationAction{
+		IPv4:                ipam.IPAllocationAction{MaxIPsToAllocate: 2},
+		EmptyInterfaceSlots: 2,
