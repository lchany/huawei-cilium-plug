+	hasBody := false
+	for _, item := range reqDef.ResponseFields {
+		if item.LocationType == def.Header {
+			headerErr := hc.deserializeResponseHeaders(resp, reqDef, item)
+			if headerErr != nil {
+				return processError(headerErr)
+			}
+		}
