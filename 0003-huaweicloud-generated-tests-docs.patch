+	"github.com/stretchr/testify/require"
+)
+
+func TestGetKnownInstanceType(t *testing.T) {
+	testCases := map[string]ipamTypes.Limits{
+		"c7.large.4":    {Adapters: 1, IPv4: 16},
+		"c7n.large.2":   {Adapters: 1, IPv4: 16},
+		"c7n.xlarge.2":  {Adapters: 1, IPv4: 32},
+		"c7.xlarge.4":   {Adapters: 1, IPv4: 32},
+		"c7n.xlarge.4":  {Adapters: 1, IPv4: 32},
+		"m7.2xlarge.8":  {Adapters: 1, IPv4: 64},
+		"hc3.large.8":   {Adapters: 1, IPv4: 4},
+		"c9.large.2":    {Adapters: 1, IPv4: 16},
+		"c9.4xlarge.2":  {Adapters: 1, IPv4: 128},
+		"ac9.xlarge.2":  {Adapters: 1, IPv4: 16},
+		"ac8.2xlarge.4": {Adapters: 1, IPv4: 32},
+		"m9.xlarge.8":   {Adapters: 1, IPv4: 32},
+		"i7.8xlarge.4":  {Adapters: 1, IPv4: 192},
+	}
+
+	for instanceType, expected := range testCases {
+		got, ok := Get(instanceType)
+		require.True(t, ok, "known instance type %s should exist", instanceType)
+		require.Equal(t, expected, got)
+	}
+}
+
+func TestGetUnknownInstanceType(t *testing.T) {
+	_, ok := Get("unknown.type.9999")
+	require.False(t, ok)
+}
+
+func TestUpdate(t *testing.T) {
+	instanceType := "test.type.custom"
+
+	_, ok := Get(instanceType)
+	require.False(t, ok)
+
+	Update(instanceType, ipamTypes.Limits{Adapters: 2, IPv4: 32})
+	updated, ok := Get(instanceType)
+	require.True(t, ok)
+	require.Equal(t, ipamTypes.Limits{Adapters: 2, IPv4: 32}, updated)
+
+	Update(instanceType, ipamTypes.Limits{Adapters: 1, IPv4: 8})
+	updated, ok = Get(instanceType)
+	require.True(t, ok)
+	require.Equal(t, ipamTypes.Limits{Adapters: 1, IPv4: 8}, updated)
+}
+
+func TestConcurrentAccess(t *testing.T) {
+	const workers = 100
+
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		i := i
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			Get("c7.xlarge.4")
+		}()
+		go func() {
+			defer wg.Done()
+			instanceType := fmt.Sprintf("concurrent.test.%d", i)
+			Update(instanceType, ipamTypes.Limits{Adapters: 1, IPv4: i%16 + 1})
+		}()
+	}
+	wg.Wait()
+
+	for i := 0; i < workers; i++ {
+		instanceType := fmt.Sprintf("concurrent.test.%d", i)
+		got, ok := Get(instanceType)
+		require.True(t, ok)
+		require.Equal(t, ipamTypes.Limits{Adapters: 1, IPv4: i%16 + 1}, got)
+	}
+}
