+func (s *strategyBase) SetBaseDelay(baseDelay int32) {
+	if s != nil {
+		s.baseDelay = baseDelay
+	}
+}
+
+func (s *strategyBase) GetBaseDelay() int32 {
+	if s != nil {
+		return s.baseDelay
+	}
+	return BaseDelay
+}
