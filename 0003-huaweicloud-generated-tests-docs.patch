+type fakeNodeEventHandler struct {
+	upserts []string
+	deletes []string
+	resyncs int
+}
+
+func (f *fakeNodeEventHandler) Create(resource *ciliumv2.CiliumNode) bool {
+	return false
+}
+
+func (f *fakeNodeEventHandler) Update(resource *ciliumv2.CiliumNode) bool {
+	return false
+}
+
+func (f *fakeNodeEventHandler) Delete(resource *ciliumv2.CiliumNode) {
+	f.deletes = append(f.deletes, resource.Name)
+}
+
+func (f *fakeNodeEventHandler) Resync(context.Context, time.Time) {
+	f.resyncs++
+}
+
+func (f *fakeNodeEventHandler) Upsert(resource *ciliumv2.CiliumNode) {
+	f.upserts = append(f.upserts, resource.Name)
+}
+
+var _ allocator.NodeEventHandler = (*fakeNodeEventHandler)(nil)
+
+type fakeNodeResource struct {
+	events []resource.Event[*ciliumv2.CiliumNode]
+}
+
+func (f *fakeNodeResource) Observe(ctx context.Context, next func(resource.Event[*ciliumv2.CiliumNode]), complete func(error)) {
+	stream.FromChannel(f.Events(ctx)).Observe(ctx, next, complete)
+}
+
+func (f *fakeNodeResource) Events(context.Context, ...resource.EventsOpt) <-chan resource.Event[*ciliumv2.CiliumNode] {
+	ch := make(chan resource.Event[*ciliumv2.CiliumNode], len(f.events))
+	for _, ev := range f.events {
+		ch <- ev
+	}
+	close(ch)
+	return ch
+}
