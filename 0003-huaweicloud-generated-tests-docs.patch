+// Integer create node for integer value
+func Integer(tk *token.Token) *IntegerNode {
+	var v any
+	if num := token.ToNumber(tk.Value); num != nil {
+		v = num.Value
+	}
+	return &IntegerNode{
+		BaseNode: &BaseNode{},
+		Token:    tk,
+		Value:    v,
+	}
+}
