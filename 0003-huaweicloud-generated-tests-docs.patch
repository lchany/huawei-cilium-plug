+		PrivateIPAddress: "10.0.1.5",
+		SecurityGroups:   []string{"sg-1", "sg-2"},
+		State:            "ACTIVE",
+		VlanID:           100,
+	}
+
+	copy := original.DeepCopy()
+	assert.Equal(t, original.ID, copy.ID)
+	assert.Equal(t, original.SecurityGroups, copy.SecurityGroups)
+
+	copy.SecurityGroups[0] = "sg-modified"
+	assert.Equal(t, "sg-1", original.SecurityGroups[0])
+}
+
+func TestSubENIInterfaceID(t *testing.T) {
+	s := &SubENI{ID: "sub-eni-xyz"}
+	assert.Equal(t, "sub-eni-xyz", s.InterfaceID())
+}
