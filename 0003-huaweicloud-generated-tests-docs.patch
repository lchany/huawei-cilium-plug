+func (s *GlobalCredentials) ProcessDerivedAuthParams(derivedAuthServiceName, regionId string) ICredential {
+	if s.derivedAuthServiceName == "" {
+		s.derivedAuthServiceName = derivedAuthServiceName
+	}
+
+	if s.regionId == "" {
+		s.regionId = globalRegionId
+	}
+
+	return s
+}
