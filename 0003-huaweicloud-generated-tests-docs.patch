+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	hwAPI "github.com/cilium/cilium/pkg/huaweicloud/api"
+	eniTypes "github.com/cilium/cilium/pkg/huaweicloud/eni/types"
+	hwTypes "github.com/cilium/cilium/pkg/huaweicloud/types"
+	ipamTypes "github.com/cilium/cilium/pkg/ipam/types"
+)
+
+func newTestAPI() *API {
+	return NewAPI(
+		[]*ipamTypes.Subnet{{
+			ID:               "subnet-1",
+			Name:             "subnet-1",
+			VirtualNetworkID: "vpc-1",
+		}},
+		[]*ipamTypes.VirtualNetwork{{
+			ID:          "vpc-1",
+			PrimaryCIDR: "10.0.0.0/16",
+		}},
+		[]*hwTypes.SecurityGroup{
+			{ID: "sg-1", VPCID: "vpc-1", Tags: map[string]string{"role": "worker"}},
+			{ID: "sg-2", VPCID: "vpc-1", Tags: map[string]string{"role": "db"}},
+		},
+	)
+}
+
+func TestSubENILifecycle(t *testing.T) {
+	ctx := context.Background()
+	api := newTestAPI()
+
+	subENIID, created, err := api.CreateSubNetworkInterface(ctx, hwAPI.CreateSubENIRequest{SubnetID: "subnet-1", TrunkInterfaceID: "parent-1", SecurityGroupIDs: []string{"sg-1"}})
+	require.NoError(t, err)
+	require.NotEmpty(t, subENIID)
+	require.NotNil(t, created)
+
+	assert.Equal(t, subENIID, created.ID)
+	assert.Equal(t, "subnet-1", created.SubnetID)
+	assert.Equal(t, "parent-1", created.ParentID)
+	assert.Equal(t, "ACTIVE", created.State)
+	assert.Equal(t, []string{"sg-1"}, created.SecurityGroups)
+
+	loaded, err := api.GetSubNetworkInterface(ctx, subENIID)
+	require.NoError(t, err)
+	require.NotNil(t, loaded)
+	assert.Equal(t, created.ID, loaded.ID)
+	assert.Equal(t, created.PrivateIPAddress, loaded.PrivateIPAddress)
+	assert.Equal(t, created.MACAddress, loaded.MACAddress)
+
+	listed, err := api.ListSubNetworkInterfaces(ctx, "parent-1")
+	require.NoError(t, err)
+	require.Len(t, listed, 1)
+	assert.Equal(t, subENIID, listed[0].ID)
+
+	err = api.DeleteSubNetworkInterface(ctx, subENIID)
+	require.NoError(t, err)
+
+	_, err = api.GetSubNetworkInterface(ctx, subENIID)
+	require.Error(t, err)
+}
+
+func TestBatchCreateSubNetworkInterfaces(t *testing.T) {
+	ctx := context.Background()
+	api := newTestAPI()
+
+	subENIs, err := api.BatchCreateSubNetworkInterfaces(ctx, 3, hwAPI.CreateSubENIRequest{SubnetID: "subnet-1", TrunkInterfaceID: "parent-2", SecurityGroupIDs: []string{"sg-1", "sg-2"}})
+	require.NoError(t, err)
+	require.Len(t, subENIs, 3)
+
+	ids := map[string]struct{}{}
+	for _, subENI := range subENIs {
+		require.NotNil(t, subENI)
+		assert.Equal(t, "subnet-1", subENI.SubnetID)
+		assert.Equal(t, "parent-2", subENI.ParentID)
+		assert.Equal(t, "ACTIVE", subENI.State)
+		assert.Equal(t, []string{"sg-1", "sg-2"}, subENI.SecurityGroups)
+		ids[subENI.ID] = struct{}{}
+	}
+	assert.Len(t, ids, 3)
+
+	_, err = api.BatchCreateSubNetworkInterfaces(ctx, 11, hwAPI.CreateSubENIRequest{SubnetID: "subnet-1", TrunkInterfaceID: "parent-2", SecurityGroupIDs: []string{"sg-1"}})
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "10")
+}
+
+func TestAddSubENIAndGetSubENIs(t *testing.T) {
+	ctx := context.Background()
+	api := newTestAPI()
+
+	seed := &eniTypes.SubENI{
+		ID:               "subeni-seeded",
+		PrivateIPAddress: "10.0.0.20",
+		MACAddress:       "fa:16:3e:00:00:20",
+		SubnetID:         "subnet-1",
+		ParentID:         "parent-seeded",
+		VPCID:            "vpc-1",
+		SecurityGroups:   []string{"sg-1"},
+		State:            "ACTIVE",
+	}
+
+	api.AddSubENI("instance-1", seed)
+
+	seed.State = "ERROR"
+	seed.SecurityGroups[0] = "sg-2"
+
+	first := api.GetSubENIs("instance-1")
+	require.Len(t, first, 1)
+	require.NotNil(t, first["subeni-seeded"])
+	assert.Equal(t, "ACTIVE", first["subeni-seeded"].State)
+	assert.Equal(t, []string{"sg-1"}, first["subeni-seeded"].SecurityGroups)
+
+	first["subeni-seeded"].State = "ERROR"
+	second := api.GetSubENIs("instance-1")
+	assert.Equal(t, "ACTIVE", second["subeni-seeded"].State)
+
+	instance, err := api.GetInstance(ctx, "instance-1")
+	require.NoError(t, err)
+	require.Len(t, instance.Interfaces, 1)
+
+	iface, ok := instance.Interfaces["subeni-seeded"]
+	require.True(t, ok)
+	resource, ok := iface.Resource.(*eniTypes.SubENI)
+	require.True(t, ok)
+	assert.Equal(t, "10.0.0.20", resource.PrivateIPAddress)
+
+	allInstances, err := api.GetInstances(ctx, nil, nil)
+	require.NoError(t, err)
+	require.True(t, allInstances.Exists("instance-1"))
+}
+
+func TestInjectAndListVPCSubnetSecurityGroup(t *testing.T) {
+	ctx := context.Background()
+	api := NewAPI(nil, nil, nil)
+
+	api.AddVPC(&ipamTypes.VirtualNetwork{ID: "vpc-2", PrimaryCIDR: "172.16.0.0/16"})
+	api.AddSubnet(&ipamTypes.Subnet{ID: "subnet-2", VirtualNetworkID: "vpc-2", AvailabilityZone: "cn-north-4a"})
+	api.AddSecurityGroup(&hwTypes.SecurityGroup{ID: "sg-20", VPCID: "vpc-2", Tags: map[string]string{"env": "test"}})
+
+	vpcs, err := api.GetVPCs(ctx)
+	require.NoError(t, err)
+	require.Len(t, vpcs, 1)
+	require.Contains(t, vpcs, "vpc-2")
+
+	subnets, err := api.GetSubnets(ctx, "vpc-2")
+	require.NoError(t, err)
+	require.Len(t, subnets, 1)
+	require.Contains(t, subnets, "subnet-2")
+
+	securityGroups, err := api.GetSecurityGroups(ctx, "vpc-2")
+	require.NoError(t, err)
+	require.Len(t, securityGroups, 1)
+	require.Contains(t, securityGroups, "sg-20")
+}
