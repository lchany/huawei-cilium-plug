+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package api
+
+import (
+	"testing"
+
+	vpcmodel "github.com/huaweicloud/huaweicloud-sdk-go-v3/services/vpc/v3/model"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSelectIPv4SubnetCIDRAndGateway(t *testing.T) {
+	entries := []vpcmodel.SubnetCidr{
+		{IpVersion: "4", Cidr: "192.168.1.0/24", GatewayIp: "192.168.1.1"},
+		{IpVersion: "4", Cidr: "192.168.2.64/26", GatewayIp: "192.168.2.65"},
+		{IpVersion: "6", Cidr: "fd00::/64", GatewayIp: "fd00::1"},
+	}
+
+	t.Run("match private IP CIDR", func(t *testing.T) {
+		gw, cidr := selectIPv4SubnetCIDRAndGateway(entries, "192.168.2.90")
+		require.Equal(t, "192.168.2.65", gw)
+		require.Equal(t, "192.168.2.64/26", cidr)
+	})
+
+	t.Run("fallback when private IP not match", func(t *testing.T) {
+		gw, cidr := selectIPv4SubnetCIDRAndGateway(entries, "10.0.0.10")
+		require.Equal(t, "192.168.1.1", gw)
+		require.Equal(t, "192.168.1.0/24", cidr)
+	})
+
+	t.Run("fallback when private IP missing", func(t *testing.T) {
+		gw, cidr := selectIPv4SubnetCIDRAndGateway(entries, "")
+		require.Equal(t, "192.168.1.1", gw)
+		require.Equal(t, "192.168.1.0/24", cidr)
+	})
+
+	t.Run("ignore invalid CIDR entries", func(t *testing.T) {
+		gw, cidr := selectIPv4SubnetCIDRAndGateway([]vpcmodel.SubnetCidr{
+			{IpVersion: "4", Cidr: "invalid", GatewayIp: "192.168.9.1"},
+			{IpVersion: "4", Cidr: "192.168.9.0/24", GatewayIp: "192.168.9.1"},
+		}, "192.168.9.10")
+		require.Equal(t, "192.168.9.1", gw)
+		require.Equal(t, "192.168.9.0/24", cidr)
+	})
+}
diff --git a/pkg/huaweicloud/api/error_test.go b/pkg/huaweicloud/api/error_test.go
new file mode 100644
index 0000000000..9fe70f1255
--- /dev/null
+++ b/pkg/huaweicloud/api/error_test.go
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package api
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/huaweicloud/huaweicloud-sdk-go-v3/core/sdkerr"
+)
+
+func makeSdkErr(statusCode int, errorCode, errorMessage string) error {
+	return &sdkerr.ServiceResponseError{
+		StatusCode:   statusCode,
+		ErrorCode:    errorCode,
+		ErrorMessage: errorMessage,
+		RequestId:    "test-request-id",
+	}
+}
+
+func TestNormalizeAPIError_Nil(t *testing.T) {
+	if err := normalizeAPIError(nil); err != nil {
+		t.Fatalf("expected nil, got %v", err)
+	}
+}
+
+func TestNormalizeAPIError_NonSDKError(t *testing.T) {
+	original := fmt.Errorf("some non-sdk error")
+	result := normalizeAPIError(original)
+	if result != original {
+		t.Fatalf("expected original error, got %v", result)
+	}
+}
+
+func TestNormalizeAPIError_Unauthorized_401(t *testing.T) {
+	err := normalizeAPIError(makeSdkErr(401, "APIGW.0301", "Unauthorized"))
+	if !errors.Is(err, ErrUnauthorized) {
+		t.Fatalf("expected ErrUnauthorized, got %v", err)
+	}
+}
+
+func TestNormalizeAPIError_Unauthorized_403(t *testing.T) {
+	err := normalizeAPIError(makeSdkErr(403, "APIGW.0308", "Forbidden"))
+	if !errors.Is(err, ErrUnauthorized) {
+		t.Fatalf("expected ErrUnauthorized, got %v", err)
+	}
+}
+
+func TestNormalizeAPIError_NotFound(t *testing.T) {
+	err := normalizeAPIError(makeSdkErr(404, "VPC.0204", "Resource not found"))
+	if !errors.Is(err, ErrNotFound) {
+		t.Fatalf("expected ErrNotFound, got %v", err)
+	}
+}
+
+func TestNormalizeAPIError_RateLimited(t *testing.T) {
+	err := normalizeAPIError(makeSdkErr(429, "APIGW.0301", "Rate limit exceeded"))
+	if !errors.Is(err, ErrRateLimited) {
+		t.Fatalf("expected ErrRateLimited, got %v", err)
+	}
+}
+
+func TestNormalizeAPIError_SubnetInsufficientIP_VPC0703(t *testing.T) {
+	err := normalizeAPIError(makeSdkErr(409, "VPC.0703", "No more IP addresses available on network xxx."))
+	if !errors.Is(err, ErrSubnetInsufficientIP) {
+		t.Fatalf("expected ErrSubnetInsufficientIP for VPC.0703, got %v", err)
+	}
+}
+
+func TestNormalizeAPIError_SubnetInsufficientIP_VPC0532(t *testing.T) {
+	err := normalizeAPIError(makeSdkErr(409, "VPC.0532", "No more IP addresses available on network."))
+	if !errors.Is(err, ErrSubnetInsufficientIP) {
+		t.Fatalf("expected ErrSubnetInsufficientIP for VPC.0532, got %v", err)
+	}
+}
+
+func TestNormalizeAPIError_InvalidArgument_400(t *testing.T) {
+	err := normalizeAPIError(makeSdkErr(400, "VPC.0001", "Invalid parameter"))
+	if !errors.Is(err, ErrInvalidArgument) {
+		t.Fatalf("expected ErrInvalidArgument, got %v", err)
+	}
+}
+
+func TestNormalizeAPIError_UnknownError(t *testing.T) {
+	err := normalizeAPIError(makeSdkErr(500, "VPC.9999", "Internal server error"))
+	// 500 error should not match any sentinel
+	if errors.Is(err, ErrSubnetInsufficientIP) || errors.Is(err, ErrUnauthorized) ||
+		errors.Is(err, ErrNotFound) || errors.Is(err, ErrRateLimited) || errors.Is(err, ErrInvalidArgument) {
+		t.Fatalf("500 error should not match any sentinel, got %v", err)
+	}
+	if err == nil {
+		t.Fatal("expected non-nil error for 500")
+	}
+	// default branch preserves error chain via %w — callers can errors.As to SDK type
+	var sdkErr *sdkerr.ServiceResponseError
+	if !errors.As(err, &sdkErr) {
+		t.Fatalf("expected SDK error chain to be preserved, got %v", err)
+	}
+	if sdkErr.StatusCode != 500 {
+		t.Fatalf("expected StatusCode 500, got %d", sdkErr.StatusCode)
+	}
+}
+
+func TestIsSubnetInsufficientIP(t *testing.T) {
+	cases := []struct {
+		code   string
+		expect bool
+	}{
+		{"VPC.0703", true},
+		{"VPC.0532", true},
+		{"VPC.0001", false},
+		{"VPC.0301", false},
+		{"", false},
+	}
+	for _, c := range cases {
+		if got := isSubnetInsufficientIP(c.code); got != c.expect {
+			t.Errorf("isSubnetInsufficientIP(%q) = %v, want %v", c.code, got, c.expect)
+		}
+	}
+}
