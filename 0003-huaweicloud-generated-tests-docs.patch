+
+func TestWatchCiliumNodesBootstrapsFromTypedList(t *testing.T) {
+	nodeA := &ciliumv2.CiliumNode{ObjectMeta: metav1.ObjectMeta{Name: "node-a"}}
+	nodeB := &ciliumv2.CiliumNode{ObjectMeta: metav1.ObjectMeta{Name: "node-b"}}
+
+	handler := &fakeNodeEventHandler{}
+	lister := &fakeNodeLister{nodes: []*ciliumv2.CiliumNode{nodeA, nodeB}}
+	res := &fakeNodeResource{
+		events: []resource.Event[*ciliumv2.CiliumNode]{
+			{Kind: resource.Sync, Done: func(error) {}},
+		},
+	}
+
+	watchCiliumNodes(t.Context(), hivetest.Logger(t), lister, res, handler, true)
+
+	assert.ElementsMatch(t, []string{"node-a", "node-b"}, handler.upserts)
+	assert.Equal(t, 1, handler.resyncs)
+	assert.Empty(t, handler.deletes)
+}
+
+func TestWatchCiliumNodesIgnoresBootstrapListError(t *testing.T) {
+	nodeA := &ciliumv2.CiliumNode{ObjectMeta: metav1.ObjectMeta{Name: "node-a"}}
+
+	handler := &fakeNodeEventHandler{}
+	lister := &fakeNodeLister{err: errors.New("boom")}
+	res := &fakeNodeResource{
+		events: []resource.Event[*ciliumv2.CiliumNode]{
+			{Kind: resource.Upsert, Object: nodeA, Done: func(error) {}},
+			{Kind: resource.Sync, Done: func(error) {}},
+		},
+	}
+
+	watchCiliumNodes(t.Context(), hivetest.Logger(t), lister, res, handler, true)
+
+	require.Len(t, handler.upserts, 1)
+	assert.Equal(t, "node-a", handler.upserts[0])
+	assert.Equal(t, 1, handler.resyncs)
+	assert.Empty(t, handler.deletes)
+}
+
+func TestWatchCiliumNodesSkipsIgnoredNodesOnBootstrap(t *testing.T) {
+	ignoredNode := &ciliumv2.CiliumNode{ObjectMeta: metav1.ObjectMeta{
+		Name: "ignored-node",
+		Annotations: map[string]string{
+			annotation.IPAMIgnore: "true",
+		},
+	}}
+	activeNode := &ciliumv2.CiliumNode{ObjectMeta: metav1.ObjectMeta{Name: "active-node"}}
+
+	handler := &fakeNodeEventHandler{}
+	lister := &fakeNodeLister{nodes: []*ciliumv2.CiliumNode{ignoredNode, activeNode}}
+	res := &fakeNodeResource{
+		events: []resource.Event[*ciliumv2.CiliumNode]{
+			{Kind: resource.Sync, Done: func(error) {}},
+		},
+	}
+
+	watchCiliumNodes(t.Context(), hivetest.Logger(t), lister, res, handler, false)
+
+	assert.Equal(t, []string{"active-node"}, handler.upserts)
+	assert.Equal(t, 0, handler.resyncs)
+	assert.False(t, slices.Contains(handler.upserts, "ignored-node"))
+}
