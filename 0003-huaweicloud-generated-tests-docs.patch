+func TestGetTrunkInterfaceID(t *testing.T) {
+	tests := []struct {
+		name    string
+		body    string
+		status  int
+		wantID  string
+		wantErr bool
+	}{
+		{
+			name:   "success",
+			status: http.StatusOK,
+			body:   `{"links":[{"vif_id":"abc-123","ethernet_mac_address":"fa:16:3e:00:00:01"}],"networks":[],"services":[]}`,
+			wantID: "abc-123",
+		},
+		{
+			name:    "empty links",
+			status:  http.StatusOK,
+			body:    `{"links":[],"networks":[],"services":[]}`,
+			wantErr: true,
+		},
+		{
+			name:    "empty vif_id",
+			status:  http.StatusOK,
+			body:    `{"links":[{"vif_id":""}],"networks":[],"services":[]}`,
+			wantErr: true,
+		},
+		{
+			name:    "http error",
+			status:  http.StatusInternalServerError,
+			body:    ``,
+			wantErr: true,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(tt.status)
+				fmt.Fprint(w, tt.body)
+			}))
+			defer srv.Close()
+
+			// Override the metadata URL for testing.
+			orig := metadataNetworkDataURL
+			metadataNetworkDataURL = srv.URL
+			defer func() { metadataNetworkDataURL = orig }()
+
+			id, err := GetTrunkInterfaceID(context.Background())
+			if tt.wantErr {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+				assert.Equal(t, tt.wantID, id)
+			}
+		})
+	}
+}
diff --git a/pkg/huaweicloud/subenimap/manager_test.go b/pkg/huaweicloud/subenimap/manager_test.go
new file mode 100644
index 0000000000..3eb578d4ed
--- /dev/null
+++ b/pkg/huaweicloud/subenimap/manager_test.go
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package subenimap
+
+import (
+	"fmt"
+	"log/slog"
+	"testing"
+
+	"github.com/cilium/cilium/pkg/bpf"
+)
+
+// ---------------------------------------------------------------------------
+// fakeMap — in-memory mapBackend for unit tests.
+// ---------------------------------------------------------------------------
+
+type fakeMapEntry struct {
+	key   string
+	value bpf.MapValue
+}
+
+type fakeMap struct {
+	entries map[string]bpf.MapValue
+}
+
+func newFakeMap() *fakeMap {
+	return &fakeMap{entries: make(map[string]bpf.MapValue)}
+}
+
+func (f *fakeMap) Update(key bpf.MapKey, value bpf.MapValue) error {
+	f.entries[key.String()] = value
+	return nil
+}
+
+func (f *fakeMap) Delete(key bpf.MapKey) (bool, error) {
+	k := key.String()
+	if _, ok := f.entries[k]; !ok {
+		return false, nil
+	}
+	delete(f.entries, k)
+	return true, nil
+}
+
+// ---------------------------------------------------------------------------
+// fakeEndpoint — minimal EndpointInfo implementation.
+// ---------------------------------------------------------------------------
+
+type fakeEndpoint struct {
+	ipv4    string
+	id      uint32
+	ifIndex uint32
+	mac     [6]byte
+	vlanID  int32
+}
+
+func (e *fakeEndpoint) GetIPv4Address() string { return e.ipv4 }
+func (e *fakeEndpoint) GetID() uint32          { return e.id }
+func (e *fakeEndpoint) GetIfIndex() uint32     { return e.ifIndex }
+func (e *fakeEndpoint) GetMACAddress() [6]byte { return e.mac }
+func (e *fakeEndpoint) GetVLANID() int32       { return e.vlanID }
+
+// ---------------------------------------------------------------------------
+// helpers
+// ---------------------------------------------------------------------------
+
+func newTestManager(t *testing.T) (*SubENIMapManager, *fakeMap, *fakeMap) {
+	t.Helper()
+	srcIP := newFakeMap()
+	vlanMAC := newFakeMap()
+	logger := slog.Default()
+	mgr := newWithBackends(logger, srcIP, vlanMAC)
+	return mgr, srcIP, vlanMAC
+}
+
+// ---------------------------------------------------------------------------
+// tests
+// ---------------------------------------------------------------------------
+
+// TestOnEndpointReady_UpdatesBothMaps verifies that calling OnEndpointReady
+// inserts the correct key/value pair in both the srcip and vlan-mac maps.
+func TestOnEndpointReady_UpdatesBothMaps(t *testing.T) {
+	mgr, srcIPFake, vlanMACFake := newTestManager(t)
+
+	ep := &fakeEndpoint{
+		ipv4:    "10.0.1.5",
+		id:      42,
+		ifIndex: 7,
+		mac:     [6]byte{0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF},
+		vlanID:  100,
+	}
+
+	if err := mgr.OnEndpointReady(ep); err != nil {
+		t.Fatalf("OnEndpointReady returned unexpected error: %v", err)
+	}
+
+	// --- verify srcip map ---
+	addrBE, err := parseIPv4("10.0.1.5")
+	if err != nil {
+		t.Fatalf("parseIPv4 failed: %v", err)
+	}
+	srcKey := &SrcIPKey4{Addr: addrBE}
+	srcVal, ok := srcIPFake.entries[srcKey.String()]
+	if !ok {
+		t.Fatalf("srcip map: expected entry for key %q, but none found; entries: %v",
+			srcKey.String(), mapKeys(srcIPFake))
+	}
+	info, ok := srcVal.(*SubENIInfo)
+	if !ok {
+		t.Fatalf("srcip map: unexpected value type %T", srcVal)
+	}
+	if info.VlanID != 100 {
+		t.Errorf("srcip map: VlanID got=%d want=100", info.VlanID)
+	}
+	if info.MAC != [6]uint8{0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF} {
+		t.Errorf("srcip map: MAC got=%v want=[AA BB CC DD EE FF]", info.MAC)
+	}
+	if info.LxcID != 42 {
+		t.Errorf("srcip map: LxcID got=%d want=42", info.LxcID)
+	}
+
+	// --- verify vlan-mac map ---
+	vlanKey := &VLANMACKey{
+		VlanID: 100,
+		MAC:    [6]uint8{0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF},
+	}
+	vmVal, ok := vlanMACFake.entries[vlanKey.String()]
+	if !ok {
+		t.Fatalf("vlan-mac map: expected entry for key %q, but none found; entries: %v",
+			vlanKey.String(), mapKeys(vlanMACFake))
+	}
+	epInfo, ok := vmVal.(*EPInfo)
+	if !ok {
+		t.Fatalf("vlan-mac map: unexpected value type %T", vmVal)
+	}
+	if epInfo.IfIndex != 7 {
+		t.Errorf("vlan-mac map: IfIndex got=%d want=7", epInfo.IfIndex)
+	}
+	if epInfo.LxcID != 42 {
+		t.Errorf("vlan-mac map: LxcID got=%d want=42", epInfo.LxcID)
+	}
+}
+
+// TestOnEndpointDelete_DeletesFromBothMaps verifies that calling
+// OnEndpointDelete removes entries previously inserted by OnEndpointReady
+// from both maps.
+func TestOnEndpointDelete_DeletesFromBothMaps(t *testing.T) {
+	mgr, srcIPFake, vlanMACFake := newTestManager(t)
+
+	ep := &fakeEndpoint{
+		ipv4:    "192.168.0.3",
+		id:      99,
+		ifIndex: 3,
+		mac:     [6]byte{0x11, 0x22, 0x33, 0x44, 0x55, 0x66},
+		vlanID:  200,
+	}
+
+	// First insert entries.
+	if err := mgr.OnEndpointReady(ep); err != nil {
+		t.Fatalf("OnEndpointReady returned unexpected error: %v", err)
+	}
+
+	// Sanity-check that entries are present.
+	if len(srcIPFake.entries) == 0 {
+		t.Fatal("srcip map should have at least one entry after OnEndpointReady")
+	}
+	if len(vlanMACFake.entries) == 0 {
+		t.Fatal("vlan-mac map should have at least one entry after OnEndpointReady")
+	}
+
+	// Now delete.
+	if err := mgr.OnEndpointDelete(ep); err != nil {
+		t.Fatalf("OnEndpointDelete returned unexpected error: %v", err)
+	}
+
+	// Both maps must be empty.
+	if len(srcIPFake.entries) != 0 {
+		t.Errorf("srcip map: expected 0 entries after delete, got %d: %v",
+			len(srcIPFake.entries), mapKeys(srcIPFake))
+	}
+	if len(vlanMACFake.entries) != 0 {
+		t.Errorf("vlan-mac map: expected 0 entries after delete, got %d: %v",
+			len(vlanMACFake.entries), mapKeys(vlanMACFake))
+	}
+}
+
+// TestOnEndpointReady_InvalidIP verifies that an invalid IP address returns an
+// error and does not modify either map.
+func TestOnEndpointReady_InvalidIP(t *testing.T) {
+	mgr, srcIPFake, vlanMACFake := newTestManager(t)
+
+	ep := &fakeEndpoint{
+		ipv4:   "not-an-ip",
+		id:     1,
+		vlanID: 10,
+	}
+
+	err := mgr.OnEndpointReady(ep)
+	if err == nil {
+		t.Fatal("expected error for invalid IP, got nil")
+	}
+	if len(srcIPFake.entries) != 0 || len(vlanMACFake.entries) != 0 {
+		t.Error("maps should remain empty when IP is invalid")
+	}
+}
+
+// TestOnEndpointDelete_BestEffortOnMissingEntry verifies that deleting a
+// non-existent endpoint does not return an error.
+func TestOnEndpointDelete_BestEffortOnMissingEntry(t *testing.T) {
+	mgr, _, _ := newTestManager(t)
+
+	ep := &fakeEndpoint{
+		ipv4:   "172.16.0.1",
+		id:     5,
+		vlanID: 50,
+		mac:    [6]byte{0xDE, 0xAD, 0xBE, 0xEF, 0x00, 0x01},
+	}
+
+	// Should not error even though the entry was never inserted.
+	if err := mgr.OnEndpointDelete(ep); err != nil {
+		t.Fatalf("OnEndpointDelete returned unexpected error: %v", err)
+	}
+}
+
+// ---------------------------------------------------------------------------
+// internal helpers
+// ---------------------------------------------------------------------------
+
+func mapKeys(fm *fakeMap) []string {
+	keys := make([]string, 0, len(fm.entries))
+	for k := range fm.entries {
+		keys = append(keys, fmt.Sprintf("%q", k))
+	}
+	return keys
+}
