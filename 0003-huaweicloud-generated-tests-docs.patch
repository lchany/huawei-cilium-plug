+
+func TestSubENIForeachAddress(t *testing.T) {
+	s := &SubENI{
+		ID:               "sub-eni-123",
+		PrivateIPAddress: "192.168.1.100",
+		SubnetID:         "subnet-abc",
+	}
+
+	var calls int
+	var gotInstanceID, gotInterfaceID, gotIP, gotSubnet string
+
+	err := s.ForeachAddress("instance-1", func(instanceID, interfaceID, ip, subnetID string, iface ipamTypes.Address) error {
+		calls++
+		gotInstanceID = instanceID
+		gotInterfaceID = interfaceID
+		gotIP = ip
+		gotSubnet = subnetID
+		return nil
+	})
+
+	assert.NoError(t, err)
+	assert.Equal(t, 1, calls, "ForeachAddress should call fn exactly once per Sub-ENI")
+	assert.Equal(t, "instance-1", gotInstanceID)
+	assert.Equal(t, "sub-eni-123", gotInterfaceID)
+	assert.Equal(t, "192.168.1.100", gotIP)
+	assert.Equal(t, "subnet-abc", gotSubnet)
+}
+
+func TestSubENIForeachAddress_EmptyIP(t *testing.T) {
+	s := &SubENI{ID: "sub-eni-empty"}
+	var calls int
+	err := s.ForeachAddress("instance-1", func(instanceID, interfaceID, ip, subnetID string, iface ipamTypes.Address) error {
+		calls++
+		return nil
+	})
+	assert.NoError(t, err)
+	assert.Equal(t, 0, calls, "ForeachAddress with empty IP should not call fn")
+}
